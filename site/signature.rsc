","normative_status":"deployed ecosystem profile","primitive":"digital_signature","proof_model":"random oracle","security":{"mode":"public-key","model":"random oracle","notion":"EUF-CMA"},"signer_model":"single_signer","signing_cost":"hash-to-curve and one scalar multiplication","sizes":{"public_key":"one group element","secret_key":"one scalar","signature":"one group element"},"statefulness":"stateless","status":"active_family","title":"BLS short signature","verification_cost":"pairing equation","work_id":"SIG-PAPER-2001-BLS","year":2001},"primaryUrl":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","sections":[{"content":"This entry is ordinary BLS signing; multisignatures and aggregation are separate functionalities.","heading":"Construction note"}],"slug":"bls01-boneh-lynn-shacham-signature","status":"primary_source_reviewed","subtitle":"digital_signature · 2001","summary":"This entry is ordinary BLS signing; multisignatures and aggregation are separate functionalities.","title":"Boneh-Lynn-Shacham signature","type":"construction","venue":"ASIACRYPT 2001","year":2001,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2001-BLS"},{"contributions":["SIG-RESULT-2004-BB-Q-SDH-EUF-CMA","SIG-RESULT-2004-BB-SHORT-STANDARD-MODEL-SIGNATURES"],"evidence":"primary_source_reviewed","id":"SIG-CONSTRUCTION-2004-BB","keywords":["digital_signature","pairing","public-verification","short-signature","standard-model-proof"],"metadata":{"assumption":{"family":"pairing","name":"q-strong Diffie-Hellman"},"capabilities":["public-verification","short-signature","standard-model-proof"],"construction_family":"pairing","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2004-BB","name":"Boneh-Boyen short signature","nonce_generation":"randomized signing in the full construction","normative_status":"research construction","primitive":"digital_signature","proof_model":"standard model for the full construction","security":{"mode":"public-key","model":"standard","notion":"EUF-CMA"},"signer_model":"single_signer","signing_cost":"pairing-group exponentiation","sizes":{"public_key":"pairing-group elements","secret_key":"scalar","signature":"constant-size pairing-group encoding"},"statefulness":"stateless","status":"research","title":"Boneh-Boyen short signature","verification_cost":"pairing equation","work_id":"SIG-PAPER-2004-BB","year":2004},"primaryUrl":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","sections":[{"content":"This entry is the full standard-model signature, not the weak-message variant from the same paper.","heading":"Construction note"}],"slug":"bb04-boneh-boyen-short-signature","status":"primary_source_reviewed","subtitle":"digital_signature · 2004","summary":"This entry is the full standard-model signature, not the weak-message variant from the same paper.","title":"Boneh-Boyen short signature","type":"construction","venue":"EUROCRYPT 2004","year":2004,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2004-BB"},{"contributions":["SIG-RESULT-2008-GPV-LATTICE-HASH-AND-SIGN","SIG-RESULT-2008-GPV-LATTICE-PREIMAGE-SAMPLING-TRAPDOORS"],"evidence":"primary_source_reviewed","id":"SIG-CONSTRUCTION-2008-GPV","keywords":["digital_signature","lattice_hash_and_sign","public-verification","trapdoor-preimage-sampling","post-quantum"],"metadata":{"assumption":{"family":"lattice","name":"SIS and worst-case lattice problems"},"capabilities":["public-verification","trapdoor-preimage-sampling","post-quantum"],"construction_family":"lattice_hash_and_sign","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2008-GPV","name":"GPV lattice signature framework","nonce_generation":"randomized preimage sampling","normative_status":"foundational research framework","primitive":"digital_signature","proof_model":"random oracle for signatures","security":{"mode":"public-key","model":"random oracle","notion":"EUF-CMA"},"signer_model":"single_signer","signing_cost":"discrete Gaussian preimage sampling","sizes":{"public_key":"lattice matrix","secret_key":"short trapdoor basis","signature":"short lattice preimage"},"statefulness":"stateless","status":"foundational","title":"GPV hash-and-sign lattice signature","verification_cost":"matrix-vector relation and norm check","work_id":"SIG-PAPER-2008-GPV","year":2008},"primaryUrl":"https://doi.org/10.1145/1374376.1374407","sections":[{"content":"The hash-and-sign lattice root later optimized by compact trapdoors and fast Fourier sampling.","heading":"Construction note"}],"slug":"gpv08-gpv-lattice-signature-framew","status":"primary_source_reviewed","subtitle":"digital_signature · 2008","summary":"The hash-and-sign lattice root later optimized by compact trapdoors and fast Fourier sampling.","title":"GPV lattice signature framework","type":"construction","venue":"STOC 2008","year":2008,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2008-GPV"},{"contributions":["SIG-RESULT-2009-LYU-FIAT-SHAMIR-WITH-ABORTS"],"evidence":"bibliographic_reviewed","id":"SIG-CONSTRUCTION-2009-LYU","keywords":["digital_signature","lattice_fswa","public-verification","rejection-sampling","post-quantum"],"metadata":{"assumption":{"family":"lattice","name":"Ring-SIS (SIS over ideal lattices)"},"capabilities":["public-verification","rejection-sampling","post-quantum"],"construction_family":"lattice_fswa","dossier_type":"construction","evidence":"bibliographic_checked","id":"SIG-CONSTRUCTION-2009-LYU","name":"Lyubashevsky lattice signature with rejection sampling","nonce_generation":"short random mask plus rejection sampling","normative_status":"foundational research framework","primitive":"digital_signature","proof_model":"random oracle","security":{"mode":"public-key","model":"random oracle","notion":"EUF-CMA lineage"},"signer_model":"single_signer","signing_cost":"repeated masking and rejection sampling","sizes":{"public_key":"lattice relation","secret_key":"short vector","signature":"masked short vector and challenge"},"statefulness":"stateless with fresh signing randomness","status":"foundational","title":"Lyubashevsky Fiat-Shamir-with-aborts signature","verification_cost":"lattice linear relation and norm check","work_id":"SIG-PAPER-2009-LYU","year":2009},"primaryUrl":"https://doi.org/10.1007/978-3-642-10366-7_35","sections":[],"slug":"lyubashevsky09-lyubashevsky-lattice-signatu","status":"bibliographic_reviewed","subtitle":"digital_signature · 2009","summary":"Exact theorem and parameter locators remain queued for a local full-text audit.","title":"Lyubashevsky lattice signature with rejection sampling","type":"construction","venue":"ASIACRYPT 2009","year":2009,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2009-LYU"},{"contributions":["SIG-RESULT-2011-ED25519-DETERMINISTIC-NONCE-SIDE-CHANNEL-DISCIPLINE","SIG-RESULT-2011-ED25519-ED25519-ENGINEERING-PROFILE"],"evidence":"primary_source_reviewed","id":"SIG-CONSTRUCTION-2011-ED25519","keywords":["digital_signature","eddsa","public-verification","deterministic-signing","high-speed-software"],"metadata":{"assumption":{"family":"discrete_log","name":"discrete logarithm in the Edwards-curve group"},"capabilities":["public-verification","deterministic-signing","high-speed-software"],"construction_family":"eddsa","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2011-ED25519","name":"Ed25519 deterministic Edwards-curve signature","nonce_generation":"deterministic secret-prefix-and-message hash","normative_status":"EdDSA standardized in FIPS 186-5","primitive":"digital_signature","proof_model":"Schnorr-derived design","security":{"mode":"public-key","model":"hash-function idealization in analyses","notion":"public-key unforgeability lineage"},"signer_model":"single_signer","signing_cost":"fixed-base and variable-base scalar arithmetic plus hashing","sizes":{"public_key":"32 bytes","secret_key":"32-byte seed in the reference format","signature":"64 bytes"},"statefulness":"stateless","status":"standardized","title":"Ed25519","verification_cost":"double-scalar multiplication plus hashing","work_id":"SIG-PAPER-2011-ED25519","year":2011},"primaryUrl":"https://eprint.iacr.org/2011/368","sections":[{"content":"The size fields describe Ed25519's reference encoding, not every EdDSA parameterization.","heading":"Construction note"}],"slug":"bdlsy11-ed25519-deterministic-edward","status":"primary_source_reviewed","subtitle":"digital_signature · 2011","summary":"The size fields describe Ed25519's reference encoding, not every EdDSA parameterization.","title":"Ed25519 deterministic Edwards-curve signature","type":"construction","venue":"CHES 2011","year":2011,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2011-ED25519"},{"contributions":["SIG-RESULT-2018-DILITHIUM-GAUSSIAN-FREE-CONSTANT-TIME-DESIGN","SIG-RESULT-2018-DILITHIUM-MODULE-LATTICE-FSWA-SIGNATURE"],"evidence":"fulltext_reviewed","id":"SIG-CONSTRUCTION-2018-DILITHIUM","keywords":["digital_signature","module_lattice_fswa","public-verification","post-quantum","gaussian-free-design"],"metadata":{"assumption":{"family":"lattice","name":"Module-LWE and Module-SIS"},"capabilities":["public-verification","post-quantum","gaussian-free-design"],"construction_family":"module_lattice_fswa","dossier_type":"construction","evidence":"fulltext_checked","id":"SIG-CONSTRUCTION-2018-DILITHIUM","name":"CRYSTALS-Dilithium","nonce_generation":"deterministic masking from a secret seed and the message in the paper's full scheme (Section 1.2); randomized variant possible","normative_status":"design lineage standardized as ML-DSA","primitive":"digital_signature","proof_model":"quantum random oracle (concrete bound via Kiltz–Lyubashevsky–Schaffner, Section 4.2); non-tight classical random-oracle reduction","security":{"mode":"public-key","model":"quantum random-oracle model","notion":"SUF-CMA"},"signer_model":"single_signer","signing_cost":"polynomial arithmetic with rejection sampling","sizes":{"public_key":"module-lattice vectors","secret_key":"short module-lattice vectors","signature":"masked vector challenge and hint"},"statefulness":"stateless","status":"standardized_lineage","title":"CRYSTALS-Dilithium","verification_cost":"polynomial arithmetic and norm checks","work_id":"SIG-PAPER-2018-DILITHIUM","year":2018},"primaryUrl":"https://eprint.iacr.org/2017/633","sections":[{"content":"Algorithmic family card; exact FIPS encodings and parameter sets belong to the ML-DSA card. The paper's SUF-CMA bound (Section 4.2, Eq. 6) uses MLWE, MSIS, and the hash-combined SelfTargetMSIS problem.","heading":"Construction note"}],"slug":"dkl18-crystals-dilithium","status":"fulltext_reviewed","subtitle":"digital_signature · 2018","summary":"Algorithmic family card; exact FIPS encodings and parameter sets belong to the ML-DSA card. The paper's SUF-CMA bound (Section 4.2, Eq. 6) uses MLWE, MSIS, and the hash-combined SelfTargetMSIS problem.","title":"CRYSTALS-Dilithium","type":"construction","venue":"IACR TCHES 2018(1)","year":2018,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2018-DILITHIUM"},{"contributions":["SIG-RESULT-2019-SPHINCSPLUS-STATELESS-HASH-BASED-HYPERTREE"],"evidence":"primary_source_reviewed","id":"SIG-CONSTRUCTION-2019-SPHINCSPLUS","keywords":["digital_signature","stateless_hash_based","public-verification","post-quantum","stateless-signing"],"metadata":{"assumption":{"family":"hash","name":"security properties of cryptographic hash functions"},"capabilities":["public-verification","post-quantum","stateless-signing"],"construction_family":"stateless_hash_based","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2019-SPHINCSPLUS","name":"SPHINCS+ stateless hash-based signature","nonce_generation":"randomized or deterministic message randomization by profile","normative_status":"design lineage standardized as SLH-DSA","primitive":"digital_signature","proof_model":"hash-based reduction","security":{"mode":"public-key","model":"hash-function assumptions","notion":"EUF-CMA and stronger multi-target analyses by profile"},"signer_model":"single_signer","signing_cost":"many hash computations","sizes":{"public_key":"compact hash roots","secret_key":"compact seeds and root","signature":"many hash outputs across FORS and hypertree paths"},"statefulness":"stateless","status":"standardized_lineage","title":"SPHINCS+","verification_cost":"many hash computations","work_id":"SIG-PAPER-2019-SPHINCSPLUS","year":2019},"primaryUrl":"https://eprint.iacr.org/2019/1086","sections":[{"content":"The conservative-assumption branch trades comparatively large signatures and hashing work for stateless operation.","heading":"Construction note"}],"slug":"hkb19-sphincs-stateless-hash-based","status":"primary_source_reviewed","subtitle":"digital_signature · 2019","summary":"The conservative-assumption branch trades comparatively large signatures and hashing work for stateless operation.","title":"SPHINCS+ stateless hash-based signature","type":"construction","venue":"ACM CCS 2019","year":2019,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2019-SPHINCSPLUS"},{"contributions":["SIG-RESULT-2020-FALCON-COMPACT-LATTICE-SIGNATURES","SIG-RESULT-2020-FALCON-GPV-NTRU-FAST-FOURIER-SAMPLING"],"evidence":"primary_source_reviewed","id":"SIG-CONSTRUCTION-2020-FALCON","keywords":["digital_signature","ntru_lattice_hash_and_sign","public-verification","post-quantum","compact-signature"],"metadata":{"assumption":{"family":"lattice","name":"NTRU-lattice SIS lineage"},"capabilities":["public-verification","post-quantum","compact-signature"],"construction_family":"ntru_lattice_hash_and_sign","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2020-FALCON","name":"Falcon fast-Fourier lattice signature","nonce_generation":"randomized hash-to-point and Gaussian preimage sampling","normative_status":"selected by NIST; FN-DSA standard in development at cutoff","primitive":"digital_signature","proof_model":"random oracle lineage","security":{"mode":"public-key","model":"random-oracle lineage","notion":"EUF-CMA"},"signer_model":"single_signer","signing_cost":"fast Fourier Gaussian sampling","sizes":{"public_key":"compressed NTRU polynomial","secret_key":"compressed NTRU trapdoor","signature":"salt and compressed short vector"},"statefulness":"stateless","status":"selected_pending_final_standard","title":"Falcon","verification_cost":"NTRU polynomial arithmetic and norm check","work_id":"SIG-PAPER-2020-FALCON","year":2020},"primaryUrl":"https://falcon-sign.info/falcon.pdf","sections":[{"content":"Implementation assurance centers on the correctness and side-channel behavior of the sampler as well as the algebraic core.","heading":"Construction note"}],"slug":"fhk20-falcon-fast-fourier-lattice","status":"primary_source_reviewed","subtitle":"digital_signature · 2020","summary":"Implementation assurance centers on the correctness and side-channel behavior of the sampler as well as the algebraic core.","title":"Falcon fast-Fourier lattice signature","type":"construction","venue":"NIST PQC supporting documentation","year":2020,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2020-FALCON"},{"contributions":["SIG-RESULT-2024-FIPS204-ML-DSA-STANDARDIZATION"],"evidence":"standard_reviewed","id":"SIG-CONSTRUCTION-2024-MLDSA","keywords":["digital_signature","module_lattice_fswa","public-verification","post-quantum","federal-standard"],"metadata":{"assumption":{"family":"lattice","name":"Module-LWE and Module-SIS lineage"},"capabilities":["public-verification","post-quantum","federal-standard"],"construction_family":"module_lattice_fswa","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2024-MLDSA","name":"Module-Lattice-Based Digital Signature Standard","nonce_generation":"deterministic signing with an optional randomness input in the standard","normative_status":"NIST FIPS 204 final","primitive":"digital_signature","proof_model":"standardized Dilithium-derived profile","security":{"mode":"public-key","model":"FIPS 204 specification","notion":"standardized digital-signature security profile"},"signer_model":"single_signer","signing_cost":"parameter-set-defined NTT polynomial arithmetic and rejection sampling","sizes":{"public_key":"parameter-set-defined byte string","secret_key":"parameter-set-defined byte string","signature":"parameter-set-defined byte string"},"statefulness":"stateless","status":"standardized","title":"ML-DSA","verification_cost":"parameter-set-defined NTT polynomial arithmetic and checks","work_id":"SIG-PAPER-2024-FIPS204","year":2024},"primaryUrl":"https://csrc.nist.gov/pubs/fips/204/final","sections":[{"content":"Use the three named FIPS parameter sets for concrete byte counts; this cross-family card deliberately avoids mixing them.","heading":"Construction note"}],"slug":"nist24-fips204-module-lattice-based-digital","status":"standard_reviewed","subtitle":"digital_signature · 2024","summary":"Use the three named FIPS parameter sets for concrete byte counts; this cross-family card deliberately avoids mixing them.","title":"Module-Lattice-Based Digital Signature Standard","type":"construction","venue":"FIPS 204","year":2024,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2024-MLDSA"},{"contributions":["SIG-RESULT-2024-FIPS205-SLH-DSA-STANDARDIZATION"],"evidence":"standard_reviewed","id":"SIG-CONSTRUCTION-2024-SLHDSA","keywords":["digital_signature","stateless_hash_based","public-verification","post-quantum","federal-standard","conservative-assumption-profile"],"metadata":{"assumption":{"family":"hash","name":"security properties of approved hash functions"},"capabilities":["public-verification","post-quantum","federal-standard","conservative-assumption-profile"],"construction_family":"stateless_hash_based","dossier_type":"construction","evidence":"primary_source_checked","id":"SIG-CONSTRUCTION-2024-SLHDSA","name":"Stateless Hash-Based Digital Signature Standard","nonce_generation":"deterministic or hedged randomized signing mode","normative_status":"NIST FIPS 205 final","primitive":"digital_signature","proof_model":"standardized SPHINCS+-derived profile","security":{"mode":"public-key","model":"FIPS 205 specification","notion":"standardized digital-signature security profile"},"signer_model":"single_signer","signing_cost":"parameter-set-defined hash computation","sizes":{"public_key":"parameter-set-defined byte string","secret_key":"parameter-set-defined byte string","signature":"parameter-set-defined large hash-based byte string"},"statefulness":"stateless","status":"standardized","title":"SLH-DSA","verification_cost":"parameter-set-defined hash computation","work_id":"SIG-PAPER-2024-FIPS205","year":2024},"primaryUrl":"https://csrc.nist.gov/pubs/fips/205/final","sections":[{"content":"The SHA2 and SHAKE parameter families expose different speed/size/security tradeoffs and should be compared at parameter-set granularity.","heading":"Construction note"}],"slug":"nist24-fips205-stateless-hash-based-digital","status":"standard_reviewed","subtitle":"digital_signature · 2024","summary":"The SHA2 and SHAKE parameter families expose different speed/size/security tradeoffs and should be compared at parameter-set granularity.","title":"Stateless Hash-Based Digital Signature Standard","type":"construction","venue":"FIPS 205","year":2024,"sourcePath":"data/signature-catalog.json#SIG-CONSTRUCTION-2024-SLHDSA"},{"evidence":"synthesized_from_sources","id":"SIG-GOAL-001","keywords":["ecdsa","provable-security","conversion-function","generic-group-model","meta-reduction"],"metadata":{"basis":"synthesized","dossier_type":"goal","evidence":"synthesized_from_sources","frontier":[{"cells":{"chosen_message":"yes","dlog_reduction":"no","real_conversion":"no","unmodified":"yes"},"hardness_assumption":"discrete logarithm, implied by the generic group","line":"Generic-group analyses before 2016","note":"Analyses of (EC)DSA that model the group as generic, which, as Fersch, Kiltz and Poettering observe, implicitly idealizes the conversion function; a generic group gives no reduction to discrete logarithms in a concrete curve.","security_model":["generic group"],"setting":"none beyond the goal","sources":[{"locator":"§1, pp. 1651-1652 (CCS 2016 proceedings)","paper":"SIG-PAPER-2016-FKP"}]},{"cells":{"chosen_message":"yes","dlog_reduction":"yes","real_conversion":"no","unmodified":"yes"},"hardness_assumption":"discrete logarithm","line":"Bijective random oracle inside the conversion function","note":"Covers unmodified DSA and ECDSA and reduces to discrete logarithms, with a loss of about the number of bijective-oracle queries and a squared success probability, but the reduction programs the middle part of the conversion function.","security_model":["random permutation"],"setting":"none beyond the goal","sources":[{"locator":"§1.1, pp. 1653-1654, and the reductions of §4 (CCS 2016 proceedings)","paper":"SIG-PAPER-2016-FKP"}]},{"cells":{"chosen_message":"yes","dlog_reduction":"no","real_conversion":"no","unmodified":"yes"},"hardness_assumption":"collision- and preimage-resistant hash function","line":"Elliptic-curve generic group model","note":"The generic encoding exposes x-coordinates, so the real conversion function and malleability are captured, and the bound also covers strong unforgeability up to sign; the group itself is idealized.","security_model":["generic group"],"setting":"none beyond the goal","sources":[{"locator":"§2, p. 8; Theorem 1, p. 16 (author version of ePrint 2021/1330, 2022-04-27)","paper":"SIG-PAPER-2022-GS"}]},{"cells":{"chosen_message":"yes","dlog_reduction":"yes","real_conversion":"yes","unmodified":"no"},"hardness_assumption":"discrete logarithm","line":"Schnorr signatures (Fiat–Shamir)","note":"A different scheme: rewinding on hash queries reduces Schnorr signatures to discrete logarithms with only the hash idealized. The argument does not carry over to ECDSA, which is not a Fiat–Shamir scheme.","security_model":["random oracle"],"setting":"none beyond the goal","sources":[{"locator":"§1, pp. 1651-1652 (CCS 2016 proceedings)","paper":"SIG-PAPER-2016-FKP"},{"locator":"abstract and §1","paper":"SIG-PAPER-1991-SCHNORR"}]}],"id":"SIG-GOAL-001","keywords":["ecdsa","provable-security","conversion-function","generic-group-model","meta-reduction"],"layers":[{"best":"proofs in idealized models","distance":"reached","distance_note":"Reached in 2016 with part of the conversion function idealized; the assumptions dimension measures what the proofs idealize.","layer":"feasibility","rungs":[{"kind":"construction","level":"Unmodified (EC)DSA proved unforgeable, with the middle of the conversion function a programmable random bijection.","sources":[{"locator":"§1.1, pp. 1653-1654","paper":"SIG-PAPER-2016-FKP"}],"status":"reached","year":2016},{"alongside":true,"kind":"construction","level":"Unmodified ECDSA proved unforgeable in a generic group that exposes the real conversion function and malleability.","problem":"SIG-OP-003","sources":[{"locator":"§2, p. 8; Theorem 1, p. 16","paper":"SIG-PAPER-2022-GS"}],"status":"reached","year":2022}],"target":"a CMA proof for unmodified ECDSA"},{"best":"DL, with a programmable conversion","distance":"far","distance_note":"Every proof idealizes the group or the conversion function, and algebraic black-box reductions that avoid this provably fail unless a one-more discrete-logarithm assumption fails.","layer":"assumptions","near_misses":[{"gives_up":"chosen_message","level":"Key-only unforgeability from discrete logarithms with the real conversion function: still open.","problem":"SIG-OP-005","status":"open"}],"rungs":[{"kind":"construction","level":"From discrete logarithms, with the inner bijection of the conversion function a programmable random bijection.","problem":"SIG-OP-004","sources":[{"locator":"§1.1, pp. 1653-1654, and §4","paper":"SIG-PAPER-2016-FKP"}],"status":"reached","year":2016},{"barrier":"SIG-BARRIER-002","kind":"barrier","level":"Algebraic black-box reductions from discrete logarithms must program the conversion function, already for key-only security."},{"kind":"construction","level":"From discrete logarithms, with the real conversion function, under chosen-message attack.","problem":"SIG-OP-002","status":"open"}],"target":"discrete logarithms alone"},{"layer":"asymptotic","not_applicable":"The question is whether any reduction with polynomial loss exists; the sources set no target for its tightness.","not_applicable_label":"Any polynomial loss counts"},{"layer":"concrete","not_applicable":"Deployment is not the question: the goal asks for a proof about ECDSA as FIPS 186-5 fixes it, and a proof changes neither its sizes nor its costs.","not_applicable_label":"Already standardized; cost is fixed"}],"recognized_by":[{"locator":"abstract, p. 1651, and §1, pp. 1651-1652 (CCS 2016 proceedings)","paper":"SIG-PAPER-2016-FKP","statement":"Finds that earlier analyses either modify (EC)DSA or idealize its conversion function, so that understanding the security of DSA and ECDSA remains an open problem."},{"locator":"abstract, PDF p. 1, and §1 (Observation and Question), PDF p. 2 (ePrint 2023/914)","paper":"SIG-PAPER-2023-HK","statement":"Asks whether (EC)DSA is provably secure without programming its conversion function, with the message hash still allowed to be a random oracle."},{"locator":"abstract and §1, p. 2 (author version of ePrint 2021/1330, 2022-04-27)","paper":"SIG-PAPER-2022-GS","statement":"Notes that ECDSA, although widely deployed, has only been analyzed in idealized models."}],"requirements":[{"axis":"Setting","key":"unmodified","label":"Unmodified ECDSA","layer":"feasibility","target":"ECDSA exactly as in FIPS 186-5, with the conversion function x(R) mod \\( n \\) and the malleability (s, t) → (−s, t)"},{"axis":"Security","key":"chosen_message","label":"Chosen-message security","layer":"feasibility","target":"existential unforgeability under adaptive chosen-message attack"},{"axis":"Assumption","key":"dlog_reduction","label":"From discrete logarithms","layer":"assumptions","target":"a reduction from discrete logarithms in the curve group with loss polynomial in the number of queries"},{"axis":"Model","key":"real_conversion","label":"Real group and conversion","layer":"assumptions","target":"curve group and conversion function used as given, never generic or programmable; only the message hash may be a random oracle"}],"reviewed_by":[],"status":"open","summary":"A proof that standard ECDSA is unforgeable under chosen-message attack assuming only that discrete logarithms are hard, with at most the message hash idealized. Every known proof idealizes the curve group or part of the conversion function.","title":"Unmodified ECDSA as secure as discrete logarithms"},"primaryUrl":null,"sections":[{"content":"ECDSA is specified in FIPS 186-5 (SIG-PAPER-2023-FIPS186-5), deployed in TLS\nand in cryptocurrencies, and the basis of threshold-ECDSA protocols, yet its\nsecurity has only been shown in idealized models (SIG-PAPER-2022-GS). Unlike\nSchnorr signatures it is not a Fiat–Shamir scheme, and its conversion\nfunction, the x-coordinate of a point reduced modulo the group order, has no\nalgebraic meaning, so the forking-lemma proof of Schnorr signatures does not\napply (SIG-PAPER-2016-FKP). The goal is the proof that every analysis of\nECDSA has aimed at: unforgeability from discrete logarithms in the curve\ngroup, with nothing idealized except possibly the message hash.","heading":"Why this goal"},{"content":"Rows group the proofs by what they idealize. The two ECDSA proofs keep the\nscheme unmodified and give up the real conversion function in different\nways: one programs part of it, the other makes the whole group generic. The\nSchnorr row is a different scheme and shows that the target shape is\nreachable for Fiat–Shamir signatures. Hartmann and Kiltz explain why no row\nmeets every requirement (SIG-BARRIER-002): an algebraic reduction from\ndiscrete logarithms must program the conversion function, so a proof with\nthe real function needs a reduction of a new kind.","heading":"Reading the frontier"}],"slug":"goal-1","status":"open","subtitle":"","summary":"Unmodified ECDSA as secure as discrete logarithms","title":"Unmodified ECDSA as secure as discrete logarithms","type":"goal","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-GOAL-001"},{"evidence":"synthesized_from_sources","id":"SIG-GOAL-002","keywords":["hash-based","signature-length","random-oracle-model","stateless","lower-bound","slh-dsa"],"metadata":{"basis":"synthesized","dossier_type":"goal","evidence":"synthesized_from_sources","frontier":[{"cells":{"hash_only":"yes","linear_length":"no","many_time":"no","stateless":"yes"},"hardness_assumption":"one-way function","line":"Lamport one-time signatures","note":"One key signs one message. Known hash-based schemes are roughly quadratic in \\( \\lambda \\) even for one-time use, as the 2026 lower-bound paper notes.","security_model":["standard model"],"setting":"none beyond the goal","sources":[{"locator":"bibliographic record (full text not checked)","paper":"SIG-PAPER-1979-LAMPORT"},{"locator":"abstract (ePrint 2026/2237)","paper":"SIG-PAPER-2026-CHMY"}]},{"cells":{"hash_only":"yes","linear_length":"no","many_time":"yes","stateless":"no"},"hardness_assumption":"hash function","line":"Merkle tree signatures","note":"A tree authenticates many one-time keys under one root, so one key signs a bounded number of messages, but the signer must remember which one-time keys it has used.","security_model":["standard model"],"setting":"none beyond the goal","sources":[{"locator":"bibliographic record (full text not checked)","paper":"SIG-PAPER-1989-MERKLE"}]},{"cells":{"hash_only":"yes","linear_length":"no","many_time":"yes","stateless":"yes"},"hardness_assumption":"hash function","line":"Stateless hypertrees (SPHINCS+, SLH-DSA)","note":"Stateless, but SLH-DSA signatures are 7,856 to 49,856 bytes across its parameter sets, against 64 bytes for Ed25519 (SIG-PAPER-2011-ED25519).","security_model":["unknown"],"setting":"none beyond the goal","sources":[{"locator":"abstract and Introduction (ePrint 2019/1086)","paper":"SIG-PAPER-2019-SPHINCSPLUS"},{"locator":"§11, Table 2, p. 43","paper":"SIG-PAPER-2024-FIPS205"}]},{"cells":{"hash_only":"no","linear_length":"yes","many_time":"yes","stateless":"yes"},"hardness_assumption":"discrete logarithm","line":"Discrete-log signatures (Schnorr)","note":"Signatures of \\( O(\\lambda) \\) bits, but security rests on discrete logarithms as well as the hash function.","security_model":["random oracle"],"setting":"none beyond the goal","sources":[{"locator":"abstract and §1","paper":"SIG-PAPER-1991-SCHNORR"},{"locator":"abstract (ePrint 2026/2237)","paper":"SIG-PAPER-2026-CHMY"}]}],"id":"SIG-GOAL-002","keywords":["hash-based","signature-length","random-oracle-model","stateless","lower-bound","slh-dsa"],"layers":[{"best":"SLH-DSA (SPHINCS+)","distance":"reached","distance_note":"Reached by stateless hypertree signatures; the open question is length.","layer":"feasibility","near_misses":[{"gives_up":"many_time","level":"One-time signatures from one-way functions.","sources":[{"locator":"bibliographic record (full text not checked)","paper":"SIG-PAPER-1979-LAMPORT"}],"year":1979},{"gives_up":"stateless","level":"Many-time signatures from a hash tree, with a signer that remembers which one-time keys it used.","sources":[{"locator":"bibliographic record (full text not checked)","paper":"SIG-PAPER-1989-MERKLE"}],"year":1989}],"rungs":[{"kind":"construction","level":"Stateless many-time signatures from hash functions alone, in the SPHINCS+ form that FIPS 205 standardizes.","sources":[{"locator":"abstract and Introduction (ePrint 2019/1086)","paper":"SIG-PAPER-2019-SPHINCSPLUS"},{"locator":"normative standard","paper":"SIG-PAPER-2024-FIPS205"}],"status":"reached","year":2019}],"target":"stateless, many-time, hash only"},{"layer":"assumptions","not_applicable":"The goal fixes the assumption at a hash function alone; only length is in question.","not_applicable_label":"Hash functions only, by definition; length is the question"},{"best":"about \\( \\lambda^{2} \\) bits; \\( \\Omega(\\lambda^{2}/\\log \\lambda) \\) lower bound","distance":"far","distance_note":"Every known scheme is about \\( \\lambda^{2} \\) bits, a factor of about \\( \\lambda \\) above the goal, and a lower bound already covers the verifiers that the known schemes use.","layer":"asymptotic","near_misses":[{"gives_up":"hash_only","level":"Discrete-log signatures of length linear in the security parameter, \\( O(\\lambda) \\) bits.","sources":[{"locator":"abstract and §1","paper":"SIG-PAPER-1991-SCHNORR"},{"locator":"abstract (ePrint 2026/2237)","paper":"SIG-PAPER-2026-CHMY"}],"year":1991}],"rungs":[{"kind":"construction","level":"Stateless signatures of roughly quadratic length, about \\( \\lambda^{2} \\) bits: SLH-DSA signatures are 7,856 to 49,856 bytes.","sources":[{"locator":"§11, Table 2, p. 43","paper":"SIG-PAPER-2024-FIPS205"},{"locator":"abstract (ePrint 2026/2237)","paper":"SIG-PAPER-2026-CHMY"}],"status":"reached","year":2019},{"kind":"lower_bound","level":"A one-time signature making \\( q \\) random-oracle queries has security at most \\( 2^{(1+o(1))q} \\); this counts queries, not bits.","sources":[{"locator":"Theorem 1.1, §1, PDF p. 2 (arXiv 0801.3680v3)","paper":"SIG-PAPER-2007-BM"}],"year":2007},{"kind":"lower_bound","level":"Random-oracle signatures with non-adaptive verifiers and salted soundness need \\( \\Omega(\\lambda^{2}/\\log \\lambda) \\) bits.","sources":[{"locator":"abstract (ePrint 2026/2237; full text not checked)","paper":"SIG-PAPER-2026-CHMY"}],"year":2026},{"kind":"construction","level":"Random-oracle signatures of \\( o(\\lambda^{2}/\\log \\lambda) \\) bits, or the \\( \\Omega(\\lambda^{2}/\\log \\lambda) \\) bound for every verifier.","problem":"SIG-OP-006","status":"open"}],"target":"\\( O(\\lambda) \\)-bit signatures, or a lower bound"},{"layer":"concrete","not_applicable":"The covered sources describe no deployment scenario with a size budget: FIPS 205 names uses such as software distribution with no limit on signature size, and the papers compare lengths only as functions of \\( \\lambda \\).","not_applicable_label":"The literature gives no deployment target"}],"recognized_by":[{"locator":"abstract (ePrint 2026/2237; full text not checked)","paper":"SIG-PAPER-2026-CHMY","statement":"Contrasts \\( O(\\lambda) \\)-length discrete-log signatures with roughly quadratic-length hash-based signatures and asks whether this gap is inherent."},{"locator":"§8 'Conclusions and open questions', PDF p. 26 (arXiv 0801.3680v3)","paper":"SIG-PAPER-2007-BM","statement":"After bounding the random-oracle queries of one-time signatures, asks for the optimal query count and for stronger bounds on many-time signatures."},{"locator":"abstract (ePrint 2023/250; full text not checked)","paper":"SIG-PAPER-2023-BGZ","statement":"Proves that signatures using a group action as a black box need length \\( \\Omega(\\lambda^{2}/\\log \\lambda) \\), matching known group-action constructions."}],"requirements":[{"axis":"Assumption","key":"hash_only","label":"Hash function alone","layer":"feasibility","target":"security from a hash function alone, modeled as a random oracle; no algebraic assumption"},{"axis":"Functionality","key":"many_time","label":"Many messages per key","layer":"feasibility","target":"one key signs any polynomial number of messages under chosen-message attack"},{"axis":"Setting","key":"stateless","label":"Stateless signer","layer":"feasibility","target":"the signer keeps no state between signatures"},{"axis":"Efficiency","key":"linear_length","label":"Signatures of \\( O(\\lambda) \\) bits","layer":"asymptotic","target":"signature length \\( O(\\lambda) \\) bits at security level \\( \\lambda \\), as for discrete-log signatures"}],"reviewed_by":[],"status":"open","summary":"Stateless many-time signatures that rest on a hash function alone and are \\( O(\\lambda) \\) bits long, like discrete-log signatures, or a proof that hash functions cannot give them. Every known hash-based scheme is about \\( \\lambda^{2} \\) bits long, and a 2026 lower bound shows this is necessary for a broad class of verifiers.","title":"Hash-based signatures as short as Schnorr signatures"},"primaryUrl":null,"sections":[{"content":"Hash-based signatures need nothing beyond a hash function, which makes them\nthe most conservative basis for post-quantum signatures, and SLH-DSA\nstandardizes them (SIG-PAPER-2024-FIPS205). Their cost is length: from\nLamport's one-time scheme to SLH-DSA they are roughly quadratic in the\nsecurity parameter, while discrete-log signatures are linear\n(SIG-PAPER-2026-CHMY). Whether that gap is forced by the random oracle model\ndecides how much room is left for shorter hash-based signatures.","heading":"Why this goal"},{"content":"Each hash-based row gives up one requirement or length: Lamport signatures\nsign one message, Merkle trees need a signer that keeps state, and stateless\nhypertrees are long. The Schnorr row reaches linear length only by adding a\ndiscrete-logarithm assumption. Group-action signatures, another\npost-quantum family, meet the same \\( \\Omega(\\lambda^{2}/\\log \\lambda) \\) length bound in a generic\nmodel (SIG-PAPER-2023-BGZ) and are not a row here because they also add an\nassumption. The 2026 lower bound and the group-action bound are read from\nthe papers' abstracts only.","heading":"Reading the frontier"}],"slug":"goal-2","status":"open","subtitle":"","summary":"Hash-based signatures as short as Schnorr signatures","title":"Hash-based signatures as short as Schnorr signatures","type":"goal","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-GOAL-002"},{"evidence":"claim_audited","id":"SIG-OP-002","keywords":["ecdsa","provable-security","conversion-function","random-oracle-model","meta-reduction"],"metadata":{"barriers":["SIG-BARRIER-002"],"basis":"named","caveat":null,"dossier_type":"open_problem","evidence":"claim_audited","id":"SIG-OP-002","keywords":["ecdsa","provable-security","conversion-function","random-oracle-model","meta-reduction"],"named_open_by":[{"locator":"Abstract, p. 1651, and §1, pp. 1651–1652 (CCS 2016 proceedings)","paper":"SIG-PAPER-2016-FKP","statement":"Finds that earlier analyses either modify (EC)DSA or analyze it in a generic group model that implicitly idealizes the conversion function, so that understanding the security of DSA and ECDSA remains an open problem."},{"locator":"Abstract, PDF p. 1, and §1 (Observation and Question), PDF p. 2 (TCC 2023; ePrint 2023/914, PDF downloaded 2026-10-11)","paper":"SIG-PAPER-2023-HK","statement":"Observes that all existing (EC)DSA security proofs model the conversion function, or part of it, as a programmable idealized function, explicitly as a random function or bijection or implicitly through the generic group model, and asks whether (EC)DSA is provably secure without relying on that programmability, with the message hash still allowed to be a programmable random oracle."}],"profile":{"Assumption":"discrete logarithm in the curve group","Model":"hash may be a random oracle; curve group and conversion function not idealized","Security":"existential unforgeability under chosen-message attack (EUF-CMA)","Setting":"unmodified ECDSA as in FIPS 186-5"},"refuted_by":[],"related":[],"resolution_condition":"A reduction showing that any adversary breaking EUF-CMA of unmodified ECDSA (FIPS 186-5 signing and verification, conversion function R -> x(R) mod \\( n \\), malleability (s, t) -> (-s, t) accounted for) with non-negligible advantage yields an algorithm computing discrete logarithms in the same curve group with non-negligible advantage, where the message hash may be modeled as a (programmable) random oracle or assumed collision resistant, and neither the group nor the conversion function is modeled as a generic, random, bijective-random or programmable object. Loss polynomial in the number of queries is acceptable.","resolved_by":[],"status":"open","summary":"Is standard ECDSA unforgeable assuming only that discrete logarithms are hard, with at most the message hash idealized? Every known proof idealizes the group or the conversion function, and algebraic reductions provably need to program that function.","title":"Security of unmodified ECDSA without idealized models"},"primaryUrl":null,"sections":[{"content":"ECDSA, standardized in FIPS 186-5 (SIG-PAPER-2023-FIPS186-5), signs a message\n\\( m \\) with secret key \\( d \\) by choosing a nonce \\( r \\), computing\n\\( R = rG \\), \\( t = f(R) \\) and \\( s = r^{-1}(H(m) + t d) \\), where the\nconversion function \\( f \\) takes the x-coordinate of \\( R \\) modulo the group\norder. Unlike Schnorr signatures, ECDSA is not obtained by the Fiat–Shamir\ntransform, and \\( f \\) has no algebraic meaning: its outputs are biased and\npreimages are easy to find (SIG-PAPER-2016-FKP, Section 1). ECDSA is deployed\nin TLS and in cryptocurrencies and underlies threshold-ECDSA protocols, yet it\nhas only been analyzed in idealized models (SIG-PAPER-2022-GS, Section 1).","heading":"Background"},{"content":"Prove that unmodified ECDSA is existentially unforgeable under chosen-message\nattack assuming only that discrete logarithms are hard in the curve group. The\nmessage hash \\( H \\) may be modeled as a random oracle, but the curve group\nand the conversion function must be the real objects: not a generic group,\nnot a random or bijective random function, and not programmable by the\nreduction.","heading":"Problem"},{"content":"The forking-lemma argument for Schnorr does not carry over: a forger may use a\nfresh nonce in every forgery, so rewinding on hash queries yields systems with\nmore unknowns than equations, and modeling \\( f \\) as a random oracle ignores\nits bias and easy preimages (SIG-PAPER-2016-FKP, Section 1). Positive results\ntherefore idealize something: the group, as in [the generic group\nproof](SIG-OP-003) of SIG-PAPER-2022-GS, or part of \\( f \\), as in [the\nbijective-random-oracle proof](SIG-OP-004) of SIG-PAPER-2016-FKP.\nSIG-PAPER-2023-HK show by meta-reductions that an algebraic reduction from\ndiscrete logarithms must be able to program the conversion function, already\nfor [key-only unforgeability](SIG-OP-005); their argument assumes a free-base\none-more discrete-logarithm assumption. A proof meeting the target must\ntherefore use a reduction that is not algebraic or not black-box, unless that\nassumption fails, and no such technique for ECDSA is known\n(SIG-PAPER-2023-HK, Section 1.1).","heading":"Why it is open"},{"content":"- Proofs in the generic group model or the elliptic-curve generic group model.\n- Proofs that model the conversion function, or a component of it, as a\n  random oracle or bijective random oracle.\n- Proofs for modified variants, such as those that hash the message together\n  with \\( t \\).\n- Proofs from assumptions defined through the conversion function or ECDSA's\n  verification equation, which restate the target.\n- Proofs for DSA only, whose conversion function behaves differently.","heading":"What would not resolve it"},{"content":"$8","heading":"Formal target"},{"content":"The meta-reductions of SIG-PAPER-2023-HK rule out algebraic reductions from\ndiscrete logarithms that do not program the conversion function, for\nkey-only and for chosen-message unforgeability, conditionally on a free-base\none-more discrete-logarithm assumption. They do not rule out non-algebraic or\nnon-black-box reductions, or proofs from stronger assumptions over the group.","heading":"Known obstacles"},{"content":"SIG-PAPER-2016-FKP surveyed earlier ECDSA analyses, found that positive\nresults either modify the scheme or rely on generic-group arguments that\nimplicitly idealize \\( f \\), and proposed the bijective-random-oracle model.\nSIG-PAPER-2022-GS made the generic-group approach precise for elliptic curves,\ncapturing the conversion function and malleability, and extended it to\npresignatures and key derivation, the variants used in threshold ECDSA.\nSIG-PAPER-2023-HK asked whether idealization is necessary and showed that\nalgebraic reductions cannot avoid programming the conversion function.","heading":"Research history"}],"slug":"op-2","status":"open","subtitle":"","summary":"Security of unmodified ECDSA without idealized models","title":"Security of unmodified ECDSA without idealized models","type":"open_problem","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-OP-002"},{"evidence":"fulltext_checked","id":"SIG-OP-003","keywords":["ecdsa","generic-group-model","unforgeability"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"SIG-OP-003","keywords":["ecdsa","generic-group-model","unforgeability"],"profile":{"Model":"elliptic-curve generic group model; hash collision and preimage resistant","Security":"existential unforgeability under chosen-message attack (EUF-CMA)","Setting":"unmodified ECDSA as in FIPS 186-5"},"resolved_by":[{"locator":"§2 'The EC-GGM', p. 8, and Theorem 1, p. 16 (author version of ePrint 2021/1330, 2022-04-27)","paper":"SIG-PAPER-2022-GS"}],"status":"resolved","summary":"EUF-CMA security of unmodified ECDSA when the curve group is modeled as a generic group that also captures the conversion function and signature malleability. Solved in the elliptic-curve generic group model.","title":"Unforgeability of ECDSA in the generic group model"},"primaryUrl":null,"sections":[{"content":"Prove that unmodified ECDSA is existentially unforgeable under chosen-message\nattack when the curve group is modeled as a generic group, with only\nstandard-model properties assumed of the message hash.","heading":"Problem"},{"content":"SIG-PAPER-2022-GS define an elliptic-curve generic group model in which the\nencoding exposes x-coordinates, so the real conversion function and the\nmalleability \\( (s, t) \\mapsto (-s, t) \\) are captured. Their Theorem 1\nbounds the forging advantage by the collision, random-preimage and\nzero-preimage advantages against the hash plus \\( O(N^2/q) \\) for \\( N \\)\ngroup and signing queries, and the bound also covers strong unforgeability up\nto sign. The authors note that earlier generic-group analyses ruled out\nmalleability that ECDSA in fact has. A generic group gives no reduction to\ndiscrete logarithms in a concrete curve.","heading":"Resolution"}],"slug":"op-3","status":"resolved","subtitle":"","summary":"Unforgeability of ECDSA in the generic group model","title":"Unforgeability of ECDSA in the generic group model","type":"open_problem","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-OP-003"},{"evidence":"claim_audited","id":"SIG-OP-004","keywords":["ecdsa","bijective-random-oracle","conversion-function","forking-lemma"],"metadata":{"dossier_type":"open_problem","evidence":"claim_audited","id":"SIG-OP-004","keywords":["ecdsa","bijective-random-oracle","conversion-function","forking-lemma"],"profile":{"Assumption":"discrete logarithm in the curve group","Model":"inner bijection of the conversion function is a programmable bijective random oracle","Security":"existential unforgeability under chosen-message attack (EUF-CMA)","Setting":"unmodified ECDSA as in FIPS 186-5"},"resolved_by":[{"locator":"§1.1, pp. 1653–1654, and the reductions of §4 (CCS 2016 proceedings)","paper":"SIG-PAPER-2016-FKP"}],"status":"resolved","summary":"EUF-CMA security of unmodified ECDSA from discrete logarithms when the middle part of the conversion function is a programmable bijective random oracle. Solved.","title":"Unforgeability of ECDSA with an idealized conversion function"},"primaryUrl":null,"sections":[{"content":"Prove that unmodified ECDSA is existentially unforgeable under chosen-message\nattack from the discrete-logarithm assumption when the conversion function is\nwritten as \\( f = \\psi \\circ \\Pi \\circ \\varphi \\) and the middle bijection\n\\( \\Pi \\) is a bijective random oracle that the reduction may program.","heading":"Problem"},{"content":"SIG-PAPER-2016-FKP define GenDSA, which covers unmodified DSA and ECDSA, and\nprove its unforgeability from discrete logarithms when \\( \\Pi \\) is a\nbijective random oracle, the hash is collision resistant and division\nresistant, and \\( \\varphi \\) is semi-injective. The reduction loses about a\nfactor of the number of bijective-oracle queries and squares the success\nprobability. By SIG-PAPER-2023-HK, programming \\( f \\) is unavoidable for\nalgebraic reductions.","heading":"Resolution"}],"slug":"op-4","status":"resolved","subtitle":"","summary":"Unforgeability of ECDSA with an idealized conversion function","title":"Unforgeability of ECDSA with an idealized conversion function","type":"open_problem","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-OP-004"},{"evidence":"claim_audited","id":"SIG-OP-005","keywords":["ecdsa","key-only-attack","conversion-function","meta-reduction"],"metadata":{"barriers":["SIG-BARRIER-002"],"basis":"named","dossier_type":"open_problem","evidence":"claim_audited","id":"SIG-OP-005","keywords":["ecdsa","key-only-attack","conversion-function","meta-reduction"],"named_open_by":[{"locator":"§1 (Observation and Question), PDF p. 2; Figure 1, PDF p. 3; Theorems 1 and 2, §4.1, pp. 14-15 (ePrint 2023/914)","paper":"SIG-PAPER-2023-HK","statement":"Asks whether (EC)DSA is provably secure without programming the conversion function, and shows that algebraic reductions from discrete logarithms to key-only security must program it and rewind, leaving other reductions open."}],"profile":{"Assumption":"discrete logarithm in the curve group","Model":"hash may be a random oracle; curve group and conversion function not idealized","Security":"key-only unforgeability: no signing queries","Setting":"unmodified ECDSA as in FIPS 186-5"},"resolution_condition":"A reduction from discrete logarithms in the curve group to key-only existential unforgeability of unmodified ECDSA, with the message hash possibly a random oracle and with the real curve group and conversion function, neither idealized nor programmable.","status":"open","summary":"Unforgeability of unmodified ECDSA against adversaries that see only the public key, from discrete logarithms and without idealizing the group or the conversion function. Open; algebraic reductions must program the conversion function even here.","title":"Key-only unforgeability of ECDSA from discrete logarithms"},"primaryUrl":null,"sections":[{"content":"Prove that no efficient adversary given only an ECDSA public key can output a\nvalid signature on any message, assuming only that discrete logarithms are\nhard in the curve group, with the hash possibly a random oracle and with the\nreal, non-programmable conversion function.","heading":"Problem"},{"content":"SIG-PAPER-2016-FKP reach key-only security from discrete logarithms by\nrewinding while programming the bijective random oracle inside \\( f \\).\nSIG-PAPER-2023-HK show that an algebraic reduction from discrete logarithms to\nthis notion must both program \\( f \\) and rewind the adversary, conditionally\non a free-base one-more discrete-logarithm assumption, so a proof with the real\nconversion function must leave the class of algebraic reductions. Removing signing queries therefore does not remove the\nmain obstacle.","heading":"Why it is open"}],"slug":"op-5","status":"open","subtitle":"","summary":"Key-only unforgeability of ECDSA from discrete logarithms","title":"Key-only unforgeability of ECDSA from discrete logarithms","type":"open_problem","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-OP-005"},{"evidence":"claim_audited","id":"SIG-OP-006","keywords":["random-oracle-model","lower-bound","signature-length","hash-based","one-time-signatures","slh-dsa"],"metadata":{"barriers":[],"basis":"named","caveat":"The only length lower bound in the pure random oracle model is a September 2026 preprint, read from its abstract.","dossier_type":"open_problem","evidence":"claim_audited","id":"SIG-OP-006","keywords":["random-oracle-model","lower-bound","signature-length","hash-based","one-time-signatures","slh-dsa"],"named_open_by":[{"locator":"ePrint 2026/2237, abstract (\"Is this gap inherent?\"), checked on the ePrint abstract page 2026-10-10","paper":"SIG-PAPER-2026-CHMY","statement":"Contrasts \\( O(\\lambda) \\)-length discrete-log signatures with roughly quadratic-length hash-based signatures, asks whether the gap is inherent, and answers it for schemes with non-adaptive verifiers and salted soundness."},{"locator":"arXiv 0801.3680v3, §8 'Conclusions and open questions', PDF p. 26","paper":"SIG-PAPER-2007-BM","statement":"Asks for the optimal number of random-oracle queries of one-time signatures and for stronger lower bounds on many-time signatures."}],"profile":{"Assumption":"none beyond a hash function","Efficiency":"signature length \\( o(\\lambda^{2}/\\log \\lambda) \\) bits; for one-time schemes, public key plus signature","Model":"pure random oracle model; adversaries charged only for oracle queries","Security":"one-time or chosen-message existential unforgeability","Setting":"any verifier, including verifiers whose oracle queries are adaptive"},"refuted_by":[],"related":[],"resolution_condition":"Either (a) a proof that every one-time signature scheme in the pure random oracle model with public key plus signature length \\( o(\\lambda^{2}/\\log \\lambda) \\), and every many-time scheme with signature length \\( o(\\lambda^{2}/\\log \\lambda) \\), is broken under standard (one-time or chosen-message) existential unforgeability by some adversary making \\( 2^{o(\\lambda)} \\) oracle queries with inverse-polynomial probability, with no restriction on verifier adaptivity and no salted-soundness assumption; or (b) a scheme in the pure random oracle model with signature length \\( o(\\lambda^{2}/\\log \\lambda) \\) (one-time: public key plus signature) that no adversary making \\( 2^{\\delta\\lambda} \\) oracle queries, for some constant \\( \\delta > 0 \\), forges except with negligible probability.","resolved_by":[],"status":"open","summary":"Must every signature scheme built from a random oracle alone have signatures of about \\( \\lambda^{2} \\) bits, as known hash-based schemes do, or can it come closer to the \\( O(\\lambda) \\) bits of Schnorr signatures? A 2026 preprint proves \\( \\Omega(\\lambda^{2}/\\log \\lambda) \\) for non-adaptive verifiers; the general case is open.","title":"Signature length in the random oracle model"},"primaryUrl":null,"sections":[{"content":"Hash-based signatures, from Lamport's one-time scheme through Merkle trees to\nSPHINCS+ and the SLH-DSA standard, need nothing beyond a hash function, which\nproofs model as a random oracle. Their cost is length: SLH-DSA-SHA2-128s\nsignatures are 7,856 bytes at NIST security category 1\n(SIG-PAPER-2024-FIPS205, Table 2), while discrete-log signatures such as\nSchnorr's have length \\( O(\\lambda) \\) (SIG-PAPER-2026-CHMY). Whether this gap\nis forced by the random oracle model decides how much room is left for\nshorter hash-based signatures.","heading":"Background"},{"content":"Fix the pure random oracle model: key generation, signing and verification\nmay query a random oracle, and no other hardness assumption is available.\nMust every secure one-time signature scheme have public key plus signature of\nlength \\( \\Omega(\\lambda^2/\\log\\lambda) \\) bits, and every many-time scheme\nsignatures of that length, or is there a scheme whose signatures are\nasymptotically shorter? The question is open for verifiers that choose oracle\nqueries adaptively and for the standard unforgeability notions.","heading":"Problem"},{"content":"SIG-PAPER-2007-BM bounds the number of oracle queries of a one-time scheme\n(black-box security at most \\( 2^{(1+o(1))q} \\) for \\( q \\) queries), not the\nnumber of bits a signature carries; a short signature can still steer many\nlong queries. SIG-PAPER-2026-CHMY prove a length bound, but only for\nnon-adaptive verifiers, whose oracle queries are fixed by the public key,\nmessage and signature, and for salted soundness, a variant of unforgeability.\nThe authors state that this class captures essentially all known hash-based\nconstructions; a bound for arbitrary verifiers and plain unforgeability has\nnot been given. SIG-PAPER-2023-BGZ prove the same\n\\( \\Omega(\\lambda^2/\\log\\lambda) \\) bound in a different idealized model, for\nsignatures that use a group action as a black box. On the construction side,\nevery stateless scheme keeps the quadratic template: SLH-DSA signatures range\nfrom 7,856 to 49,856 bytes across its parameter sets (SIG-PAPER-2024-FIPS205,\nTable 2).","heading":"Why it is open"},{"content":"- Bounds on the number of oracle queries rather than on key or signature bits.\n- Bounds in generic group, group-action or algebraic models.\n- Shorter signatures that add a structured assumption (lattices, isogenies,\n  discrete logarithms) or a hash function with algebraic structure.\n- Constant-factor size reductions for SPHINCS+-type schemes that keep\n  quadratic length.","heading":"What would not resolve it"},{"content":"$9","heading":"Formal target"},{"content":"Lamport's one-time signature (SIG-PAPER-1979-LAMPORT) and Merkle's tree\n(SIG-PAPER-1989-MERKLE) fixed the quadratic-length template that SPHINCS+\n(SIG-PAPER-2019-SPHINCSPLUS) and SLH-DSA inherit. SIG-PAPER-2007-BM gave the\nfirst black-box lower bound for one-time signatures from random oracles, in\nterms of oracle queries, and asked for sharper bounds and for bounds on\nmany-time schemes. SIG-PAPER-2023-BGZ proved a length lower bound for\ngroup-action signatures. SIG-PAPER-2026-CHMY gave a length lower bound in\nthe pure random oracle model, for non-adaptive verifiers with salted\nsoundness.","heading":"Research history"}],"slug":"op-6","status":"open","subtitle":"","summary":"Signature length in the random oracle model","title":"Signature length in the random oracle model","type":"open_problem","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-OP-006"},{"evidence":"primary_source_checked","id":"SIG-PAPER-1978-RSA","keywords":["foundations","rsa","factoring","trapdoor-permutation"],"metadata":{"also_in":[{"id":"PKE-PAPER-1978-RSA","topic":"pke-kem"}],"authors":["Ronald L. Rivest","Adi Shamir","Leonard M. Adleman"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-1978-RSA","keywords":["foundations","rsa","factoring","trapdoor-permutation"],"maps_to":[],"primary_url":"https://people.csail.mit.edu/rivest/Rsapaper.pdf","status":"published","title":"A Method for Obtaining Digital Signatures and Public-Key Cryptosystems","venue":"Communications of the ACM 21(2)","versions":["CACM article"],"year":1978},"primaryUrl":"https://people.csail.mit.edu/rivest/Rsapaper.pdf","sections":[{"content":"The private RSA transformation can sign and the public transformation can verify. The card does not attribute modern EUF-CMA security to textbook RSA.","heading":"Atomic claims"},{"content":"Abstract and the signature discussion in the author-hosted CACM paper.","heading":"Evidence locator"}],"slug":"rsa78","status":"published","subtitle":"Ronald L. Rivest, Adi Shamir, Leonard M. Adleman · 1978","summary":"The private RSA transformation can sign and the public transformation can verify. The card does not attribute modern EUF-CMA security to textbook RSA.","title":"A Method for Obtaining Digital Signatures and Public-Key Cryptosystems","type":"paper","venue":"Communications of the ACM 21(2)","year":1978,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1978-RSA"},{"evidence":"bibliographic_checked","id":"SIG-PAPER-1979-LAMPORT","keywords":["foundations","hash-based","one-time","post-quantum"],"metadata":{"authors":["Leslie Lamport"],"dossier_type":"paper","evidence":"bibliographic_checked","id":"SIG-PAPER-1979-LAMPORT","keywords":["foundations","hash-based","one-time","post-quantum"],"maps_to":[],"primary_url":"https://lamport.azurewebsites.net/pubs/dig-sig.pdf","status":"published","title":"Constructing Digital Signatures from a One Way Function","venue":"SRI technical report CSL-98","versions":["technical report"],"year":1979},"primaryUrl":"https://lamport.azurewebsites.net/pubs/dig-sig.pdf","sections":[{"content":"Introduces a one-time signature from one-way functions, the conservative root of the hash-based post-quantum line.","heading":"Atomic claims"}],"slug":"lamport79","status":"published","subtitle":"Leslie Lamport · 1979","summary":"Introduces a one-time signature from one-way functions, the conservative root of the hash-based post-quantum line.","title":"Constructing Digital Signatures from a One Way Function","type":"paper","venue":"SRI technical report CSL-98","year":1979,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1979-LAMPORT"},{"evidence":"primary_source_checked","id":"SIG-PAPER-1986-FS","keywords":["foundations","fiat-shamir","identification","random-oracle"],"metadata":{"also_in":[{"id":"PROOF-PAPER-1986-FS","topic":"proof-systems"}],"authors":["Amos Fiat","Adi Shamir"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-1986-FS","keywords":["foundations","fiat-shamir","identification","random-oracle"],"maps_to":[],"primary_url":"https://doi.org/10.1007/3-540-47721-7_12","status":"published","title":"How to Prove Yourself: Practical Solutions to Identification and Signature Problems","venue":"CRYPTO 1986","versions":["conference paper"],"year":1986},"primaryUrl":"https://doi.org/10.1007/3-540-47721-7_12","sections":[{"content":"Turns public-coin identification transcripts into non-interactive signatures by deriving the verifier challenge from a hash.","heading":"Atomic claims"},{"content":"The later random-oracle formalization and QROM analyses are not silently attributed to the 1986 paper.","heading":"Scope"}],"slug":"fs86","status":"published","subtitle":"Amos Fiat, Adi Shamir · 1986","summary":"Turns public-coin identification transcripts into non-interactive signatures by deriving the verifier challenge from a hash.","title":"How to Prove Yourself: Practical Solutions to Identification and Signature Problems","type":"paper","venue":"CRYPTO 1986","year":1986,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1986-FS"},{"evidence":"primary_source_checked","id":"SIG-PAPER-1988-GMR","keywords":["foundations","euf-cma","factoring","claw-free-permutations"],"metadata":{"authors":["Shafi Goldwasser","Silvio Micali","Ronald L. Rivest"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-1988-GMR","keywords":["foundations","euf-cma","factoring","claw-free-permutations"],"maps_to":[],"primary_url":"https://doi.org/10.1137/0217017","status":"published","title":"A Digital Signature Scheme Secure Against Adaptive Chosen-Message Attacks","venue":"SIAM Journal on Computing 17(2)","versions":["journal article"],"year":1988},"primaryUrl":"https://doi.org/10.1137/0217017","sections":[{"content":"Defines adaptive chosen-message unforgeability and gives a claw-free-permutation construction meeting it, with factoring as an instantiation.","heading":"Atomic claims"},{"content":"Journal abstract and paper security experiment.","heading":"Evidence locator"}],"slug":"gmr88","status":"published","subtitle":"Shafi Goldwasser, Silvio Micali, Ronald L. Rivest · 1988","summary":"Defines adaptive chosen-message unforgeability and gives a claw-free-permutation construction meeting it, with factoring as an instantiation.","title":"A Digital Signature Scheme Secure Against Adaptive Chosen-Message Attacks","type":"paper","venue":"SIAM Journal on Computing 17(2)","year":1988,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1988-GMR"},{"evidence":"bibliographic_checked","id":"SIG-PAPER-1989-MERKLE","keywords":["hash-based","stateful","merkle-tree","post-quantum"],"metadata":{"authors":["Ralph C. Merkle"],"dossier_type":"paper","evidence":"bibliographic_checked","id":"SIG-PAPER-1989-MERKLE","keywords":["hash-based","stateful","merkle-tree","post-quantum"],"maps_to":[],"primary_url":"https://doi.org/10.1007/0-387-34805-0_21","status":"published","title":"A Certified Digital Signature","venue":"CRYPTO 1989","versions":["conference paper"],"year":1989},"primaryUrl":"https://doi.org/10.1007/0-387-34805-0_21","sections":[{"content":"Authenticates many one-time verification keys beneath one public root, turning one-time hash signatures into a bounded many-signature system with state.","heading":"Atomic claims"}],"slug":"merkle89","status":"published","subtitle":"Ralph C. Merkle · 1989","summary":"Authenticates many one-time verification keys beneath one public root, turning one-time hash signatures into a bounded many-signature system with state.","title":"A Certified Digital Signature","type":"paper","venue":"CRYPTO 1989","year":1989,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1989-MERKLE"},{"evidence":"primary_source_checked","id":"SIG-PAPER-1991-SCHNORR","keywords":["schnorr","discrete-log","fiat-shamir","deterministic-compatible"],"metadata":{"authors":["Claus-Peter Schnorr"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-1991-SCHNORR","keywords":["schnorr","discrete-log","fiat-shamir","deterministic-compatible"],"maps_to":[],"primary_url":"https://doi.org/10.1007/BF00196725","status":"published","title":"Efficient Signature Generation by Smart Cards","venue":"Journal of Cryptology 4(3)","versions":["journal article"],"year":1991},"primaryUrl":"https://doi.org/10.1007/BF00196725","sections":[{"content":"Presents a compact discrete-log signature whose expensive commitment computation can be performed before the message is known.","heading":"Atomic claims"},{"content":"Abstract and Section 1 of the author-hosted paper.","heading":"Evidence locator"}],"slug":"schnorr91","status":"published","subtitle":"Claus-Peter Schnorr · 1991","summary":"Presents a compact discrete-log signature whose expensive commitment computation can be performed before the message is known.","title":"Efficient Signature Generation by Smart Cards","type":"paper","venue":"Journal of Cryptology 4(3)","year":1991,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1991-SCHNORR"},{"evidence":"bibliographic_checked","id":"SIG-PAPER-1996-PSS","keywords":["rsa","pss","random-oracle","probabilistic-encoding"],"metadata":{"authors":["Mihir Bellare","Phillip Rogaway"],"dossier_type":"paper","evidence":"bibliographic_checked","id":"SIG-PAPER-1996-PSS","keywords":["rsa","pss","random-oracle","probabilistic-encoding"],"maps_to":[],"primary_url":"https://doi.org/10.1007/3-540-68339-9_34","status":"published","title":"Optimal Asymmetric Encryption and Signature","venue":"EUROCRYPT 1996","versions":["conference paper"],"year":1996},"primaryUrl":"https://doi.org/10.1007/3-540-68339-9_34","sections":[{"content":"Introduces the PSS randomized encoding and a reduction-oriented RSA signature profile in the random-oracle model.","heading":"Atomic claims"}],"slug":"br96","status":"published","subtitle":"Mihir Bellare, Phillip Rogaway · 1996","summary":"Introduces the PSS randomized encoding and a reduction-oriented RSA signature profile in the random-oracle model.","title":"Optimal Asymmetric Encryption and Signature","type":"paper","venue":"EUROCRYPT 1996","year":1996,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1996-PSS"},{"evidence":"primary_source_checked","id":"SIG-PAPER-1999-CS","keywords":["rsa","strong-rsa","standard-model","euf-cma"],"metadata":{"authors":["Ronald Cramer","Victor Shoup"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-1999-CS","keywords":["rsa","strong-rsa","standard-model","euf-cma"],"maps_to":[],"primary_url":"https://crypto.ethz.ch/publications/CraSho99.html","status":"published","title":"Signature Schemes Based on the Strong RSA Assumption","venue":"ACM CCS 1999","versions":["CCS extended abstract","ACM TISSEC 2000 journal version"],"year":1999},"primaryUrl":"https://crypto.ethz.ch/publications/CraSho99.html","sections":[{"content":"Gives an efficient stateless signature proven secure against adaptive chosen-message attacks in the standard model under Strong RSA.","heading":"Atomic claims"},{"content":"Author publication page abstract and journal-version introduction.","heading":"Evidence locator"}],"slug":"cs99","status":"published","subtitle":"Ronald Cramer, Victor Shoup · 1999","summary":"Gives an efficient stateless signature proven secure against adaptive chosen-message attacks in the standard model under Strong RSA.","title":"Signature Schemes Based on the Strong RSA Assumption","type":"paper","venue":"ACM CCS 1999","year":1999,"sourcePath":"data/signature-catalog.json#SIG-PAPER-1999-CS"},{"evidence":"primary_source_checked","id":"SIG-PAPER-2001-BLS","keywords":["pairing","bls","cdh","random-oracle","short-signature"],"metadata":{"authors":["Dan Boneh","Ben Lynn","Hovav Shacham"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-2001-BLS","keywords":["pairing","bls","cdh","random-oracle","short-signature"],"maps_to":[],"primary_url":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","status":"published","title":"Short Signatures from the Weil Pairing","venue":"ASIACRYPT 2001","versions":["conference paper"],"year":2001},"primaryUrl":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","sections":[{"content":"Uses a bilinear pairing to verify a one-group-element signature, with EUF-CMA security under CDH in the ROM.","heading":"Atomic claims"},{"content":"Abstract and Introduction of the IACR proceedings PDF.","heading":"Evidence locator"}],"slug":"bls01","status":"published","subtitle":"Dan Boneh, Ben Lynn, Hovav Shacham · 2001","summary":"Uses a bilinear pairing to verify a one-group-element signature, with EUF-CMA security under CDH in the ROM.","title":"Short Signatures from the Weil Pairing","type":"paper","venue":"ASIACRYPT 2001","year":2001,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2001-BLS"},{"evidence":"primary_source_checked","id":"SIG-PAPER-2004-BB","keywords":["pairing","q-sdh","standard-model","short-signature"],"metadata":{"authors":["Dan Boneh","Xavier Boyen"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-2004-BB","keywords":["pairing","q-sdh","standard-model","short-signature"],"maps_to":[],"primary_url":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","status":"published","title":"Short Signatures Without Random Oracles","venue":"EUROCRYPT 2004","versions":["conference paper","Journal of Cryptology 2008"],"year":2004},"primaryUrl":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","sections":[{"content":"Removes random oracles from a short pairing-based signature at the cost of the q-SDH assumption.","heading":"Atomic claims"},{"content":"Abstract and Introduction of the IACR proceedings PDF.","heading":"Evidence locator"}],"slug":"bb04","status":"published","subtitle":"Dan Boneh, Xavier Boyen · 2004","summary":"Removes random oracles from a short pairing-based signature at the cost of the q-SDH assumption.","title":"Short Signatures Without Random Oracles","type":"paper","venue":"EUROCRYPT 2004","year":2004,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2004-BB"},{"evidence":"fulltext_checked","id":"SIG-PAPER-2007-BM","keywords":["random-oracle-model","lower-bound","one-time","hash-based","black-box"],"metadata":{"authors":["Boaz Barak","Mohammad Mahmoody-Ghidary"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"SIG-PAPER-2007-BM","keywords":["random-oracle-model","lower-bound","one-time","hash-based","black-box"],"maps_to":["SIG-OP-006"],"primary_url":"https://arxiv.org/abs/0801.3680","review_scope":"arXiv 0801.3680v3 read in full for the abstract, Theorem 1.1 (Section 1, PDF p. 2), the Lamport variant (Section 5, PDF p. 14) and Section 8, Conclusions and open questions (PDF p. 26); the FOCS 2007 version was not compared.","status":"published","title":"Lower Bounds on Signatures From Symmetric Primitives","venue":"FOCS 2007","versions":["arXiv 0801.3680 (v3, 2019; PDF dated 2010-07-05)","ePrint 2008/033","conference paper"],"year":2007},"primaryUrl":"https://arxiv.org/abs/0801.3680","sections":[{"content":"Every one-time signature scheme for n-bit messages that makes at most \\( q \\le n \\) queries to a random oracle has black-box security at most \\( 2^{(1+o(1))q} \\). A variant of Lamport's scheme achieves \\( 2^{(0.812-o(1))q} \\), so the bound is tight up to a constant factor in the number of queries. The bound counts oracle queries, not the bit length of keys or signatures.","heading":"Atomic claims"},{"content":"arXiv 0801.3680v3: abstract and Theorem 1.1 (Section 1, PDF p. 2) for the query bound; Section 5 (PDF p. 14) for the 0.812 Lamport variant; Section 8, \"Conclusions and open questions\" (PDF p. 26), which asks for the optimal query count and for stronger bounds on many-time signatures.","heading":"Evidence locator"}],"slug":"bm07","status":"published","subtitle":"Boaz Barak, Mohammad Mahmoody-Ghidary · 2007","summary":"Every one-time signature scheme for n-bit messages that makes at most \\( q \\le n \\) queries to a random oracle has black-box security at most \\( 2^{(1+o(1))q} \\). A variant of Lamport's scheme achieves \\( 2^{(0.812-o(1))q} \\), so the bound is tight up to a constant factor in the number of queries. The bound counts oracle queries, not the bit length of keys or signatures.","title":"Lower Bounds on Signatures From Symmetric Primitives","type":"paper","venue":"FOCS 2007","year":2007,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2007-BM"},{"evidence":"primary_source_checked","id":"SIG-PAPER-2008-GPV","keywords":["lattice","post-quantum","hash-and-sign","gaussian-sampling","trapdoor"],"metadata":{"authors":["Craig Gentry","Chris Peikert","Vinod Vaikuntanathan"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-2008-GPV","keywords":["lattice","post-quantum","hash-and-sign","gaussian-sampling","trapdoor"],"maps_to":[],"primary_url":"https://doi.org/10.1145/1374376.1374407","status":"published","title":"Trapdoors for Hard Lattices and New Cryptographic Constructions","venue":"STOC 2008","versions":["conference paper"],"year":2008},"primaryUrl":"https://doi.org/10.1145/1374376.1374407","sections":[{"content":"Introduces preimage-sampling lattice trapdoors and a hash-and-sign construction grounded in worst-case lattice hardness.","heading":"Atomic claims"},{"content":"Abstract and construction overview in the ACM version.","heading":"Evidence locator"}],"slug":"gpv08","status":"published","subtitle":"Craig Gentry, Chris Peikert, Vinod Vaikuntanathan · 2008","summary":"Introduces preimage-sampling lattice trapdoors and a hash-and-sign construction grounded in worst-case lattice hardness.","title":"Trapdoors for Hard Lattices and New Cryptographic Constructions","type":"paper","venue":"STOC 2008","year":2008,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2008-GPV"},{"evidence":"abstract_checked","id":"SIG-PAPER-2009-LYU","keywords":["lattice","post-quantum","fiat-shamir","rejection-sampling"],"metadata":{"authors":["Vadim Lyubashevsky"],"dossier_type":"paper","evidence":"abstract_checked","id":"SIG-PAPER-2009-LYU","keywords":["lattice","post-quantum","fiat-shamir","rejection-sampling"],"maps_to":[],"primary_url":"https://doi.org/10.1007/978-3-642-10366-7_35","status":"published","title":"Fiat-Shamir with Aborts: Applications to Lattice and Factoring-Based Signatures","venue":"ASIACRYPT 2009","versions":["conference paper"],"year":2009},"primaryUrl":"https://doi.org/10.1007/978-3-642-10366-7_35","sections":[{"content":"Adds rejection/abort sampling to Fiat-Shamir-style identification so responses can hide a lattice signing secret without a trapdoor sampler.","heading":"Atomic claims"}],"slug":"lyubashevsky09","status":"published","subtitle":"Vadim Lyubashevsky · 2009","summary":"Adds rejection/abort sampling to Fiat-Shamir-style identification so responses can hide a lattice signing secret without a trapdoor sampler.","title":"Fiat-Shamir with Aborts: Applications to Lattice and Factoring-Based Signatures","type":"paper","venue":"ASIACRYPT 2009","year":2009,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2009-LYU"},{"evidence":"primary_source_checked","id":"SIG-PAPER-2011-ED25519","keywords":["schnorr","eddsa","ed25519","deterministic","side-channel"],"metadata":{"authors":["Daniel J. Bernstein","Niels Duif","Tanja Lange","Peter Schwabe","Bo-Yin Yang"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-2011-ED25519","keywords":["schnorr","eddsa","ed25519","deterministic","side-channel"],"maps_to":[],"primary_url":"https://eprint.iacr.org/2011/368","status":"published","title":"High-Speed High-Security Signatures","venue":"CHES 2011","versions":["ePrint 2011/368","conference paper"],"year":2011},"primaryUrl":"https://eprint.iacr.org/2011/368","sections":[{"content":"Builds a high-speed Edwards-curve Schnorr-style signature with 32-byte public keys, 64-byte signatures, deterministic nonces, and constant-time software discipline.","heading":"Atomic claims"},{"content":"Abstract and Introduction of ePrint 2011/368.","heading":"Evidence locator"}],"slug":"bdlsy11","status":"published","subtitle":"Daniel J. Bernstein, Niels Duif, Tanja Lange et al. · 2011","summary":"Builds a high-speed Edwards-curve Schnorr-style signature with 32-byte public keys, 64-byte signatures, deterministic nonces, and constant-time software discipline.","title":"High-Speed High-Security Signatures","type":"paper","venue":"CHES 2011","year":2011,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2011-ED25519"},{"evidence":"fulltext_checked","id":"SIG-PAPER-2012-LYU","keywords":["lattice","post-quantum","fiat-shamir","rejection-sampling","sis","lwe"],"metadata":{"authors":["Vadim Lyubashevsky"],"dossier_type":"paper","evidence":"fulltext_checked","id":"SIG-PAPER-2012-LYU","keywords":["lattice","post-quantum","fiat-shamir","rejection-sampling","sis","lwe"],"maps_to":[],"primary_url":"https://eprint.iacr.org/2011/537","review_scope":"Local ePrint 2011/537 PDF (no revision date printed) read on 2026-10-11 for the abstract and Sections 1.1-1.3 (PDF pp. 1-5), Section 4 with Theorem 4.6 (PDF pp. 9-13), Section 5 with Figures 1-2 and Theorem 5.1 (PDF pp. 14-15), Section 6 (PDF pp. 19-21) and Section 7 (PDF pp. 21-22); the proofs of Lemmas 5.3-5.4 and the EUROCRYPT 2012 proceedings version were not re-verified.","status":"published","title":"Lattice Signatures Without Trapdoors","venue":"EUROCRYPT 2012","versions":["ePrint 2011/537","conference paper, EUROCRYPT 2012, pp. 738–755 (as cited in Dilithium's bibliography, ePrint 2017/633)"],"year":2012},"primaryUrl":"https://eprint.iacr.org/2011/537","sections":[{"content":"Gives a lattice signature in the Fiat–Shamir style that needs no trapdoor preimage sampling: the signer hashes Ay and the message to a sparse challenge c, forms z = Sc + y with y drawn from a discrete Normal distribution, and outputs (z, c) only with a rejection-sampling probability that makes z statistically independent of the secret S. Security is proved in the random oracle model from SIS with signature length \\( \\tilde O(n) \\); variants based on LWE or low-density SIS shorten keys and signatures, and the construction carries over to rings.","heading":"Atomic claims"},{"content":"ePrint 2011/537 (local PDF): abstract (PDF p. 1); Section 1 (PDF p. 1), which places [Lyu09] in the Fiat–Shamir framework [FS86]; Section 1.1 (PDF p. 2), whose first contribution adapts the ring-SIS scheme of [Lyu09] to plain SIS; Section 1.2 (PDF p. 3), which replaces [Lyu09]'s uniform masking and acceptance region with Normal-distribution rejection sampling; Section 1.3 (PDF pp. 4–5) for the comparison with GPV-style hash-and-sign; Theorem 4.6 (PDF p. 12) for the rejection-sampling theorem; Figure 1 and Theorem 5.1 (PDF pp. 14–15) for the scheme and its SIS reduction via the forking lemma; Section 6 (PDF pp. 19–21) for the low-density SIS and LWE variants; Section 7 (PDF pp. 21–22) for ring versions.","heading":"Evidence locator"}],"slug":"lyubashevsky12","status":"published","subtitle":"Vadim Lyubashevsky · 2012","summary":"Gives a lattice signature in the Fiat–Shamir style that needs no trapdoor preimage sampling: the signer hashes Ay and the message to a sparse challenge c, forms z = Sc + y with y drawn from a discrete Normal distribution, and outputs (z, c) only with a rejection-sampling probability that makes z statistically independent of the secret S. Security is proved in the random oracle model from SIS with signature length…","title":"Lattice Signatures Without Trapdoors","type":"paper","venue":"EUROCRYPT 2012","year":2012,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2012-LYU"},{"evidence":"fulltext_checked","id":"SIG-PAPER-2016-FKP","keywords":["ecdsa","dsa","conversion-function","bijective-random-oracle","forking-lemma"],"metadata":{"authors":["Manuel Fersch","Eike Kiltz","Bertram Poettering"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"SIG-PAPER-2016-FKP","keywords":["ecdsa","dsa","conversion-function","bijective-random-oracle","forking-lemma"],"maps_to":["SIG-OP-002","SIG-OP-004"],"primary_url":"https://doi.org/10.1145/2976749.2978413","review_scope":"CCS 2016 proceedings version read for the abstract (p. 1651), Section 1 (pp. 1651-1652), Section 1.1 (pp. 1653-1654) and the definitions of Section 2; the proofs of Section 4 and the full version were not re-verified.","status":"published","title":"On the Provable Security of (EC)DSA Signatures","venue":"ACM CCS 2016","versions":["conference paper, pp. 1651-1662"],"year":2016},"primaryUrl":"https://doi.org/10.1145/2976749.2978413","sections":[{"content":"Defines GenDSA, which covers unmodified DSA and ECDSA, and writes the conversion function as f = psi o Pi o phi. With the inner bijection Pi modeled as a bijective random oracle, H collision resistant and psi-division resistant, and phi semi-injective, existential unforgeability of GenDSA reduces to the discrete-logarithm problem. The reduction loses a factor of about Q (bijective-oracle queries) and squares the success probability.","heading":"Atomic claims"},{"content":"CCS 2016 proceedings version: abstract (p. 1651), which states that understanding the security of DSA and ECDSA remains an open problem; Section 1 (pp. 1651-1652) on why rewinding fails for (EC)DSA and why earlier generic-group analyses implicitly idealize f; Section 1.1 (pp. 1653-1654) for the bijective-random-oracle model and the reductions of Sections 4.1 and 4.2.","heading":"Evidence locator"}],"slug":"fkp16","status":"published","subtitle":"Manuel Fersch, Eike Kiltz, Bertram Poettering · 2016","summary":"Defines GenDSA, which covers unmodified DSA and ECDSA, and writes the conversion function as f = psi o Pi o phi. With the inner bijection Pi modeled as a bijective random oracle, H collision resistant and psi-division resistant, and phi semi-injective, existential unforgeability of GenDSA reduces to the discrete-logarithm problem. The reduction loses a factor of about Q (bijective-oracle queries) and squares the success…","title":"On the Provable Security of (EC)DSA Signatures","type":"paper","venue":"ACM CCS 2016","year":2016,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2016-FKP"},{"evidence":"fulltext_checked","id":"SIG-PAPER-2018-DILITHIUM","keywords":["lattice","post-quantum","module-lwe","module-sis","fiat-shamir-with-aborts"],"metadata":{"authors":["Léo Ducas","Eike Kiltz","Tancrède Lepoint","Vadim Lyubashevsky","Peter Schwabe","Gregor Seiler","Damien Stehlé"],"dossier_type":"paper","evidence":"fulltext_checked","id":"SIG-PAPER-2018-DILITHIUM","keywords":["lattice","post-quantum","module-lwe","module-sis","fiat-shamir-with-aborts"],"maps_to":[],"primary_url":"https://eprint.iacr.org/2017/633","review_scope":"Local ePrint 2017/633 PDF (TCHES-format revision; no revision date printed) read on 2026-10-11 for the abstract and Section 1 with Figure 1 (PDF pp. 1-4), Section 1.3 (PDF p. 5), Section 4 through Section 4.2.1 (PDF pp. 11-13), the related-work discussion of lattice signatures (PDF p. 20) and Appendix B (PDF p. 27); the full specification of Section 2, the parameter analysis and the TCHES proceedings version were not re-verified.","status":"published","title":"CRYSTALS-Dilithium: A Lattice-Based Digital Signature Scheme","venue":"IACR TCHES 2018(1)","versions":["ePrint 2017/633","TCHES article"],"year":2018},"primaryUrl":"https://eprint.iacr.org/2017/633","sections":[{"content":"Builds a module-lattice Fiat–Shamir-with-aborts signature that uses only uniform sampling, so it avoids discrete Gaussian sampling and is easily implemented in constant time. Starting from the Bai–Galbraith scheme, it drops low-order bits of the public key and adds hints to signatures, shrinking the public key about 2.5 times at the cost of roughly 100 to 150 extra signature bytes. It also reports an AVX2 NTT about twice as fast as the previously best.","heading":"Atomic claims"},{"content":"ePrint 2017/633 (local PDF): abstract and Section 1 (PDF p. 1), where Dilithium \"only uses uniform sampling, as was originally proposed in [Lyu09, GLP12, BG14]\"; Section 1.1 and Figure 1 (PDF pp. 2–3), which base the design on the Fiat–Shamir with Aborts approach [Lyu09] and call the template a slightly modified version of [BG14]; Section 1.2 (PDF pp. 3–4) for the public-key compression with hints; Section 1.3 (PDF p. 5), which credits [Lyu12] with basing the approach on (Ring)-LWE plus (Ring)-SIS; Section 4 (PDF pp. 11–13) for SUF-CMA security from MLWE, MSIS and SelfTargetMSIS, with the zero-knowledge argument following [Lyu09, Lyu12, BG14]; related work (PDF p. 20) for the 2.5x public-key reduction relative to [BG14]; Appendix B (PDF p. 27), where signature simulation follows [Lyu12, BG14].","heading":"Evidence locator"}],"slug":"dkl18","status":"published","subtitle":"Léo Ducas, Eike Kiltz, Tancrède Lepoint et al. · 2018","summary":"Builds a module-lattice Fiat–Shamir-with-aborts signature that uses only uniform sampling, so it avoids discrete Gaussian sampling and is easily implemented in constant time. Starting from the Bai–Galbraith scheme, it drops low-order bits of the public key and adds hints to signatures, shrinking the public key about 2.5 times at the cost of roughly 100 to 150 extra signature bytes. It also reports an AVX2 NTT about twice as…","title":"CRYSTALS-Dilithium: A Lattice-Based Digital Signature Scheme","type":"paper","venue":"IACR TCHES 2018(1)","year":2018,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2018-DILITHIUM"},{"evidence":"primary_source_checked","id":"SIG-PAPER-2019-SPHINCSPLUS","keywords":["hash-based","stateless","post-quantum","hypertree","fors"],"metadata":{"authors":["Andreas Hülsing","Stefan Kölbl","Daniel J. Bernstein","Ruben Niederhagen","Joost Rijneveld","Peter Schwabe"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-2019-SPHINCSPLUS","keywords":["hash-based","stateless","post-quantum","hypertree","fors"],"maps_to":[],"primary_url":"https://eprint.iacr.org/2019/1086","status":"published","title":"The SPHINCS+ Signature Framework","venue":"ACM CCS 2019","versions":["ePrint 2019/1086","conference paper"],"year":2019},"primaryUrl":"https://eprint.iacr.org/2019/1086","sections":[{"content":"Introduces a stateless hash-based framework using FORS and tweakable hashes, avoiding the state discipline of classic Merkle signature systems.","heading":"Atomic claims"},{"content":"Abstract and Introduction of ePrint 2019/1086.","heading":"Evidence locator"}],"slug":"hkb19","status":"published","subtitle":"Andreas Hülsing, Stefan Kölbl, Daniel J. Bernstein et al. · 2019","summary":"Introduces a stateless hash-based framework using FORS and tweakable hashes, avoiding the state discipline of classic Merkle signature systems.","title":"The SPHINCS+ Signature Framework","type":"paper","venue":"ACM CCS 2019","year":2019,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2019-SPHINCSPLUS"},{"evidence":"primary_source_checked","id":"SIG-PAPER-2020-FALCON","keywords":["lattice","post-quantum","ntru","gpv","gaussian-sampling","falcon"],"metadata":{"authors":["Pierre-Alain Fouque","Jeffrey Hoffstein","Paul Kirchner","Vadim Lyubashevsky","Thomas Pornin","Thomas Prest","Thomas Ricosset","Gregor Seiler","William Whyte","Zhenfei Zhang"],"dossier_type":"paper","evidence":"primary_source_checked","id":"SIG-PAPER-2020-FALCON","keywords":["lattice","post-quantum","ntru","gpv","gaussian-sampling","falcon"],"maps_to":[],"primary_url":"https://falcon-sign.info/falcon.pdf","status":"published","title":"Falcon: Fast-Fourier Lattice-Based Compact Signatures over NTRU","venue":"NIST PQC supporting documentation","versions":["Falcon specification"],"year":2020},"primaryUrl":"https://falcon-sign.info/falcon.pdf","sections":[{"content":"Instantiates GPV hash-and-sign with NTRU lattices and fast Fourier sampling to obtain compact signatures.","heading":"Atomic claims"},{"content":"Specification Chapter 1 and complete scheme specification.","heading":"Evidence locator"}],"slug":"fhk20","status":"published","subtitle":"Pierre-Alain Fouque, Jeffrey Hoffstein, Paul Kirchner et al. · 2020","summary":"Instantiates GPV hash-and-sign with NTRU lattices and fast Fourier sampling to obtain compact signatures.","title":"Falcon: Fast-Fourier Lattice-Based Compact Signatures over NTRU","type":"paper","venue":"NIST PQC supporting documentation","year":2020,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2020-FALCON"},{"evidence":"fulltext_checked","id":"SIG-PAPER-2022-GS","keywords":["ecdsa","generic-group-model","presignatures","key-derivation"],"metadata":{"authors":["Jens Groth","Victor Shoup"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"SIG-PAPER-2022-GS","keywords":["ecdsa","generic-group-model","presignatures","key-derivation"],"maps_to":["SIG-OP-002","SIG-OP-003"],"primary_url":"https://eprint.iacr.org/2021/1330","review_scope":"Author version of ePrint 2021/1330 dated 2022-04-27 read for the abstract, Section 1 (pp. 1-2), Section 2 (p. 8) and Section 5 (p. 12 onward); the EUROCRYPT 2022 proceedings version was not compared.","status":"published","title":"On the Security of ECDSA with Additive Key Derivation and Presignatures","venue":"EUROCRYPT 2022","versions":["ePrint 2021/1330 (author version dated 2022-04-27)","conference paper"],"year":2022},"primaryUrl":"https://eprint.iacr.org/2021/1330","sections":[{"content":"Introduces an elliptic-curve generic group model (EC-GGM) that models the ECDSA conversion function and signature malleability, and proves security of unmodified ECDSA, ECDSA with additive key derivation, and ECDSA with presignatures in that model. Reports a cube-root attack when the two variations are combined, and lightweight mitigations.","heading":"Atomic claims"},{"content":"Author version at https://www.shoup.net/papers/2021-1330.pdf: abstract and Section 1 (p. 2), which states that ECDSA has only been analyzed in idealized models; Section 2 (p. 8) for the EC-GGM; Section 5 (p. 12 onward) for the proof of ECDSA in the EC-GGM, with Theorem 1 (p. 16) bounding the EUF-CMA advantage by collision, random-preimage and zero-preimage terms for Hash plus \\( O(N^2/q) \\); note 3 after Theorem 1 extends it to strong unforgeability up to sign. Rechecked against the author PDF on 2026-10-10.","heading":"Evidence locator"}],"slug":"gs22","status":"published","subtitle":"Jens Groth, Victor Shoup · 2022","summary":"Introduces an elliptic-curve generic group model (EC-GGM) that models the ECDSA conversion function and signature malleability, and proves security of unmodified ECDSA, ECDSA with additive key derivation, and ECDSA with presignatures in that model. Reports a cube-root attack when the two variations are combined, and lightweight mitigations.","title":"On the Security of ECDSA with Additive Key Derivation and Presignatures","type":"paper","venue":"EUROCRYPT 2022","year":2022,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2022-GS"},{"evidence":"bibliographic_checked","id":"SIG-PAPER-2023-BGZ","keywords":["lower-bound","signature-length","group-actions","isogenies","generic-model"],"metadata":{"authors":["Dan Boneh","Jiaxin Guan","Mark Zhandry"],"contribution_ids":[],"dossier_type":"paper","evidence":"bibliographic_checked","id":"SIG-PAPER-2023-BGZ","keywords":["lower-bound","signature-length","group-actions","isogenies","generic-model"],"maps_to":[],"primary_url":"https://eprint.iacr.org/2023/250","review_scope":"ePrint 2023/250 abstract page only; the full text was not retrieved.","status":"published","title":"A Lower Bound on the Length of Signatures Based on Group Actions and Generic Isogenies","venue":"EUROCRYPT 2023","versions":["ePrint 2023/250","conference paper"],"year":2023},"primaryUrl":"https://eprint.iacr.org/2023/250","sections":[{"content":"For a large class of signature schemes that use a (possibly non-abelian) group action as a black box, the signature length must be \\( \\Omega(\\lambda^2 / \\log \\lambda) \\), matching known group-action constructions.","heading":"Atomic claims"},{"content":"ePrint 2023/250 abstract page (checked 2026-10-10). The full text was not retrieved; the introduction's discussion of random-oracle signatures was not checked against the PDF.","heading":"Evidence locator"}],"slug":"bgz23","status":"published","subtitle":"Dan Boneh, Jiaxin Guan, Mark Zhandry · 2023","summary":"For a large class of signature schemes that use a (possibly non-abelian) group action as a black box, the signature length must be \\( \\Omega(\\lambda^2 / \\log \\lambda) \\), matching known group-action constructions.","title":"A Lower Bound on the Length of Signatures Based on Group Actions and Generic Isogenies","type":"paper","venue":"EUROCRYPT 2023","year":2023,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2023-BGZ"},{"evidence":"official_source_checked","id":"SIG-PAPER-2023-FIPS186-5","keywords":["standard","rsa","ecdsa","eddsa","nist"],"metadata":{"authors":["National Institute of Standards and Technology"],"dossier_type":"paper","evidence":"official_source_checked","id":"SIG-PAPER-2023-FIPS186-5","keywords":["standard","rsa","ecdsa","eddsa","nist"],"maps_to":[],"primary_url":"https://csrc.nist.gov/pubs/fips/186-5/final","status":"standard","title":"FIPS 186-5: Digital Signature Standard","venue":"FIPS 186-5","versions":["final standard"],"year":2023},"primaryUrl":"https://csrc.nist.gov/pubs/fips/186-5/final","sections":[{"content":"Specifies RSA, ECDSA, and EdDSA signature generation/verification; DSA remains only for verification of existing signatures.","heading":"Normative contribution"},{"content":"NIST final publication page and FIPS 186-5 overview.","heading":"Evidence locator"}],"slug":"nist23","status":"standard","subtitle":"National Institute of Standards and Technology · 2023","summary":"Specifies RSA, ECDSA, and EdDSA signature generation/verification; DSA remains only for verification of existing signatures.","title":"FIPS 186-5: Digital Signature Standard","type":"paper","venue":"FIPS 186-5","year":2023,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2023-FIPS186-5"},{"evidence":"fulltext_checked","id":"SIG-PAPER-2023-HK","keywords":["ecdsa","meta-reduction","conversion-function","programmability","impossibility"],"metadata":{"authors":["Dominik Hartmann","Eike Kiltz"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"SIG-PAPER-2023-HK","keywords":["ecdsa","meta-reduction","conversion-function","programmability","impossibility"],"maps_to":["SIG-OP-002","SIG-OP-005"],"primary_url":"https://eprint.iacr.org/2023/914","review_scope":"ePrint 2023/914 PDF (no revision date stated; downloaded 2026-10-11) read for the abstract, Section 1 with Figure 1 (pp. 1-5), Section 1.2 (pp. 5-6), Sections 2.3-2.4 and 3 (pp. 7-14), and the statements of Theorems 1-5 (pp. 14-23); the proofs and the supplementary material were not re-verified.","status":"published","title":"Limits in the Provable Security of ECDSA Signatures","venue":"TCC 2023","versions":["ePrint 2023/914","conference paper, LNCS 14372, pp. 279-309"],"year":2023},"primaryUrl":"https://eprint.iacr.org/2023/914","sections":[{"content":"Asks whether (EC)DSA is provably secure without relying on the programmability of its conversion function f, noting that every existing proof models f, or part of it, as a programmable idealized function. For GenDSA with f = psi o Pi o phi, Pi a bijective random oracle and the hash a programmable random oracle, proves by meta-reductions that an algebraic reduction from DLog to SDLog, which is equivalent to key-only (UF-NMA) security, must program Pi (Theorem 1) and, if it may program Pi, must rewind (Theorem 2), unless the free-base one-more discrete-logarithm assumption fails; that no algebraic reduction from UF-NMA to UF-CMA security avoids programming Pi unless DLog is easy (Theorem 3); and that the loss linear in the number of users for multi-user security cannot be reduced by algebraic reductions that do not program Pi or do not rewind (Theorems 4 and 5). The authors conclude that a meaningful ECDSA proof without strong idealization is unlikely.","heading":"Atomic claims"},{"content":"$a","heading":"Evidence locator"}],"slug":"hk23","status":"published","subtitle":"Dominik Hartmann, Eike Kiltz · 2023","summary":"Asks whether (EC)DSA is provably secure without relying on the programmability of its conversion function f, noting that every existing proof models f, or part of it, as a programmable idealized function. For GenDSA with f = psi o Pi o phi, Pi a bijective random oracle and the hash a programmable random oracle, proves by meta-reductions that an algebraic reduction from DLog to SDLog, which is equivalent to key-only (UF-NMA)…","title":"Limits in the Provable Security of ECDSA Signatures","type":"paper","venue":"TCC 2023","year":2023,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2023-HK"},{"evidence":"official_source_checked","id":"SIG-PAPER-2024-FIPS204","keywords":["standard","post-quantum","lattice","ml-dsa","nist"],"metadata":{"authors":["National Institute of Standards and Technology"],"citation_key":"NIST24/FIPS204","dossier_type":"paper","evidence":"official_source_checked","id":"SIG-PAPER-2024-FIPS204","keywords":["standard","post-quantum","lattice","ml-dsa","nist"],"maps_to":[],"primary_url":"https://csrc.nist.gov/pubs/fips/204/final","status":"standard","title":"FIPS 204: Module-Lattice-Based Digital Signature Standard","venue":"FIPS 204","versions":["final standard"],"year":2024},"primaryUrl":"https://csrc.nist.gov/pubs/fips/204/final","sections":[{"content":"Standardizes ML-DSA, the module-lattice signature family derived from CRYSTALS-Dilithium.","heading":"Normative contribution"},{"content":"NIST final publication page and normative standard.","heading":"Evidence locator"}],"slug":"nist24-fips204","status":"standard","subtitle":"National Institute of Standards and Technology · 2024","summary":"Standardizes ML-DSA, the module-lattice signature family derived from CRYSTALS-Dilithium.","title":"FIPS 204: Module-Lattice-Based Digital Signature Standard","type":"paper","venue":"FIPS 204","year":2024,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2024-FIPS204"},{"evidence":"official_source_checked","id":"SIG-PAPER-2024-FIPS205","keywords":["standard","post-quantum","hash-based","slh-dsa","nist"],"metadata":{"authors":["National Institute of Standards and Technology"],"citation_key":"NIST24/FIPS205","dossier_type":"paper","evidence":"official_source_checked","id":"SIG-PAPER-2024-FIPS205","keywords":["standard","post-quantum","hash-based","slh-dsa","nist"],"maps_to":[],"primary_url":"https://csrc.nist.gov/pubs/fips/205/final","status":"standard","title":"FIPS 205: Stateless Hash-Based Digital Signature Standard","venue":"FIPS 205","versions":["final standard"],"year":2024},"primaryUrl":"https://csrc.nist.gov/pubs/fips/205/final","sections":[{"content":"Standardizes SLH-DSA, the stateless hash-based signature family derived from SPHINCS+.","heading":"Normative contribution"},{"content":"NIST final publication page and normative standard. Section 11, Table 2 (printed p. 43), rechecked 2026-10-12: SLH-DSA public keys of 32 to 64 bytes and signatures of 7,856 (SLH-DSA-SHA2/SHAKE-128s) to 49,856 (SLH-DSA-SHA2/SHAKE-256f) bytes. Announcement item 7, 'Applications' (front matter, rechecked 2026-10-12): intended for electronic mail, electronic funds transfer, electronic data interchange, software distribution and data storage; the standard states no budget on signature size for any of these uses.","heading":"Evidence locator"}],"slug":"nist24-fips205","status":"standard","subtitle":"National Institute of Standards and Technology · 2024","summary":"Standardizes SLH-DSA, the stateless hash-based signature family derived from SPHINCS+.","title":"FIPS 205: Stateless Hash-Based Digital Signature Standard","type":"paper","venue":"FIPS 205","year":2024,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2024-FIPS205"},{"evidence":"bibliographic_checked","id":"SIG-PAPER-2026-CHMY","keywords":["random-oracle-model","lower-bound","signature-length","hash-based"],"metadata":{"authors":["Alon Chayet","Iftach Haitner","Mathias Marty","Eylon Yogev"],"contribution_ids":[],"dossier_type":"paper","evidence":"bibliographic_checked","id":"SIG-PAPER-2026-CHMY","keywords":["random-oracle-model","lower-bound","signature-length","hash-based"],"maps_to":["SIG-OP-006"],"primary_url":"https://eprint.iacr.org/2026/2237","review_scope":"ePrint 2026/2237 abstract page only; the full text was not retrieved.","status":"preprint","title":"Lower Bounds on Random-Oracle-Model Signature Length","venue":"IACR ePrint 2026/2237","versions":["ePrint 2026/2237 (received 2026-09-27, revised 2026-09-30)"],"year":2026},"primaryUrl":"https://eprint.iacr.org/2026/2237","sections":[{"content":"In the pure random oracle model, for schemes with non-adaptive verifiers and salted soundness, one-time signatures need public key plus signature length \\( \\Omega(\\lambda^2 / \\log \\lambda) \\), and many-time signatures need signature length \\( \\Omega(\\lambda^2 / \\log \\lambda) \\) regardless of public-key length. Shorter schemes are broken with inverse-polynomial probability by an adversary making \\( 2^{o(\\lambda)} \\) oracle queries. The abstract asks whether the gap between \\( O(\\lambda) \\)-length discrete-log signatures and quadratic-length hash-based signatures is inherent.","heading":"Atomic claims"},{"content":"ePrint 2026/2237 abstract page (checked 2026-10-10): \"Is this gap inherent?\", the scope sentence on non-adaptive verifiers and salted soundness, and the claim that the class captures essentially all known hash-based constructions. The full text was not retrieved; theorem numbers are not recorded.","heading":"Evidence locator"}],"slug":"chmy26","status":"preprint","subtitle":"Alon Chayet, Iftach Haitner, Mathias Marty et al. · 2026","summary":"In the pure random oracle model, for schemes with non-adaptive verifiers and salted soundness, one-time signatures need public key plus signature length \\( \\Omega(\\lambda^2 / \\log \\lambda) \\), and many-time signatures need signature length \\( \\Omega(\\lambda^2 / \\log \\lambda) \\) regardless of public-key length. Shorter schemes are broken with inverse-polynomial probability by an adversary making \\( 2^{o(\\lambda)} \\) oracle…","title":"Lower Bounds on Random-Oracle-Model Signature Length","type":"paper","venue":"IACR ePrint 2026/2237","year":2026,"sourcePath":"data/signature-catalog.json#SIG-PAPER-2026-CHMY"},{"evidence":"primary_source_checked","id":"SIG-RESULT-1978-RSA-PUBLIC-KEY-SIGNATURE-FEASIBILITY","keywords":["atomic-result","foundations","rsa","factoring","trapdoor-permutation","signature_security_roots","provable_unforgeability","assumption_families","boundary_result"],"metadata":{"claim_slug":"public-key-signature-feasibility","contribution_kind":"boundary_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability","assumption_families"],"technical_thread":["signature_security_roots"]},"historical_context":{"narrative":"In the 1970s, a digital signature with public verification was still a new cryptographic interface rather than a routine application primitive. The RSA paper showed that one algebraic key pair could separate a private operation held by the signer from a public operation available to every verifier. This made publicly checkable origin authentication concrete and connected it to the emerging idea of public-key cryptography. The narrow breakthrough captured here is the asymmetric interface itself: applying the private RSA transformation creates a value that the public transformation checks. Textbook RSA's later-known weaknesses mean this node must not be read as an EUF-CMA construction.","prior_boundary":"Before public-key cryptography, signature mechanisms did not provide a public verification operation separated from the signing secret.","significance_at_publication":"It established the feasibility and interface of public-key signing, making signatures a first-class public-key primitive rather than a symmetric authentication convention.","technical_delta":"RSA used the private exponent for signing and the public exponent for verification, separating signer capability from public verification."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1978-RSA-PUBLIC-KEY-SIGNATURE-FEASIBILITY","keywords":["foundations","rsa","factoring","trapdoor-permutation","signature_security_roots","provable_unforgeability","assumption_families","boundary_result"],"limitations":["Does not attribute modern EUF-CMA security to textbook RSA."],"paper_id":"SIG-PAPER-1978-RSA","qualifiers":["Feasibility claim for the RSA relation."],"source_locator":{"dossier_section":"SIG-PAPER-1978-RSA § Atomic claims and Evidence locator","primary_source":"Abstract and the signature discussion in the author-hosted CACM paper.","primary_source_url":"https://people.csail.mit.edu/rivest/Rsapaper.pdf","status":"section_checked"},"statement":"The RSA private transformation can produce a value that anyone holding the public key can verify, establishing a public-key signature interface.","statement_status":"source_normalized_statement","status":"published","title":"Public-key signature feasibility via the RSA private transformation","work_id":"SIG-PAPER-1978-RSA"},"primaryUrl":"https://people.csail.mit.edu/rivest/Rsapaper.pdf","sections":[],"slug":"rsa78-rsa-public-verification-inte","status":"published","subtitle":"A Method for Obtaining Digital Signatures and Public-Key Cryptosystems","summary":"The RSA private transformation can produce a value that anyone holding the public key can verify, establishing a public-key signature interface.","tableRows":["SIG-CONSTRUCTION-1978-RSA"],"title":"Public-key signature feasibility via the RSA private transformation","type":"result","venue":"Communications of the ACM 21(2)","year":1978,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1978-RSA-PUBLIC-KEY-SIGNATURE-FEASIBILITY"},{"evidence":"bibliographic_checked","id":"SIG-RESULT-1979-LAMPORT-ONE-TIME-SIGNATURES-FROM-ONE-WAY-FUNCTIONS","keywords":["atomic-result","foundations","hash-based","one-time","post-quantum","hash_tree_signatures","assumption_families","construction"],"metadata":{"claim_slug":"one-time-signatures-from-one-way-functions","contribution_kind":"construction","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["assumption_families"],"technical_thread":["hash_tree_signatures"]},"historical_context":{"narrative":"Early signature proposals drew their security intuition from algebraic trapdoors. Lamport instead asked whether the much weaker premise of a one-way function already sufficed. His answer used pairs of secret values and published images, revealing only the message-selected secrets when signing. The construction opened a conservative branch whose security did not depend on factoring or discrete logarithms. Its guarantee is deliberately one-time: reusing the secret material can disclose both alternatives at bit positions and destroy security. Later hash-tree systems build on this primitive by managing many such keys under one root.","prior_boundary":"Early public-key signatures were tied to algebraic trapdoor assumptions, leaving unclear how little structure was sufficient for signing.","significance_at_publication":"The construction showed that one-way functions alone support one-time authentication, creating the conservative foundation later hash-based systems compose.","technical_delta":"The signing key publishes one-way images of secret values and reveals message-selected preimages in a single signature."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1979-LAMPORT-ONE-TIME-SIGNATURES-FROM-ONE-WAY-FUNCTIONS","keywords":["foundations","hash-based","one-time","post-quantum","hash_tree_signatures","assumption_families","construction"],"limitations":["Key material must not be reused for unrestricted messages."],"paper_id":"SIG-PAPER-1979-LAMPORT","qualifiers":["One-time security and a one-way-function foundation."],"source_locator":{"dossier_section":"SIG-PAPER-1979-LAMPORT § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://lamport.azurewebsites.net/pubs/dig-sig.pdf","status":"not_normalized"},"statement":"Lamport constructs a one-time signature using only one-way functions.","statement_status":"source_normalized_statement","status":"published","title":"One-time signatures from one-way functions","work_id":"SIG-PAPER-1979-LAMPORT"},"primaryUrl":"https://lamport.azurewebsites.net/pubs/dig-sig.pdf","sections":[],"slug":"lamport79-one-way-function-one","status":"published","subtitle":"Constructing Digital Signatures from a One Way Function","summary":"Lamport constructs a one-time signature using only one-way functions.","title":"One-time signatures from one-way functions","type":"result","venue":"SRI technical report CSL-98","year":1979,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1979-LAMPORT-ONE-TIME-SIGNATURES-FROM-ONE-WAY-FUNCTIONS"},{"evidence":"primary_source_checked","id":"SIG-RESULT-1986-FS-FIAT-SHAMIR-IDENTIFICATION-TO-SIGNATURE","keywords":["atomic-result","foundations","fiat-shamir","identification","random-oracle","fiat_shamir_schnorr","provable_unforgeability","transform"],"metadata":{"claim_slug":"fiat-shamir-identification-to-signature","contribution_kind":"transform","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["fiat_shamir_schnorr"]},"historical_context":{"narrative":"Interactive identification let a prover answer a verifier's fresh random challenge, but a signature had to be transferable and checkable later without that verifier. Fiat and Shamir connected these settings by deriving the challenge from a hash of the commitment and message. The move created a general design pattern through which efficient identification protocols could become noninteractive signature candidates. Here the atomic change is compilation: the verifier's coin is replaced by a message-bound digest. Security still depends on the identification protocol and hash model, so the transform is not a blanket theorem for every three-move proof.","prior_boundary":"Identification protocols offered interactive proofs of secret-key possession, while signatures required a transferable noninteractive transcript bound to a message.","significance_at_publication":"The transform connected identification design to signature design and became a reusable compilation pattern across discrete-log and lattice constructions.","technical_delta":"A hash-derived challenge made an identification transcript message-bound and publicly transferable without an online verifier."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1986-FS-FIAT-SHAMIR-IDENTIFICATION-TO-SIGNATURE","keywords":["foundations","fiat-shamir","identification","random-oracle","fiat_shamir_schnorr","provable_unforgeability","transform"],"limitations":["The transform alone does not establish security for every identification protocol."],"paper_id":"SIG-PAPER-1986-FS","qualifiers":["Heuristic random-oracle-style compilation in this historical record."],"source_locator":{"dossier_section":"SIG-PAPER-1986-FS § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/3-540-47721-7_12","status":"section_checked"},"statement":"The Fiat–Shamir transform replaces a public-coin verifier challenge with a hash of the message and commitment to obtain a noninteractive signature.","statement_status":"source_normalized_statement","status":"published","title":"Hash-derived challenges compile identification into signatures","work_id":"SIG-PAPER-1986-FS"},"primaryUrl":"https://doi.org/10.1007/3-540-47721-7_12","sections":[],"slug":"fs86-hash-compiled-identification","status":"published","subtitle":"How to Prove Yourself: Practical Solutions to Identification and Signature Problems","summary":"The Fiat–Shamir transform replaces a public-coin verifier challenge with a hash of the message and commitment to obtain a noninteractive signature.","title":"Hash-derived challenges compile identification into signatures","type":"result","venue":"CRYPTO 1986","year":1986,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1986-FS-FIAT-SHAMIR-IDENTIFICATION-TO-SIGNATURE"},{"evidence":"primary_source_checked","id":"SIG-RESULT-1988-GMR-ADAPTIVE-CHOSEN-MESSAGE-UNFORGEABILITY","keywords":["atomic-result","foundations","euf-cma","factoring","claw-free-permutations","signature_security_roots","provable_unforgeability","definition"],"metadata":{"claim_slug":"adaptive-chosen-message-unforgeability","contribution_kind":"definition","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["signature_security_roots"]},"historical_context":{"narrative":"Signature proposals lacked a stable adversarial target when Goldwasser, Micali, and Rivest formulated their result. A realistic attacker could request signatures on messages chosen in response to earlier answers and then attempt a fresh forgery. Making that sequence explicit supplied the security boundary against which later constructions could compare assumptions, proof models, and efficiency. The paper also gave a claw-free-permutation construction meeting its definition, but this record deliberately isolates the definition rather than merging the security game with the feasibility construction. Its role on the map is therefore definitional, not a claim about practical performance.","prior_boundary":"Earlier signature proposals lacked a durable game capturing an adversary that adaptively requests signatures before attempting a fresh forgery.","significance_at_publication":"GMR gave later signature constructions a durable adversarial target against which assumptions and efficiency could be compared.","technical_delta":"The work made adaptive signing queries followed by a fresh-message forgery the explicit security experiment."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1988-GMR-ADAPTIVE-CHOSEN-MESSAGE-UNFORGEABILITY","keywords":["foundations","euf-cma","factoring","claw-free-permutations","signature_security_roots","provable_unforgeability","definition"],"limitations":["The foundational construction is not an efficiency benchmark for later schemes."],"paper_id":"SIG-PAPER-1988-GMR","qualifiers":["Adaptive chosen-message attack model."],"source_locator":{"dossier_section":"SIG-PAPER-1988-GMR § Atomic claims and Evidence locator","primary_source":"Journal abstract and paper security experiment.","primary_source_url":"https://doi.org/10.1137/0217017","status":"section_checked"},"statement":"GMR formalizes signature security against an adversary that adaptively obtains signatures before forging a new message.","statement_status":"source_normalized_statement","status":"published","title":"Adaptive chosen-message unforgeability for digital signatures","work_id":"SIG-PAPER-1988-GMR"},"primaryUrl":"https://doi.org/10.1137/0217017","sections":[],"slug":"gmr88-adaptive-chosen-message-unfo","status":"published","subtitle":"A Digital Signature Scheme Secure Against Adaptive Chosen-Message Attacks","summary":"GMR formalizes signature security against an adversary that adaptively obtains signatures before forging a new message.","tableRows":["SIG-CONSTRUCTION-1988-GMR"],"title":"Adaptive chosen-message unforgeability for digital signatures","type":"result","venue":"SIAM Journal on Computing 17(2)","year":1988,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1988-GMR-ADAPTIVE-CHOSEN-MESSAGE-UNFORGEABILITY"},{"evidence":"bibliographic_checked","id":"SIG-RESULT-1989-MERKLE-MERKLE-TREE-MANY-TIME-HASH-SIGNATURES","keywords":["atomic-result","hash-based","stateful","merkle-tree","post-quantum","hash_tree_signatures","size_and_signing_cost","capability_result"],"metadata":{"claim_slug":"merkle-tree-many-time-hash-signatures","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost"],"technical_thread":["hash_tree_signatures"]},"historical_context":{"narrative":"A Lamport-style key could safely authenticate only one message, so using it repeatedly required an unwieldy collection of independently trusted public keys. Merkle authentication trees compressed that collection into one root. Each signature carried a one-time signature and an authentication path, while the signer tracked which leaf keys had already been consumed. The idea transformed one-time primitives into a bounded many-signature system. The resulting capability is many-time only within a finite tree, and safe use requires persistent leaf state. That explicit limitation distinguishes the Merkle construction from the later stateless hypertree design of SPHINCS+.","prior_boundary":"One-time signatures from one-way functions required a fresh public key for every message and therefore did not by themselves provide a practical many-signature interface.","significance_at_publication":"Authentication trees amortized one public root across many one-time keys, establishing the stateful composition pattern behind the hash-based signature lineage.","technical_delta":"Tree authentication paths let each one-time key inherit trust from a compact root while signer state prevents leaf reuse."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1989-MERKLE-MERKLE-TREE-MANY-TIME-HASH-SIGNATURES","keywords":["hash-based","stateful","merkle-tree","post-quantum","hash_tree_signatures","size_and_signing_cost","capability_result"],"limitations":["The construction does not remove signer-state management."],"paper_id":"SIG-PAPER-1989-MERKLE","qualifiers":["Bounded, stateful many-time signing."],"source_locator":{"dossier_section":"SIG-PAPER-1989-MERKLE § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/0-387-34805-0_21","status":"not_normalized"},"statement":"A Merkle authentication tree binds many one-time verification keys to one public root, enabling a bounded number of signatures.","statement_status":"source_normalized_statement","status":"published","title":"Merkle trees lift one-time keys to stateful many-time signatures","work_id":"SIG-PAPER-1989-MERKLE"},"primaryUrl":"https://doi.org/10.1007/0-387-34805-0_21","sections":[],"slug":"merkle89-stateful-merkle-many-time","status":"published","subtitle":"A Certified Digital Signature","summary":"A Merkle authentication tree binds many one-time verification keys to one public root, enabling a bounded number of signatures.","title":"Merkle trees lift one-time keys to stateful many-time signatures","type":"result","venue":"CRYPTO 1989","year":1989,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1989-MERKLE-MERKLE-TREE-MANY-TIME-HASH-SIGNATURES"},{"evidence":"primary_source_checked","id":"SIG-RESULT-1991-SCHNORR-COMPACT-DISCRETE-LOG-SIGNATURE","keywords":["atomic-result","schnorr","discrete-log","fiat-shamir","deterministic-compatible","fiat_shamir_schnorr","provable_unforgeability","size_and_signing_cost","nonce_and_sampling_safety","assumption_families","construction"],"metadata":{"claim_slug":"compact-discrete-log-signature","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability","size_and_signing_cost","nonce_and_sampling_safety","assumption_families"],"technical_thread":["fiat_shamir_schnorr"]},"historical_context":{"narrative":"Fiat–Shamir provided a route from identification to signing, but deployment still depended on a clean algebraic instantiation with compact communication and little message-dependent work. Schnorr supplied such an instantiation in a discrete-log group. Its commitment could be prepared before the message arrived, after which hashing and one scalar response completed a small, easily verified signature. The contribution is the compact commitment–challenge–response signature and its shiftable precomputation boundary. Its apparent simplicity does not relax the essential requirement that every nonce remain secret and never be reused.","prior_boundary":"Fiat–Shamir made identification transcripts noninteractive, but practical signing still needed a compact discrete-log instantiation with low online work.","significance_at_publication":"Schnorr supplied a particularly simple commitment–challenge–response signature whose preprocessing and compact algebraic form shaped later classical implementations and threshold protocols.","technical_delta":"The construction instantiated commitment–challenge–response signing with a small response and shiftable offline group work."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1991-SCHNORR-COMPACT-DISCRETE-LOG-SIGNATURE","keywords":["schnorr","discrete-log","fiat-shamir","deterministic-compatible","fiat_shamir_schnorr","provable_unforgeability","size_and_signing_cost","nonce_and_sampling_safety","assumption_families","construction"],"limitations":["Nonce uniqueness and secrecy remain essential to security."],"paper_id":"SIG-PAPER-1991-SCHNORR","qualifiers":["Discrete-log setting; hash-derived challenge."],"source_locator":{"dossier_section":"SIG-PAPER-1991-SCHNORR § Atomic claims and Evidence locator","primary_source":"Abstract and Section 1 of the author-hosted paper.","primary_source_url":"https://doi.org/10.1007/BF00196725","status":"section_checked"},"statement":"Schnorr gives a compact discrete-log signature whose commitment computation can be performed before the message is known.","statement_status":"source_normalized_statement","status":"published","title":"Compact discrete-log signatures with offline commitment work","work_id":"SIG-PAPER-1991-SCHNORR"},"primaryUrl":"https://doi.org/10.1007/BF00196725","sections":[],"slug":"schnorr91-offline-precomputable-schnor","status":"published","subtitle":"Efficient Signature Generation by Smart Cards","summary":"Schnorr gives a compact discrete-log signature whose commitment computation can be performed before the message is known.","tableRows":["SIG-CONSTRUCTION-1991-SCHNORR"],"title":"Compact discrete-log signatures with offline commitment work","type":"result","venue":"Journal of Cryptology 4(3)","year":1991,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1991-SCHNORR-COMPACT-DISCRETE-LOG-SIGNATURE"},{"evidence":"bibliographic_checked","id":"SIG-RESULT-1996-PSS-RSA-PSS-PROBABILISTIC-ENCODING","keywords":["atomic-result","rsa","pss","random-oracle","probabilistic-encoding","rsa_encoding_signatures","provable_unforgeability","mechanism"],"metadata":{"claim_slug":"rsa-pss-probabilistic-encoding","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["rsa_encoding_signatures"]},"historical_context":{"narrative":"Direct RSA exponentiation did not provide the randomized message encoding or chosen-message analysis expected of a modern signature. Bellare and Rogaway designed PSS so that the RSA representative incorporates a salt and hash-derived structure before the private permutation is applied. The encoding and its random-oracle proof made security reduction quality an explicit part of an RSA signature profile. One node isolates the encoding mechanism: randomized salt and structured hashing replace raw message exponentiation. That object is distinct from the accompanying reduction and remains tied to the RSA trapdoor-permutation and random-oracle setting.","prior_boundary":"Textbook RSA signing exposed the raw algebraic relation and did not provide the modern chosen-message security treatment expected of a signature encoding.","significance_at_publication":"PSS made randomized message encoding and a reduction in the random-oracle model explicit design objectives for the RSA signature family.","technical_delta":"The encoding replaced direct deterministic message exponentiation with a salt-based representative designed for reduction-oriented security."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1996-PSS-RSA-PSS-PROBABILISTIC-ENCODING","keywords":["rsa","pss","random-oracle","probabilistic-encoding","rsa_encoding_signatures","provable_unforgeability","mechanism"],"limitations":["The encoding is not a standard-model construction."],"paper_id":"SIG-PAPER-1996-PSS","qualifiers":["RSA trapdoor permutation in the random-oracle model."],"source_locator":{"dossier_section":"SIG-PAPER-1996-PSS § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/3-540-68339-9_34","status":"not_normalized"},"statement":"PSS randomizes and structures the message representative before applying the RSA private operation.","statement_status":"source_normalized_statement","status":"published","title":"Probabilistic RSA-PSS message encoding","work_id":"SIG-PAPER-1996-PSS"},"primaryUrl":"https://doi.org/10.1007/3-540-68339-9_34","sections":[],"slug":"br96-randomized-rsa-pss-encoding","status":"published","subtitle":"Optimal Asymmetric Encryption and Signature","summary":"PSS randomizes and structures the message representative before applying the RSA private operation.","tableRows":["SIG-CONSTRUCTION-1996-PSS"],"title":"Probabilistic RSA-PSS message encoding","type":"result","venue":"EUROCRYPT 1996","year":1996,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1996-PSS-RSA-PSS-PROBABILISTIC-ENCODING"},{"evidence":"bibliographic_checked","id":"SIG-RESULT-1996-PSS-TIGHT-ROM-RSA-SIGNATURES","keywords":["atomic-result","rsa","pss","random-oracle","probabilistic-encoding","rsa_encoding_signatures","provable_unforgeability","security_result"],"metadata":{"claim_slug":"tight-rom-rsa-signatures","contribution_kind":"security_result","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["rsa_encoding_signatures"]},"historical_context":{"narrative":"Direct RSA exponentiation did not provide the randomized message encoding or chosen-message analysis expected of a modern signature. Bellare and Rogaway designed PSS so that the RSA representative incorporates a salt and hash-derived structure before the private permutation is applied. The encoding and its random-oracle proof made security reduction quality an explicit part of an RSA signature profile. The second node records the proof contribution, which relates forgery of the encoded signature to inversion of RSA far more directly than textbook signing allowed. It does not remove the idealized hash oracle.","prior_boundary":"Textbook RSA signing exposed the raw algebraic relation and did not provide the modern chosen-message security treatment expected of a signature encoding.","significance_at_publication":"PSS made randomized message encoding and a reduction in the random-oracle model explicit design objectives for the RSA signature family.","technical_delta":"The proof supplied a substantially sharper security account for an RSA encoding than textbook signing offered."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1996-PSS-TIGHT-ROM-RSA-SIGNATURES","keywords":["rsa","pss","random-oracle","probabilistic-encoding","rsa_encoding_signatures","provable_unforgeability","security_result"],"limitations":["The claim does not remove the random-oracle idealization."],"paper_id":"SIG-PAPER-1996-PSS","qualifiers":["Random-oracle model and the paper's exact RSA reduction."],"source_locator":{"dossier_section":"SIG-PAPER-1996-PSS § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/3-540-68339-9_34","status":"not_normalized"},"statement":"The PSS analysis relates adaptive signature forgery to inverting the underlying RSA permutation in the random-oracle model.","statement_status":"source_normalized_statement","status":"published","title":"Reduction-oriented RSA-PSS security in the random-oracle model","work_id":"SIG-PAPER-1996-PSS"},"primaryUrl":"https://doi.org/10.1007/3-540-68339-9_34","sections":[],"slug":"br96-reduction-oriented-rsa-pss","status":"published","subtitle":"Optimal Asymmetric Encryption and Signature","summary":"The PSS analysis relates adaptive signature forgery to inverting the underlying RSA permutation in the random-oracle model.","tableRows":["SIG-CONSTRUCTION-1996-PSS"],"title":"Reduction-oriented RSA-PSS security in the random-oracle model","type":"result","venue":"EUROCRYPT 1996","year":1996,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1996-PSS-TIGHT-ROM-RSA-SIGNATURES"},{"evidence":"primary_source_checked","id":"SIG-RESULT-1999-CS-EFFICIENT-STANDARD-MODEL-SIGNATURES","keywords":["atomic-result","rsa","strong-rsa","standard-model","euf-cma","rsa_encoding_signatures","provable_unforgeability","size_and_signing_cost","assumption_families","optimization"],"metadata":{"claim_slug":"efficient-standard-model-signatures","contribution_kind":"optimization","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability","size_and_signing_cost","assumption_families"],"technical_thread":["rsa_encoding_signatures"]},"historical_context":{"narrative":"Foundational standard-model signatures had established feasibility but remained far from the simplicity and cost of popular random-oracle designs. Cramer and Shoup narrowed that gap with a stateless construction based on Strong RSA. Their work showed that adaptive chosen-message security without a programmable hash oracle could coexist with a substantially more practical signing structure, although under a different and stronger-looking assumption profile. The efficiency node concerns the construction's practical structure relative to earlier provable standard-model schemes. It should not be interpreted as faster than every contemporary random-oracle signature or as a benchmark claim.","prior_boundary":"Provably secure signatures in the standard model existed, but the gap between foundational feasibility and efficient stateless constructions remained substantial.","significance_at_publication":"Cramer–Shoup demonstrated a practical-looking adaptive chosen-message construction under Strong RSA without programming a random oracle, clarifying a different assumption/proof-model tradeoff from RSA-PSS.","technical_delta":"The construction reduced key and signing complexity relative to earlier standard-model feasibility results while avoiding random oracles."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1999-CS-EFFICIENT-STANDARD-MODEL-SIGNATURES","keywords":["rsa","strong-rsa","standard-model","euf-cma","rsa_encoding_signatures","provable_unforgeability","size_and_signing_cost","assumption_families","optimization"],"limitations":["Efficiency is relative to prior provable standard-model constructions, not every ROM scheme."],"paper_id":"SIG-PAPER-1999-CS","qualifiers":["Strong RSA assumption; standard model."],"source_locator":{"dossier_section":"SIG-PAPER-1999-CS § Atomic claims and Evidence locator","primary_source":"Author publication page abstract and journal-version introduction.","primary_source_url":"https://crypto.ethz.ch/publications/CraSho99.html","status":"section_checked"},"statement":"Cramer–Shoup gives a stateless Strong-RSA signature construction that the paper compares as more efficient than earlier provably secure standard-model schemes.","statement_status":"source_normalized_statement","status":"published","title":"Stateless Strong-RSA signing with lower cost than prior standard-model schemes","work_id":"SIG-PAPER-1999-CS"},"primaryUrl":"https://crypto.ethz.ch/publications/CraSho99.html","sections":[],"slug":"cs99-stateless-strong-rsa-signing","status":"published","subtitle":"Signature Schemes Based on the Strong RSA Assumption","summary":"Cramer–Shoup gives a stateless Strong-RSA signature construction that the paper compares as more efficient than earlier provably secure standard-model schemes.","tableRows":["SIG-CONSTRUCTION-1999-CS"],"title":"Stateless Strong-RSA signing with lower cost than prior standard-model schemes","type":"result","venue":"ACM CCS 1999","year":1999,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1999-CS-EFFICIENT-STANDARD-MODEL-SIGNATURES"},{"evidence":"primary_source_checked","id":"SIG-RESULT-1999-CS-STRONG-RSA-EUF-CMA","keywords":["atomic-result","rsa","strong-rsa","standard-model","euf-cma","rsa_encoding_signatures","provable_unforgeability","security_result"],"metadata":{"claim_slug":"strong-rsa-euf-cma","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["rsa_encoding_signatures"]},"historical_context":{"narrative":"Foundational standard-model signatures had established feasibility but remained far from the simplicity and cost of popular random-oracle designs. Cramer and Shoup narrowed that gap with a stateless construction based on Strong RSA. Their work showed that adaptive chosen-message security without a programmable hash oracle could coexist with a substantially more practical signing structure, although under a different and stronger-looking assumption profile. A separate security node records adaptive unforgeability under Strong RSA without a random oracle. Keeping it apart from the construction's efficiency prevents the proof model and performance comparison from collapsing into one adjective.","prior_boundary":"Provably secure signatures in the standard model existed, but the gap between foundational feasibility and efficient stateless constructions remained substantial.","significance_at_publication":"Cramer–Shoup demonstrated a practical-looking adaptive chosen-message construction under Strong RSA without programming a random oracle, clarifying a different assumption/proof-model tradeoff from RSA-PSS.","technical_delta":"The analysis changed the assumption and proof-model coordinate rather than merely proposing a faster RSA encoding."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-1999-CS-STRONG-RSA-EUF-CMA","keywords":["rsa","strong-rsa","standard-model","euf-cma","rsa_encoding_signatures","provable_unforgeability","security_result"],"limitations":["The security statement is bound to the paper's exact construction and parameters."],"paper_id":"SIG-PAPER-1999-CS","qualifiers":["Strong RSA assumption; adaptive chosen-message security."],"source_locator":{"dossier_section":"SIG-PAPER-1999-CS § Atomic claims and Evidence locator","primary_source":"Author publication page abstract and journal-version introduction.","primary_source_url":"https://crypto.ethz.ch/publications/CraSho99.html","status":"section_checked"},"statement":"The Cramer–Shoup signature is proved adaptively unforgeable under the Strong RSA assumption in the standard model.","statement_status":"source_normalized_statement","status":"published","title":"EUF-CMA security from Strong RSA without random oracles","work_id":"SIG-PAPER-1999-CS"},"primaryUrl":"https://crypto.ethz.ch/publications/CraSho99.html","sections":[],"slug":"cs99-euf-cma-security-from","status":"published","subtitle":"Signature Schemes Based on the Strong RSA Assumption","summary":"The Cramer–Shoup signature is proved adaptively unforgeable under the Strong RSA assumption in the standard model.","tableRows":["SIG-CONSTRUCTION-1999-CS"],"title":"EUF-CMA security from Strong RSA without random oracles","type":"result","venue":"ACM CCS 1999","year":1999,"sourcePath":"data/signature-catalog.json#SIG-RESULT-1999-CS-STRONG-RSA-EUF-CMA"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2001-BLS-CDH-ROM-EUF-CMA","keywords":["atomic-result","pairing","bls","cdh","random-oracle","short-signature","pairing_short_signatures","provable_unforgeability","security_result"],"metadata":{"claim_slug":"cdh-rom-euf-cma","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["pairing_short_signatures"]},"historical_context":{"narrative":"Existing signatures generally occupied several group or field elements, making very short public authentication a distinct design objective. Boneh, Lynn, and Shacham used a bilinear pairing to check a single group element derived from a hash of the message. This established a compact pairing-based construction whose algebraic output was unusually simple. The security record identifies computational Diffie–Hellman and the random-oracle model as the basis for chosen-message unforgeability, rather than treating short output as evidence of a stronger proof. That boundary also distinguishes BLS from the later Boneh–Boyen standard-model point.","prior_boundary":"Classical signatures generally used multiple group or field elements, so substantially shorter public signatures required a new verification mechanism.","significance_at_publication":"Bilinear pairings enabled verification of a single-group-element signature and established a compact pairing-based construction under an explicit CDH/ROM security boundary.","technical_delta":"The proof connected pairing-based compactness to a named hardness assumption while retaining a programmable hash oracle."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2001-BLS-CDH-ROM-EUF-CMA","keywords":["pairing","bls","cdh","random-oracle","short-signature","pairing_short_signatures","provable_unforgeability","security_result"],"limitations":["This result does not provide a standard-model proof."],"paper_id":"SIG-PAPER-2001-BLS","qualifiers":["CDH-family assumption and random-oracle model."],"source_locator":{"dossier_section":"SIG-PAPER-2001-BLS § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of the IACR proceedings PDF.","primary_source_url":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","status":"section_checked"},"statement":"The BLS signature is analyzed for adaptive chosen-message unforgeability from computational Diffie–Hellman in the random-oracle model.","statement_status":"source_normalized_statement","status":"published","title":"BLS unforgeability from CDH in the random-oracle model","work_id":"SIG-PAPER-2001-BLS"},"primaryUrl":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","sections":[],"slug":"bls01-bls-unforgeability-from-cdh","status":"published","subtitle":"Short Signatures from the Weil Pairing","summary":"The BLS signature is analyzed for adaptive chosen-message unforgeability from computational Diffie–Hellman in the random-oracle model.","tableRows":["SIG-CONSTRUCTION-2001-BLS"],"title":"BLS unforgeability from CDH in the random-oracle model","type":"result","venue":"ASIACRYPT 2001","year":2001,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2001-BLS-CDH-ROM-EUF-CMA"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2001-BLS-ONE-GROUP-ELEMENT-PAIRING-SIGNATURES","keywords":["atomic-result","pairing","bls","cdh","random-oracle","short-signature","pairing_short_signatures","size_and_signing_cost","construction"],"metadata":{"claim_slug":"one-group-element-pairing-signatures","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost"],"technical_thread":["pairing_short_signatures"]},"historical_context":{"narrative":"Existing signatures generally occupied several group or field elements, making very short public authentication a distinct design objective. Boneh, Lynn, and Shacham used a bilinear pairing to check a single group element derived from a hash of the message. This established a compact pairing-based construction whose algebraic output was unusually simple. The construction record isolates the one-element output and pairing check, while its companion card carries the CDH and random-oracle proof boundary. Actual byte length depends on the selected group and encoding, so the historical compactness claim is not silently converted into a current parameter recommendation.","prior_boundary":"Classical signatures generally used multiple group or field elements, so substantially shorter public signatures required a new verification mechanism.","significance_at_publication":"Bilinear pairings made one group element sufficient for a publicly verifiable signature, creating a sharply different compactness point from earlier schemes.","technical_delta":"Pairing verification made a single group element sufficient for a publicly verifiable signature."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2001-BLS-ONE-GROUP-ELEMENT-PAIRING-SIGNATURES","keywords":["pairing","bls","cdh","random-oracle","short-signature","pairing_short_signatures","size_and_signing_cost","construction"],"limitations":["Concrete byte size depends on the chosen group and encoding."],"paper_id":"SIG-PAPER-2001-BLS","qualifiers":["Bilinear-group setting and hash-to-group operation."],"source_locator":{"dossier_section":"SIG-PAPER-2001-BLS § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of the IACR proceedings PDF.","primary_source_url":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","status":"section_checked"},"statement":"BLS hashes a message to a group and signs with one exponentiation, yielding a signature represented by one group element.","statement_status":"source_normalized_statement","status":"published","title":"One-group-element signatures verified by a bilinear pairing","work_id":"SIG-PAPER-2001-BLS"},"primaryUrl":"https://www.iacr.org/archive/asiacrypt2001/22480516.pdf","sections":[],"slug":"bls01-one-element-pairing-signatur","status":"published","subtitle":"Short Signatures from the Weil Pairing","summary":"BLS hashes a message to a group and signs with one exponentiation, yielding a signature represented by one group element.","tableRows":["SIG-CONSTRUCTION-2001-BLS"],"title":"One-group-element signatures verified by a bilinear pairing","type":"result","venue":"ASIACRYPT 2001","year":2001,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2001-BLS-ONE-GROUP-ELEMENT-PAIRING-SIGNATURES"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2004-BB-Q-SDH-EUF-CMA","keywords":["atomic-result","pairing","q-sdh","standard-model","short-signature","pairing_short_signatures","provable_unforgeability","security_result"],"metadata":{"claim_slug":"q-sdh-euf-cma","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability"],"technical_thread":["pairing_short_signatures"]},"historical_context":{"narrative":"BLS made pairing signatures exceptionally short, but its full security argument programmed a random oracle. Boneh and Boyen explored the adjacent point where similarly compact output could be justified in the standard model. Their construction moved the proof-model boundary while introducing the parameterized q-SDH assumption, making the trade between idealized hashing and assumption strength visible rather than hiding it behind the word “short.” The proof node makes that cost explicit by tying adaptive forgery to the q-Strong Diffie–Hellman problem. It applies to the exact Boneh–Boyen construction rather than to pairing signatures as a family.","prior_boundary":"BLS achieved very short pairing signatures in the random-oracle model, leaving open whether comparable compactness could be obtained with a standard-model proof.","significance_at_publication":"Boneh–Boyen changed the proof-model boundary for short pairing signatures, at the cost of relying on the parameterized q-SDH assumption.","technical_delta":"The proof introduced a parameterized pairing assumption as the price of standard-model compact signatures."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2004-BB-Q-SDH-EUF-CMA","keywords":["pairing","q-sdh","standard-model","short-signature","pairing_short_signatures","provable_unforgeability","security_result"],"limitations":["The claim applies to the paper's scheme, not to pairing signatures generically."],"paper_id":"SIG-PAPER-2004-BB","qualifiers":["q-SDH assumption with its parameter dependence."],"source_locator":{"dossier_section":"SIG-PAPER-2004-BB § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of the IACR proceedings PDF.","primary_source_url":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","status":"section_checked"},"statement":"The Boneh–Boyen analysis derives chosen-message unforgeability for its short signature from the q-Strong Diffie–Hellman assumption.","statement_status":"source_normalized_statement","status":"published","title":"EUF-CMA proof for short signatures under q-SDH","work_id":"SIG-PAPER-2004-BB"},"primaryUrl":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","sections":[],"slug":"bb04-euf-cma-proof-for","status":"published","subtitle":"Short Signatures Without Random Oracles","summary":"The Boneh–Boyen analysis derives chosen-message unforgeability for its short signature from the q-Strong Diffie–Hellman assumption.","tableRows":["SIG-CONSTRUCTION-2004-BB"],"title":"EUF-CMA proof for short signatures under q-SDH","type":"result","venue":"EUROCRYPT 2004","year":2004,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2004-BB-Q-SDH-EUF-CMA"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2004-BB-SHORT-STANDARD-MODEL-SIGNATURES","keywords":["atomic-result","pairing","q-sdh","standard-model","short-signature","pairing_short_signatures","provable_unforgeability","size_and_signing_cost","assumption_families","security_result"],"metadata":{"claim_slug":"short-standard-model-signatures","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["provable_unforgeability","size_and_signing_cost","assumption_families"],"technical_thread":["pairing_short_signatures"]},"historical_context":{"narrative":"BLS made pairing signatures exceptionally short, but its full security argument programmed a random oracle. Boneh and Boyen explored the adjacent point where similarly compact output could be justified in the standard model. Their construction moved the proof-model boundary while introducing the parameterized q-SDH assumption, making the trade between idealized hashing and assumption strength visible rather than hiding it behind the word “short.” The central capability is short pairing-based output backed by a proof that does not program a hash oracle. “Without random oracles” does not mean assumption-free: q-SDH remains fundamental to the claim.","prior_boundary":"BLS achieved very short pairing signatures in the random-oracle model, leaving open whether comparable compactness could be obtained with a standard-model proof.","significance_at_publication":"Boneh–Boyen changed the proof-model boundary for short pairing signatures, at the cost of relying on the parameterized q-SDH assumption.","technical_delta":"The construction retained compact pairing-based output while removing random-oracle programming from the full signature proof."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2004-BB-SHORT-STANDARD-MODEL-SIGNATURES","keywords":["pairing","q-sdh","standard-model","short-signature","pairing_short_signatures","provable_unforgeability","size_and_signing_cost","assumption_families","security_result"],"limitations":["Removing random oracles changes the assumption profile rather than making it assumption-free."],"paper_id":"SIG-PAPER-2004-BB","qualifiers":["Pairing groups and the q-SDH assumption."],"source_locator":{"dossier_section":"SIG-PAPER-2004-BB § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of the IACR proceedings PDF.","primary_source_url":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","status":"section_checked"},"statement":"Boneh–Boyen constructs short pairing-based signatures with a standard-model security proof.","statement_status":"source_normalized_statement","status":"published","title":"Short pairing signatures without random oracles","work_id":"SIG-PAPER-2004-BB"},"primaryUrl":"https://iacr.org/archive/eurocrypt2004/30270057/BBsigsEC04.pdf","sections":[],"slug":"bb04-short-standard-model-pairing","status":"published","subtitle":"Short Signatures Without Random Oracles","summary":"Boneh–Boyen constructs short pairing-based signatures with a standard-model security proof.","tableRows":["SIG-CONSTRUCTION-2004-BB"],"title":"Short pairing signatures without random oracles","type":"result","venue":"EUROCRYPT 2004","year":2004,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2004-BB-SHORT-STANDARD-MODEL-SIGNATURES"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2008-GPV-LATTICE-HASH-AND-SIGN","keywords":["atomic-result","lattice","post-quantum","hash-and-sign","gaussian-sampling","trapdoor","lattice_hash_and_sign","nonce_and_sampling_safety","assumption_families","construction"],"metadata":{"claim_slug":"lattice-hash-and-sign","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["nonce_and_sampling_safety","assumption_families"],"technical_thread":["lattice_hash_and_sign"]},"historical_context":{"narrative":"Lattice cryptography needed more than hard worst-case problems to support hash-and-sign: a signer had to invert a public map while returning a short preimage with the right distribution. Gentry, Peikert, and Vaikuntanathan developed trapdoors and sampling algorithms for precisely that interface. The resulting mechanism supported a lattice signature paradigm and later became the conceptual foundation for compact NTRU-lattice instantiations. At the scheme level, hashing selects a syndrome and the trapdoor produces a short preimage as the signature. Correct distributional sampling is part of security, not a replaceable implementation detail.","prior_boundary":"Lattice signatures lacked a general trapdoor interface that could sample short preimages with a distribution suitable for secure hash-and-sign.","significance_at_publication":"GPV created both the preimage-sampling mechanism and the resulting signature paradigm, grounding a major post-quantum family in worst-case lattice hardness.","technical_delta":"The construction transferred the hash-and-sign paradigm to lattices through distribution-controlled trapdoor inversion."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2008-GPV-LATTICE-HASH-AND-SIGN","keywords":["lattice","post-quantum","hash-and-sign","gaussian-sampling","trapdoor","lattice_hash_and_sign","nonce_and_sampling_safety","assumption_families","construction"],"limitations":["Secure implementation requires faithful short-vector sampling."],"paper_id":"SIG-PAPER-2008-GPV","qualifiers":["Trapdoor lattices and discrete-Gaussian-style preimage sampling."],"source_locator":{"dossier_section":"SIG-PAPER-2008-GPV § Atomic claims and Evidence locator","primary_source":"Abstract and construction overview in the ACM version.","primary_source_url":"https://doi.org/10.1145/1374376.1374407","status":"section_checked"},"statement":"GPV signs by hashing a message to a lattice syndrome and sampling a short preimage with a trapdoor.","statement_status":"source_normalized_statement","status":"published","title":"Lattice hash-and-sign from short preimage sampling","work_id":"SIG-PAPER-2008-GPV"},"primaryUrl":"https://doi.org/10.1145/1374376.1374407","sections":[],"slug":"gpv08-gpv-lattice-hash-and","status":"published","subtitle":"Trapdoors for Hard Lattices and New Cryptographic Constructions","summary":"GPV signs by hashing a message to a lattice syndrome and sampling a short preimage with a trapdoor.","tableRows":["SIG-CONSTRUCTION-2008-GPV"],"title":"Lattice hash-and-sign from short preimage sampling","type":"result","venue":"STOC 2008","year":2008,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2008-GPV-LATTICE-HASH-AND-SIGN"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2008-GPV-LATTICE-PREIMAGE-SAMPLING-TRAPDOORS","keywords":["atomic-result","lattice","post-quantum","hash-and-sign","gaussian-sampling","trapdoor","lattice_hash_and_sign","nonce_and_sampling_safety","assumption_families","mechanism"],"metadata":{"claim_slug":"lattice-preimage-sampling-trapdoors","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["nonce_and_sampling_safety","assumption_families"],"technical_thread":["lattice_hash_and_sign"]},"historical_context":{"narrative":"Lattice cryptography needed more than hard worst-case problems to support hash-and-sign: a signer had to invert a public map while returning a short preimage with the right distribution. Gentry, Peikert, and Vaikuntanathan developed trapdoors and sampling algorithms for precisely that interface. The resulting mechanism supported a lattice signature paradigm and later became the conceptual foundation for compact NTRU-lattice instantiations. At the component level, the contribution is an interface for generating short, properly distributed preimages with a lattice trapdoor. It is reusable beyond signatures and therefore remains distinct from the complete hash-and-sign construction.","prior_boundary":"Lattice signatures lacked a general trapdoor interface that could sample short preimages with a distribution suitable for secure hash-and-sign.","significance_at_publication":"GPV created both the preimage-sampling mechanism and the resulting signature paradigm, grounding a major post-quantum family in worst-case lattice hardness.","technical_delta":"The mechanism exposed a reusable trapdoor-sampling interface rather than only an isolated signature construction."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2008-GPV-LATTICE-PREIMAGE-SAMPLING-TRAPDOORS","keywords":["lattice","post-quantum","hash-and-sign","gaussian-sampling","trapdoor","lattice_hash_and_sign","nonce_and_sampling_safety","assumption_families","mechanism"],"limitations":["A trapdoor sampler alone is not a complete signature scheme."],"paper_id":"SIG-PAPER-2008-GPV","qualifiers":["Distributional guarantees and parameter conditions are part of the mechanism."],"source_locator":{"dossier_section":"SIG-PAPER-2008-GPV § Atomic claims and Evidence locator","primary_source":"Abstract and construction overview in the ACM version.","primary_source_url":"https://doi.org/10.1145/1374376.1374407","status":"section_checked"},"statement":"GPV develops lattice trapdoors supporting short preimage sampling with distributions suitable for cryptographic use.","statement_status":"source_normalized_statement","status":"published","title":"Trapdoors that sample short lattice preimages","work_id":"SIG-PAPER-2008-GPV"},"primaryUrl":"https://doi.org/10.1145/1374376.1374407","sections":[],"slug":"gpv08-short-lattice-preimage-sampl","status":"published","subtitle":"Trapdoors for Hard Lattices and New Cryptographic Constructions","summary":"GPV develops lattice trapdoors supporting short preimage sampling with distributions suitable for cryptographic use.","tableRows":["SIG-CONSTRUCTION-2008-GPV"],"title":"Trapdoors that sample short lattice preimages","type":"result","venue":"STOC 2008","year":2008,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2008-GPV-LATTICE-PREIMAGE-SAMPLING-TRAPDOORS"},{"evidence":"abstract_checked","id":"SIG-RESULT-2009-LYU-FIAT-SHAMIR-WITH-ABORTS","keywords":["atomic-result","lattice","post-quantum","fiat-shamir","rejection-sampling","lattice_fs_with_aborts","nonce_and_sampling_safety","mechanism"],"metadata":{"claim_slug":"fiat-shamir-with-aborts","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"abstract_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["nonce_and_sampling_safety"],"technical_thread":["lattice_fs_with_aborts"]},"historical_context":{"narrative":"Fiat–Shamir responses built from a short lattice secret can betray that secret when their distribution shifts with the witness. Lyubashevsky introduced rejection sampling and intentional aborts so that accepted transcripts follow a controlled distribution. This offered a trapdoor-free route to lattice signing and made abort probability, response bounds, and distributional hiding central design coordinates for later schemes. The mapped mechanism is the accept-or-reject step that hides witness dependence in successful responses. Because this dossier has only abstract-level evidence for the paper, exact theorem parameters remain curation debt and the node stays outside the default backbone.","prior_boundary":"Lattice identification responses could reveal information about a short signing secret because their distribution depended on that secret.","significance_at_publication":"Rejection sampling with aborts made a trapdoor-free Fiat–Shamir route possible and became the conceptual mechanism behind several efficient lattice signatures.","technical_delta":"The abort step replaced trapdoor preimage sampling with a secret-hiding response distribution in a Fiat–Shamir-style design."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2009-LYU-FIAT-SHAMIR-WITH-ABORTS","keywords":["lattice","post-quantum","fiat-shamir","rejection-sampling","lattice_fs_with_aborts","nonce_and_sampling_safety","mechanism"],"limitations":["This record is based on abstract-level review and does not normalize every theorem parameter."],"paper_id":"SIG-PAPER-2009-LYU","qualifiers":["Abort probability and response bounds are integral to correctness and efficiency."],"source_locator":{"dossier_section":"SIG-PAPER-2009-LYU § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/978-3-642-10366-7_35","status":"abstract_checked"},"statement":"Fiat–Shamir with aborts uses rejection sampling so accepted response distributions are sufficiently independent of the lattice signing secret.","statement_status":"source_normalized_statement","status":"published","title":"Abort sampling hides secrets in lattice Fiat–Shamir signatures","work_id":"SIG-PAPER-2009-LYU"},"primaryUrl":"https://doi.org/10.1007/978-3-642-10366-7_35","sections":[],"slug":"lyubashevsky09-abort-sampling-hides-secrets","status":"published","subtitle":"Fiat-Shamir with Aborts: Applications to Lattice and Factoring-Based Signatures","summary":"Fiat–Shamir with aborts uses rejection sampling so accepted response distributions are sufficiently independent of the lattice signing secret.","tableRows":["SIG-CONSTRUCTION-2009-LYU"],"title":"Abort sampling hides secrets in lattice Fiat–Shamir signatures","type":"result","venue":"ASIACRYPT 2009","year":2009,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2009-LYU-FIAT-SHAMIR-WITH-ABORTS"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2011-ED25519-DETERMINISTIC-NONCE-SIDE-CHANNEL-DISCIPLINE","keywords":["atomic-result","schnorr","eddsa","ed25519","deterministic","side-channel","fiat_shamir_schnorr","nonce_and_sampling_safety","security_analysis"],"metadata":{"claim_slug":"deterministic-nonce-side-channel-discipline","contribution_kind":"security_analysis","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["nonce_and_sampling_safety"],"technical_thread":["fiat_shamir_schnorr"]},"historical_context":{"narrative":"An abstract Schnorr-family construction left many security-critical deployment choices unspecified: curve form, point encoding, nonce generation, scalar arithmetic, and timing behavior. Ed25519 fixed those choices together over a twisted Edwards curve and accompanied them with high-speed software. The result treated implementation discipline and wire compatibility as part of the named signature profile rather than as afterthoughts around a theorem. A second contribution isolates deterministic nonce derivation and constant-time-oriented execution. These choices reduce dependence on runtime randomness and timing leakage, but they do not prove resistance to every fault or side-channel technique.","prior_boundary":"Schnorr-family signatures were compact, but deployments still depended on curve choices, nonce handling, encodings, and implementation discipline not fixed by the abstract construction.","significance_at_publication":"Ed25519 packaged those choices into a fast deterministic software profile, turning implementation safety and interoperability into part of the named construction.","technical_delta":"The profile reduced dependence on per-signature randomness and made timing discipline an explicit part of the implementation design."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2011-ED25519-DETERMINISTIC-NONCE-SIDE-CHANNEL-DISCIPLINE","keywords":["schnorr","eddsa","ed25519","deterministic","side-channel","fiat_shamir_schnorr","nonce_and_sampling_safety","security_analysis"],"limitations":["It does not by itself prove resistance to every side channel or fault attack."],"paper_id":"SIG-PAPER-2011-ED25519","qualifiers":["Deterministic nonce derivation does not relax secret-key protection."],"source_locator":{"dossier_section":"SIG-PAPER-2011-ED25519 § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of ePrint 2011/368.","primary_source_url":"https://eprint.iacr.org/2011/368","status":"section_checked"},"statement":"Ed25519 derives the signing nonce from secret material and the message and uses a constant-time-oriented implementation profile.","statement_status":"source_normalized_statement","status":"published","title":"Deterministic nonce derivation and constant-time signing discipline","work_id":"SIG-PAPER-2011-ED25519"},"primaryUrl":"https://eprint.iacr.org/2011/368","sections":[],"slug":"bdlsy11-deterministic-nonce-derivati","status":"published","subtitle":"High-Speed High-Security Signatures","summary":"Ed25519 derives the signing nonce from secret material and the message and uses a constant-time-oriented implementation profile.","tableRows":["SIG-CONSTRUCTION-2011-ED25519"],"title":"Deterministic nonce derivation and constant-time signing discipline","type":"result","venue":"CHES 2011","year":2011,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2011-ED25519-DETERMINISTIC-NONCE-SIDE-CHANNEL-DISCIPLINE"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2011-ED25519-ED25519-ENGINEERING-PROFILE","keywords":["atomic-result","schnorr","eddsa","ed25519","deterministic","side-channel","fiat_shamir_schnorr","nonce_and_sampling_safety","optimization"],"metadata":{"claim_slug":"ed25519-engineering-profile","contribution_kind":"optimization","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["nonce_and_sampling_safety"],"technical_thread":["fiat_shamir_schnorr"]},"historical_context":{"narrative":"An abstract Schnorr-family construction left many security-critical deployment choices unspecified: curve form, point encoding, nonce generation, scalar arithmetic, and timing behavior. Ed25519 fixed those choices together over a twisted Edwards curve and accompanied them with high-speed software. The result treated implementation discipline and wire compatibility as part of the named signature profile rather than as afterthoughts around a theorem. One contribution is the co-designed Ed25519 profile—curve, arithmetic, encoding, signing procedure, and software strategy. Its reported speed belongs to the cited implementation context rather than every future implementation bearing the same name.","prior_boundary":"Schnorr-family signatures were compact, but deployments still depended on curve choices, nonce handling, encodings, and implementation discipline not fixed by the abstract construction.","significance_at_publication":"Ed25519 packaged those choices into a fast deterministic software profile, turning implementation safety and interoperability into part of the named construction.","technical_delta":"The work co-designed the curve, arithmetic, wire format, and signing procedure instead of leaving them as deployment choices around abstract Schnorr."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2011-ED25519-ED25519-ENGINEERING-PROFILE","keywords":["schnorr","eddsa","ed25519","deterministic","side-channel","fiat_shamir_schnorr","nonce_and_sampling_safety","optimization"],"limitations":["Reported speed is contextual, not a timeless property of all Ed25519 implementations."],"paper_id":"SIG-PAPER-2011-ED25519","qualifiers":["The paper's concrete Ed25519 profile and software environment."],"source_locator":{"dossier_section":"SIG-PAPER-2011-ED25519 § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of ePrint 2011/368.","primary_source_url":"https://eprint.iacr.org/2011/368","status":"section_checked"},"statement":"Ed25519 combines a twisted Edwards curve, fixed encodings, deterministic signing, and constant-time-oriented software into a named signature profile.","statement_status":"source_normalized_statement","status":"published","title":"Ed25519 fixes an Edwards-curve software and wire profile","work_id":"SIG-PAPER-2011-ED25519"},"primaryUrl":"https://eprint.iacr.org/2011/368","sections":[],"slug":"bdlsy11-ed25519-software-profile","status":"published","subtitle":"High-Speed High-Security Signatures","summary":"Ed25519 combines a twisted Edwards curve, fixed encodings, deterministic signing, and constant-time-oriented software into a named signature profile.","tableRows":["SIG-CONSTRUCTION-2011-ED25519"],"title":"Ed25519 fixes an Edwards-curve software and wire profile","type":"result","venue":"CHES 2011","year":2011,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2011-ED25519-ED25519-ENGINEERING-PROFILE"},{"evidence":"fulltext_checked","id":"SIG-RESULT-2012-LYU-TRAPDOOR-FREE-LATTICE-SIGNATURES","keywords":["atomic-result","lattice","post-quantum","fiat-shamir","rejection-sampling","sis","lwe","lattice_fs_with_aborts","size_and_signing_cost","nonce_and_sampling_safety","assumption_families","construction"],"metadata":{"claim_slug":"trapdoor-free-lattice-signatures","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost","nonce_and_sampling_safety","assumption_families"],"technical_thread":["lattice_fs_with_aborts"]},"historical_context":{"narrative":"Before this paper, a lattice signer typically sampled short preimages with a secret trapdoor, as in the GPV paradigm; the one Fiat–Shamir alternative was Lyubashevsky's earlier scheme over ideal lattices, which hid the secret by masking with a uniform box and discarding outputs outside a smaller region. Both routes produced long signatures. Here the mask is drawn from a discrete Normal distribution, and a general rejection-sampling theorem shows that accepting with a suitable probability yields outputs whose distribution does not depend on the key. The signer needs only matrix-vector products, a hash query, and the rejection step. Lowering parameters bases the scheme on LWE or low-density SIS for much shorter outputs, and the ring version shrinks keys further.","prior_boundary":"Provably secure lattice signatures mostly used GPV-style trapdoor preimage sampling with large keys and signatures; the only Fiat–Shamir alternative, Lyubashevsky's 2009 ring-SIS scheme, gave signatures of norm \\( \\tilde O(n^{1.5}) \\).","significance_at_publication":"The paper reported keys and signatures smaller than all previous hash-and-sign instantiations and called its ring version the most practical provably secure lattice signature to date.","technical_delta":"Masking with a discrete Normal distribution and rejecting according to the ratio of the target and shifted distributions shortened signatures to \\( \\tilde O(n) \\), and the same scheme was proved over plain SIS rather than only ideal lattices."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2012-LYU-TRAPDOOR-FREE-LATTICE-SIGNATURES","keywords":["lattice","post-quantum","fiat-shamir","rejection-sampling","sis","lwe","lattice_fs_with_aborts","size_and_signing_cost","nonce_and_sampling_safety","assumption_families","construction"],"limitations":["Key and signature sizes are the paper's Figure 2 estimates at its stated security level, not implementation benchmarks.","Ring versions are described briefly (Section 7); for the low-density variants of Section 6, the ring version rests only on the decision version of ring-SIS."],"paper_id":"SIG-PAPER-2012-LYU","qualifiers":["Theorem 5.1 reduces forgery to \\( \\ell_2 \\)-SIS with \\( \\beta = \\tilde O(dn) \\) in the random-oracle model via the forking lemma; the LWE and low-density SIS variants of Section 6 rely on different assumptions.","Expected signing repetitions are about M, a small constant in the paper's parameter sets (Figure 2)."],"source_locator":{"dossier_section":"SIG-PAPER-2012-LYU § Atomic claims and Evidence locator","primary_source":"ePrint 2011/537, Sections 1.1–1.2 (PDF pp. 2–3), Theorem 4.6 (PDF p. 12), Figure 1 and Theorem 5.1 (PDF pp. 14–15), and Section 6 (PDF pp. 19–21).","primary_source_url":"https://eprint.iacr.org/2011/537","status":"theorem_checked"},"statement":"Lyubashevsky builds a Fiat–Shamir-style lattice signature without trapdoors, in which rejection sampling against a discrete Normal distribution makes each output signature independent of the short secret key, giving signatures of length \\( \\tilde O(n) \\) secure under SIS in the random-oracle model.","statement_status":"source_normalized_statement","status":"published","title":"Trapdoor-free lattice signatures with Gaussian rejection sampling","work_id":"SIG-PAPER-2012-LYU"},"primaryUrl":"https://eprint.iacr.org/2011/537","sections":[],"slug":"lyubashevsky12-lattice-signatures-without-t","status":"published","subtitle":"Lattice Signatures Without Trapdoors","summary":"Lyubashevsky builds a Fiat–Shamir-style lattice signature without trapdoors, in which rejection sampling against a discrete Normal distribution makes each output signature independent of the short secret key, giving signatures of length \\( \\tilde O(n) \\) secure under SIS in the random-oracle model.","title":"Trapdoor-free lattice signatures with Gaussian rejection sampling","type":"result","venue":"EUROCRYPT 2012","year":2012,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2012-LYU-TRAPDOOR-FREE-LATTICE-SIGNATURES"},{"evidence":"fulltext_checked","id":"SIG-RESULT-2018-DILITHIUM-GAUSSIAN-FREE-CONSTANT-TIME-DESIGN","keywords":["atomic-result","lattice","post-quantum","module-lwe","module-sis","fiat-shamir-with-aborts","lattice_fs_with_aborts","nonce_and_sampling_safety","optimization"],"metadata":{"claim_slug":"gaussian-free-constant-time-design","contribution_kind":"optimization","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["nonce_and_sampling_safety"],"technical_thread":["lattice_fs_with_aborts"]},"historical_context":{"narrative":"Lattice signatures such as BLISS and the NTRU-based hash-and-sign schemes reached small sizes by sampling secret randomness from a discrete Gaussian distribution, but several attacks exploited implementations of exactly that step. Dilithium's designers argued that a universally deployed scheme cannot assume expert implementers, so they restricted every random choice to uniform sampling, the option already present in Lyubashevsky's 2009 scheme and its successors. The remaining operations, polynomial multiplication via the number-theoretic transform and rounding, are straightforward to write in constant time. The paper estimates that Gaussian sampling would have saved only 10 to 15 percent of the signature size. Whether a given implementation really runs in constant time still requires artifact-level evidence.","prior_boundary":"The most compact lattice signatures crucially required discrete Gaussian sampling, and published side-channel attacks showed how easily its implementations become insecure.","significance_at_publication":"The authors presented safe implementability as their first design criterion and judged that a 10 to 15 percent signature saving from Gaussian sampling did not justify the added implementation risk.","technical_delta":"Using only uniform sampling, as earlier abort-based schemes had proposed, together with polynomial multiplication and rounding that are easy to make constant time, removed the hardest component from the signing path."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2018-DILITHIUM-GAUSSIAN-FREE-CONSTANT-TIME-DESIGN","keywords":["lattice","post-quantum","module-lwe","module-sis","fiat-shamir-with-aborts","lattice_fs_with_aborts","nonce_and_sampling_safety","optimization"],"limitations":["Constant-time behavior still depends on the exact implementation."],"paper_id":"SIG-PAPER-2018-DILITHIUM","qualifiers":["Implementation-aware design claim, not a benchmark observation."],"source_locator":{"dossier_section":"SIG-PAPER-2018-DILITHIUM § Atomic claims and Evidence locator","primary_source":"ePrint 2017/633, abstract and Section 1, \"Simple to implement securely\" (PDF p. 1), and the related-work discussion of Gaussian-based schemes (PDF p. 20).","primary_source_url":"https://eprint.iacr.org/2017/633","status":"section_checked"},"statement":"Dilithium avoids discrete Gaussian sampling and uses simple bounded distributions and arithmetic designed for constant-time implementation.","statement_status":"source_normalized_statement","status":"published","title":"Gaussian-free, constant-time-oriented Dilithium signing","work_id":"SIG-PAPER-2018-DILITHIUM"},"primaryUrl":"https://eprint.iacr.org/2017/633","sections":[],"slug":"dkl18-gaussian-free-constant-time","status":"published","subtitle":"CRYSTALS-Dilithium: A Lattice-Based Digital Signature Scheme","summary":"Dilithium avoids discrete Gaussian sampling and uses simple bounded distributions and arithmetic designed for constant-time implementation.","tableRows":["SIG-CONSTRUCTION-2018-DILITHIUM"],"title":"Gaussian-free, constant-time-oriented Dilithium signing","type":"result","venue":"IACR TCHES 2018(1)","year":2018,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2018-DILITHIUM-GAUSSIAN-FREE-CONSTANT-TIME-DESIGN"},{"evidence":"fulltext_checked","id":"SIG-RESULT-2018-DILITHIUM-MODULE-LATTICE-FSWA-SIGNATURE","keywords":["atomic-result","lattice","post-quantum","module-lwe","module-sis","fiat-shamir-with-aborts","lattice_fs_with_aborts","size_and_signing_cost","nonce_and_sampling_safety","assumption_families","construction"],"metadata":{"claim_slug":"module-lattice-fswa-signature","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost","nonce_and_sampling_safety","assumption_families"],"technical_thread":["lattice_fs_with_aborts"]},"historical_context":{"narrative":"By 2017 the Fiat–Shamir-with-aborts approach had a clear lineage, from Lyubashevsky's ring-SIS scheme through his LWE-plus-SIS signatures to the compressed scheme of Bai and Galbraith, while the most compact lattice signatures depended on discrete Gaussian sampling, whose implementations several side-channel attacks had exploited. Dilithium keeps uniform sampling throughout and works over module lattices with a single fixed polynomial ring, so changing the security level changes only how many ring operations are performed. Its main new idea omits low-order bits of the public key and has the signer attach hints that let the verifier recover the needed high-order bits. Security reduces to module-lattice problems plus a hash-combined assumption. The later ML-DSA standard derives from this design but fixes its own encodings.","prior_boundary":"Abort-based lattice signatures had moved from Lyubashevsky's ring-SIS and LWE-plus-SIS schemes to the compressed Bai–Galbraith scheme, while the most compact lattice signatures relied on discrete Gaussian sampling that is hard to implement safely.","significance_at_publication":"Submitted to NIST's post-quantum call, it claimed the smallest combined public-key and signature size of any post-quantum signature that avoids Gaussian sampling, with simple constant-time implementation.","technical_delta":"Starting from the Bai–Galbraith template, Dilithium moved to module lattices over one fixed ring and replaced part of the public key with signer-supplied hints, reducing the public key about 2.5 times."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2018-DILITHIUM-MODULE-LATTICE-FSWA-SIGNATURE","keywords":["lattice","post-quantum","module-lwe","module-sis","fiat-shamir-with-aborts","lattice_fs_with_aborts","size_and_signing_cost","nonce_and_sampling_safety","assumption_families","construction"],"limitations":["This paper-level architecture is distinct from the later normative ML-DSA profile."],"paper_id":"SIG-PAPER-2018-DILITHIUM","qualifiers":["SUF-CMA security is bounded in the quantum random-oracle model, following Kiltz–Lyubashevsky–Schaffner, by MLWE, SelfTargetMSIS, and MSIS (Section 4.2, Eq. 6); the classical random-oracle reduction is non-tight (Section 4)."],"source_locator":{"dossier_section":"SIG-PAPER-2018-DILITHIUM § Atomic claims and Evidence locator","primary_source":"ePrint 2017/633, abstract and Section 1 (PDF pp. 1–2), Section 1.1 and Figure 1 (PDF pp. 2–3), Section 1.2 (PDF pp. 3–4), Section 1.3 (PDF p. 5), Section 4 (PDF pp. 11–13), and the related-work discussion (PDF p. 20).","primary_source_url":"https://eprint.iacr.org/2017/633","status":"section_checked"},"statement":"Dilithium builds a module-lattice Fiat–Shamir-with-aborts signature with uniformly sampled bounded secrets and masks, in which signers supply hints so that low-order bits of the public key can be dropped.","statement_status":"source_normalized_statement","status":"published","title":"Module-lattice Fiat–Shamir-with-aborts signature architecture","work_id":"SIG-PAPER-2018-DILITHIUM"},"primaryUrl":"https://eprint.iacr.org/2017/633","sections":[],"slug":"dkl18-module-lattice-fiat-shamir","status":"published","subtitle":"CRYSTALS-Dilithium: A Lattice-Based Digital Signature Scheme","summary":"Dilithium builds a module-lattice Fiat–Shamir-with-aborts signature with uniformly sampled bounded secrets and masks, in which signers supply hints so that low-order bits of the public key can be dropped.","tableRows":["SIG-CONSTRUCTION-2018-DILITHIUM"],"title":"Module-lattice Fiat–Shamir-with-aborts signature architecture","type":"result","venue":"IACR TCHES 2018(1)","year":2018,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2018-DILITHIUM-MODULE-LATTICE-FSWA-SIGNATURE"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2019-SPHINCSPLUS-STATELESS-HASH-BASED-HYPERTREE","keywords":["atomic-result","hash-based","stateless","post-quantum","hypertree","fors","hash_tree_signatures","size_and_signing_cost","assumption_families","capability_result"],"metadata":{"claim_slug":"stateless-hash-based-hypertree","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost","assumption_families"],"technical_thread":["hash_tree_signatures"]},"historical_context":{"narrative":"Merkle-tree signatures offered a conservative hash-based foundation but traditionally relied on durable state to avoid reusing one-time leaves. SPHINCS+ removed that operational dependency by arranging WOTS+ and FORS instances beneath a hypertree and choosing authentication material pseudorandomly. The price was larger signatures and substantial hashing, yielding a deliberately different post-quantum deployment point from lattice signatures. Its capability contribution is the stateless signing contract produced by FORS, WOTS+, and hypertree authentication. Statelessness mitigates leaf-counter failures but does not erase the family's signature-size and computation tradeoffs.","prior_boundary":"Merkle-tree signatures were conservative but traditionally required state to prevent reuse of one-time signing keys, creating a demanding operational contract.","significance_at_publication":"SPHINCS+ traded larger signatures and more computation for stateless operation under a hash-based security foundation, defining a distinct post-quantum deployment point.","technical_delta":"The framework removed the stateful signer contract of classic Merkle signatures by selecting and authenticating many-time components pseudorandomly."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2019-SPHINCSPLUS-STATELESS-HASH-BASED-HYPERTREE","keywords":["hash-based","stateless","post-quantum","hypertree","fors","hash_tree_signatures","size_and_signing_cost","assumption_families","capability_result"],"limitations":["Statelessness is obtained with larger signatures and substantial computation."],"paper_id":"SIG-PAPER-2019-SPHINCSPLUS","qualifiers":["Hash-based security with fixed parameter-set tradeoffs."],"source_locator":{"dossier_section":"SIG-PAPER-2019-SPHINCSPLUS § Atomic claims and Evidence locator","primary_source":"Abstract and Introduction of ePrint 2019/1086.","primary_source_url":"https://eprint.iacr.org/2019/1086","status":"section_checked"},"statement":"SPHINCS+ combines FORS, WOTS+, and a hypertree so signing does not require persistent leaf-use state.","statement_status":"source_normalized_statement","status":"published","title":"Stateless hash-based signatures from FORS and hypertrees","work_id":"SIG-PAPER-2019-SPHINCSPLUS"},"primaryUrl":"https://eprint.iacr.org/2019/1086","sections":[],"slug":"hkb19-stateless-hash-based-hypertr","status":"published","subtitle":"The SPHINCS+ Signature Framework","summary":"SPHINCS+ combines FORS, WOTS+, and a hypertree so signing does not require persistent leaf-use state.","tableRows":["SIG-CONSTRUCTION-2019-SPHINCSPLUS"],"title":"Stateless hash-based signatures from FORS and hypertrees","type":"result","venue":"ACM CCS 2019","year":2019,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2019-SPHINCSPLUS-STATELESS-HASH-BASED-HYPERTREE"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2020-FALCON-COMPACT-LATTICE-SIGNATURES","keywords":["atomic-result","lattice","post-quantum","ntru","gpv","gaussian-sampling","falcon","lattice_hash_and_sign","size_and_signing_cost","assumption_families","capability_result"],"metadata":{"claim_slug":"compact-lattice-signatures","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost","assumption_families"],"technical_thread":["lattice_hash_and_sign"]},"historical_context":{"narrative":"GPV had shown how a trapdoor could turn short-preimage sampling into a lattice signature, but a compact concrete scheme still needed structured lattices and an efficient sampler with faithful output distribution. Falcon instantiated the paradigm over NTRU lattices and used fast Fourier techniques inside signing. This created a notably small-signature alternative whose implementation obligations differ sharply from abort-based designs. The capability node records Falcon's compact NTRU-lattice key and signature profile. Compact output should not be conflated with a simpler signing implementation or with Dilithium's abort-based mechanism.","prior_boundary":"GPV hash-and-sign offered compact lattice signatures in principle, but concrete trapdoor sampling had to be engineered without losing distributional correctness.","significance_at_publication":"Falcon specialized GPV to NTRU lattices and fast Fourier sampling, producing the compact-signature endpoint of the NIST lattice-signature finalists.","technical_delta":"The construction occupied a smaller-signature, more sampler-intensive point than abort-based module-lattice signatures."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2020-FALCON-COMPACT-LATTICE-SIGNATURES","keywords":["lattice","post-quantum","ntru","gpv","gaussian-sampling","falcon","lattice_hash_and_sign","size_and_signing_cost","assumption_families","capability_result"],"limitations":["Compact output does not imply simpler or constant-time signing."],"paper_id":"SIG-PAPER-2020-FALCON","qualifiers":["Concrete compactness depends on the Falcon parameter profile."],"source_locator":{"dossier_section":"SIG-PAPER-2020-FALCON § Atomic claims and Evidence locator","primary_source":"Specification Chapter 1 and complete scheme specification.","primary_source_url":"https://falcon-sign.info/falcon.pdf","status":"section_checked"},"statement":"Falcon realizes short public keys and signatures by instantiating GPV hash-and-sign over structured NTRU lattices.","statement_status":"source_normalized_statement","status":"published","title":"Compact NTRU-lattice signatures from GPV sampling","work_id":"SIG-PAPER-2020-FALCON"},"primaryUrl":"https://falcon-sign.info/falcon.pdf","sections":[],"slug":"fhk20-compact-ntru-lattice-signatu","status":"published","subtitle":"Falcon: Fast-Fourier Lattice-Based Compact Signatures over NTRU","summary":"Falcon realizes short public keys and signatures by instantiating GPV hash-and-sign over structured NTRU lattices.","tableRows":["SIG-CONSTRUCTION-2020-FALCON"],"title":"Compact NTRU-lattice signatures from GPV sampling","type":"result","venue":"NIST PQC supporting documentation","year":2020,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2020-FALCON-COMPACT-LATTICE-SIGNATURES"},{"evidence":"primary_source_checked","id":"SIG-RESULT-2020-FALCON-GPV-NTRU-FAST-FOURIER-SAMPLING","keywords":["atomic-result","lattice","post-quantum","ntru","gpv","gaussian-sampling","falcon","lattice_hash_and_sign","size_and_signing_cost","nonce_and_sampling_safety","optimization"],"metadata":{"claim_slug":"gpv-ntru-fast-fourier-sampling","contribution_kind":"optimization","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["size_and_signing_cost","nonce_and_sampling_safety"],"technical_thread":["lattice_hash_and_sign"]},"historical_context":{"narrative":"GPV had shown how a trapdoor could turn short-preimage sampling into a lattice signature, but a compact concrete scheme still needed structured lattices and an efficient sampler with faithful output distribution. Falcon instantiated the paradigm over NTRU lattices and used fast Fourier techniques inside signing. This created a notably small-signature alternative whose implementation obligations differ sharply from abort-based designs. The mechanism node focuses on fast Fourier sampling as the bridge from GPV theory to efficient NTRU signing. Floating-point behavior and distributional fidelity remain security-critical implementation obligations.","prior_boundary":"GPV hash-and-sign offered compact lattice signatures in principle, but concrete trapdoor sampling had to be engineered without losing distributional correctness.","significance_at_publication":"Falcon specialized GPV to NTRU lattices and fast Fourier sampling, producing the compact-signature endpoint of the NIST lattice-signature finalists.","technical_delta":"The sampler made high-dimensional trapdoor sampling efficient enough for a compact concrete signature profile."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2020-FALCON-GPV-NTRU-FAST-FOURIER-SAMPLING","keywords":["lattice","post-quantum","ntru","gpv","gaussian-sampling","falcon","lattice_hash_and_sign","size_and_signing_cost","nonce_and_sampling_safety","optimization"],"limitations":["The mechanism is not interchangeable with Dilithium's abort-based signing path."],"paper_id":"SIG-PAPER-2020-FALCON","qualifiers":["Floating-point and distributional correctness are implementation-critical."],"source_locator":{"dossier_section":"SIG-PAPER-2020-FALCON § Atomic claims and Evidence locator","primary_source":"Specification Chapter 1 and complete scheme specification.","primary_source_url":"https://falcon-sign.info/falcon.pdf","status":"section_checked"},"statement":"Falcon implements GPV-style short-preimage signing over NTRU lattices using fast Fourier sampling.","statement_status":"source_normalized_statement","status":"published","title":"Fast Fourier sampling for NTRU-lattice hash-and-sign","work_id":"SIG-PAPER-2020-FALCON"},"primaryUrl":"https://falcon-sign.info/falcon.pdf","sections":[],"slug":"fhk20-ntru-fast-fourier-sampling","status":"published","subtitle":"Falcon: Fast-Fourier Lattice-Based Compact Signatures over NTRU","summary":"Falcon implements GPV-style short-preimage signing over NTRU lattices using fast Fourier sampling.","tableRows":["SIG-CONSTRUCTION-2020-FALCON"],"title":"Fast Fourier sampling for NTRU-lattice hash-and-sign","type":"result","venue":"NIST PQC supporting documentation","year":2020,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2020-FALCON-GPV-NTRU-FAST-FOURIER-SAMPLING"},{"evidence":"official_source_checked","id":"SIG-RESULT-2023-FIPS186-5-CURRENT-CLASSICAL-NIST-SIGNATURES","keywords":["atomic-result","standard","rsa","ecdsa","eddsa","nist","signature_deployment_profiles","standardization_result"],"metadata":{"claim_slug":"current-classical-nist-signatures","contribution_kind":"standardization_result","dossier_type":"contribution","evidence":"official_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":[],"technical_thread":["signature_deployment_profiles","rsa_encoding_signatures","fiat_shamir_schnorr"]},"historical_context":{"narrative":"Classical signatures had accumulated multiple federal profiles and legacy rules by the time FIPS 186-5 was issued. The revision consolidated current requirements for RSA, ECDSA, and EdDSA while changing how older DSA material may be used. Its historical role is to define an interoperable approval and conformance boundary, not to introduce the underlying mathematics or provide a new comparative security proof. The atomic decision is the current classical federal portfolio and its exact usage rules. Standard status neither upgrades old textbook variants nor makes all conforming implementations equally secure.","prior_boundary":"Classical signature families had accumulated separate standards and deployment profiles, including legacy choices no longer suitable for new signing applications.","significance_at_publication":"FIPS 186-5 consolidated the federal classical signature interface around profiled RSA, ECDSA, and EdDSA while changing the status of legacy DSA use.","technical_delta":"The standard consolidated algorithm, parameter, generation, verification, and conformance requirements into the current classical NIST signature profile."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2023-FIPS186-5-CURRENT-CLASSICAL-NIST-SIGNATURES","keywords":["standard","rsa","ecdsa","eddsa","nist","signature_deployment_profiles","standardization_result"],"limitations":["Standardization is not a new cryptographic security proof."],"paper_id":"SIG-PAPER-2023-FIPS186-5","qualifiers":["Normative federal standard; consult exact approval and legacy-use clauses."],"source_locator":{"dossier_section":"SIG-PAPER-2023-FIPS186-5 § Atomic claims and Evidence locator","primary_source":"NIST final publication page and FIPS 186-5 overview.","primary_source_url":"https://csrc.nist.gov/pubs/fips/186-5/final","status":"section_checked"},"statement":"FIPS 186-5 normatively specifies federal use of RSA, ECDSA, and EdDSA signature methods and revises legacy DSA status.","statement_status":"source_normalized_statement","status":"standard","title":"FIPS 186-5 profiles approved classical digital signatures","work_id":"SIG-PAPER-2023-FIPS186-5"},"primaryUrl":"https://csrc.nist.gov/pubs/fips/186-5/final","sections":[],"slug":"nist23-fips-186-5-profiles","status":"standard","subtitle":"FIPS 186-5: Digital Signature Standard","summary":"FIPS 186-5 normatively specifies federal use of RSA, ECDSA, and EdDSA signature methods and revises legacy DSA status.","title":"FIPS 186-5 profiles approved classical digital signatures","type":"result","venue":"FIPS 186-5","year":2023,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2023-FIPS186-5-CURRENT-CLASSICAL-NIST-SIGNATURES"},{"evidence":"official_source_checked","id":"SIG-RESULT-2024-FIPS204-ML-DSA-STANDARDIZATION","keywords":["atomic-result","standard","post-quantum","lattice","ml-dsa","nist","lattice_fs_with_aborts","standardization_result"],"metadata":{"claim_slug":"ml-dsa-standardization","contribution_kind":"standardization_result","dossier_type":"contribution","evidence":"official_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":[],"technical_thread":["lattice_fs_with_aborts"]},"historical_context":{"narrative":"Dilithium's selection as a post-quantum design did not by itself give implementations a permanent federal interface. FIPS 204 fixed algorithms, encodings, parameter sets, error handling, and conformance details under the name ML-DSA. The document therefore marks the transition from a research construction family to a normative deployment profile, while leaving the earlier Dilithium paper as the source of the architectural ideas. This node records ML-DSA standardization alone. It links back to Dilithium's module-lattice architecture but does not retroactively turn every historical Dilithium variant or implementation into the standardized object.","prior_boundary":"Dilithium existed as a selected post-quantum design, but deployment required normative algorithms, encodings, parameter sets, and validation-facing interfaces.","significance_at_publication":"FIPS 204 converted the design lineage into ML-DSA, a stable federal specification rather than merely another construction paper.","technical_delta":"The document fixed a normative deployment profile for module-lattice Fiat–Shamir-with-aborts signatures."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2024-FIPS204-ML-DSA-STANDARDIZATION","keywords":["standard","post-quantum","lattice","ml-dsa","nist","lattice_fs_with_aborts","standardization_result"],"limitations":["The standard does not make all Dilithium implementations equivalent."],"paper_id":"SIG-PAPER-2024-FIPS204","qualifiers":["Normative FIPS profile, not every historical Dilithium variant."],"source_locator":{"dossier_section":"SIG-PAPER-2024-FIPS204 § Atomic claims and Evidence locator","primary_source":"NIST final publication page and normative standard.","primary_source_url":"https://csrc.nist.gov/pubs/fips/204/final","status":"section_checked"},"statement":"FIPS 204 specifies ML-DSA algorithms, encodings, parameter sets, and interfaces derived from the Dilithium design.","statement_status":"source_normalized_statement","status":"standard","title":"ML-DSA standardizes the Dilithium-derived module-lattice signature","work_id":"SIG-PAPER-2024-FIPS204"},"primaryUrl":"https://csrc.nist.gov/pubs/fips/204/final","sections":[],"slug":"nist24-fips204-ml-dsa-standardizes-the","status":"standard","subtitle":"FIPS 204: Module-Lattice-Based Digital Signature Standard","summary":"FIPS 204 specifies ML-DSA algorithms, encodings, parameter sets, and interfaces derived from the Dilithium design.","tableRows":["SIG-CONSTRUCTION-2024-MLDSA"],"title":"ML-DSA standardizes the Dilithium-derived module-lattice signature","type":"result","venue":"FIPS 204","year":2024,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2024-FIPS204-ML-DSA-STANDARDIZATION"},{"evidence":"official_source_checked","id":"SIG-RESULT-2024-FIPS205-SLH-DSA-STANDARDIZATION","keywords":["atomic-result","standard","post-quantum","hash-based","slh-dsa","nist","hash_tree_signatures","standardization_result"],"metadata":{"claim_slug":"slh-dsa-standardization","contribution_kind":"standardization_result","dossier_type":"contribution","evidence":"official_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":[],"technical_thread":["hash_tree_signatures"]},"historical_context":{"narrative":"SPHINCS+ supplied a stateless hash-based framework, but interoperable deployment required one exact set of algorithms, encodings, and approved parameter choices. FIPS 205 provided that contract under the name SLH-DSA, including SHA2- and SHAKE-based families. Its importance lies in normative adoption of a conservative post-quantum rail rather than invention of hypertrees or a claim that their size and speed costs disappeared. This node similarly records SLH-DSA's normative profile rather than the invention of SPHINCS+. Conformance is parameter- and encoding-specific and does not remove the operational costs of stateless hash-based signing.","prior_boundary":"SPHINCS+ offered stateless hash-based signatures, but interoperable deployment still required fixed algorithms, parameter sets, encodings, and conformance rules.","significance_at_publication":"FIPS 205 converted that framework into SLH-DSA and supplied a normative conservative alternative to lattice-based post-quantum signatures.","technical_delta":"The document fixed a normative stateless hash-based alternative with SHA2- and SHAKE-based parameter families."},"historical_context_status":"curator_synthesis","id":"SIG-RESULT-2024-FIPS205-SLH-DSA-STANDARDIZATION","keywords":["standard","post-quantum","hash-based","slh-dsa","nist","hash_tree_signatures","standardization_result"],"limitations":["Standardization does not remove the signature-size and computation tradeoffs of the family."],"paper_id":"SIG-PAPER-2024-FIPS205","qualifiers":["Normative FIPS profile and its named parameter sets."],"source_locator":{"dossier_section":"SIG-PAPER-2024-FIPS205 § Atomic claims and Evidence locator","primary_source":"NIST final publication page and normative standard.","primary_source_url":"https://csrc.nist.gov/pubs/fips/205/final","status":"section_checked"},"statement":"FIPS 205 specifies SLH-DSA algorithms, encodings, and parameter sets derived from SPHINCS+.","statement_status":"source_normalized_statement","status":"standard","title":"SLH-DSA standardizes stateless hash-based signatures","work_id":"SIG-PAPER-2024-FIPS205"},"primaryUrl":"https://csrc.nist.gov/pubs/fips/205/final","sections":[],"slug":"nist24-fips205-slh-dsa-standardizes-statele","status":"standard","subtitle":"FIPS 205: Stateless Hash-Based Digital Signature Standard","summary":"FIPS 205 specifies SLH-DSA algorithms, encodings, and parameter sets derived from SPHINCS+.","tableRows":["SIG-CONSTRUCTION-2024-SLHDSA"],"title":"SLH-DSA standardizes stateless hash-based signatures","type":"result","venue":"FIPS 205","year":2024,"sourcePath":"data/signature-catalog.json#SIG-RESULT-2024-FIPS205-SLH-DSA-STANDARDIZATION"},{"evidence":"source_grounded_route","id":"SIG-ROUTE-001","keywords":[],"metadata":{"current_bottleneck":"Changes that simplify sampling or rejection can shift signature size, tightness, failure behavior, or the exact Module-LWE and Module-SIS assumption profile.","dossier_type":"route","entry_results":["SIG-PAPER-2009-LYU","SIG-PAPER-2018-DILITHIUM","SIG-PAPER-2024-FIPS204"],"evidence":"source_grounded_route","falsifiable_next_test":"Specify one fixed security level and compare complete key/signature bytes, signing-tail latency, verification latency, failure probability, and constant-time audit findings against ML-DSA and Falcon.","id":"SIG-ROUTE-001","mechanism":"Retain structured-lattice arithmetic and compact decompositions while reducing rejection behavior, sampler complexity, and side-channel-sensitive control flow.","status":"proposed","targets":[],"title":"Simplify module-lattice signing without surrendering compact encodings"},"primaryUrl":null,"sections":[{"content":"This route does not treat every structured-lattice signature as interchangeable and does not claim the target tradeoff is simultaneously attainable.","heading":"Route boundary"}],"slug":"simplify-module-lattice-sign","status":"proposed","subtitle":"","summary":"This route does not treat every structured-lattice signature as interchangeable and does not claim the target tradeoff is simultaneously attainable.","title":"Simplify module-lattice signing without surrendering compact encodings","type":"route","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-ROUTE-001"},{"evidence":"source_grounded_route","id":"SIG-ROUTE-002","keywords":[],"metadata":{"current_bottleneck":"Statelessness and conservative hash assumptions are paid for by many revealed hash values and repeated tree computation.","dossier_type":"route","entry_results":["SIG-PAPER-1979-LAMPORT","SIG-PAPER-1989-MERKLE","SIG-PAPER-2019-SPHINCSPLUS","SIG-PAPER-2024-FIPS205"],"evidence":"source_grounded_route","falsifiable_next_test":"Give a concrete parameter set with the same stated security target as one SLH-DSA profile, then measure signature bytes, peak memory, signing time, and verification time under identical hash primitives.","id":"SIG-ROUTE-002","mechanism":"Reduce the number or encoding cost of one-time and few-time signatures and their authentication paths while retaining an explicit hash-only security profile.","status":"proposed","targets":[],"title":"Compress stateless hash-based authentication structures"},"primaryUrl":null,"sections":[{"content":"Changing to a stateful signer, an algebraic assumption, or an aggregate-signature interface resolves a different target.","heading":"Route boundary"}],"slug":"compress-stateless-hash-base","status":"proposed","subtitle":"","summary":"Changing to a stateful signer, an algebraic assumption, or an aggregate-signature interface resolves a different target.","title":"Compress stateless hash-based authentication structures","type":"route","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#SIG-ROUTE-002"},{"evidence":"registry","id":"ASM-CDH","keywords":["group","standard"],"metadata":{"aliases":["computational Diffie-Hellman in pairing groups"],"falsifiable":true,"family":"group","id":"ASM-CDH","implied_by":["ASM-DDH","ASM-DLIN","ASM-KLIN","ASM-DBDH","ASM-GDH","ASM-QBDHE","ASM-RW13-Q1"],"implied_by_records":[{"id":"ASM-DDH","name":"Decisional Diffie-Hellman (DDH)"},{"id":"ASM-DLIN","name":"Decision linear (DLIN)"},{"id":"ASM-KLIN","name":"k-linear assumption (k-Lin)"},{"id":"ASM-DBDH","name":"Decisional bilinear Diffie-Hellman (DBDH)"},{"id":"ASM-GDH","name":"Gap Diffie-Hellman (GDH)"},{"id":"ASM-QBDHE","name":"Decisional q-bilinear Diffie-Hellman exponent (q-BDHE)"},{"id":"ASM-RW13-Q1","name":"Rouselakis–Waters q-1 assumption (q-1)"}],"implies":["ASM-DLOG"],"implies_records":[{"id":"ASM-DLOG","name":"Discrete logarithm (DL)"}],"introduced_in":{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},"kind":"standard","name":"Computational Diffie-Hellman (CDH)","post_quantum":false,"references":[{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},{"citation":"Bert den Boer, Diffie-Hellman is as Strong as Discrete Log for Certain Primes, CRYPTO 1988","url":"https://doi.org/10.1007/0-387-34799-2_38"},{"citation":"Ueli M. Maurer, Towards the Equivalence of Breaking the Diffie-Hellman Protocol and Computing Discrete Logarithms, CRYPTO 1994","url":"https://doi.org/10.1007/3-540-48658-5_26"},{"citation":"Ueli M. Maurer and Stefan Wolf, The Relationship Between Breaking the Diffie-Hellman Protocol and Computing Discrete Logarithms, SIAM J. Comput. 28(5), 1999","url":"https://doi.org/10.1137/S0097539796302749"},{"citation":"Antoine Joux and Kim Nguyen, Separating Decision Diffie-Hellman from Computational Diffie-Hellman in Cryptographic Groups, J. Cryptology 16, 2003","url":"https://doi.org/10.1007/s00145-003-0052-4"}],"status":"As of 2026-10-10 no algorithm for CDH is known that does not compute discrete logarithms, CDH is believed hard in pairing groups where DDH is easy, and it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1109/TIT.1976.1055638","sections":[{"content":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order\n\\( p \\). The CDH assumption states that, given \\( (g, g^{a}, g^{b}) \\) for\nuniform \\( a, b \\in \\mathbb{Z}_p \\), no probabilistic polynomial-time algorithm\noutputs \\( g^{ab} \\) with non-negligible probability. In a bilinear group the\nsame problem is posed in a source group; for asymmetric pairings the\ntwo-group version is co-CDH.","heading":"Definition"},{"content":"Computing discrete logarithms solves CDH, and no other general method is\nknown. Den Boer (1988), Maurer (1994) and Maurer and Wolf (1999) showed that\nCDH is equivalent to DL in groups where suitable auxiliary groups (for\nexample, elliptic curves of smooth order over \\( \\mathbb{F}_p \\)) are known.\nIn groups with a symmetric pairing, DDH is easy while CDH is believed hard\n(Joux and Nguyen 2003); such \"gap\" groups underlie BLS signatures\n(`SIG-PAPER-2001-BLS`).","heading":"Status"},{"content":"CDH implies DL (ASM-DLOG). DDH, DLIN, k-Lin, DBDH, gap DH, q-BDHE and the\nRouselakis-Waters q-1 assumption each imply CDH: a CDH oracle\nbreaks each of them. BLS signatures are proven secure from CDH in a gap group\nin the random oracle model.","heading":"Relations"}],"slug":"cdh","status":"registry","subtitle":"group","summary":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order \\( p \\).","tags":["group","standard"],"title":"Computational Diffie-Hellman (CDH)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-CDH"},{"evidence":"registry","id":"ASM-CLAWFREE-TDP","keywords":["other","standard"],"metadata":{"aliases":["claw-free trapdoor permutations"],"falsifiable":true,"family":"other","id":"ASM-CLAWFREE-TDP","implied_by":["ASM-FACTORING"],"implied_by_records":[{"id":"ASM-FACTORING","name":"Integer factorization (factoring)"}],"implies":["ASM-TDP"],"implies_records":[{"id":"ASM-TDP","name":"Trapdoor one-way permutations (TDP)"}],"introduced_in":{"citation":"Shafi Goldwasser, Silvio Micali, Ronald L. Rivest, A Digital Signature Scheme Secure Against Adaptive Chosen-Message Attacks, SIAM J. Comput. 17(2), 1988","url":"https://doi.org/10.1137/0217017"},"kind":"standard","name":"Claw-free trapdoor permutation pairs","post_quantum":"not_applicable","references":[{"citation":"Shafi Goldwasser, Silvio Micali, Ronald L. Rivest, A Digital Signature Scheme Secure Against Adaptive Chosen-Message Attacks, SIAM J. Comput. 17(2), 1988","url":"https://doi.org/10.1137/0217017"}],"status":"As of 2026-10-10 the factoring-based instantiation of Goldwasser, Micali and Rivest is as secure as factoring Blum integers and is therefore broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1137/0217017","sections":[{"content":"A claw-free pair is a family of pairs of permutations \\( (f_0, f_1) \\) on a\ncommon domain \\( D \\), generated together with trapdoors for inverting them,\nsuch that given the public description no probabilistic polynomial-time\nalgorithm finds a claw: values \\( x, y \\in D \\) with\n\n\\[\nf_0(x) = f_1(y)\n\\]\n\nwith non-negligible probability.","heading":"Definition"},{"content":"Goldwasser, Micali and Rivest (`SIG-PAPER-1988-GMR`) introduced claw-free\npairs to build the first signature scheme secure against adaptive\nchosen-message attacks, and instantiated them from factoring with\n\\( f_0(x) = x^2 \\) and \\( f_1(x) = 4x^2 \\) on quadratic residues modulo a Blum\ninteger: a claw yields a square root of 4 different from \\( \\pm 2 \\), hence a\nfactor of \\( N \\). This instantiation is broken in quantum polynomial time.","heading":"Status"},{"content":"A claw-free pair implies that each \\( f_b \\) is one-way: an inverter for\n\\( f_0 \\) applied to \\( f_1(y) \\) for random \\( y \\) produces a claw. So\nclaw-free pairs imply trapdoor permutations, and factoring implies claw-free pairs by the construction above.","heading":"Relations"}],"slug":"clawfree-tdp","status":"registry","subtitle":"other","summary":"A claw-free pair is a family of pairs of permutations \\( (f_0, f_1) \\) on a common domain \\( D \\), generated together with trapdoors for inverting them, such that given the public description no probabilistic polynomial-time algorithm finds a claw: values \\( x, y \\in D \\) with \\[ f_0(x) = f_1(y) \\] with non-negligible probability.","tags":["other","standard"],"title":"Claw-free trapdoor permutation pairs","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-CLAWFREE-TDP"},{"evidence":"registry","id":"ASM-DLOG","keywords":["group","standard"],"metadata":{"aliases":["discrete logarithm","discrete logarithm in the Edwards-curve group"],"falsifiable":true,"family":"group","id":"ASM-DLOG","implied_by":["ASM-CDH","ASM-CO-CDH","ASM-QSDH","ASM-AOMDL","ASM-DSA-EUF"],"implied_by_records":[{"id":"ASM-CDH","name":"Computational Diffie-Hellman (CDH)"},{"id":"ASM-CO-CDH","name":"Computational co-Diffie-Hellman (co-CDH)"},{"id":"ASM-QSDH","name":"q-strong Diffie-Hellman (q-SDH)"},{"id":"ASM-AOMDL","name":"Algebraic one-more discrete logarithm (AOMDL)"},{"id":"ASM-DSA-EUF","name":"Unforgeability of DSA and ECDSA ((EC)DSA EUF-CMA)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},"kind":"standard","name":"Discrete logarithm (DL)","post_quantum":false,"references":[{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},{"citation":"Victor Shoup, Lower Bounds for Discrete Logarithms and Related Problems, EUROCRYPT 1997","url":"https://doi.org/10.1007/3-540-69053-0_18"},{"citation":"Peter W. Shor, Algorithms for Quantum Computation: Discrete Logarithms and Factoring, FOCS 1994","url":"https://doi.org/10.1109/SFCS.1994.365700"},{"citation":"Razvan Barbulescu, Pierrick Gaudry, Antoine Joux, Emmanuel Thomé, A Heuristic Quasi-Polynomial Algorithm for Discrete Logarithm in Finite Fields of Small Characteristic, EUROCRYPT 2014","url":"https://doi.org/10.1007/978-3-642-55220-5_1"},{"citation":"Taechan Kim and Razvan Barbulescu, Extended Tower Number Field Sieve: A New Complexity for the Medium Prime Case, CRYPTO 2016","url":"https://doi.org/10.1007/978-3-662-53018-4_20"},{"citation":"Razvan Barbulescu and Sylvain Duquesne, Updating Key Size Estimations for Pairings, J. Cryptology 32, 2019","url":"https://doi.org/10.1007/s00145-018-9280-5"}],"status":"As of 2026-10-10 discrete logarithms in well-chosen elliptic-curve groups need about \\( \\sqrt{p} \\) operations, finite-field discrete logarithms are subexponential (quasi-polynomial in small characteristic), the extended tower number field sieve (2016) lowered the security of common pairing curves, and Shor's algorithm solves all cases in quantum polynomial time."},"primaryUrl":"https://doi.org/10.1109/TIT.1976.1055638","sections":[{"content":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order\n\\( p \\) output by a group generator (a subgroup of \\( \\mathbb{F}_q^* \\), or the\ngroup of points of an elliptic curve such as Curve25519 or its twisted Edwards\nform used by Ed25519). The discrete logarithm assumption states that, given\n\\( g \\) and \\( h = g^{x} \\) for uniform \\( x \\in \\mathbb{Z}_p \\), no\nprobabilistic polynomial-time algorithm outputs \\( x \\) with non-negligible\nprobability.","heading":"Definition"},{"content":"Generic algorithms such as Pollard's rho need \\( \\Theta(\\sqrt p) \\) group\noperations, which is optimal for generic algorithms (Shoup 1997; Generic group model (GGM), including the generic bilinear group model). For\nelliptic curves chosen to avoid known weak classes (anomalous curves, curves of\nsmall embedding degree outside pairing use), nothing better than generic\nattacks is known. In finite fields, index-calculus and number-field-sieve\nalgorithms are subexponential, and in small characteristic Barbulescu, Gaudry,\nJoux and Thomé (2014) gave a heuristic quasi-polynomial algorithm. For pairing\ngroups the discrete logarithm in the target field \\( \\mathbb{F}_{q^k} \\) also\nmatters: the extended tower number field sieve (Kim and Barbulescu 2016)\nlowered the estimated security of Barreto-Naehrig curves over 254-bit fields\nfrom about 128 to about 100 bits, and Barbulescu and Duquesne (2019) updated\npairing key sizes accordingly. Shor (1994) computes discrete logarithms in any\ngroup in quantum polynomial time.","heading":"Status"},{"content":"Every Diffie-Hellman-type assumption implies DL, directly or\nthrough CDH (ASM-CDH): if DL is easy, CDH, DDH and their pairing and q-type\nvariants are easy. The one-more assumptions (One-more discrete logarithm (OMDL), Algebraic one-more discrete logarithm (AOMDL)) and\nunforgeability of (EC)DSA also imply DL. Schnorr signatures\n(`SIG-PAPER-1991-SCHNORR`) and Ed25519 (`SIG-PAPER-2011-ED25519`) are proven\nsecure from DL in the random oracle model. Proofs for threshold\nSchnorr signatures use a range of assumptions, for example AOMDL for Olaf\n(`[CGRS23]`) and DDH for Glacius (`[BDLR24]`).","heading":"Relations"}],"slug":"dlog","status":"registry","subtitle":"group","summary":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order \\( p \\) output by a group generator (a subgroup of \\( \\mathbb{F}_q^* \\), or the group of points of an elliptic curve such as Curve25519 or its twisted Edwards form used by Ed25519).","tags":["group","standard"],"title":"Discrete logarithm (DL)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-DLOG"},{"evidence":"registry","id":"ASM-GAPSVP","keywords":["lattice","standard"],"metadata":{"aliases":[],"falsifiable":true,"family":"lattice","id":"ASM-GAPSVP","implied_by":[],"implied_by_records":[],"implies":["ASM-SIS","ASM-LWE"],"implies_records":[{"id":"ASM-SIS","name":"Short integer solution (SIS)"},{"id":"ASM-LWE","name":"Learning with errors (LWE)"}],"introduced_in":{"citation":"Miklós Ajtai, Generating Hard Instances of Lattice Problems, STOC 1996","url":"https://doi.org/10.1145/237814.237838"},"kind":"standard","name":"Worst-case approximate lattice problems (GapSVP and SIVP)","post_quantum":true,"references":[{"citation":"Miklós Ajtai, Generating Hard Instances of Lattice Problems, STOC 1996","url":"https://doi.org/10.1145/237814.237838"},{"citation":"Daniele Micciancio and Oded Regev, Worst-Case to Average-Case Reductions Based on Gaussian Measures, SIAM J. Comput. 37(1), 2007","url":"https://doi.org/10.1137/S0097539705447360"},{"citation":"Oded Regev, On Lattices, Learning with Errors, Random Linear Codes, and Cryptography, J. ACM 56(6), 2009","url":"https://doi.org/10.1145/1568318.1568324"},{"citation":"Dorit Aharonov and Oded Regev, Lattice Problems in NP ∩ coNP, J. ACM 52(5), 2005","url":"https://doi.org/10.1145/1089023.1089025"},{"citation":"Subhash Khot, Hardness of Approximating the Shortest Vector Problem in Lattices, J. ACM 52(5), 2005","url":"https://doi.org/10.1145/1089023.1089027"},{"citation":"Ishay Haviv and Oded Regev, Tensor-Based Hardness of the Shortest Vector Problem to within Almost Polynomial Factors, STOC 2007","url":"https://doi.org/10.1145/1250790.1250859"},{"citation":"Yilei Chen, Quantum Algorithms for Lattice Problems, IACR ePrint 2024/555 (claim withdrawn, April 2024)","url":"https://eprint.iacr.org/2024/555"}],"status":"As of 2026-10-10 the best classical and quantum algorithms for GapSVP and SIVP with polynomial approximation factors take time \\( 2^{\\Theta(n)} \\); the April 2024 claim of a polynomial-time quantum algorithm (Chen) was withdrawn."},"primaryUrl":"https://doi.org/10.1145/237814.237838","sections":[{"content":"Let \\( \\mathcal{L} \\subset \\mathbb{R}^n \\) be a lattice given by a basis, let\n\\( \\lambda_1(\\mathcal{L}) \\) be the length of a shortest nonzero vector and\n\\( \\lambda_n(\\mathcal{L}) \\) the smallest \\( r \\) such that \\( \\mathcal{L} \\)\ncontains \\( n \\) linearly independent vectors of length at most \\( r \\). For an\napproximation factor \\( \\gamma(n) \\ge 1 \\):\n\n- \\( \\mathrm{GapSVP}_\\gamma \\): given a basis and a number \\( d \\), decide\n  whether \\( \\lambda_1(\\mathcal{L}) \\le d \\) or \\( \\lambda_1(\\mathcal{L}) > \\gamma d \\).\n- \\( \\mathrm{SIVP}_\\gamma \\): given a basis, output \\( n \\) linearly independent\n  lattice vectors of length at most \\( \\gamma \\lambda_n(\\mathcal{L}) \\).\n\nThe cryptographic assumption is that these problems are hard in the worst case\n(for every lattice) for some \\( \\gamma = \\mathrm{poly}(n) \\), against classical\nand quantum polynomial-time algorithms.","heading":"Definition"},{"content":"The best algorithms for polynomial \\( \\gamma \\) are lattice sieving,\nenumeration and block reduction (BKZ), with time \\( 2^{\\Theta(n)} \\); quantum\nspeed-ups known so far only improve the constant in the exponent. GapSVP is\nNP-hard for every constant factor under randomized reductions (Khot 2005) and\nfor factors \\( 2^{(\\log n)^{1-\\varepsilon}} \\) under quasi-polynomial randomized\nreductions (Haviv and Regev 2007). For \\( \\gamma = \\sqrt{n} \\) GapSVP lies in\n\\( \\mathrm{NP} \\cap \\mathrm{coNP} \\) (Aharonov and Regev 2005), so the\npolynomial factors used in cryptography are unlikely to be NP-hard.\n\nIn April 2024 Chen posted a claimed polynomial-time quantum algorithm for\nthese problems with large polynomial approximation factors; the author\nwithdrew the claim on 18 April 2024 after finding a bug.","heading":"Status"},{"content":"Worst-case hardness of these problems implies average-case hardness of SIS\n(ASM-SIS) by classical reductions (Ajtai 1996; Micciancio and Regev 2007,\n`SIG-PAPER-2008-GPV`) and of LWE by a quantum reduction (Regev\n2005), which is classical for GapSVP under the moduli conditions described on\nLearning with errors (LWE). Restricting the lattices to ideal or module lattices gives the\nstructured problems behind Ring-SIS, Ring-LWE, Module-SIS and Module-LWE; hardness of the general problem does not imply hardness of\nthe structured ones.","heading":"Relations"}],"slug":"gapsvp","status":"registry","subtitle":"lattice","summary":"Let \\( \\mathcal{L} \\subset \\mathbb{R}^n \\) be a lattice given by a basis, let \\( \\lambda_1(\\mathcal{L}) \\) be the length of a shortest nonzero vector and \\( \\lambda_n(\\mathcal{L}) \\) the smallest \\( r \\) such that \\( \\mathcal{L} \\) contains \\( n \\) linearly independent vectors of length at most \\( r \\).","tags":["lattice","standard"],"title":"Worst-case approximate lattice problems (GapSVP and SIVP)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-GAPSVP"},{"evidence":"registry","id":"ASM-HASH-SPR","keywords":["hash","standard"],"metadata":{"aliases":[],"falsifiable":true,"family":"hash","id":"ASM-HASH-SPR","implied_by":[],"implied_by_records":[],"implies":[],"implies_records":[],"introduced_in":{"citation":"Moni Naor and Moti Yung, Universal One-Way Hash Functions and their Cryptographic Applications, STOC 1989","url":"https://doi.org/10.1145/73007.73011"},"kind":"standard","name":"Second-preimage and target-collision resistance of hash functions (multi-target variants)","post_quantum":true,"references":[{"citation":"Moni Naor and Moti Yung, Universal One-Way Hash Functions and their Cryptographic Applications, STOC 1989","url":"https://doi.org/10.1145/73007.73011"},{"citation":"Andreas Hülsing, Joost Rijneveld, Fang Song, Mitigating Multi-target Attacks in Hash-Based Signatures, PKC 2016","url":"https://doi.org/10.1007/978-3-662-49384-7_15"},{"citation":"Daniel J. Bernstein, Andreas Hülsing, Stefan Kölbl, Ruben Niederhagen, Joost Rijneveld, Peter Schwabe, The SPHINCS+ Signature Framework, ACM CCS 2019","url":"https://doi.org/10.1145/3319535.3363229"},{"citation":"Daniel J. Bernstein and Andreas Hülsing, Decisional Second-Preimage Resistance: When Does SPR Imply PRE?, ASIACRYPT 2019","url":"https://doi.org/10.1007/978-3-030-34618-8_2"},{"citation":"Andreas Hülsing and Mikhail Kudinov, Recovering the Tight Security Proof of SPHINCS+, IACR ePrint 2022/346","url":"https://eprint.iacr.org/2022/346"},{"citation":"NIST, FIPS 205: Stateless Hash-Based Digital Signature Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.205"}],"status":"As of 2026-10-10 no second-preimage or target-collision attack better than generic search is known for full SHA-2 or SHA-3/SHAKE; quantum search reduces generic n-bit second-preimage cost to about \\( 2^{n/2} \\)."},"primaryUrl":"https://doi.org/10.1145/73007.73011","sections":[{"content":"Let \\( H_k : \\{0,1\\}^{*} \\to \\{0,1\\}^{n} \\) be a keyed hash function family.\n\n- Second-preimage resistance (SPR): given a key \\( k \\) and a uniformly random\n  input \\( x \\), it is hard to find \\( x' \\ne x \\) with \\( H_k(x') = H_k(x) \\).\n- Target-collision resistance (TCR, universal one-wayness): an adversary first\n  commits to \\( x \\), then receives a random \\( k \\), and must find\n  \\( x' \\ne x \\) with \\( H_k(x') = H_k(x) \\).\n\nMulti-target variants give the adversary many targets at once and count a\nsuccess on any of them; tweakable variants add a public tweak (an address in a\nhash tree) to each call so that targets cannot be attacked jointly. SPHINCS+\nand SLH-DSA use single-function multi-target undetectability, TCR and\ndecisional SPR of a tweakable hash function, together with PRF security (ASM-PRF) of the key and\nrandomizer derivation and interleaved-target subset resilience of the message\nhash. In practice \\( H \\) is instantiated with SHA-2 or SHAKE.","heading":"Definition"},{"content":"No attack faster than generic search is known for second preimages or target\ncollisions in full SHA-256, SHA-512 or SHA-3/SHAKE. Multi-target security\ndegrades generically by the number of targets unless tweaks separate them,\nwhich is the reason for the tweakable design (Hülsing, Rijneveld and Song\n2016). The 2019 tight security proof of SPHINCS+ had a gap in its WOTS part,\nidentified in 2020; Hülsing and Kudinov (2022) gave a corrected tight proof\nwith an additional loss factor equal to the Winternitz parameter (commonly 16).\nFIPS 205 standardized SLH-DSA (`SIG-PAPER-2024-FIPS205`), derived from\n`SIG-PAPER-2019-SPHINCSPLUS`, in August 2024.","heading":"Status"},{"content":"Collision resistance implies second-preimage resistance for sufficiently\ncompressing functions, but hash-based signatures deliberately avoid relying on\ncollision resistance, whose generic cost is only \\( 2^{n/2} \\). Bernstein and\nHülsing (2019) relate decisional SPR to preimage resistance. These properties\nare used in the random oracle model or in the standard model\ndepending on the component.","heading":"Relations"}],"slug":"hash-spr","status":"registry","subtitle":"hash","summary":"Let \\( H_k : \\{0,1\\}^{*} \\to \\{0,1\\}^{n} \\) be a keyed hash function family.","tags":["hash","standard"],"title":"Second-preimage and target-collision resistance of hash functions (multi-target variants)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-HASH-SPR"},{"evidence":"registry","id":"ASM-MLWE","keywords":["lattice","standard"],"metadata":{"aliases":["Module-LWE"],"falsifiable":true,"family":"lattice","id":"ASM-MLWE","implied_by":["ASM-HINT-MLWE"],"implied_by_records":[{"id":"ASM-HINT-MLWE","name":"Module learning with errors with hints (Hint-MLWE)"}],"implies":["ASM-MSIS","ASM-HINT-MLWE"],"implies_records":[{"id":"ASM-MSIS","name":"Module short integer solution (Module-SIS)"},{"id":"ASM-HINT-MLWE","name":"Module learning with errors with hints (Hint-MLWE)"}],"introduced_in":{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},"kind":"standard","name":"Module learning with errors (Module-LWE)","post_quantum":true,"references":[{"citation":"Zvika Brakerski, Craig Gentry, Vinod Vaikuntanathan, (Leveled) Fully Homomorphic Encryption without Bootstrapping, ITCS 2012","url":"https://doi.org/10.1145/2090236.2090262"},{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},{"citation":"NIST, FIPS 203: Module-Lattice-Based Key-Encapsulation Mechanism Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.203"},{"citation":"NIST, FIPS 204: Module-Lattice-Based Digital Signature Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.204"}],"status":"As of 2026-10-10 no attack on Module-LWE with the parameters of ML-KEM (FIPS 203) or ML-DSA (FIPS 204), both published on 13 August 2024, is known to beat generic lattice reduction."},"primaryUrl":"https://doi.org/10.1007/s10623-014-9938-4","sections":[{"content":"Let \\( R = \\mathbb{Z}[x]/(x^n + 1) \\) (or another ring of integers of degree\n\\( n \\)), \\( R_q = R/qR \\), and let \\( d \\ge 1 \\) be the module rank. For a\nsecret \\( s \\in R_q^{d} \\), a sample is\n\n\\[\n(a, \\; b = \\langle a, s \\rangle + e) \\in R_q^{d} \\times R_q, \\qquad a \\leftarrow R_q^{d},\\; e \\leftarrow \\chi ,\n\\]\n\nwith \\( \\chi \\) a narrow error distribution on \\( R \\) (in ML-KEM, a centered\nbinomial distribution). Search Module-LWE asks for \\( s \\); decision Module-LWE\nasks to distinguish samples from uniform. With \\( d = 1 \\) this is Ring-LWE; with \\( n = 1 \\) and \\( R = \\mathbb{Z} \\) it is LWE in\ndimension \\( d \\).","heading":"Definition"},{"content":"Langlois and Stehlé (2015) gave worst-case to average-case reductions for\nmodule lattices, from approximate SVP on module lattices of rank \\( d \\) to\nModule-LWE (quantum) and to Module-SIS (classical). Module-LWE is the hardness\nassumption of ML-KEM (`[NIST24/FIPS203]`, derived from\n`[BDK+17]`) and, together with Module-SIS, of ML-DSA\n(`SIG-PAPER-2024-FIPS204`, derived from `SIG-PAPER-2018-DILITHIUM`). Concrete\nsecurity of these parameter sets is estimated by primal and dual lattice\nattacks, treating the module structure as giving no extra advantage; no\nalgebraic attack exploiting the module structure is known for these rings.","heading":"Status"},{"content":"Module-LWE interpolates between LWE and Ring-LWE. Brakerski, Gentry and\nVaikuntanathan (2012) had already defined a general LWE problem (GLWE)\ncovering both, without studying the intermediate ranks. Module-LWE with\nmatching parameters implies Module-SIS (ASM-MSIS) by the same argument as for\nLWE and SIS. Hint-MLWE, which reveals additional noisy linear\ninformation about the secret, implies Module-LWE trivially and is reduced to\nModule-LWE for suitable parameters by its authors.","heading":"Relations"}],"slug":"mlwe","status":"registry","subtitle":"lattice","summary":"Let \\( R = \\mathbb{Z}[x]/(x^n + 1) \\) (or another ring of integers of degree \\( n \\)), \\( R_q = R/qR \\), and let \\( d \\ge 1 \\) be the module rank.","tags":["lattice","standard"],"title":"Module learning with errors (Module-LWE)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-MLWE"},{"evidence":"registry","id":"ASM-MSIS","keywords":["lattice","standard"],"metadata":{"aliases":["module-sis"],"falsifiable":true,"family":"lattice","id":"ASM-MSIS","implied_by":["ASM-MLWE"],"implied_by_records":[{"id":"ASM-MLWE","name":"Module learning with errors (Module-LWE)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},"kind":"standard","name":"Module short integer solution (Module-SIS)","post_quantum":true,"references":[{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},{"citation":"NIST, FIPS 204: Module-Lattice-Based Digital Signature Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.204"}],"status":"As of 2026-10-10 no attack on Module-SIS with the parameters of ML-DSA (FIPS 204, August 2024) is known to beat generic lattice reduction."},"primaryUrl":"https://doi.org/10.1007/s10623-014-9938-4","sections":[{"content":"Let \\( R_q = \\mathbb{Z}_q[x]/(x^n + 1) \\). Given a uniformly random matrix\n\\( A \\in R_q^{k \\times \\ell} \\), find a nonzero \\( z \\in R^{\\ell} \\) with\n\n\\[\nA z \\equiv 0 \\pmod q, \\qquad \\lVert z \\rVert \\le \\beta ,\n\\]\n\nfor a norm bound \\( \\beta \\) (Euclidean or infinity norm, depending on the\napplication). In Dilithium-style schemes the matrix is written\n\\( [A \\mid I] \\) and the solution is split accordingly.","heading":"Definition"},{"content":"Langlois and Stehlé (2015) reduce worst-case approximate SVP on module lattices\nto Module-SIS by a classical reduction. Module-SIS, together with Module-LWE,\nunderlies ML-DSA (`SIG-PAPER-2024-FIPS204`) and the threshold and two-party\nvariants in `[DOTT21]`, `[LSV22]` and\n`[TPCZ23]`, and the lattice polynomial commitments of\n`[CMNW24]`. Concrete security is estimated with BKZ-based\nshort-vector attacks on the corresponding \\( n\\ell \\)-dimensional lattice.","heading":"Status"},{"content":"Module-SIS is the module analogue of SIS (ASM-SIS); with \\( k = 1 \\) it is\nRing-SIS (ASM-RSIS). Module-LWE (ASM-MLWE) with matching parameters implies\nModule-SIS. SelfTargetMSIS, used for Fiat-Shamir\nsignatures in the quantum random oracle model, is a hash-dependent variant\nthat reduces to Module-SIS only in the classical random oracle model.","heading":"Relations"}],"slug":"msis","status":"registry","subtitle":"lattice","summary":"Let \\( R_q = \\mathbb{Z}_q[x]/(x^n + 1) \\).","tags":["lattice","standard"],"title":"Module short integer solution (Module-SIS)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-MSIS"},{"evidence":"registry","id":"ASM-NTRU","keywords":["lattice","standard"],"metadata":{"aliases":[],"falsifiable":true,"family":"lattice","id":"ASM-NTRU","implied_by":[],"implied_by_records":[],"implies":[],"implies_records":[],"introduced_in":{"citation":"Jeffrey Hoffstein, Jill Pipher, Joseph H. Silverman, NTRU: A Ring-Based Public Key Cryptosystem, ANTS-III 1998","url":"https://doi.org/10.1007/BFb0054868"},"kind":"standard","name":"NTRU assumption (NTRU)","post_quantum":true,"references":[{"citation":"Jeffrey Hoffstein, Jill Pipher, Joseph H. Silverman, NTRU: A Ring-Based Public Key Cryptosystem, ANTS-III 1998","url":"https://doi.org/10.1007/BFb0054868"},{"citation":"Damien Stehlé and Ron Steinfeld, Making NTRU as Secure as Worst-Case Problems over Ideal Lattices, EUROCRYPT 2011","url":"https://doi.org/10.1007/978-3-642-20465-4_4"},{"citation":"Martin Albrecht, Shi Bai, Léo Ducas, A Subfield Lattice Attack on Overstretched NTRU Assumptions, CRYPTO 2016","url":"https://doi.org/10.1007/978-3-662-53018-4_6"},{"citation":"Paul Kirchner and Pierre-Alain Fouque, Revisiting Lattice Attacks on Overstretched NTRU Parameters, EUROCRYPT 2017","url":"https://doi.org/10.1007/978-3-319-56620-7_1"},{"citation":"Pierre-Alain Fouque et al., Falcon: Fast-Fourier Lattice-based Compact Signatures over NTRU, Specification v1.2, NIST PQC submission, 2020","url":"https://falcon-sign.info/falcon.pdf"}],"status":"As of 2026-10-10 NTRU with small modulus, as in NTRU encryption and the Falcon signature, has no known attack beyond lattice reduction; NTRU with a large (\"overstretched\") modulus relative to the secret size, as used in early NTRU-based homomorphic encryption, is broken by subfield and dense-sublattice attacks (2016-2017)."},"primaryUrl":"https://doi.org/10.1007/BFb0054868","sections":[{"content":"Let \\( R = \\mathbb{Z}[x]/(\\phi(x)) \\) with \\( \\phi = x^n - 1 \\) in the original\nscheme or \\( \\phi = x^n + 1 \\) in later ones, and \\( R_q = R/qR \\). Sample\n\\( f, g \\in R \\) with small coefficients, \\( f \\) invertible modulo \\( q \\), and\nset\n\n\\[\nh = g \\cdot f^{-1} \\bmod q .\n\\]\n\nSearch NTRU asks to recover a short pair \\( (f', g') \\) with\n\\( h f' \\equiv g' \\pmod q \\) (for example \\( (f, g) \\) itself) given \\( h \\).\nDecision NTRU asks to distinguish \\( h \\) from a uniformly random element of\n\\( R_q \\). Both are problems about the NTRU lattice\n\\( \\{ (u, v) \\in R^2 : h u \\equiv v \\bmod q \\} \\), which contains the unusually\nshort vector \\( (f, g) \\).","heading":"Definition"},{"content":"For the parameters of NTRU encryption and of Falcon (\\( q = 12289 \\)), the best\nknown attacks are lattice reduction and hybrid lattice/meet-in-the-middle\nattacks. When \\( q \\) is very large compared with the size of \\( f \\) and\n\\( g \\), the NTRU lattice contains a dense sublattice that reduction finds much\nearlier than the short vector analysis predicts: Albrecht, Bai and Ducas\n(2016) broke the NTRU-based homomorphic encryption schemes LTV and YASHE and\nNTRU-type multilinear-map parameters with a subfield attack, and stated that\nthe attack does not apply to small moduli such as those of NTRU encryption;\nKirchner and Fouque (2017) sharpened the analysis and broke concrete YASHE\ninstances. These attacks define the \"overstretched\" regime to be avoided.","heading":"Status"},{"content":"Decision NTRU with uniform-looking public keys lets one replace \\( h \\) by a\nuniform ring element; Falcon (`SIG-PAPER-2020-FALCON`) instantiates the\nGPV hash-and-sign framework over NTRU lattices, and its specification states\nthe underlying problem as SIS over NTRU lattices, i.e. Ring-SIS (ASM-RSIS) for\nthe specific matrix \\( [1 \\mid h] \\). For the small secrets used in practice,\nNTRU is not known to be implied by Ring-LWE; Stehlé and Steinfeld\n(2011) showed that with much wider key distributions the public key is\nstatistically close to uniform, which gives an NTRU variant whose security\nfollows from Ring-LWE.","heading":"Relations"}],"slug":"ntru","status":"registry","subtitle":"lattice","summary":"Let \\( R = \\mathbb{Z}[x]/(\\phi(x)) \\) with \\( \\phi = x^n - 1 \\) in the original scheme or \\( \\phi = x^n + 1 \\) in later ones, and \\( R_q = R/qR \\).","tags":["lattice","standard"],"title":"NTRU assumption (NTRU)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-NTRU"},{"evidence":"registry","id":"ASM-PRF","keywords":["symmetric","standard"],"metadata":{"aliases":["Pseudorandom functions","pseudorandom-function"],"falsifiable":true,"family":"symmetric","id":"ASM-PRF","implied_by":["ASM-PRG","ASM-AES-PRP","ASM-CHACHA20"],"implied_by_records":[{"id":"ASM-PRG","name":"Pseudorandom generators (PRG)"},{"id":"ASM-AES-PRP","name":"AES as a pseudorandom permutation (AES PRP)"},{"id":"ASM-CHACHA20","name":"ChaCha20 block function as a PRF (ChaCha20)"}],"implies":["ASM-PRG"],"implies_records":[{"id":"ASM-PRG","name":"Pseudorandom generators (PRG)"}],"introduced_in":{"citation":"Oded Goldreich, Shafi Goldwasser, Silvio Micali, How to Construct Random Functions, J. ACM 33(4), 1986 (FOCS 1984)","url":"https://doi.org/10.1145/6490.6503"},"kind":"standard","name":"Pseudorandom functions (PRF)","post_quantum":true,"references":[{"citation":"Oded Goldreich, Shafi Goldwasser, Silvio Micali, How to Construct Random Functions, J. ACM 33(4), 1986","url":"https://doi.org/10.1145/6490.6503"},{"citation":"Johan Håstad, Russell Impagliazzo, Leonid A. Levin, Michael Luby, A Pseudorandom Generator from any One-way Function, SIAM J. Comput. 28(4), 1999","url":"https://doi.org/10.1137/S0097539793244708"},{"citation":"Mark Zhandry, How to Construct Quantum Random Functions, FOCS 2012; J. ACM 2021","url":"https://doi.org/10.1109/FOCS.2012.37"}],"status":"As of 2026-10-10 PRFs exist if and only if one-way functions exist, the Goldreich-Goldwasser-Micali construction is secure against quantum queries, and practical instantiations (AES, ChaCha20, SHA-2/SHA-3-based PRFs) have no known attacks on full rounds."},"primaryUrl":"https://doi.org/10.1145/6490.6503","sections":[{"content":"A keyed function family \\( F : \\{0,1\\}^{\\lambda} \\times \\{0,1\\}^{n} \\to\n\\{0,1\\}^{m} \\) is a pseudorandom function if, for a uniformly random key\n\\( k \\), no probabilistic polynomial-time adversary with oracle access to\n\\( F(k, \\cdot) \\) distinguishes it from a uniformly random function\n\\( \\{0,1\\}^n \\to \\{0,1\\}^m \\) with non-negligible advantage. Quantum-secure\nPRFs require indistinguishability even when the adversary queries the oracle\nin superposition.\n\nAs used in topic results, the assumption is that some efficient PRF exists,\ntypically instantiated with a block cipher, a stream-cipher core, or a hash\nfunction in a keyed mode.","heading":"Definition"},{"content":"Goldreich, Goldwasser and Micali (1984) built PRFs from any length-doubling\npseudorandom generator; with Håstad, Impagliazzo, Levin and Luby\n(1999) this shows PRFs exist if and only if one-way functions exist. Zhandry\n(2012) proved the GGM construction secure against quantum superposition\nqueries when the underlying generator is quantum-secure. For concrete\ninstantiations, see AES and ChaCha20.","heading":"Status"},{"content":"PRFs and PRGs imply each other. Concrete primitives modelled as PRFs (AES via\nthe PRP/PRF switching lemma, the ChaCha20 block function) imply that PRFs\nexist. PRFs are the assumption behind client-preprocessing PIR such as\n`[ZPSZ24]` and `[LP24]`, behind the\nsymmetric-key pseudorandom correlation functions of `[IKR26]`,\nand behind the PRF and PRF_msg components of SPHINCS+ (`SIG-PAPER-2019-SPHINCSPLUS`).","heading":"Relations"}],"slug":"prf","status":"registry","subtitle":"symmetric","summary":"A keyed function family \\( F : \\{0,1\\}^{\\lambda} \\times \\{0,1\\}^{n} \\to \\{0,1\\}^{m} \\) is a pseudorandom function if, for a uniformly random key \\( k \\), no probabilistic polynomial-time adversary with oracle access to \\( F(k, \\cdot) \\) distinguishes it from a uniformly random function \\( \\{0,1\\}^n \\to \\{0,1\\}^m \\) with non-negligible advantage.","tags":["symmetric","standard"],"title":"Pseudorandom functions (PRF)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-PRF"},{"evidence":"registry","id":"ASM-QSDH","keywords":["pairing","parameterized"],"metadata":{"aliases":["q-strong Diffie-Hellman"],"falsifiable":true,"family":"pairing","id":"ASM-QSDH","implied_by":[],"implied_by_records":[],"implies":["ASM-DLOG"],"implies_records":[{"id":"ASM-DLOG","name":"Discrete logarithm (DL)"}],"introduced_in":{"citation":"Dan Boneh and Xavier Boyen, Short Signatures Without Random Oracles, EUROCRYPT 2004; J. Cryptology 21, 2008","url":"https://doi.org/10.1007/978-3-540-24676-3_4"},"kind":"parameterized","name":"q-strong Diffie-Hellman (q-SDH)","post_quantum":false,"references":[{"citation":"Dan Boneh and Xavier Boyen, Short Signatures Without Random Oracles, EUROCRYPT 2004","url":"https://doi.org/10.1007/978-3-540-24676-3_4"},{"citation":"Dan Boneh and Xavier Boyen, Short Signatures Without Random Oracles and the SDH Assumption in Bilinear Groups, J. Cryptology 21, 2008","url":"https://doi.org/10.1007/s00145-007-9005-7"},{"citation":"Jung Hee Cheon, Security Analysis of the Strong Diffie-Hellman Problem, EUROCRYPT 2006","url":"https://doi.org/10.1007/11761679_1"}],"status":"As of 2026-10-10 q-SDH holds in the generic bilinear group model, but Cheon (2006) showed that the secret can be recovered about \\( \\sqrt{d} \\) times faster than generic discrete logarithms when some \\( d \\le q \\) divides \\( p - 1 \\) (with a weaker gain for divisors of \\( p + 1 \\)); it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/978-3-540-24676-3_4","sections":[{"content":"Let \\( (\\mathbb{G}_1, \\mathbb{G}_2) \\) be groups of prime order \\( p \\) with\ngenerators \\( g_1, g_2 \\) and a bilinear map. Given\n\n\\[\n\\big(g_1, g_1^{x}, g_1^{x^2}, \\dots, g_1^{x^q}, \\; g_2, g_2^{x}\\big)\n\\]\n\nfor uniform \\( x \\in \\mathbb{Z}_p^* \\), the q-SDH assumption states that no\nprobabilistic polynomial-time algorithm outputs a pair\n\\( \\big(c, g_1^{1/(x + c)}\\big) \\) with \\( c \\in \\mathbb{Z}_p \\setminus \\{-x\\} \\)\nwith non-negligible probability. The output is a \"fresh\" inversion; the\nadversary chooses \\( c \\).","heading":"Definition"},{"content":"Boneh and Boyen (2004) introduced q-SDH for short signatures without random\noracles and gave a generic-group lower bound; the journal version notes that\nMitsunari, Sakai and Kasahara had earlier used a weaker related assumption.\nCheon (2006) showed, and the journal version of Boneh and Boyen notes that\nBrown and Gallant independently obtained a similar result, that if\n\\( d \\mid p - 1 \\) for some \\( d \\le q \\), the secret \\( x \\) can be found in about\n\\( \\sqrt{p/d} + \\sqrt{d} \\) operations, and in about \\( \\sqrt{p/d} + d \\) if\n\\( d \\mid p + 1 \\). Parameters for q-SDH-based schemes must account for this\nloss or choose \\( p \\) so that \\( p \\pm 1 \\) has no suitable divisors.","heading":"Status"},{"content":"q-SDH implies DL (ASM-DLOG). It is the assumption of the Boneh-Boyen signature\n(`SIG-PAPER-2004-BB`) and, in the form used for polynomial commitments, of the\nevaluation binding of KZG commitments (`[KZG10]`). It differs from\nthe decisional q-type assumptions Decisional q-bilinear Diffie-Hellman exponent (q-BDHE) and Decisional q-parallel bilinear Diffie-Hellman exponent (q-parallel BDHE) in being a\ncomputational, adversary-chosen-output assumption, but it is subject to the\nsame auxiliary-input attack.","heading":"Relations"}],"slug":"qsdh","status":"registry","subtitle":"pairing","summary":"Let \\( (\\mathbb{G}_1, \\mathbb{G}_2) \\) be groups of prime order \\( p \\) with generators \\( g_1, g_2 \\) and a bilinear map.","tags":["pairing","parameterized"],"title":"q-strong Diffie-Hellman (q-SDH)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-QSDH"},{"evidence":"registry","id":"ASM-RSA","keywords":["factoring","standard"],"metadata":{"aliases":["RSA inversion"],"falsifiable":true,"family":"factoring","id":"ASM-RSA","implied_by":["ASM-STRONG-RSA"],"implied_by_records":[{"id":"ASM-STRONG-RSA","name":"Strong RSA assumption (strong RSA)"}],"implies":["ASM-FACTORING","ASM-TDP"],"implies_records":[{"id":"ASM-FACTORING","name":"Integer factorization (factoring)"},{"id":"ASM-TDP","name":"Trapdoor one-way permutations (TDP)"}],"introduced_in":{"citation":"Ronald L. Rivest, Adi Shamir, Leonard Adleman, A Method for Obtaining Digital Signatures and Public-Key Cryptosystems, Commun. ACM 21(2), 1978","url":"https://doi.org/10.1145/359340.359342"},"kind":"standard","name":"RSA assumption (RSA)","post_quantum":false,"references":[{"citation":"Ronald L. Rivest, Adi Shamir, Leonard Adleman, A Method for Obtaining Digital Signatures and Public-Key Cryptosystems, Commun. ACM 21(2), 1978","url":"https://doi.org/10.1145/359340.359342"},{"citation":"Dan Boneh and Ramarathnam Venkatesan, Breaking RSA May Not Be Equivalent to Factoring, EUROCRYPT 1998","url":"https://doi.org/10.1007/BFb0054117"},{"citation":"Divesh Aggarwal and Ueli Maurer, Breaking RSA Generically Is Equivalent to Factoring, EUROCRYPT 2009","url":"https://doi.org/10.1007/978-3-642-01001-9_2"},{"citation":"Michael J. Wiener, Cryptanalysis of Short RSA Secret Exponents, IEEE Trans. Inf. Theory 36(3), 1990","url":"https://doi.org/10.1109/18.54902"},{"citation":"Dan Boneh and Glenn Durfee, Cryptanalysis of RSA with Private Key d Less than N^0.292, EUROCRYPT 1999","url":"https://doi.org/10.1007/3-540-48910-X_1"}],"status":"As of 2026-10-10 no way to invert RSA with properly generated keys is known other than factoring the modulus; it is broken in quantum polynomial time by Shor's algorithm, and it is open whether RSA is as hard as factoring."},"primaryUrl":"https://doi.org/10.1145/359340.359342","sections":[{"content":"Let \\( N = pq \\) be a product of two random primes of equal length and let\n\\( e \\) be an exponent with \\( \\gcd(e, \\varphi(N)) = 1 \\) (fixed small values\nsuch as \\( e = 65537 \\), or random). The RSA assumption states that, given\n\\( (N, e) \\) and a uniformly random \\( y \\in \\mathbb{Z}_N^* \\), no\nprobabilistic polynomial-time algorithm computes \\( x \\) with\n\n\\[\nx^{e} \\equiv y \\pmod N\n\\]\n\nwith non-negligible probability. The function \\( x \\mapsto x^e \\bmod N \\) is a\npermutation of \\( \\mathbb{Z}_N^* \\) with trapdoor \\( d = e^{-1} \\bmod \\varphi(N) \\).","heading":"Definition"},{"content":"Factoring \\( N \\) breaks RSA, and no better general attack is known; Integer factorization (factoring)\ndescribes the current factoring frontier and\nShor's quantum algorithm. Whether RSA inversion is as hard as factoring is\nopen: Boneh and Venkatesan (1998) show that for small \\( e \\) an algebraic\nreduction from factoring is unlikely, while Aggarwal and Maurer (2009) show\nthat breaking RSA with generic ring algorithms is equivalent to factoring.\nAttacks on key generation choices, such as a small private exponent\n\\( d < N^{0.292} \\) (Wiener 1990; Boneh and Durfee 1999), or on unpadded use\nwith small \\( e \\), concern parameter or usage choices rather than the\nassumption itself.","heading":"Status"},{"content":"RSA implies factoring and gives a candidate trapdoor permutation.\nStrong RSA (ASM-STRONG-RSA), where the adversary may choose the exponent,\nimplies RSA. RSA-OAEP (`[BR94]`), RSA-PSS (`SIG-PAPER-1996-PSS`)\nand Shoup's threshold RSA (`[Shoup00]`) are proven secure from RSA\nin the random oracle model.","heading":"Relations"}],"slug":"rsa","status":"registry","subtitle":"factoring","summary":"Let \\( N = pq \\) be a product of two random primes of equal length and let \\( e \\) be an exponent with \\( \\gcd(e, \\varphi(N)) = 1 \\) (fixed small values such as \\( e = 65537 \\), or random).","tags":["factoring","standard"],"title":"RSA assumption (RSA)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-RSA"},{"evidence":"registry","id":"ASM-RSIS","keywords":["lattice","standard"],"metadata":{"aliases":["Ring-SIS (SIS over ideal lattices)"],"falsifiable":true,"family":"lattice","id":"ASM-RSIS","implied_by":["ASM-IDEAL-SVP","ASM-RLWE"],"implied_by_records":[{"id":"ASM-IDEAL-SVP","name":"Worst-case approximate SVP on ideal lattices (Ideal-SVP)"},{"id":"ASM-RLWE","name":"Ring learning with errors (Ring-LWE)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Vadim Lyubashevsky and Daniele Micciancio, Generalized Compact Knapsacks Are Collision Resistant, ICALP 2006","url":"https://doi.org/10.1007/11787006_13"},"kind":"standard","name":"Ring short integer solution (Ring-SIS)","post_quantum":true,"references":[{"citation":"Daniele Micciancio, Generalized Compact Knapsacks, Cyclic Lattices, and Efficient One-Way Functions, Computational Complexity 16(4), 2007 (FOCS 2002)","url":"https://doi.org/10.1007/s00037-007-0234-9"},{"citation":"Vadim Lyubashevsky and Daniele Micciancio, Generalized Compact Knapsacks Are Collision Resistant, ICALP 2006","url":"https://doi.org/10.1007/11787006_13"},{"citation":"Chris Peikert and Alon Rosen, Efficient Collision-Resistant Hashing from Worst-Case Assumptions on Cyclic Lattices, TCC 2006","url":"https://doi.org/10.1007/11681878_8"}],"status":"As of 2026-10-10 no attack on Ring-SIS over rings with irreducible defining polynomial (such as \\( x^n + 1 \\)) is known to beat generic lattice reduction; over \\( \\mathbb{Z}[x]/(x^n - 1) \\) the problem is easy, which is why that ring is excluded."},"primaryUrl":"https://doi.org/10.1007/11787006_13","sections":[{"content":"Let \\( R = \\mathbb{Z}[x]/(f(x)) \\) with \\( f \\) monic, irreducible and of degree\n\\( n \\) (the standard choice is \\( f = x^n + 1 \\) with \\( n \\) a power of two),\nand \\( R_q = R/qR \\). Given \\( m \\) uniformly random elements\n\\( a_1, \\dots, a_m \\in R_q \\), find \\( z_1, \\dots, z_m \\in R \\), not all zero,\nwith\n\n\\[\n\\sum_{i=1}^{m} a_i z_i \\equiv 0 \\pmod q, \\qquad \\lVert (z_1, \\dots, z_m) \\rVert \\le \\beta .\n\\]\n\nEquivalently, find a collision in the compact knapsack function\n\\( (z_i) \\mapsto \\sum_i a_i z_i \\) restricted to short inputs.","heading":"Definition"},{"content":"Micciancio (2002) showed one-wayness of the compact knapsack from worst-case\nproblems on cyclic lattices. Lyubashevsky and Micciancio (2006) and,\nindependently, Peikert and Rosen (2006) showed that the knapsack is\ncollision resistant, i.e. that Ring-SIS is hard on average, assuming the\nworst-case hardness of approximate SVP on ideal lattices in \\( R \\) for\nirreducible \\( f \\); for \\( f = x^n - 1 \\) collisions are easy to find, which\nshows that the irreducibility condition is needed. Attacks on cryptographic\nparameters use generic lattice reduction.","heading":"Status"},{"content":"Worst-case Ideal-SVP hardness implies Ring-SIS by classical\nreductions. Ring-LWE with matching parameters implies Ring-SIS.\nRing-SIS is the rank-1 case of Module-SIS (ASM-MSIS) and the ring analogue of\nSIS (ASM-SIS). The Falcon signature (`SIG-PAPER-2020-FALCON`) relies on SIS over\nNTRU lattices, which combines Ring-SIS with the NTRU assumption (ASM-NTRU);\nthe two-round threshold signature `[GKS23]` relies on Ring-LWE and\nRing-SIS.","heading":"Relations"}],"slug":"rsis","status":"registry","subtitle":"lattice","summary":"Let \\( R = \\mathbb{Z}[x]/(f(x)) \\) with \\( f \\) monic, irreducible and of degree \\( n \\) (the standard choice is \\( f = x^n + 1 \\) with \\( n \\) a power of two), and \\( R_q = R/qR \\).","tags":["lattice","standard"],"title":"Ring short integer solution (Ring-SIS)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-RSIS"},{"evidence":"registry","id":"ASM-SIS","keywords":["lattice","standard"],"metadata":{"aliases":[],"falsifiable":true,"family":"lattice","id":"ASM-SIS","implied_by":["ASM-GAPSVP","ASM-LWE"],"implied_by_records":[{"id":"ASM-GAPSVP","name":"Worst-case approximate lattice problems (GapSVP and SIVP)"},{"id":"ASM-LWE","name":"Learning with errors (LWE)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Miklós Ajtai, Generating Hard Instances of Lattice Problems, STOC 1996","url":"https://doi.org/10.1145/237814.237838"},"kind":"standard","name":"Short integer solution (SIS)","post_quantum":true,"references":[{"citation":"Miklós Ajtai, Generating Hard Instances of Lattice Problems, STOC 1996","url":"https://doi.org/10.1145/237814.237838"},{"citation":"Daniele Micciancio and Oded Regev, Worst-Case to Average-Case Reductions Based on Gaussian Measures, SIAM J. Comput. 37(1), 2007","url":"https://doi.org/10.1137/S0097539705447360"},{"citation":"Craig Gentry, Chris Peikert, Vinod Vaikuntanathan, Trapdoors for Hard Lattices and New Cryptographic Constructions, STOC 2008","url":"https://doi.org/10.1145/1374376.1374407"}],"status":"As of 2026-10-10 no attack better than lattice reduction in time \\( 2^{\\Theta(n)} \\) is known for SIS with norm bounds covered by the worst-case reductions."},"primaryUrl":"https://doi.org/10.1145/237814.237838","sections":[{"content":"Fix \\( n \\), a modulus \\( q \\), a width \\( m \\ge n \\log q \\) and a norm bound\n\\( \\beta < q \\). Given a uniformly random matrix\n\\( A \\in \\mathbb{Z}_q^{n \\times m} \\), find a nonzero integer vector\n\\( z \\in \\mathbb{Z}^m \\) with\n\n\\[\nA z \\equiv 0 \\pmod q, \\qquad \\lVert z \\rVert \\le \\beta .\n\\]\n\nIn the inhomogeneous variant (ISIS) one is also given a uniform target\n\\( t \\in \\mathbb{Z}_q^n \\) and must find a short \\( z \\) with\n\\( A z \\equiv t \\pmod q \\).","heading":"Definition"},{"content":"For \\( q \\ge \\beta \\cdot \\omega(\\sqrt{n \\log n}) \\), solving SIS on average is at\nleast as hard as solving \\( \\mathrm{SIVP}_\\gamma \\) in the worst case with\n\\( \\gamma = \\beta \\cdot \\tilde O(\\sqrt n) \\) (Micciancio and Regev 2007;\n`SIG-PAPER-2008-GPV`), by classical reductions starting from Ajtai (1996). The\nbest known attacks find short vectors in the lattice\n\\( \\{ z : A z \\equiv 0 \\bmod q \\} \\) by BKZ-type reduction and sieving, in time\n\\( 2^{\\Theta(n)} \\) for the parameters in use.","heading":"Status"},{"content":"Worst-case GapSVP/SIVP hardness (ASM-GAPSVP) implies SIS. An SIS solution for\nthe transpose of an LWE matrix distinguishes LWE samples from uniform when\n\\( \\beta \\) times the LWE error width is small compared with \\( q \\), so LWE with matching parameters implies SIS. Ring-SIS (ASM-RSIS) and\nModule-SIS (ASM-MSIS) are the structured variants; SIS hardness does not imply\ntheirs. The GPV signature (`SIG-PAPER-2008-GPV`) is proven secure from SIS in\nthe random oracle model.","heading":"Relations"}],"slug":"sis","status":"registry","subtitle":"lattice","summary":"Fix \\( n \\), a modulus \\( q \\), a width \\( m \\ge n \\log q \\) and a norm bound \\( \\beta < q \\).","tags":["lattice","standard"],"title":"Short integer solution (SIS)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-SIS"},{"evidence":"registry","id":"ASM-STRONG-RSA","keywords":["factoring","standard"],"metadata":{"aliases":["strong RSA assumption"],"falsifiable":true,"family":"factoring","id":"ASM-STRONG-RSA","implied_by":[],"implied_by_records":[],"implies":["ASM-RSA"],"implies_records":[{"id":"ASM-RSA","name":"RSA assumption (RSA)"}],"introduced_in":{"citation":"Niko Barić and Birgit Pfitzmann, Collision-Free Accumulators and Fail-Stop Signature Schemes Without Trees, EUROCRYPT 1997","url":"https://doi.org/10.1007/3-540-69053-0_33"},"kind":"standard","name":"Strong RSA assumption (strong RSA)","post_quantum":false,"references":[{"citation":"Niko Barić and Birgit Pfitzmann, Collision-Free Accumulators and Fail-Stop Signature Schemes Without Trees, EUROCRYPT 1997","url":"https://doi.org/10.1007/3-540-69053-0_33"},{"citation":"Eiichiro Fujisaki and Tatsuaki Okamoto, Statistical Zero Knowledge Protocols to Prove Modular Polynomial Relations, CRYPTO 1997","url":"https://doi.org/10.1007/BFb0052225"},{"citation":"Ronald Cramer and Victor Shoup, Signature Schemes Based on the Strong RSA Assumption, ACM TISSEC 3(3), 2000 (ACM CCS 1999)","url":"https://doi.org/10.1145/357830.357847"}],"status":"As of 2026-10-10 no attack on strong RSA is known other than factoring the modulus; it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/3-540-69053-0_33","sections":[{"content":"Let \\( N \\) be an RSA modulus (often a product of two safe primes). Given\n\\( N \\) and a uniformly random \\( y \\in \\mathbb{Z}_N^* \\), the strong RSA\nassumption states that no probabilistic polynomial-time algorithm outputs a\npair \\( (x, e) \\) with \\( e > 1 \\) and\n\n\\[\nx^{e} \\equiv y \\pmod N .\n\\]\n\nUnlike the RSA assumption, the adversary chooses the exponent \\( e \\).","heading":"Definition"},{"content":"Factoring \\( N \\) breaks the assumption, and no other attack is known.\nBarić and Pfitzmann (1997) and, independently, Fujisaki and Okamoto (1997)\nintroduced it. It underlies the Cramer-Shoup signature scheme without random\noracles (`SIG-PAPER-1999-CS`), RSA accumulators, and the integer commitments\nand range proofs over RSA groups used in Paillier-based threshold ECDSA\nprotocols such as `[CGGMP20]`.","heading":"Status"},{"content":"Strong RSA implies RSA (ASM-RSA) for every fixed exponent, hence also\nfactoring. The converse is not known: an algorithm for strong\nRSA may output roots only for exponents of its own choosing, which does not\ninvert RSA for a prescribed exponent.","heading":"Relations"}],"slug":"strong-rsa","status":"registry","subtitle":"factoring","summary":"Let \\( N \\) be an RSA modulus (often a product of two safe primes).","tags":["factoring","standard"],"title":"Strong RSA assumption (strong RSA)","type":"assumption","venue":null,"year":null,"sourcePath":"data/signature-catalog.json#ASM-STRONG-RSA"}],"notation":[{"aliases":[],"meaning":"Computational security parameter.","regime":"Signature security and random-oracle lower bounds.","symbol":"\\lambda"},{"aliases":[{"paper":"SIG-PAPER-2018-DILITHIUM","writes":"q"}],"meaning":"Coefficient modulus.","regime":"Lattice signatures.","symbol":"q"},{"aliases":[{"paper":"SIG-PAPER-2012-LYU","writes":"n"},{"paper":"SIG-PAPER-2018-DILITHIUM","writes":"n"}],"meaning":"Lattice dimension or polynomial degree, as specified by the construction.","regime":"Lattice bounds: dimension or polynomial degree. ECDSA body text separately defines the group order; these parameters are not equated.","symbol":"n"},{"aliases":[{"paper":"SIG-PAPER-2018-DILITHIUM","writes":"k"}],"meaning":"Module row rank.","regime":"Dilithium parameters.","symbol":"k"},{"aliases":[{"paper":"SIG-PAPER-2018-DILITHIUM","writes":"\\ell"}],"meaning":"Module column rank.","regime":"Dilithium parameters.","symbol":"\\ell"},{"aliases":[],"meaning":"Adversary signing-oracle query count.","regime":"Unforgeability reductions.","symbol":"q_s"},{"aliases":[],"meaning":"Adversary hash-oracle query count.","regime":"Unforgeability reductions.","symbol":"q_h"},{"aliases":[],"meaning":"Forgery advantage in the stated game.","regime":"Security reductions.","symbol":"\\varepsilon"}],"primer":{"id":"SIG-PRIMER","keyProblems":["SIG-OP-002","SIG-OP-006"],"sections":[{"content":"A signature scheme has three algorithms. KeyGen outputs a public verification\nkey and a secret signing key. Sign uses the secret key to produce a signature\non a message. Verify uses the public key to accept or reject a\nmessage–signature pair, and honestly generated signatures must be accepted.\nThe standard security notion is existential unforgeability under adaptive\nchosen-message attack (EUF-CMA): an adversary that may request signatures on\nmessages of its choice cannot output a valid signature on any message it did\nnot query (SIG-PAPER-1988-GMR). RSA gave the first public-key signature\nconstruction (SIG-PAPER-1978-RSA), but unpadded RSA signatures are not EUF-CMA\nsecure.","heading":"What it is"},{"content":"$b","heading":"Core notions"},{"content":"$c","heading":"Main approaches"},{"content":"$d","heading":"Notation"},{"content":"This topic covers publicly verifiable signatures under one signing key: RSA,\ndiscrete-log and Schnorr-type, pairing-based, hash-based, and lattice\nsignatures. MACs and identity-based, blind, ring, group, and other specialized\nsignatures are separate functionalities; multisignatures and aggregate\nsignatures are adjacent; threshold signatures have their own topic.","heading":"Scope of this atlas"}],"sources":["SIG-PAPER-1988-GMR","SIG-PAPER-1991-SCHNORR","SIG-PAPER-2001-BLS","SIG-PAPER-2008-GPV","SIG-PAPER-2018-DILITHIUM","SIG-PAPER-2019-SPHINCSPLUS","SIG-PAPER-1978-RSA","SIG-PAPER-1979-LAMPORT","SIG-PAPER-1989-MERKLE","SIG-PAPER-1996-PSS","SIG-PAPER-1986-FS","SIG-PAPER-2011-ED25519","SIG-PAPER-1999-CS","SIG-PAPER-2016-FKP","SIG-PAPER-2022-GS","SIG-PAPER-2023-FIPS186-5","SIG-PAPER-2004-BB","SIG-PAPER-2024-FIPS205","SIG-PAPER-2020-FALCON","SIG-PAPER-2009-LYU","SIG-PAPER-2012-LYU","SIG-PAPER-2024-FIPS204","SIG-PAPER-2026-CHMY","SIG-PAPER-2023-HK"],"startHere":["SIG-PAPER-1988-GMR","SIG-PAPER-1991-SCHNORR","SIG-PAPER-2001-BLS","SIG-PAPER-2008-GPV","SIG-PAPER-2018-DILITHIUM","SIG-PAPER-2019-SPHINCSPLUS"],"summary":"A signer holding a secret key produces signatures that anyone can check against the matching public key, and no one else can produce a valid signature on a new message.","title":"Digital signatures"},"propertyAssertions":[{"dimension":"signer_model","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1996-PSS.md","id":"SIG-PROP-015F8C03EAE52E","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-1996-PSS","value":"single_signer"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1978-RSA.md","id":"SIG-PROP-080090C2B2DF12","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-1978-RSA","value":"rsa"},{"dimension":"signing_cost","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2001-BLS.md","id":"SIG-PROP-0A2B253B6D6696","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2001-BLS","value":"hash-to-curve and one scalar multiplication"},{"dimension":"signer_model","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2020-FALCON.md","id":"SIG-PROP-0A6CFFADDC3AD5","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2020-FALCON","value":"single_signer"},{"dimension":"statefulness","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2009-LYU.md","id":"SIG-PROP-0ABD1F917BE032","review_status":"bibliographic_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2009-LYU","value":"stateless with fresh signing randomness"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2004-BB.md","id":"SIG-PROP-0ACFCD1711E77F","review_status":"scheme_declared","scope":"construction","subject_id":"SIG-CONSTRUCTION-2004-BB","value":"short-signature"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1978-RSA.md","id":"SIG-PROP-0C165D00D29589","review_status":"scheme_declared","scope":"construction","subject_id":"SIG-CONSTRUCTION-1978-RSA","value":"public-verification"},{"dimension":"nonce_generation","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2020-FALCON.md","id":"SIG-PROP-0DC68F4B20C81B","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2020-FALCON","value":"randomized hash-to-point and Gaussian preimage sampling"},{"dimension":"signing_cost","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2024-MLDSA.md","id":"SIG-PROP-0F3FFB8CD0DF74","review_status":"standard_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2024-MLDSA","value":"parameter-set-defined NTT polynomial arithmetic and rejection sampling"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2004-BB.md","id":"SIG-PROP-1021968AAE69FD","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2004-BB","value":"pairing"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2020-FALCON.md","id":"SIG-PROP-10A9EA00BA9014","review_status":"scheme_declared","scope":"construction","subject_id":"SIG-CONSTRUCTION-2020-FALCON","value":"public-verification"},{"dimension":"normative_status","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2020-FALCON.md","id":"SIG-PROP-10DC8937B63DAF","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2020-FALCON","value":"selected by NIST; FN-DSA standard in development at cutoff"},{"dimension":"statefulness","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1999-CS.md","id":"SIG-PROP-1200739C91973F","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-1999-CS","value":"stateless"},{"dimension":"primitive","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1996-PSS.md","id":"SIG-PROP-15034013D0960F","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-1996-PSS","value":"digital_signature"},{"dimension":"statefulness","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2020-FALCON.md","id":"SIG-PROP-15387712E03FA7","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2020-FALCON","value":"stateless"},{"dimension":"normative_status","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2008-GPV.md","id":"SIG-PROP-16014D6693FF01","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2008-GPV","value":"foundational research framework"},{"dimension":"nonce_generation","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1996-PSS.md","id":"SIG-PROP-16CD3104745FDB","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-1996-PSS","value":"randomized salt"},{"dimension":"signing_cost","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2024-SLHDSA.md","id":"SIG-PROP-174FAB45EE6D52","review_status":"standard_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2024-SLHDSA","value":"parameter-set-defined hash computation"},{"dimension":"normative_status","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-1999-CS.md","id":"SIG-PROP-18D26A7E0C3043","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-1999-CS","value":"research construction"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2019-SPHINCSPLUS.md","id":"SIG-PROP-1BB5269F11044D","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2019-SPHINCSPLUS","value":"stateless_hash_based"},{"dimension":"nonce_generation","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2011-ED25519.md","id":"SIG-PROP-1BB99BD499E96B","review_status":"primary_source_reviewed","scope":"construction","subject_id":"SIG-CONSTRUCTION-2011-ED25519","value":"deterministic secret-prefix-and-message hash"},{"dimension":"verification_cost","evidence_ref":"knowledge/primitives/signature/schemes/SIG-CONSTRUCTION-2019-SPHINCS
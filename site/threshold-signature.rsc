:"source_declared","source":"TSIG-PAPER-2025-GLRS","target":"TSIG-OP-007","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-9AC61BA54733DC","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2023-OLAF","target":"TSIG-RESULT-2023-OLAF-PROOF-WITHOUT-AGM","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-9C6D7A5133384C","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2023-GKS","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"Shoup related-work comparison and construction overview","evidenceUrl":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","id":"TSIG-REL-9FBC650675612F","note":"Shoup presents a more practical robust threshold-RSA signature protocol with noninteractive signature shares and direct share verification.","resultId":"TSIG-RESULT-1996-GJKR-RSA-ROBUST-THRESHOLD-RSA-FUNCTION-SHARING","reviewStatus":"primary_source_checked","source":"TSIG-RESULT-1996-GJKR-RSA-ROBUST-THRESHOLD-RSA-FUNCTION-SHARING","target":"TSIG-RESULT-2000-SHOUP-PRACTICAL-ROBUST-THRESHOLD-RSA","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-A1962195A024D0","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-1999-GJKR-DKG","target":"TSIG-RESULT-1999-GJKR-DKG-MALICIOUS-MINORITY-SECURITY","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2022-DILIZIUM2--RELIES_ON--ASM-MLWE","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2022-DILIZIUM2","target":"ASM-MLWE","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2022-DILIZIUM2--RELIES_ON--ASM-MSIS","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2022-DILIZIUM2","target":"ASM-MSIS","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-A52516DC33BD76","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-FLOOD","target":"TSIG-RESULT-2024-FLOOD-RANDOM-SUBMERSIONS","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-A538E66E65BC75","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2023-OLAF","target":"TSIG-OP-007","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-A745FB2FC7DD9D","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-RACCOON","target":"TSIG-RESULT-2024-RACCOON-ONE-TIME-ADDITIVE-MASK-DEFENSE","type":"HAS_RESULT"},{"evidenceLocator":"GKS Section 5 opening (PDF p. 23), Section 6 (PDF p. 31), and Section 7 parameter setting (PDF p. 32)","evidenceUrl":"https://eprint.iacr.org/2023/1318","id":"TSIG-REL-A8F77F4680697E","note":"GKS's actively secure t-out-of-n protocol hashes a commitment to w rather than w itself, the approach DOTT takes, and instantiates its trapdoor commitments with DOTT's homomorphic trapdoor commitment scheme.","resultId":"TSIG-RESULT-2021-DOTT-ABORT-LEAKAGE-COUNTERMEASURE","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2021-DOTT-ABORT-LEAKAGE-COUNTERMEASURE","target":"TSIG-RESULT-2023-GKS-TWO-ROUND-ARBITRARY-THRESHOLD-LATTICE-SIGNATURE","type":"REUSES_COMMITMENT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-AA20DEE8A549A9","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2020-FROST","target":"TSIG-RESULT-2020-FROST-IDENTIFIABLE-MISBEHAVING-PARTICIPANT","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-AC60971851BB16","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-CONSTRUCTION-2018-GG","target":"TSIG-PAPER-2018-GG","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-AD7F8A9C07113D","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-TANG","target":"TSIG-RESULT-2024-TANG-FUNCTIONAL-INTERCHANGEABILITY","type":"HAS_RESULT"},{"evidenceLocator":"DiLizium 2.0 Sections 1.1–1.2, PDF pp. 2–3; audited ePrint is marked outdated","evidenceUrl":"https://eprint.iacr.org/2022/644","id":"TSIG-REL-B0574E00C59EC3","note":"DiLizium 2.0 follows the DOTT commitment-based logic but incorporates Dilithium signature-compression techniques in a two-party authentication setting.","resultId":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","target":"TSIG-RESULT-2022-DILIZIUM2-TWO-PARTY-DILITHIUM-LINE","type":"CHANGES_ENCODING"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-B1487ED834D12D","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2021-DOTT","target":"TSIG-RESULT-2021-DOTT-ABORT-LEAKAGE-COUNTERMEASURE","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-B18D6572D1DCCD","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-CONSTRUCTION-2024-RACCOON","target":"TSIG-PAPER-2024-RACCOON","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-B1A8F781B6A579","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-CONSTRUCTION-2021-DOTT","target":"TSIG-PAPER-2021-DOTT","type":"DESCRIBED_IN"},{"evidenceLocator":"Tang et al. Section 1.2, Achieving Proactive Security, citing CGGMP as reference [15] (PDF pp. 6–7); mobile-adversary model in Section 5.1, Definition 3 (PDF p. 14), and Section 6, Theorem 2 (PDF pp. 17–18)","evidenceUrl":"https://eprint.iacr.org/2024/1067","id":"TSIG-REL-B24053CDF00571","note":"Following CGGMP's proactive threshold ECDSA, Tang et al. refresh lattice key shares by adding fresh sharings of zero, but generate the zero shares with SPDZ's multiplication protocol and catch malicious behavior with SPDZ MAC checks instead of verifiable secret sharing.","resultId":"TSIG-RESULT-2020-CGGMP-PROACTIVE-SECURITY","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2020-CGGMP-PROACTIVE-SECURITY","target":"TSIG-RESULT-2024-TANG-PROACTIVE-REFRESH","type":"ADAPTS_SHARE_REFRESH"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-B37633CEB00345","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2018-BGGJKRS","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-B4128A909BBFB9","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2017-LINDELL","target":"TSIG-RESULT-2017-LINDELL-MALICIOUS-SECURITY","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2023-OLAF--RELIES_ON--ASM-AOMDL","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2023-OLAF","target":"ASM-AOMDL","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2023-OLAF--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2023-OLAF","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"CGGMP revised full version, abstract and contribution overview","evidenceUrl":"https://eprint.iacr.org/2021/060","id":"TSIG-REL-B678E6D9CE289B","note":"Building on GG18, CGGMP moves all message-independent signing rounds into preprocessing and leaves one message-dependent online round.","resultId":"TSIG-RESULT-2018-GG-MULTIPARTY-THRESHOLD-ECDSA","reviewStatus":"primary_source_checked","source":"TSIG-RESULT-2018-GG-MULTIPARTY-THRESHOLD-ECDSA","target":"TSIG-RESULT-2020-CGGMP-ONE-MESSAGE-DEPENDENT-ONLINE-ROUND","type":"IMPROVES_ONLINE_INTERACTION"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-B9CAC67D741526","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-CONSTRUCTION-2024-GLACIUS","target":"TSIG-PAPER-2024-GLACIUS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-BA74BF232AF7B4","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2026-QUORUS","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-BBEB8B9BE72F87","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2018-GG","target":"TSIG-RESULT-2018-GG-MULTIPARTY-THRESHOLD-ECDSA","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-C043063306CD42","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-1989-DF","target":"TSIG-RESULT-1989-DF-THRESHOLD-CRYPTOSYSTEM-PARADIGM","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2000-SHOUP--RELIES_ON--ASM-RSA","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2000-SHOUP","target":"ASM-RSA","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2020-CGGMP--RELIES_ON--ASM-DSA-EUF","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2020-CGGMP","target":"ASM-DSA-EUF","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2020-CGGMP--RELIES_ON--ASM-DLOG","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2020-CGGMP","target":"ASM-DLOG","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2020-CGGMP--RELIES_ON--ASM-DCR","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2020-CGGMP","target":"ASM-DCR","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2020-CGGMP--RELIES_ON--ASM-STRONG-RSA","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2020-CGGMP","target":"ASM-STRONG-RSA","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-C3D14E192C91A3","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-GLACIUS","target":"TSIG-OP-007","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2020-FROST--RELIES_ON--ASM-DLOG","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2020-FROST","target":"ASM-DLOG","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-C7A7B7157B8A32","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2020-FROST","target":"TSIG-OP-007","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-CC8C9E96ACD0C5","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-1991-PEDERSEN","target":"TSIG-RESULT-1991-PEDERSEN-DISTRIBUTED-KEY-GENERATION-WITHOUT-DEALER","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2019-DKLSN--RELIES_ON--ASM-DSA-EUF","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2019-DKLSN","target":"ASM-DSA-EUF","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2019-DKLSN--RELIES_ON--ASM-CDH","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2019-DKLSN","target":"ASM-CDH","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2019-DKLSN--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2019-DKLSN","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"GJKR DKG abstract, introduction, and protocol comparison","evidenceUrl":"https://doi.org/10.1007/3-540-48910-X_21","id":"TSIG-REL-D2871697DFB891","note":"GJKR revisits discrete-log DKG and supplies a robust malicious-security treatment for distributed key generation.","resultId":"TSIG-RESULT-1991-PEDERSEN-DISTRIBUTED-KEY-GENERATION-WITHOUT-DEALER","reviewStatus":"primary_source_checked","source":"TSIG-RESULT-1991-PEDERSEN-DISTRIBUTED-KEY-GENERATION-WITHOUT-DEALER","target":"TSIG-RESULT-1999-GJKR-DKG-ROBUST-DISCRETE-LOG-DKG","type":"STRENGTHENS_ROBUSTNESS"},{"evidenceLocator":"AOM-MLWE Sections 1.1, 2.1, and 6.2, Figures 2 and 8, Theorem 6.1, PDF pp. 4–10 and 33–36","evidenceUrl":"https://eprint.iacr.org/2024/496","id":"TSIG-REL-D442E3941447FA","note":"Starting from Threshold Raccoon's pairwise-mask approach, the AOM-MLWE construction reduces signing from three rounds to two and makes the first round message- and signer-set-independent by introducing an algebraic one-more lattice assumption.","resultId":"TSIG-RESULT-2024-RACCOON-ONE-TIME-ADDITIVE-MASK-DEFENSE","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2024-RACCOON-ONE-TIME-ADDITIVE-MASK-DEFENSE","target":"TSIG-RESULT-2024-AOMMLWE-TWO-ROUND-LATTICE-THRESHOLD-WITHOUT-FHE","type":"CHANGES_ASSUMPTION_AND_ROUNDS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-D8615E164DF357","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2026-THED","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"AOM-MLWE Section 1, A Closer Look at Round Complexity (PDF p. 3), and Section 2.1, Making it Two-Round, Figure 2 (PDF p. 9)","evidenceUrl":"https://eprint.iacr.org/2024/496","id":"TSIG-REL-DB927B1C668BDB","note":"The AOM-MLWE construction carries the offline-online two-round pattern it attributes to FROST into lattices: following an approach the authors call similar to FROST's, signers send first-round commitments in the clear, so that round can be preprocessed before the message and signer set are known.","resultId":"TSIG-RESULT-2020-FROST-ONE-ROUND-WITH-PREPROCESSING","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2020-FROST-ONE-ROUND-WITH-PREPROCESSING","target":"TSIG-RESULT-2024-AOMMLWE-OFFLINE-ONLINE-SIGNING","type":"ADAPTS_OFFLINE_ONLINE"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-DCCE30CCDC0EA5","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2021-GKMN","target":"TSIG-RESULT-2021-GKMN-STATELESS-DETERMINISTIC-THRESHOLD-SCHNORR","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-DCE13E854DDAEF","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-ROUTE-002","target":"TSIG-OP-001","type":"ENABLES"},{"evidenceLocator":"Tang et al. Section 1, Schnorr-like Method paragraph (PDF p. 3), and Section 1.1, Functional Interchangeability (PDF p. 4)","evidenceUrl":"https://eprint.iacr.org/2024/1067","id":"TSIG-REL-DE60059453E636","note":"Tang et al. single out DOTT's n-out-of-n lattice scheme as the closest Schnorr-like attempt and address its two stated limits: their t-out-of-n signatures verify with the ordinary non-threshold algorithm, and key and signature sizes do not grow with the number of parties.","resultId":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","target":"TSIG-RESULT-2024-TANG-FUNCTIONAL-INTERCHANGEABILITY","type":"RESTORES_INTERCHANGEABILITY"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-DF41C64E4573FA","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2022-DILIZIUM2","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-E13B4D24A2F884","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2020-FROST","target":"TSIG-RESULT-2020-FROST-TWO-ROUND-THRESHOLD-SCHNORR","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-E494E7A32C3C0F","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2025-FAFROST","target":"TSIG-OP-007","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-E4C52A21AC8B84","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2018-DKLS-2P","target":"TSIG-RESULT-2018-DKLS-2P-TWO-PARTY-ECDSA-WITHOUT-PAILLIER","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-E7BDB56BC4F805","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2003-BOLDYREVA","target":"TSIG-RESULT-2003-BOLDYREVA-THRESHOLD-BLS-SIGNATURE","type":"HAS_RESULT"},{"evidenceLocator":"GKS Section 5, Figure 7 and Theorem 3, PDF pp. 22–26","evidenceUrl":"https://eprint.iacr.org/2023/1318","id":"TSIG-REL-EBF60742CF0CBC","note":"GKS preserves two signing rounds while moving from DOTT's full n-out-of-n threshold to arbitrary t<=n through threshold linearly homomorphic encryption.","resultId":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","reviewStatus":"fulltext_checked","source":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","target":"TSIG-RESULT-2023-GKS-TWO-ROUND-ARBITRARY-THRESHOLD-LATTICE-SIGNATURE","type":"GENERALIZES_THRESHOLD"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-ED885C4DA2F65E","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2000-SHOUP","target":"TSIG-RESULT-2000-SHOUP-PRACTICAL-ROBUST-THRESHOLD-RSA","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-EE8C0987FD762C","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-CONSTRUCTION-2017-LINDELL","target":"TSIG-PAPER-2017-LINDELL","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-EFE51CF8E5ADCF","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-FLOOD","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-F0955A77887562","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-CONSTRUCTION-2024-FLOOD","target":"TSIG-PAPER-2024-FLOOD","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-F198DDB374474F","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-1999-GJKR-DKG","target":"TSIG-RESULT-1999-GJKR-DKG-ROBUST-DISCRETE-LOG-DKG","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-F1DAF9C4CE24F2","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-AOMMLWE","target":"TSIG-OP-001","type":"TARGETS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-F40CB171E1C478","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2003-BOLDYREVA","target":"TSIG-RESULT-2003-BOLDYREVA-UNIQUE-COMPACT-OUTPUT","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-F470ACC05C4C8B","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-BARRIER-003","target":"TSIG-OP-007","type":"BLOCKS"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2017-LINDELL--RELIES_ON--ASM-DSA-EUF","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2017-LINDELL","target":"ASM-DSA-EUF","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2017-LINDELL--RELIES_ON--ASM-DLOG","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2017-LINDELL","target":"ASM-DLOG","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-CONSTRUCTION-2017-LINDELL--RELIES_ON--ASM-DCR","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"TSIG-CONSTRUCTION-2017-LINDELL","target":"ASM-DCR","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-FB3E56BEF8F385","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2017-LINDELL","target":"TSIG-RESULT-2017-LINDELL-EFFICIENT-TWO-PARTY-ECDSA","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"TSIG-REL-FBA9CC7EC1734A","note":"","resultId":null,"reviewStatus":"source_declared","source":"TSIG-PAPER-2024-TANG","target":"TSIG-OP-001","type":"TARGETS"}],"nodes":[{"evidence":"primary_source_checked","id":"TSIG-BARRIER-001","keywords":[],"metadata":{"claim":"Naively applying ordinary field-based Shamir sharing to a short lattice signing secret does not ensure that the local shares remain short enough for the target signing distribution and norm constraints.","does_not_exclude":["Threshold homomorphic-encryption routes","Verifiable short secret sharing and random submersions","MPC protocols that never expose short local signing shares"],"dossier_type":"barrier","escape_hatches":["threshold linear homomorphic encryption","verifiable short secret sharing","jointly sampled masked responses","specialized lattice MPC"],"evidence":"primary_source_checked","excludes":["Treating a field-shared lattice secret as if every local share automatically had the base scheme's short distribution","Generalizing an n-out-of-n additive-share proof to arbitrary t-out-of-n without a new short-share mechanism"],"id":"TSIG-BARRIER-001","scope":{"resource":"short secret shares needed by lattice signature equations","setting":"general t-out-of-n lattice threshold signing"},"status":"scoped_literature_barrier","targets":["TSIG-OP-001"],"title":"Ordinary Shamir shares do not preserve a lattice signing key's shortness"},"primaryUrl":null,"sections":[{"content":"GKS ePrint 2023/1318, Introduction Sections 1.1-1.3, states the short-share obstacle and motivates its threshold-HE solution. This is not an impossibility theorem for all secret-sharing methods.","heading":"Evidence note"}],"slug":"ordinary-shamir-shares-do","status":"scoped_literature_barrier","subtitle":"","summary":"GKS ePrint 2023/1318, Introduction Sections 1.1-1.3, states the short-share obstacle and motivates its threshold-HE solution. This is not an impossibility theorem for all secret-sharing methods.","title":"Ordinary Shamir shares do not preserve a lattice signing key's shortness","type":"barrier","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-BARRIER-001"},{"evidence":"primary_source_checked","id":"TSIG-BARRIER-002","keywords":[],"metadata":{"claim":"A distributed signer cannot reveal signer-correlated abort or rejection behavior naively; the transcript distribution must be proven independent of the hidden shares up to the declared leakage.","does_not_exclude":["Homomorphic or trapdoor commitments that hide the first message until responses are fixed","One-time additive masks or noise-flooding techniques with a complete proof","Threshold-HE routes that sample the response under encryption"],"dossier_type":"barrier","escape_hatches":["commit-before-challenge","trapdoor commitments","one-time additive masks","noise flooding","encrypted response sampling"],"evidence":"primary_source_checked","excludes":["Assuming the single-signer rejection-sampling proof composes automatically across separately aborting parties","Reusing abandoned partial transcripts without a proof that conditions on the abort event"],"id":"TSIG-BARRIER-002","scope":{"adversary_view":"commitments partial responses and abort decisions across sessions","setting":"distributed Fiat-Shamir-with-aborts lattice signing"},"status":"scoped_literature_barrier","targets":["TSIG-OP-001"],"title":"Rejection and abort transcripts can leak partial lattice signing keys"},"primaryUrl":null,"sections":[{"content":"DOTT ePrint 2020/1110 identifies leakage from aborting after the first message and supplies a commitment-based defense; later branches change the defense mechanism rather than eliminating the distributional obligation.","heading":"Evidence note"}],"slug":"rejection-and-abort-transcri","status":"scoped_literature_barrier","subtitle":"","summary":"DOTT ePrint 2020/1110 identifies leakage from aborting after the first message and supplies a commitment-based defense; later branches change the defense mechanism rather than eliminating the distributional obligation.","title":"Rejection and abort transcripts can leak partial lattice signing keys","type":"barrier","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-BARRIER-002"},{"evidence":"abstract_checked","id":"TSIG-BARRIER-003","keywords":[],"metadata":{"claim":"For key-unique schemes, whose public key shares fix the secret shares, adaptive security against between about t/2 and t corruptions cannot be proved in the random oracle model from OMDL or AOMDL with natural rewinding reductions, nor from non-interactive assumptions with a broad class of reductions. For threshold Schnorr schemes whose secret shares are Shamir shares with commitments that the adversary can compute, FROST and its variants included, adaptive security against a given number of corruptions requires hardness of the LDVR problem for the same parameters.","does_not_exclude":["Schemes whose public key shares are hidden or not unique, for example DDH-based shares","Masking of partial signatures with pairwise keys, either in the random oracle model alone with state across sessions, a third round, or one extra scalar in the signature (TSIG-PAPER-2025-CHEN, Section 1.1, p. 2, and Theorems 1-2, pp. 15 and 26), or in two stateless rounds with no public key shares in the algebraic group and random oracle models, as in ms-FROST (TSIG-PAPER-2025-MSFROST, Section 4 and Theorem 1, PDF pp. 12-13) and FaFROST (TSIG-PAPER-2025-FAFROST, Figure 4 and Theorem 1, PDF p. 18)","Proofs in the algebraic group model","Adaptive security against at most about half the threshold"],"dossier_type":"barrier","escape_hatches":["decisional assumptions with non-unique key shares","pairwise masking","algebraic group model","periodic key refresh"],"evidence":"abstract_checked","excludes":["Rewinding proofs from OMDL or AOMDL in the random oracle model of full adaptive security for key-unique threshold Schnorr","Proofs of adaptive security for threshold Schnorr schemes with Shamir-shared keys and computable share commitments, such as FROST, that do not imply hardness of the LDVR problem for the same parameters"],"id":"TSIG-BARRIER-003","scope":{"resource":"proofs of adaptive security against more than about half the threshold","setting":"key-unique threshold signatures with standard-compatible output"},"status":"scoped_literature_barrier","targets":["TSIG-OP-007"],"title":"Key-unique threshold Schnorr resists adaptive proofs beyond half the threshold"},"primaryUrl":null,"sections":[{"content":"$7","heading":"Evidence note"}],"slug":"key-unique-threshold-schnorr","status":"scoped_literature_barrier","subtitle":"","summary":"TSIG-PAPER-2025-CCKM (ePrint 2025/943, abstract) proves the two impossibility results for key-unique schemes. TSIG-PAPER-2025-CKKTZ, Section 4.2 (CRYPTO 2025; ePrint 2025/1061, PDF pp. 16-18), gives an explicit adaptive attack, which needs no signing queries and works even with erasures, on any threshold Schnorr scheme whose secret shares are Shamir shares with computable commitments, FROST included, whenever the LDVR…","title":"Key-unique threshold Schnorr resists adaptive proofs beyond half the threshold","type":"barrier","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-BARRIER-003"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-1996-GJKR-DSS","keywords":["threshold_signature","threshold_dss","ordinary-verifier-output","malicious-security","robustness"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"discrete_log","name":"hardness of forging the underlying DSS signature under the paper model"},"base_signature":"DSS","capabilities":["ordinary-verifier-output","malicious-security","robustness"],"communication":"historical interactive protocol; exact accounting queued","construction_family":"threshold_dss","corruption_model":"malicious faults with separate robustness bounds","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-1996-GJKR-DSS","identifiable_abort":"scoped share verification; modern terminology not used","name":"GJKR robust threshold DSS","output_compatibility":"ordinary DSS signature","post_quantum_mechanism":"none","preprocessing":"protocol-dependent","primitive":"threshold_signature","resilience":"unforgeability against up to t corrupted players in the stated range","robustness":"paper gives distinct bounds for nonparticipation and incorrect partial signatures","security":{"mode":"threshold public-key","model":"paper-specific","notion":"threshold unforgeability and scoped robustness"},"setup_model":"distributed sharing of the DSS secret","signing_rounds":"interactive multiparty protocol","sizes":{"public_key":"ordinary DSS public key","signature":"ordinary DSS signature"},"status":"historical","threshold_policy":"2t+1 participating signers for t<n/2 in the base threshold statement","title":"GJKR robust threshold DSS","work_id":"TSIG-PAPER-1996-GJKR-DSS","year":1996},"primaryUrl":"https://doi.org/10.1007/3-540-68339-9_31","sections":[{"content":"The threshold t, signing-quorum size, crash tolerance, and malicious-share tolerance are not collapsed into one number.","heading":"Construction note"}],"slug":"gjkr96b-gjkr-robust-threshold-dss","status":"primary_source_reviewed","subtitle":"threshold_signature · 1996","summary":"The threshold t, signing-quorum size, crash tolerance, and malicious-share tolerance are not collapsed into one number.","title":"GJKR robust threshold DSS","type":"construction","venue":"EUROCRYPT 1996","year":1996,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-1996-GJKR-DSS"},{"evidence":"bibliographic_reviewed","id":"TSIG-CONSTRUCTION-1996-GJKR-RSA","keywords":["threshold_signature","threshold_rsa","rsa-function-sharing","robustness"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"factoring","name":"RSA-function security with paper-specific sharing assumptions"},"base_signature":"RSA function with a signature encoding supplied by the profile","capabilities":["rsa-function-sharing","robustness"],"communication":"exact accounting queued","construction_family":"threshold_rsa","corruption_model":"malicious threshold adversary","dossier_type":"construction","evidence":"bibliographic_checked","id":"TSIG-CONSTRUCTION-1996-GJKR-RSA","identifiable_abort":"share verification rather than modern identifiable-abort interface","name":"GJKR robust threshold RSA line","output_compatibility":"RSA function output; signature encoding must be fixed separately","post_quantum_mechanism":"none","preprocessing":"key sharing and verification setup","primitive":"threshold_signature","resilience":"paper-specific threshold","robustness":"yes under the scoped model","security":{"mode":"threshold public-key","model":"paper-specific","notion":"robust shared RSA evaluation"},"setup_model":"shared RSA trapdoor","signing_rounds":"nontrivial distributed protocol","sizes":{"public_key":"RSA modulus and exponent","signature":"one RSA function output before profile encoding"},"status":"historical","threshold_policy":"general threshold with robustness under the paper's bounds","title":"GJKR robust RSA function sharing","work_id":"TSIG-PAPER-1996-GJKR-RSA","year":1996},"primaryUrl":"https://doi.org/10.1007/3-540-68697-5","sections":[],"slug":"gjkr96a-gjkr-robust-threshold-rsa","status":"bibliographic_reviewed","subtitle":"threshold_signature · 1996","summary":"The proceedings PDF is required to promote exact round, threshold, and assumption fields.","title":"GJKR robust threshold RSA line","type":"construction","venue":"CRYPTO 1996","year":1996,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-1996-GJKR-RSA"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-2000-SHOUP","keywords":["threshold_signature","threshold_rsa","noninteractive-signature-shares","robustness","ordinary-verifier-output"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"factoring","name":"RSA assumption plus paper-specific number-theoretic setup"},"base_signature":"RSA","capabilities":["noninteractive-signature-shares","robustness","ordinary-verifier-output"],"communication":"one signature share per participating server plus combining metadata","construction_family":"threshold_rsa","corruption_model":"static malicious adversary in the paper model","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-2000-SHOUP","identifiable_abort":"invalid shares are detectable","name":"Shoup practical threshold RSA","output_compatibility":"ordinary RSA signature value for the specified encoding","post_quantum_mechanism":"none","preprocessing":"distributed key setup outside the signing algorithm","primitive":"threshold_signature","resilience":"threshold unforgeability under stated bounds","robustness":"combiner verifies signature shares and can proceed with enough valid shares","security":{"mode":"threshold public-key","model":"random-oracle/profile-dependent encoding","notion":"robust threshold unforgeability"},"setup_model":"RSA modulus and verified secret-key shares","signing_rounds":"noninteractive share generation followed by combining","sizes":{"public_key":"ordinary RSA public key","signature":"ordinary RSA modulus element"},"status":"historical_active_lineage","threshold_policy":"k-out-of-l threshold in the paper notation","title":"Shoup practical threshold RSA","work_id":"TSIG-PAPER-2000-SHOUP","year":2000},"primaryUrl":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","sections":[{"content":"“Noninteractive” describes per-server signature-share production, not dealer-free key generation.","heading":"Construction note"}],"slug":"shoup00-shoup-practical-threshold-rs","status":"primary_source_reviewed","subtitle":"threshold_signature · 2000","summary":"“Noninteractive” describes per-server signature-share production, not dealer-free key generation.","title":"Shoup practical threshold RSA","type":"construction","venue":"EUROCRYPT 2000","year":2000,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2000-SHOUP"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-2003-BOLDYREVA","keywords":["threshold_signature","threshold_pairing","compact-output","noninteractive-signature-shares","public-share-verification"],"metadata":{"adaptive_security":"not the card's claim","assumption":{"family":"pairing","name":"gap Diffie-Hellman / co-CDH lineage in pairing groups"},"base_signature":"BLS","capabilities":["compact-output","noninteractive-signature-shares","public-share-verification"],"communication":"one group-element share per participant","construction_family":"threshold_pairing","corruption_model":"static threshold adversary in the paper model","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-2003-BOLDYREVA","identifiable_abort":"malformed shares are attributable to their senders","name":"Boldyreva threshold BLS/GDH signature","output_compatibility":"ordinary one-group-element BLS signature","post_quantum_mechanism":"none","preprocessing":"distributed key setup","primitive":"threshold_signature","resilience":"threshold unforgeability under the stated bound","robustness":"valid shares can be publicly checked in the pairing setting","security":{"mode":"threshold public-key","model":"random oracle","notion":"threshold EUF-CMA lineage"},"setup_model":"shared scalar key in a gap-Diffie-Hellman group","signing_rounds":"noninteractive shares and public combining","sizes":{"public_key":"ordinary BLS public key plus share-verification data","signature":"one BLS signature group element"},"status":"research_and_deployment_lineage","threshold_policy":"t-out-of-n threshold sharing under the paper notation","title":"Boldyreva threshold BLS","work_id":"TSIG-PAPER-2003-BOLDYREVA","year":2003},"primaryUrl":"https://eprint.iacr.org/2002/118","sections":[{"content":"The assumption is a pairing/GDH-family point, not the plain DDH assumption used by Glacius.","heading":"Construction note"}],"slug":"boldyreva03-boldyreva-threshold-bls-gdh","status":"primary_source_reviewed","subtitle":"threshold_signature · 2003","summary":"The assumption is a pairing/GDH-family point, not the plain DDH assumption used by Glacius.","title":"Boldyreva threshold BLS/GDH signature","type":"construction","venue":"PKC 2003","year":2003,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2003-BOLDYREVA"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2017-LINDELL","keywords":["threshold_signature","threshold_ecdsa_paillier","ordinary-verifier-output","two-party-signing","malicious-security"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"discrete_log_and_factoring","name":"ECDSA/discrete-log and Paillier-related assumptions under the proof"},"base_signature":"ECDSA","capabilities":["ordinary-verifier-output","two-party-signing","malicious-security"],"communication":"constant number of two-party messages; exact bytes parameter-dependent","construction_family":"threshold_ecdsa_paillier","corruption_model":"one statically corrupted malicious party","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2017-LINDELL","identifiable_abort":"not claimed; the first party detects a cheating second party when the output signature fails to verify","name":"Lindell fast two-party ECDSA","output_compatibility":"ordinary ECDSA signature","post_quantum_mechanism":"none","preprocessing":"none claimed; the Paillier encryption of the first party's key share is created once at key generation","primitive":"threshold_signature","resilience":"no single party can forge alone","robustness":"abort on malicious behavior; guaranteed output not claimed","security":{"mode":"threshold public-key","model":"game-based with concurrent executions and global abort; simulation-based for sequential composition","notion":"maliciously secure two-party signing"},"setup_model":"two-party key generation with multiplicative key shares, a Paillier key of the first party, and a proof that the second party's ciphertext encrypts the first party's share (Protocol 3.1)","signing_rounds":"four messages (Protocol 3.2)","sizes":{"public_key":"ordinary ECDSA public key","signature":"ordinary ECDSA signature"},"status":"practical_lineage","threshold_policy":"2-out-of-2","title":"Lindell fast two-party ECDSA","work_id":"TSIG-PAPER-2017-LINDELL","year":2017},"primaryUrl":"https://eprint.iacr.org/2017/552","sections":[{"content":"ECDSA's inversion and multiplication structure makes its threshold protocol qualitatively different from linear Schnorr aggregation. Theorem 4.5 assumes Paillier IND-CPA and ECDSA unforgeability; Theorem 5.3 adds the non-standard Paillier-EC assumption for simulation security.","heading":"Construction note"}],"slug":"lindell17-lindell-fast-two-party","status":"fulltext_reviewed","subtitle":"threshold_signature · 2017","summary":"ECDSA's inversion and multiplication structure makes its threshold protocol qualitatively different from linear Schnorr aggregation. Theorem 4.5 assumes Paillier IND-CPA and ECDSA unforgeability; Theorem 5.3 adds the non-standard Paillier-EC assumption for simulation security.","title":"Lindell fast two-party ECDSA","type":"construction","venue":"CRYPTO 2017","year":2017,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2017-LINDELL"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2018-DKLS2","keywords":["threshold_signature","threshold_ecdsa_ot","ordinary-verifier-output","two-party-signing","paillier-free-route"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"discrete_log","name":"ECDSA unforgeability and CDH for oblivious transfer, in the random oracle model"},"base_signature":"ECDSA","capabilities":["ordinary-verifier-output","two-party-signing","paillier-free-route"],"communication":"dominated by OT extension; Table II of the reproduced paper reports 169.8 KiB per 2-of-2 signature at kappa=256 (232.8 KiB for 2-of-n), against 769 B for Lindell's protocol","construction_family":"threshold_ecdsa_ot","corruption_model":"one statically corrupted malicious party","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2018-DKLS2","identifiable_abort":"not claimed; with two signers a failed session implicates the counterparty","name":"DKLS OT-based two-party threshold ECDSA","output_compatibility":"ordinary ECDSA signature","post_quantum_mechanism":"none","preprocessing":"base OT (Verified Simplest OT) and OT-extension setup between each signing pair","primitive":"threshold_signature","resilience":"no single party can forge alone","robustness":"abort on detected cheating","security":{"mode":"threshold public-key","model":"random oracle; non-programmable global random oracle in the 2023 revision (Theorem 4.3)","notion":"maliciously secure two-party signing"},"setup_model":"dealerless key generation with multiplicative (2-of-2) or Shamir-derived (2-of-n) ECDSA key shares; no Paillier encryption","signing_rounds":"two messages in the original protocol; the 2023 revision adds one pipelineable commitment round","sizes":{"public_key":"ordinary ECDSA public key","signature":"ordinary ECDSA signature"},"status":"practical_lineage","threshold_policy":"2-out-of-2 and 2-out-of-n (Section V); general thresholds left to future work","title":"DKLS two-party ECDSA","work_id":"TSIG-PAPER-2018-DKLS-2P","year":2018},"primaryUrl":"https://eprint.iacr.org/2018/499","sections":[{"content":"This is the two-party root of the DKLS route; its multiplications use hardened OT-based Gilboa multiplication, not Paillier encryption or hash-proof systems, and its setup is not interchangeable with Paillier-based ECDSA protocols. The original two-message protocol realizes a nonce-biasable functionality argued secure in the generic group model; the 2023 revision restores the standard functionality with an extra round.","heading":"Construction note"}],"slug":"dkls18-dkls-ot-based-two","status":"fulltext_reviewed","subtitle":"threshold_signature · 2018","summary":"This is the two-party root of the DKLS route; its multiplications use hardened OT-based Gilboa multiplication, not Paillier encryption or hash-proof systems, and its setup is not interchangeable with Paillier-based ECDSA protocols. The original two-message protocol realizes a nonce-biasable functionality argued secure in the generic group model; the 2023 revision restores the standard functionality with an extra round.","title":"DKLS OT-based two-party threshold ECDSA","type":"construction","venue":"IEEE S&P 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2018-DKLS2"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2018-GG","keywords":["threshold_signature","threshold_ecdsa_paillier","ordinary-verifier-output","multiparty","trustless-setup"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"discrete_log_and_factoring","name":"ECDSA/discrete-log and Paillier-related assumptions"},"base_signature":"ECDSA","capabilities":["ordinary-verifier-output","multiparty","trustless-setup"],"communication":"multiparty interactive protocol; exact accounting parameter-dependent","construction_family":"threshold_ecdsa_paillier","corruption_model":"static malicious corruption of up to t players, with t up to n-1 (dishonest majority)","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2018-GG","identifiable_abort":"not claimed","name":"Gennaro-Goldfeder threshold ECDSA","output_compatibility":"ordinary ECDSA signature","post_quantum_mechanism":"none","preprocessing":"none claimed beyond key generation","primitive":"threshold_signature","resilience":"threshold unforgeability","robustness":"none; the protocol aborts when a check fails (Section 2)","security":{"mode":"threshold public-key","model":"static dishonest-majority corruption","notion":"game-based threshold unforgeability"},"setup_model":"dealerless key generation by per-player Feldman VSS, with each player's own Paillier key and proofs about its modulus (Section 4.1)","signing_rounds":"interactive signing in Phases 1-5 with a masked signature check before shares are released (Section 4.2)","sizes":{"public_key":"ordinary ECDSA public key","signature":"ordinary ECDSA signature"},"status":"practical_lineage","threshold_policy":"t-out-of-n multiparty threshold","title":"GG18 multiparty threshold ECDSA","work_id":"TSIG-PAPER-2018-GG","year":2018},"primaryUrl":"https://eprint.iacr.org/2019/114","sections":[{"content":"The setup and signing protocols should be compared separately; “fast setup” does not make the online signer noninteractive. Theorem 1 (PDF p. 12) assumes DSA unforgeability, Strong RSA, DDH, and non-malleable equivocable commitments; the registry string above is the record's existing mapping and does not name Strong RSA or DDH separately.","heading":"Construction note"}],"slug":"gg18-gennaro-goldfeder-threshold","status":"fulltext_reviewed","subtitle":"threshold_signature · 2018","summary":"The setup and signing protocols should be compared separately; “fast setup” does not make the online signer noninteractive. Theorem 1 (PDF p. 12) assumes DSA unforgeability, Strong RSA, DDH, and non-malleable equivocable commitments; the registry string above is the record's existing mapping and does not name Strong RSA or DDH separately.","title":"Gennaro-Goldfeder threshold ECDSA","type":"construction","venue":"ACM CCS 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2018-GG"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2019-DKLSN","keywords":["threshold_signature","threshold_ecdsa_ot","ordinary-verifier-output","general-threshold","paillier-free-route"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"discrete_log","name":"ECDSA unforgeability and CDH for oblivious transfer, in the random oracle model"},"base_signature":"ECDSA","capabilities":["ordinary-verifier-output","general-threshold","paillier-free-route"],"communication":"OT and multiparty arithmetic dependent","construction_family":"threshold_ecdsa_ot","corruption_model":"static malicious corruption of up to \\( t-1 \\) parties","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2019-DKLSN","identifiable_abort":"not claimed","name":"DKLS threshold ECDSA from ECDSA assumptions","output_compatibility":"ordinary ECDSA signature","post_quantum_mechanism":"none","preprocessing":"pairwise base OT and OT-extension setup; message-independent signing rounds can be preprocessed","primitive":"threshold_signature","resilience":"threshold unforgeability","robustness":"abort-oriented","security":{"mode":"threshold public-key","model":"global random oracle with static corruption","notion":"UC realization of the threshold ECDSA functionality"},"setup_model":"dealerless Shamir sharing of the ECDSA key with a proof of knowledge (Protocol 3)","signing_rounds":"⌈log t⌉ + 6; only the final round depends on the message","sizes":{"public_key":"ordinary ECDSA public key","signature":"ordinary ECDSA signature"},"status":"practical_lineage","threshold_policy":"general t-out-of-n","title":"DKLS general-threshold ECDSA","work_id":"TSIG-PAPER-2019-DKLS-N","year":2019},"primaryUrl":"https://eprint.iacr.org/2019/523","sections":[{"content":"Fields were checked against the ePrint 2019/523 revision dated 2020-05-22; the IEEE S&P 2019 proceedings version was not compared. Theorem 5.1's UC realization of the threshold ECDSA functionality needs only CDH in the global random-oracle model; the registry assumption string also lists ECDSA unforgeability, on which the unforgeability of the output signatures rests.","heading":"Construction note"}],"slug":"dkls19-dkls-threshold-ecdsa-from","status":"fulltext_reviewed","subtitle":"threshold_signature · 2019","summary":"Fields were checked against the ePrint 2019/523 revision dated 2020-05-22; the IEEE S&P 2019 proceedings version was not compared. Theorem 5.1's UC realization of the threshold ECDSA functionality needs only CDH in the global random-oracle model; the registry assumption string also lists ECDSA unforgeability, on which the unforgeability of the output signatures rests.","title":"DKLS threshold ECDSA from ECDSA assumptions","type":"construction","venue":"IEEE Symposium on Security and Privacy 2019","year":2019,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2019-DKLSN"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-2020-CGGMP","keywords":["threshold_signature","threshold_ecdsa_paillier","ordinary-verifier-output","identifiable-abort","proactive-refresh","noninteractive-online"],"metadata":{"adaptive_security":"UC/proactive profile; exact adaptive clauses follow paper","assumption":{"family":"discrete_log_and_factoring","name":"ECDSA/discrete-log and Paillier-range-proof related assumptions"},"base_signature":"ECDSA","capabilities":["ordinary-verifier-output","identifiable-abort","proactive-refresh","noninteractive-online"],"communication":"shifted toward preprocessing; online contribution is noninteractive","construction_family":"threshold_ecdsa_paillier","corruption_model":"UC malicious adversary in the paper model","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-2020-CGGMP","identifiable_abort":true,"name":"UC noninteractive-online threshold ECDSA with identifiable aborts","output_compatibility":"ordinary ECDSA signature","post_quantum_mechanism":"none","preprocessing":"substantial presigning phase","primitive":"threshold_signature","resilience":"threshold unforgeability with proactive refresh support","robustness":"identifiable abort rather than guaranteed output","security":{"mode":"threshold public-key","model":"UC","notion":"UC threshold signing with identifiable abort"},"setup_model":"distributed key generation and auxiliary cryptographic setup","signing_rounds":"noninteractive online contribution after preprocessing","sizes":{"public_key":"ordinary ECDSA public key","signature":"ordinary ECDSA signature"},"status":"practical_lineage","threshold_policy":"t-out-of-n under the paper bounds","title":"CGGMP20 threshold ECDSA","work_id":"TSIG-PAPER-2020-CGGMP","year":2020},"primaryUrl":"https://eprint.iacr.org/2021/060","sections":[{"content":"The online-round claim presupposes valid presignatures; total latency must include replenishing them.","heading":"Construction note"}],"slug":"cggmp20-uc-noninteractive-online-thr","status":"primary_source_reviewed","subtitle":"threshold_signature · 2020","summary":"The online-round claim presupposes valid presignatures; total latency must include replenishing them.","title":"UC noninteractive-online threshold ECDSA with identifiable aborts","type":"construction","venue":"ACM CCS 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2020-CGGMP"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2020-FROST","keywords":["threshold_signature","threshold_schnorr","ordinary-verifier-output","two-round","optional-preprocessing","true-threshold"],"metadata":{"adaptive_security":"no; static proof profile","assumption":{"family":"discrete_log","name":"discrete logarithm"},"base_signature":"Schnorr","capabilities":["ordinary-verifier-output","two-round","optional-preprocessing","true-threshold"],"communication":"two messages per signer in the two-round mode","construction_family":"threshold_schnorr","corruption_model":"static adversary controlling fewer than the threshold","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2020-FROST","identifiable_abort":"operational participant identification in the paper protocol","name":"FROST threshold Schnorr","output_compatibility":"ordinary Schnorr-family signature under the chosen ciphersuite","post_quantum_mechanism":"none","preprocessing":"optional nonce-commitment preprocessing","primitive":"threshold_signature","resilience":"true threshold participation","robustness":"abort and identify/exclude a misbehaving participant","security":{"mode":"threshold public-key","model":"random-oracle lineage","notion":"chosen-message threshold unforgeability"},"setup_model":"threshold key shares; DKG can be composed separately","signing_rounds":"two rounds; one online round with preprocessing","sizes":{"public_key":"ordinary Schnorr public key","signature":"ordinary Schnorr signature"},"status":"standards_lineage","threshold_policy":"t-out-of-n","title":"FROST threshold Schnorr","work_id":"TSIG-PAPER-2020-FROST","year":2020},"primaryUrl":"https://eprint.iacr.org/2020/852","sections":[{"content":"Nonce commitments are consumable protocol material; Figure 3 requires deletion after use, and Section 5.2 warns that reuse can expose the long-term secret share. FROST attributes an invalid response and aborts; it does not guarantee completion against withholding participants.","heading":"Construction note"}],"slug":"kg20-frost-threshold-schnorr","status":"fulltext_reviewed","subtitle":"threshold_signature · 2020","summary":"Nonce commitments are consumable protocol material; Figure 3 requires deletion after use, and Section 5.2 warns that reuse can expose the long-term secret share. FROST attributes an invalid response and aborts; it does not guarantee completion against withholding participants.","title":"FROST threshold Schnorr","type":"construction","venue":"SAC 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2020-FROST"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2021-DOTT","keywords":["threshold_signature","lattice_fswa_distributed","post-quantum","two-round","abort-leakage-defense"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"lattice","name":"Module-SIS and Module-LWE"},"base_signature":"Dilithium-G-style Fiat-Shamir with aborts","capabilities":["post-quantum","two-round","abort-leakage-defense"],"communication":"two-round commitments and masked lattice responses","construction_family":"lattice_fswa_distributed","corruption_model":"malicious adversary under the paper model","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2021-DOTT","identifiable_abort":"commitment-based transcript protection, not general robust completion","name":"DOTT n-out-of-n lattice signature","output_compatibility":"distributed Dilithium-G variant; verifier/parameters differ from standardized Dilithium","post_quantum_mechanism":"Module-SIS and Module-LWE","preprocessing":"no online-round reduction stated in the paper","primitive":"threshold_signature","resilience":"all n signers required","robustness":"abort leakage is hidden; availability still fails when one signer withholds","security":{"mode":"n-out-of-n","model":"random-oracle lineage","notion":"distributed-signature unforgeability"},"setup_model":"distributed public key and lattice trapdoor commitment machinery","signing_rounds":"two","sizes":{"public_key":"distributed-scheme public key","signature":"grows with the paper parameters and signer count"},"status":"foundational_post_quantum","threshold_policy":"n-out-of-n","title":"DOTT two-round lattice distributed signature","work_id":"TSIG-PAPER-2021-DOTT","year":2021},"primaryUrl":"https://eprint.iacr.org/2020/1110","sections":[{"content":"This is a full-threshold distributed signature, not a general t-out-of-n scheme. The paper's two-round profile uses parallel repetition to drive the probability of a successful non-aborting execution high; Section 3.2 explains that a single execution has three messages and succeeds only with its rejection probability.","heading":"Construction note"}],"slug":"dott21-dott-n-out-of","status":"fulltext_reviewed","subtitle":"threshold_signature · 2021","summary":"This is a full-threshold distributed signature, not a general t-out-of-n scheme. The paper's two-round profile uses parallel repetition to drive the probability of a successful non-aborting execution high; Section 3.2 explains that a single execution has three messages and succeeds only with its rejection probability.","title":"DOTT n-out-of-n lattice signature","type":"construction","venue":"PKC 2021; Journal of Cryptology 2022","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2021-DOTT"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2021-GKMN","keywords":["threshold_signature","threshold_schnorr_mpc_nonce","deterministic-nonce","stateless-signing","dishonest-majority","ordinary-verifier-output"],"metadata":{"adaptive_security":"not the paper's main claim","assumption":{"family":"discrete_log","name":"discrete-log and standard symmetric/commitment assumptions"},"base_signature":"Schnorr","capabilities":["deterministic-nonce","stateless-signing","dishonest-majority","ordinary-verifier-output"],"communication":"garbled-circuit and proof dependent","construction_family":"threshold_schnorr_mpc_nonce","corruption_model":"static adversary corrupting up to n-1 parties","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2021-GKMN","identifiable_abort":"protocol-specific","name":"GKMN deterministic-nonce threshold Schnorr","output_compatibility":"ordinary Schnorr signature","post_quantum_mechanism":"none","preprocessing":"reusable commitment setup for the zero-knowledge layer","primitive":"threshold_signature","resilience":"threshold unforgeability","robustness":"abort-oriented","security":{"mode":"threshold public-key","model":"standard assumptions with specified idealizations","notion":"threshold unforgeability with deterministic nonces"},"setup_model":"shared Schnorr key plus UC-commitment and garbled-circuit machinery","signing_rounds":"three","sizes":{"public_key":"ordinary Schnorr public key","signature":"ordinary Schnorr signature"},"status":"research","threshold_policy":"n-out-of-n in the instantiated n-party protocol","title":"Stateless deterministic threshold Schnorr","work_id":"TSIG-PAPER-2021-GKMN","year":2021},"primaryUrl":"https://eprint.iacr.org/2021/1055","sections":[{"content":"Stateless refers to nonce derivation and long-term signer state, not absence of all setup or protocol transcripts.","heading":"Construction note"}],"slug":"gkmn21-gkmn-deterministic-nonce-thr","status":"fulltext_reviewed","subtitle":"threshold_signature · 2021","summary":"Stateless refers to nonce derivation and long-term signer state, not absence of all setup or protocol transcripts.","title":"GKMN deterministic-nonce threshold Schnorr","type":"construction","venue":"CRYPTO 2021","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2021-GKMN"},{"evidence":"fulltext_preprint_reviewed_final_pending","id":"TSIG-CONSTRUCTION-2022-DILIZIUM2","keywords":["threshold_signature","lattice_fswa_distributed","post-quantum","two-party","signature-compression"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"lattice","name":"Module-LWE and Module-SIS"},"base_signature":"Dilithium-derived","capabilities":["post-quantum","two-party","signature-compression"],"communication":"network bytes not benchmarked; signing communication repeats with the audited preprint's average 101.55 rejections","construction_family":"lattice_fswa_distributed","corruption_model":"one malicious party under the paper model","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2022-DILIZIUM2","identifiable_abort":"not promoted from the outdated preprint","name":"DiLizium 2.0 two-party Dilithium-line signature","output_compatibility":"closer to Dilithium through signature compression; exact standard interoperability not asserted","post_quantum_mechanism":"Module-LWE and Module-SIS","preprocessing":"differs between the preprint and the final version","primitive":"threshold_signature","resilience":"both parties required","robustness":"abort-oriented","security":{"mode":"two-party","model":"classical random oracle in the preprint","notion":"two-party signature unforgeability"},"setup_model":"two-party shared module-lattice secret and additively homomorphic commitment","signing_rounds":"three in the audited ePrint","sizes":{"public_key":"2976 bytes in the audited preprint","secret_key_share":"8864 bytes in the audited preprint","signature":"21120 bytes in the audited preprint"},"status":"published_final_version_pending_audit","threshold_policy":"2-out-of-2","title":"DiLizium 2.0","work_id":"TSIG-PAPER-2022-DILIZIUM2","year":2022},"primaryUrl":"https://eprint.iacr.org/2022/644","sections":[{"content":"The ePrint page says the preprint is outdated. Section 4 reports Java 17/Bouncy Castle measurements on an AMD Ryzen 5 PRO 3500U: 1.48 ms key generation, 174.65 ms signing, 1.18 ms verification, and 101.55 average rejections over 1000 executions, excluding network delay. All values are retained only as preprint observations, not current journal benchmarks.","heading":"Version warning"}],"slug":"lsv22-dilizium-2-0-two","status":"fulltext_preprint_reviewed_final_pending","subtitle":"threshold_signature · 2022","summary":"The ePrint page says the preprint is outdated. Section 4 reports Java 17/Bouncy Castle measurements on an AMD Ryzen 5 PRO 3500U: 1.48 ms key generation, 174.65 ms signing, 1.18 ms verification, and 101.55 average rejections over 1000 executions, excluding network delay. All values are retained only as preprint observations, not current journal benchmarks.","title":"DiLizium 2.0 two-party Dilithium-line signature","type":"construction","venue":"Journal of Computer Security final version","year":2022,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2022-DILIZIUM2"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2023-GKS","keywords":["threshold_signature","lattice_threshold_he","post-quantum","arbitrary-threshold","two-round","distributed-key-generation"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"lattice","name":"standard Ring-LWE and SIS-family lattice assumptions"},"base_signature":"lattice Fiat-Shamir-with-aborts line","capabilities":["post-quantum","arbitrary-threshold","two-round","distributed-key-generation"],"communication":"two online rounds with ciphertext/proof overhead","construction_family":"lattice_threshold_he","corruption_model":"active adversary under the paper threshold-HE model","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2023-GKS","identifiable_abort":"exact property not promoted","name":"GKS threshold-HE lattice signature","output_compatibility":"scheme-specific lattice signature","post_quantum_mechanism":"Ring-LWE and SIS lineage through threshold HE and the signature layer","preprocessing":"DKG and threshold-HE setup","primitive":"threshold_signature","resilience":"arbitrary threshold t<=n","robustness":"abort handling within active security; guaranteed output not claimed here","security":{"mode":"t-out-of-n","model":"random-oracle lineage","notion":"actively secure threshold signing"},"setup_model":"actively secure threshold linearly homomorphic encryption and distributed key generation","signing_rounds":"two","sizes":{"public_key":"13.6 KB for that same estimate","signature":"46.6 KB for the paper's 128-bit 3-out-of-5 estimate"},"status":"research","threshold_policy":"arbitrary t-out-of-n","title":"GKS two-round t-out-of-n lattice signature","work_id":"TSIG-PAPER-2023-GKS","year":2023},"primaryUrl":"https://eprint.iacr.org/2023/1318","sections":[{"content":"The concrete byte figures are bound to the paper's stated 3-out-of-5, 128-bit estimate and are not universal scheme constants. Figure 7 gives the actively secure two-round protocol; Theorem 3 includes the threshold-HE, NIZK, commitment, and random-oracle terms rather than reducing the complete package to Ring-LWE/SIS alone in one step.","heading":"Construction note"}],"slug":"gks23-gks-threshold-he-lattice","status":"fulltext_reviewed","subtitle":"threshold_signature · 2023","summary":"The concrete byte figures are bound to the paper's stated 3-out-of-5, 128-bit estimate and are not universal scheme constants. Figure 7 gives the actively secure two-round protocol; Theorem 3 includes the threshold-HE, NIZK, commitment, and random-oracle terms rather than reducing the complete package to Ring-LWE/SIS alone in one step.","title":"GKS threshold-HE lattice signature","type":"construction","venue":"PQCrypto 2024","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2023-GKS"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-2023-OLAF","keywords":["threshold_signature","threshold_schnorr","ordinary-verifier-output","proof-without-agm","pedersen-dkg"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"discrete_log","name":"algebraic one-more discrete logarithm and random oracle"},"base_signature":"Schnorr","capabilities":["ordinary-verifier-output","proof-without-agm","pedersen-dkg"],"communication":"FROST3 profile plus DKG cost","construction_family":"threshold_schnorr","corruption_model":"static threshold adversary in the proof","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-2023-OLAF","identifiable_abort":"protocol-specific","name":"Olaf FROST3 with Pedersen DKG","output_compatibility":"ordinary Schnorr-family signature","post_quantum_mechanism":"none","preprocessing":"FROST-family nonce preprocessing options","primitive":"threshold_signature","resilience":"threshold unforgeability","robustness":"abort-oriented FROST family","security":{"mode":"threshold public-key","model":"ROM without AGM","notion":"threshold unforgeability"},"setup_model":"Pedersen-DKG variant composed with FROST3","signing_rounds":"FROST3 signing profile","sizes":{"public_key":"ordinary Schnorr public key plus DKG verification data","signature":"ordinary Schnorr signature"},"status":"research","threshold_policy":"t-out-of-n","title":"Olaf threshold Schnorr","work_id":"TSIG-PAPER-2023-OLAF","year":2023},"primaryUrl":"https://eprint.iacr.org/2023/899","sections":[{"content":"Removing AGM from the proof does not mean the scheme relies only on plain discrete log; the AOMDL assumption is recorded explicitly.","heading":"Construction note"}],"slug":"cgrs23-olaf-frost3-with-pedersen","status":"primary_source_reviewed","subtitle":"threshold_signature · 2023","summary":"Removing AGM from the proof does not mean the scheme relies only on plain discrete log; the AOMDL assumption is recorded explicitly.","title":"Olaf FROST3 with Pedersen DKG","type":"construction","venue":"CRYPTO 2023","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2023-OLAF"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2024-AOMMLWE","keywords":["threshold_signature","lattice_one_more","post-quantum","two-round","noninteractive-online","large-threshold"],"metadata":{"adaptive_security":"no for signer corruption; the main reduction uses adaptive AOM-MLWE as an assumption","assumption":{"family":"lattice_one_more","name":"adaptive AOM-MLWE and PRF security; selective AOM-UMLWE has a UMLWE/MSIS reduction"},"base_signature":"Lyubashevsky-style lattice signature","capabilities":["post-quantum","two-round","noninteractive-online","large-threshold"],"communication":"at 128-bit security and T=1024, 14.1 KB optimized online or 276 KB naive online per user, plus 262 KB offline","construction_family":"lattice_one_more","corruption_model":"selective/static corruption of fewer than T signers","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2024-AOMMLWE","identifiable_abort":"no; misbehavior detection is left as future work","name":"Two-round threshold signature from AOM-MLWE","output_compatibility":"scheme-specific lattice signature","post_quantum_mechanism":"adaptive AOM-MLWE; only its selective variant is reduced from UMLWE and MSIS","preprocessing":"first round can be prepared without the message or signer set","primitive":"threshold_signature","resilience":"threshold signing","robustness":"no; robust signing is left as future work","security":{"mode":"T-out-of-N","model":"selective-corruption random-oracle game under adaptive AOM-MLWE","notion":"threshold unforgeability"},"setup_model":"trusted-dealer key generation; DKG is left as future work","signing_rounds":"two; online phase noninteractive after message-independent preprocessing","sizes":{"public_key":"5.5 KB for the same Table 3 profile","signature":"10.8 KB at 128-bit security and T=1024"},"status":"research","threshold_policy":"arbitrary T-out-of-N with concrete support up to T=1024","title":"AOM-MLWE two-round lattice threshold signature","work_id":"TSIG-PAPER-2024-AOMMLWE","year":2024},"primaryUrl":"https://eprint.iacr.org/2024/496","sections":[{"content":"The assumption axis is intentionally separated from standard MLWE-only constructions. Theorem 6.1 bases threshold unforgeability on adaptive AOM-MLWE, whereas Theorem 4.5 reduces only selective AOM-UMLWE to UMLWE and MSIS; the final revision leaves bridging this adaptivity gap open.","heading":"Construction note"}],"slug":"ekt24-two-round-threshold-signatur","status":"fulltext_reviewed","subtitle":"threshold_signature · 2024","summary":"The assumption axis is intentionally separated from standard MLWE-only constructions. Theorem 6.1 bases threshold unforgeability on adaptive AOM-MLWE, whereas Theorem 4.5 reduces only selective AOM-UMLWE to UMLWE and MSIS; the final revision leaves bridging this adaptivity gap open.","title":"Two-round threshold signature from AOM-MLWE","type":"construction","venue":"CRYPTO 2024; Journal of Cryptology revision","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2024-AOMMLWE"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-2024-FLOOD","keywords":["threshold_signature","lattice_hash_and_sign_submersion","post-quantum","robust-dkg","hash-and-sign","no-fhe"],"metadata":{"adaptive_security":"not stated in the paper","assumption":{"family":"lattice","name":"Module-LWE"},"base_signature":"lattice hash-and-sign","capabilities":["post-quantum","robust-dkg","hash-and-sign","no-fhe"],"communication":"paper-specific; no FHE ciphertext layer","construction_family":"lattice_hash_and_sign_submersion","corruption_model":"malicious threshold adversary under the paper model","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-2024-FLOOD","identifiable_abort":"verifiable shares support blame; exact interface follows paper","name":"Robust hash-and-sign lattice threshold signature","output_compatibility":"scheme-specific hash-and-sign lattice verifier","post_quantum_mechanism":"MLWE, random submersions, and noise flooding","preprocessing":"verifiable short-secret-sharing and DKG material","primitive":"threshold_signature","resilience":"threshold unforgeability","robustness":"yes, including key generation in the paper claim","security":{"mode":"threshold public-key","model":"random oracle","notion":"robust threshold unforgeability"},"setup_model":"robust DKG via random submersions","signing_rounds":"distributed hash-and-sign protocol; exact count parameterized","sizes":{"public_key":"parameter-set-specific","signature":"about 13 KB in the paper's typical T=16 parameter set"},"status":"research","threshold_policy":"general threshold profile with a representative T=16 parameter set","title":"Flood and Submerse threshold signature","work_id":"TSIG-PAPER-2024-FLOOD","year":2024},"primaryUrl":"https://eprint.iacr.org/2024/959","sections":[{"content":"The 13 KB observation is tied to the paper's typical T=16 parameter set.","heading":"Construction note"}],"slug":"enp24-robust-hash-and-sign","status":"primary_source_reviewed","subtitle":"threshold_signature · 2024","summary":"The 13 KB observation is tied to the paper's typical T=16 parameter set.","title":"Robust hash-and-sign lattice threshold signature","type":"construction","venue":"CRYPTO 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2024-FLOOD"},{"evidence":"primary_source_reviewed","id":"TSIG-CONSTRUCTION-2024-GLACIUS","keywords":["threshold_signature","threshold_schnorr_adaptive","ordinary-verifier-output","full-adaptive-security","full-corruption-threshold","identifiable-abort","constant-size-signing-key"],"metadata":{"adaptive_security":"full adaptive security","assumption":{"family":"ddh","name":"decisional Diffie-Hellman"},"base_signature":"Schnorr","capabilities":["ordinary-verifier-output","full-adaptive-security","full-corruption-threshold","identifiable-abort","constant-size-signing-key"],"communication":"exact table parameter-dependent","construction_family":"threshold_schnorr_adaptive","corruption_model":"fully adaptive adversary","dossier_type":"construction","evidence":"primary_source_checked","id":"TSIG-CONSTRUCTION-2024-GLACIUS","identifiable_abort":"yes, with a formal game-based definition","name":"Glacius fully adaptive threshold Schnorr from DDH","output_compatibility":"ordinary Schnorr-family signature","post_quantum_mechanism":"none","preprocessing":"protocol setup and signing-key material","primitive":"threshold_signature","resilience":"full corruption threshold stated as t<n in the paper","robustness":"identifiable abort rather than guaranteed output","security":{"mode":"threshold public-key","model":"random oracle","notion":"fully adaptive threshold unforgeability with identifiable abort"},"setup_model":"distributed Schnorr key with constant-size per-signer signing keys","signing_rounds":"exact protocol phases follow paper","sizes":{"public_key":"ordinary Schnorr public key","signature":"ordinary Schnorr signature"},"status":"published","threshold_policy":"full threshold range t<n under the paper's convention","title":"Glacius threshold Schnorr","work_id":"TSIG-PAPER-2024-GLACIUS","year":2024},"primaryUrl":"https://eprint.iacr.org/2024/1628","sections":[{"content":"DDH here is a precise proof assumption for a 2024/2025 threshold-Schnorr result, not the origin assumption of the entire threshold-signature field.","heading":"Construction note"}],"slug":"bdlr24-glacius-fully-adaptive-thres","status":"primary_source_reviewed","subtitle":"threshold_signature · 2024","summary":"DDH here is a precise proof assumption for a 2024/2025 threshold-Schnorr result, not the origin assumption of the entire threshold-signature field.","title":"Glacius fully adaptive threshold Schnorr from DDH","type":"construction","venue":"EUROCRYPT 2025","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2024-GLACIUS"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2024-RACCOON","keywords":["threshold_signature","lattice_masked_partial_signatures","post-quantum","large-threshold","implementation","symmetric-and-simple-lattice-signing"],"metadata":{"adaptive_security":"no; static corruption game","assumption":{"family":"lattice","name":"Hint-MLWE and SelfTargetMSIS with reductions to MLWE/MSIS"},"base_signature":"Raccoon lattice signature","capabilities":["post-quantum","large-threshold","implementation","symmetric-and-simple-lattice-signing"],"communication":"Table 2 reports 40.8 KB per signer at kappa=128; implementation accounting is 40800+16T bytes with pairwise MACs","construction_family":"lattice_masked_partial_signatures","corruption_model":"static corrupt set chosen before key generation with fewer than T parties","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2024-RACCOON","identifiable_abort":"no; left as future work","name":"Threshold Raccoon practical lattice signature","output_compatibility":"verification algorithm identical to the paper's Raccoon variant; concrete parameters are not tuned for Raccoon interchangeability","post_quantum_mechanism":"Module-LWE and Module-SIS lineage","preprocessing":"pairwise PRF seeds provisioned at key generation; per-session additive masks are generated online","primitive":"threshold_signature","resilience":"threshold signing under standard lattice assumptions","robustness":"abort-oriented; robustness against malicious failure is left as future work","security":{"mode":"T-out-of-N","model":"random-oracle static-corruption game with bounded signing queries","notion":"threshold unforgeability"},"setup_model":"trusted centralized key generation; a compatible DKG is outside the paper's scope","signing_rounds":"three","sizes":{"public_key":"3.9 KB in Table 2; implementation value 3856 bytes","signature":"12.7 KB at kappa=128 in Table 2; implementation upper bound 12736 bytes with high probability"},"status":"published","threshold_policy":"any 1<=T<=N<=1024 in the concrete parameter profile","title":"Threshold Raccoon","work_id":"TSIG-PAPER-2024-RACCOON","year":2024},"primaryUrl":"https://eprint.iacr.org/2024/184","sections":[{"content":"The paper requires a unique session identifier so pairwise PRF-derived masks are never reused. At the 128-bit parameter set, Table 3 reports three per-signer ShareSign phases; Section 9 reports 116 ms per signer at T=1024 only when communication latency is ignored and 4.5 GHz turbo is enabled.","heading":"Construction note"}],"slug":"pkm24-threshold-raccoon-practical","status":"fulltext_reviewed","subtitle":"threshold_signature · 2024","summary":"The paper requires a unique session identifier so pairwise PRF-derived masks are never reused. At the 128-bit parameter set, Table 3 reports three per-signer ShareSign phases; Section 9 reports 116 ms per signer at T=1024 only when communication latency is ignored and 4.5 GHz turbo is enabled.","title":"Threshold Raccoon practical lattice signature","type":"construction","venue":"EUROCRYPT 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2024-RACCOON"},{"evidence":"fulltext_reviewed","id":"TSIG-CONSTRUCTION-2024-TANG","keywords":["threshold_signature","lattice_mpc_rejection_sampling","post-quantum","arbitrary-threshold","interchangeable-output","proactive-refresh","implementation"],"metadata":{"adaptive_security":"proactive mobile-corruption security across refresh periods; not full within-period adaptive security","assumption":{"family":"lattice","name":"MLWE and MSIS plus the FPREP-hybrid preprocessing model"},"base_signature":"paper-specific lattice signature with ordinary verifier","capabilities":["post-quantum","arbitrary-threshold","interchangeable-output","proactive-refresh","implementation"],"communication":"1.417 MB sent per party in 15 online rounds for the Table 4 profile","construction_family":"lattice_mpc_rejection_sampling","corruption_model":"mobile malicious adversary corrupting at most \\( t-1 \\) parties in each refresh period","dossier_type":"construction","evidence":"fulltext_checked","id":"TSIG-CONSTRUCTION-2024-TANG","identifiable_abort":"no general identifiable-abort claim promoted","name":"Functionally interchangeable lattice threshold signature","output_compatibility":"yes; same verification algorithm as the paper's non-threshold signature","post_quantum_mechanism":"lattice assumptions and efficient distributed rejection sampling","preprocessing":"t-out-of-n authenticated bits and Beaver triples generated before DKG and signing; the reported batch supports five signatures","primitive":"threshold_signature","resilience":"t-out-of-n signing","robustness":"abort and restart on failed distributed rejection or MAC checks; guaranteed output not claimed","security":{"mode":"t-out-of-n","model":"random oracle and FPREP hybrid","notion":"proactive threshold EUF-CMA"},"setup_model":"t-out-of-n SPDZ variant and distributed key generation","signing_rounds":"15 online rounds in the Table 3 parameter profile","sizes":{"public_key":"same as the paper's non-threshold base public key and independent of party count","signature":"same as the paper's non-threshold base signature and independent of party count"},"status":"published","threshold_policy":"arbitrary t-out-of-n","title":"Tang-Pang-Chen-Zhang lattice threshold signature","work_id":"TSIG-PAPER-2024-TANG","year":2024},"primaryUrl":"https://doi.org/10.1109/TIFS.2023.3293408","sections":[{"content":"The 1.417 MB and 15-round figures are per-party online costs under Table 4's 123-classical/112-quantum-bit parameter setting. The MP-SPDZ-derived implementation reports 0.5-second two-party LAN signing and 1.5-second two-party WAN signing; these are environment-specific measurements, not cross-paper rankings.","heading":"Construction note"}],"slug":"tpcz23-functionally-interchangeable","status":"fulltext_reviewed","subtitle":"threshold_signature · 2024","summary":"The 1.417 MB and 15-round figures are per-party online costs under Table 4's 123-classical/112-quantum-bit parameter setting. The MP-SPDZ-derived implementation reports 0.5-second two-party LAN signing and 1.5-second two-party WAN signing; these are environment-specific measurements, not cross-paper rankings.","title":"Functionally interchangeable lattice threshold signature","type":"construction","venue":"IEEE Transactions on Information Forensics and Security 18, 4173–4187","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-CONSTRUCTION-2024-TANG"},{"evidence":"synthesized_from_sources","id":"TSIG-GOAL-001","keywords":["ml-dsa","fips-204","lattice","post-quantum","round-complexity","threshold-fhe","interchangeable-output"],"metadata":{"basis":"synthesized","dossier_type":"goal","evidence":"synthesized_from_sources","frontier":[{"cells":{"any_threshold":"yes","dishonest_majority":"yes","few_rounds_direct":"no","lattice_assumptions":"yes","ml_dsa_verifier":"yes"},"hardness_assumption":"LWE with modulus \\( 2^{\\tilde O(d)} \\) for signing depth \\( d \\)","line":"Universal thresholdizer (threshold FHE)","note":"One round for any deterministic signature scheme, Dilithium included, by evaluating all of signing under threshold FHE; each partial decryption carries a proof. The LWE modulus grows exponentially in the depth of the signing circuit, and ML-DSA must be run in its deterministic mode.","security_model":["common reference string"],"setting":"any \\( t \\) of \\( n \\) signers","sources":[{"locator":"Construction 8.16 and Theorem 8.20, §8.2, pp. 32-33; Theorem 3.10, p. 11","paper":"TSIG-PAPER-2018-BGGJKRS"},{"locator":"§4.1, PDF p. 52","paper":"TSIG-PAPER-2026-PASSELEGUE"}]},{"cells":{"any_threshold":"yes","dishonest_majority":"no","few_rounds_direct":"no","lattice_assumptions":"no","ml_dsa_verifier":"partial"},"hardness_assumption":"threshold CKKS; a Darkmatter-type PRF","line":"THED (threshold FHE, concrete)","note":"Two rounds for every \\( t \\) and \\( n \\), one of them preprocessable, with signing evaluated under threshold FHE. Proved against passive adversaries only, assuming aborted transcripts are harmless. The construction is described for round-3 Dilithium, so exact FIPS 204 conformance is unchecked.","security_model":["unknown"],"setting":"any \\( t \\) of \\( n \\) signers; passive adversaries","sources":[{"locator":"abstract (ePrint 2026/638)","paper":"TSIG-PAPER-2026-THED"},{"locator":"§4.2, PDF p. 53; §4.4, PDF pp. 58-61","paper":"TSIG-PAPER-2026-PASSELEGUE"}]},{"cells":{"any_threshold":"no","dishonest_majority":"yes","few_rounds_direct":"yes","lattice_assumptions":"yes","ml_dsa_verifier":"yes"},"hardness_assumption":"ML-DSA unforgeability; MLWE","line":"Short replicated sharing","note":"Three rounds per attempt, the first offline, about 1 MB per party, but the number of shares per party grows with \\( \\binom{N}{T-1} \\), so costs grow roughly as \\( \\exp(O(T\\sqrt{\\binom{N}{T-1}})) \\) and parameters stop at six parties.","security_model":["unknown"],"setting":"at most six parties, \\( n \\le 6 \\)","sources":[{"locator":"Abstract and §1.1, pp. 6305-6306; Remark 2, p. 6312; Theorem 3.2, p. 6314; §3.5 and Table 3, p. 6317","paper":"TSIG-PAPER-2026-CELI"}]},{"cells":{"any_threshold":"yes","dishonest_majority":"no","few_rounds_direct":"no","lattice_assumptions":"yes","ml_dsa_verifier":"yes"},"hardness_assumption":"ML-DSA no-message security; MLWE","line":"Honest-majority MPC","note":"Any number of parties, with \\( t \\) of \\( n = 2t + 1 \\) corrupted, after a small change to signing that keeps the standard verifier. The rejection test runs in MPC: 16 or 29 online rounds per attempt after 81 to 108 offline rounds.","security_model":["quantum random oracle"],"setting":"honest majority, \\( t_c \\) of \\( n = 2t_c + 1 \\) corrupted","sources":[{"locator":"§1.1, p. 2; §2.2, p. 5; Theorems 1 and 3, pp. 8 and 11; §5.1, Tables 3-5, p. 13","paper":"TSIG-PAPER-2026-QUORUS"}]},{"cells":{"any_threshold":"yes","dishonest_majority":"yes","few_rounds_direct":"yes","lattice_assumptions":"yes","ml_dsa_verifier":"no"},"hardness_assumption":"the lattice assumptions underlying Dilithium","line":"Threshold Raccoon","note":"Three rounds with pairwise one-time masks and ordinary Shamir shares, thresholds up to 1024, 12.7 KB signatures; Raccoon has no rejection sampling and its own verifier.","security_model":["random oracle"],"setting":"thresholds up to 1024 signers","sources":[{"locator":"§§1.1 and 2.3, PDF pp. 4-10; Theorem 7.2, PDF pp. 20-25; Tables 2-3, PDF pp. 43-44","paper":"TSIG-PAPER-2024-RACCOON"}]},{"cells":{"any_threshold":"partial","dishonest_majority":"yes","few_rounds_direct":"no","lattice_assumptions":"no","ml_dsa_verifier":"no"},"hardness_assumption":"FALCON unforgeability; dual-LPN","line":"Threshold FALCON by generic MPC","note":"Signatures pass the unmodified verifier of FALCON, the other NIST-selected lattice signature, not ML-DSA's. Signing runs through any MPC back end, implemented for N of N parties against N − 1 static malicious ones; for N = 4 a Falcon-512 signature takes 7.66 s online, amortized over 2000 signatures, and about 6,189 rounds.","security_model":["unknown"],"setting":"\\( n \\) of \\( n \\) parties, \\( n - 1 \\) static malicious corruptions","sources":[{"locator":"abstract and §1.1, pp. 1-3; §3 'Security Model', p. 9; Theorem 2 and Remark 1, pp. 17-18; §8.1-8.3 and Tables 3-4, pp. 20-23","paper":"TSIG-PAPER-2026-GEPTW"}]}],"id":"TSIG-GOAL-001","keywords":["ml-dsa","fips-204","lattice","post-quantum","round-complexity","threshold-fhe","interchangeable-output"],"layers":[{"best":"one round via threshold FHE","distance":"reached","distance_note":"Reached in principle in 2018 by evaluating all of signing under threshold FHE; the asymptotic dimension asks for it without that.","layer":"feasibility","rungs":[{"kind":"construction","level":"Any deterministic signature, ML-DSA included, in one round by evaluating signing under threshold FHE.","problem":"TSIG-OP-005","sources":[{"locator":"Construction 8.16 and Theorem 8.20, §8.2, pp. 32-33","paper":"TSIG-PAPER-2018-BGGJKRS"},{"locator":"§4.1, PDF p. 52","paper":"TSIG-PAPER-2026-PASSELEGUE"}],"status":"reached","year":2018}],"target":"ML-DSA output, any \\( t \\), \\( t-1 \\) malicious"},{"best":"LWE, modulus exponential in depth","distance":"reached","distance_note":"The threshold-FHE construction needs only LWE and the unforgeability of the base scheme, though its modulus grows exponentially in the depth of signing.","layer":"assumptions","rungs":[{"kind":"construction","level":"LWE-based threshold FHE plus unforgeability of the base scheme, with no heuristic.","sources":[{"locator":"Theorem 3.10, p. 11; Theorem 8.20, p. 33","paper":"TSIG-PAPER-2018-BGGJKRS"}],"status":"reached","year":2018}],"target":"ML-DSA's own lattice assumptions"},{"best":"three rounds, up to six parties","distance":"partway","distance_note":"Three rounds without FHE are reached only for at most six parties or for Raccoon's own verifier; for any \\( n \\) with the ML-DSA verifier the direct protocol needs an honest majority and 16 or more online rounds.","layer":"asymptotic","near_misses":[{"gives_up":"any_threshold","level":"Three rounds per attempt against a dishonest majority, for at most six parties.","problem":"TSIG-OP-002","sources":[{"locator":"Remark 2, p. 6312; Theorem 3.2, p. 6314; §3.5 and Table 3, p. 6317","paper":"TSIG-PAPER-2026-CELI"}],"year":2026},{"gives_up":"dishonest_majority","level":"Any number of parties with an honest majority, in 16 or 29 online rounds after an offline phase.","problem":"TSIG-OP-004","sources":[{"locator":"Theorem 3, p. 11; §5.1, Tables 3-5, p. 13","paper":"TSIG-PAPER-2026-QUORUS"}],"year":2026},{"gives_up":"dishonest_majority","level":"At most three rounds with an honest majority: still open.","problem":"TSIG-OP-003","status":"open"},{"gives_up":"ml_dsa_verifier","level":"Raccoon's own verifier: three rounds for thresholds up to 1024.","problem":"TSIG-OP-006","sources":[{"locator":"Theorem 7.2, PDF pp. 20-25; Tables 2-3, PDF pp. 43-44","paper":"TSIG-PAPER-2024-RACCOON"}],"year":2024}],"rungs":[{"kind":"construction","level":"One round, but only by evaluating all of signing under threshold FHE.","sources":[{"locator":"Construction 8.16, §8.2, p. 32","paper":"TSIG-PAPER-2018-BGGJKRS"}],"status":"reached","year":2018},{"barrier":"TSIG-BARRIER-002","kind":"barrier","level":"Rejected attempts must stay hidden: the single-signer rejection proof does not carry over to separately aborting parties."},{"barrier":"TSIG-BARRIER-001","kind":"barrier","level":"Ordinary Shamir shares of the short key are not short, so direct signing for any \\( t \\) needs a new sharing method."},{"kind":"construction","level":"At most three rounds for any \\( t \\le n \\) with the ML-DSA verifier, against \\( t-1 \\) malicious parties, without FHE or generic MPC.","problem":"TSIG-OP-001","status":"open"}],"target":"≤ 3 rounds per attempt, no FHE or MPC"},{"layer":"concrete","not_applicable":"The covered papers name applications only in passing (wallets, certificate authorities, credential issuance; TSIG-PAPER-2026-GEPTW, §1) and give no workload or budget for threshold ML-DSA signing, and NIST's call leaves use cases and threshold profiles for each submitter to name (TSIG-PAPER-2026-NIST8214C, Appendix C.3), so no source fixes what a deployment can afford.","not_applicable_label":"The literature gives no deployment target"}],"recognized_by":[{"locator":"Ch. 5, paragraph 'Threshold Lattice-Based Signatures', PDF p. 63 (printed p. 55)","paper":"TSIG-PAPER-2026-PASSELEGUE","statement":"States that an ideal threshold Dilithium/ML-DSA protocol would combine low computational cost, few rounds, low communication, scalability to large \\( n \\) and \\( t \\), and malicious security, and that no existing approach combines all of them."},{"locator":"§1, p. 6305","paper":"TSIG-PAPER-2026-CELI","statement":"States that no practical threshold construction for ML-DSA existed and calls its absence a deep technical challenge caused by rejection sampling."},{"locator":"§1, paragraph 'Difficulties in designing threshold ML-DSA', p. 2","paper":"TSIG-PAPER-2026-QUORUS","statement":"Calls a threshold version of standardized ML-DSA an elusive open problem, because generic MPC would have to evaluate SHA-3 on hidden inputs at prohibitive cost."},{"locator":"Table 6 and Requirement 10.1","paper":"TSIG-PAPER-2026-NIST8214C","statement":"Lists ML-DSA signing as a target of NIST's threshold call and requires threshold outputs to pass the standard verifier."}],"requirements":[{"axis":"Setting","key":"ml_dsa_verifier","label":"Standard ML-DSA verifier","layer":"feasibility","target":"signatures are accepted by the unmodified FIPS 204 verifier under an ordinary ML-DSA public key"},{"axis":"Setting","key":"any_threshold","label":"Any \\( t \\le n \\)","layer":"feasibility","target":"every \\( 1 \\le t \\le n \\le \\mathrm{poly}(\\lambda) \\), with per-party communication and computation \\( \\mathrm{poly}(\\lambda, n) \\)"},{"axis":"Security","key":"dishonest_majority","label":"Malicious, dishonest majority","layer":"feasibility","target":"unforgeable against a static malicious adversary corrupting \\( t-1 \\) parties, however many signers take part"},{"axis":"Assumption","key":"lattice_assumptions","label":"ML-DSA's assumptions","layer":"assumptions","target":"MLWE and SelfTargetMSIS, or ML-DSA unforgeability plus lattice assumptions, with no heuristic about rejected attempts"},{"axis":"Efficiency","key":"few_rounds_direct","label":"Three rounds, no FHE or MPC","layer":"asymptotic","target":"at most three rounds per attempt and \\( O(1) \\) expected attempts, without evaluating signing under FHE or generic MPC"}],"reviewed_by":[],"status":"open","summary":"Any \\( t \\) of \\( n \\) parties produce ordinary ML-DSA signatures in a few rounds, against \\( t-1 \\) malicious parties, from ML-DSA's own lattice assumptions and without evaluating signing under FHE or generic MPC. Every known protocol gives up at least one of these.","title":"Few-round threshold ML-DSA for any threshold"},"primaryUrl":null,"sections":[{"content":"ML-DSA is the standardized post-quantum signature, and NIST's threshold call\nasks for threshold signing whose output its unmodified verifier accepts\n(TSIG-PAPER-2026-NIST8214C). For Schnorr and ECDSA, a few rounds and any\nthreshold were reached years ago (TSIG-PAPER-2020-FROST,\nTSIG-PAPER-2020-CGGMP). ML-DSA retries until its response is short and must\nhide the rejected attempts, and its short key does not survive ordinary\nsecret sharing, so each published protocol keeps only some of the properties\nthe area asks for at once (TSIG-PAPER-2026-PASSELEGUE, Ch. 5).","heading":"Why this goal"},{"content":"$8","heading":"Reading the frontier"}],"slug":"goal-1","status":"open","subtitle":"","summary":"Few-round threshold ML-DSA for any threshold","title":"Few-round threshold ML-DSA for any threshold","type":"goal","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-GOAL-001"},{"evidence":"synthesized_from_sources","id":"TSIG-GOAL-002","keywords":["schnorr","frost","adaptive-security","two-round","aomdl","ddh","algebraic-group-model"],"metadata":{"basis":"synthesized","dossier_type":"goal","evidence":"synthesized_from_sources","frontier":[{"cells":{"full_adaptive":"partial","schnorr_output":"yes","standard_assumption":"yes","two_rounds":"yes"},"hardness_assumption":"AOMDL","line":"FROST: static or half-threshold adaptive security","note":"Two rounds with standard output, secure under AOMDL in the random oracle model alone against static corruptions, but against adaptive corruptions only up to \\( \\lfloor (t-1)/2 \\rfloor \\) parties.","security_model":["random oracle"],"setting":"static corruptions, or adaptive corruptions of up to \\( \\lfloor (t-1)/2 \\rfloor \\) parties","sources":[{"locator":"§§5.1-5.2, PDF pp. 10-15; Theorem 6.1, PDF pp. 16-18","paper":"TSIG-PAPER-2020-FROST"},{"locator":"abstract and proof overview (ePrint 2023/899)","paper":"TSIG-PAPER-2023-OLAF"},{"locator":"Theorem 1, §3, PDF p. 12","paper":"TSIG-PAPER-2025-CKKTZ"}]},{"cells":{"full_adaptive":"yes","schnorr_output":"yes","standard_assumption":"no","two_rounds":"yes"},"hardness_assumption":"AOMDL; LDVR","line":"FROST: fully adaptive security","note":"The same two-round FROST is secure against adaptive corruption of up to \\( t-1 \\) parties, but the proof needs the algebraic group model and the new LDVR assumption.","security_model":["algebraic group","random oracle"],"setting":"adaptive corruptions of up to \\( t-1 \\) parties","sources":[{"locator":"Theorem 2, §4.3, PDF p. 18","paper":"TSIG-PAPER-2025-CKKTZ"}]},{"cells":{"full_adaptive":"yes","schnorr_output":"yes","standard_assumption":"yes","two_rounds":"no"},"hardness_assumption":"DDH","line":"Glacius","note":"Full adaptive security from DDH with standard output and identifiable abort, in four rounds with state kept across sessions.","security_model":["random oracle"],"setting":"fully adaptive corruptions; signers keep state across sessions","sources":[{"locator":"abstract (ePrint 2024/1628)","paper":"TSIG-PAPER-2024-GLACIUS"},{"locator":"§1 and Table 1, pp. 1-3","paper":"TSIG-PAPER-2025-CHEN"}]},{"cells":{"full_adaptive":"yes","schnorr_output":"yes","standard_assumption":"yes","two_rounds":"partial"},"hardness_assumption":"AOMDL","line":"FROST-Mask","note":"Pairwise masks on FROST's partial signatures give full adaptive security with a rewinding proof. It signs in two rounds if signers keep state across sessions, and in three stateless rounds otherwise.","security_model":["random oracle"],"setting":"fully adaptive corruptions; two rounds with state across sessions, three without","sources":[{"locator":"abstract, p. 1; §1.1, p. 2; Theorem 1, §3.2, p. 15","paper":"TSIG-PAPER-2025-CHEN"}]},{"cells":{"full_adaptive":"yes","schnorr_output":"no","standard_assumption":"yes","two_rounds":"yes"},"hardness_assumption":"discrete logarithm","line":"HBTS-Mask","note":"Two stateless rounds and full adaptive security from DL, but signatures carry one more scalar than a Schnorr signature and need their own verifier.","security_model":["random oracle"],"setting":"fully adaptive corruptions; stateless","sources":[{"locator":"abstract, p. 1; §1.1, p. 2; Theorem 2, §4.2, p. 26","paper":"TSIG-PAPER-2025-CHEN"}]},{"cells":{"full_adaptive":"yes","schnorr_output":"yes","standard_assumption":"no","two_rounds":"yes"},"hardness_assumption":"AOMDL","line":"ms-FROST and FaFROST","note":"The same masked FROST variant, found independently: two stateless rounds with a message-independent first round, fully adaptive under AOMDL in the algebraic group model. No algebraic black-box reduction from AOMDL in the random oracle model alone proves it adaptively secure.","security_model":["algebraic group","random oracle"],"setting":"fully adaptive corruptions; stateless","sources":[{"locator":"Theorem 1, §4, PDF p. 13; Theorem 2, §5, PDF p. 24","paper":"TSIG-PAPER-2025-MSFROST"},{"locator":"Theorem 1, §6, PDF p. 18","paper":"TSIG-PAPER-2025-FAFROST"}]},{"cells":{"full_adaptive":"yes","schnorr_output":"yes","standard_assumption":"partial","two_rounds":"yes"},"hardness_assumption":"DDH","line":"Equivocal deterministic nonces","note":"Two stateless rounds, fully adaptive from DDH in the random oracle model, but only for a bounded number of signing queries per signer, or for polynomially many when signers refresh part of their public key shares after every bounded batch.","security_model":["random oracle"],"setting":"fully adaptive corruptions; a bounded number of signing queries per signer, or periodic refresh of public-key shares","sources":[{"locator":"Theorem 1, §4, PDF p. 19; Theorem 2, §5, PDF p. 21; Theorem 3, App. B, PDF pp. 35-36","paper":"TSIG-PAPER-2025-GLRS"}]}],"id":"TSIG-GOAL-002","keywords":["schnorr","frost","adaptive-security","two-round","aomdl","ddh","algebraic-group-model"],"layers":[{"best":"DDH, four rounds","distance":"reached","distance_note":"Reached in 2024 from DDH with four rounds; the other two dimensions measure the proof model and the number of rounds.","layer":"feasibility","rungs":[{"kind":"construction","level":"Standard Schnorr output in two rounds, against static corruption.","sources":[{"locator":"§§5.1-5.2, PDF pp. 10-15; Theorem 6.1, PDF pp. 16-18","paper":"TSIG-PAPER-2020-FROST"}],"status":"reached","year":2020},{"kind":"construction","level":"Full adaptive security with standard Schnorr output, from DDH, in four rounds with state.","sources":[{"locator":"abstract (ePrint 2024/1628)","paper":"TSIG-PAPER-2024-GLACIUS"},{"locator":"§1 and Table 1, pp. 1-3","paper":"TSIG-PAPER-2025-CHEN"}],"status":"reached","year":2024}],"target":"Schnorr output, full adaptive security"},{"best":"three stateless rounds under AOMDL","distance":"near","distance_note":"One step: the random oracle model alone gives three stateless rounds; two rounds need the algebraic group model, key refresh, state, or a longer signature.","layer":"assumptions","near_misses":[{"gives_up":"schnorr_output","level":"Two stateless rounds from DL in the random oracle model alone, with one extra scalar in the signature.","problem":"TSIG-OP-012","sources":[{"locator":"§1.1, p. 2; Theorem 2, §4.2, p. 26","paper":"TSIG-PAPER-2025-CHEN"}],"year":2025}],"rungs":[{"kind":"construction","level":"DDH in the random oracle model, four rounds with state.","sources":[{"locator":"abstract (ePrint 2024/1628)","paper":"TSIG-PAPER-2024-GLACIUS"},{"locator":"§1 and Table 1, pp. 1-3","paper":"TSIG-PAPER-2025-CHEN"}],"status":"reached","year":2024},{"kind":"construction","level":"AOMDL in the random oracle model, three stateless rounds (two with state).","problem":"TSIG-OP-011","sources":[{"locator":"§1.1, p. 2; Theorem 1, §3.2, p. 15","paper":"TSIG-PAPER-2025-CHEN"}],"status":"reached","year":2025},{"barrier":"TSIG-BARRIER-003","kind":"barrier","level":"Key-unique schemes such as FROST resist rewinding proofs from one-more DL assumptions beyond about half the threshold."},{"kind":"construction","level":"Two stateless rounds in the random oracle model alone, from DL, DDH or AOMDL.","problem":"TSIG-OP-007","status":"open"}],"target":"two rounds, random oracle model alone"},{"best":"two rounds, AGM or key refresh","distance":"reached","distance_note":"Two stateless rounds with full adaptivity and standard output were reached in 2025, but only with the algebraic group model or periodic key refresh.","layer":"asymptotic","near_misses":[{"gives_up":"full_adaptive","level":"FROST itself, in the random oracle model under AOMDL, against adaptive corruption of about half the threshold.","problem":"TSIG-OP-008","sources":[{"locator":"Theorem 1, §3, PDF p. 12","paper":"TSIG-PAPER-2025-CKKTZ"}],"year":2025}],"rungs":[{"kind":"construction","level":"Four rounds with state across sessions.","sources":[{"locator":"Table 1, p. 3","paper":"TSIG-PAPER-2025-CHEN"}],"status":"reached","year":2024},{"kind":"construction","level":"Three stateless rounds, or two with state.","sources":[{"locator":"§1.1, p. 2","paper":"TSIG-PAPER-2025-CHEN"}],"status":"reached","year":2025},{"kind":"construction","level":"Two stateless rounds, proved in the algebraic group model under AOMDL.","problem":"TSIG-OP-009","sources":[{"locator":"Theorem 1, §4, PDF p. 13","paper":"TSIG-PAPER-2025-MSFROST"},{"locator":"Theorem 1, §6, PDF p. 18","paper":"TSIG-PAPER-2025-FAFROST"}],"status":"reached","year":2025},{"alongside":true,"kind":"construction","level":"Two stateless rounds from DDH, with public key shares refreshed after a bounded number of signatures.","problem":"TSIG-OP-010","sources":[{"locator":"Theorem 1, §4, PDF p. 19; Theorem 3, App. B, PDF pp. 35-36","paper":"TSIG-PAPER-2025-GLRS"}],"status":"reached","year":2025}],"target":"two rounds, stateless signers"},{"layer":"concrete","not_applicable":"The open question is which proof model allows two stateless rounds, not whether a scheme is cheap enough to deploy: no covered paper describes a deployment of fully adaptive threshold Schnorr with a workload or a budget, and NIST's call leaves use cases for each submitter to name (TSIG-PAPER-2026-NIST8214C, Appendix C.3).","not_applicable_label":"The literature gives no deployment target"}],"recognized_by":[{"locator":"abstract, PDF p. 1; §1, PDF pp. 3-4","paper":"TSIG-PAPER-2025-CKKTZ","statement":"States that security of FROST and its variants under adaptive corruptions had remained an open problem, and that no pairing-free two-round threshold scheme with adaptive security was known before, even in the algebraic group model."},{"locator":"abstract, PDF p. 1; §1, PDF p. 2","paper":"TSIG-PAPER-2025-MSFROST","statement":"States that it remained open whether a two-round threshold Schnorr signature with full adaptive security can be built from assumptions more established than LDVR."},{"locator":"§1.1, PDF pp. 2-3","paper":"TSIG-PAPER-2025-GLRS","statement":"Poses the question of a fully adaptively secure threshold Schnorr scheme from falsifiable assumptions with minimal round complexity."},{"locator":"§1, PDF p. 3","paper":"TSIG-PAPER-2025-FAFROST","statement":"Asks for a round-optimal Schnorr threshold signature with full adaptive security under well-established assumptions, for arbitrarily large signing groups."},{"locator":"§9.2.4.2","paper":"TSIG-PAPER-2026-NIST8214C","statement":"States a strong preference for adaptive security in submissions to NIST's threshold call."}],"requirements":[{"axis":"Setting","key":"schnorr_output","label":"Standard Schnorr output","layer":"feasibility","target":"signatures verify as ordinary Schnorr signatures under the group public key, for every \\( t \\le n \\)"},{"axis":"Security","key":"full_adaptive","label":"Fully adaptive","layer":"feasibility","target":"unforgeable when up to \\( t-1 \\) parties are corrupted at any time, revealing their keys and full state (no erasures)"},{"axis":"Model","key":"standard_assumption","label":"Random oracle model alone","layer":"assumptions","target":"proof in the random oracle model under DL, DDH or AOMDL: no algebraic group model, no new assumption, no periodic key refresh"},{"axis":"Efficiency","key":"two_rounds","label":"Two stateless rounds","layer":"asymptotic","target":"two signing rounds, with signers keeping no state across sessions"}],"reviewed_by":[],"status":"open","summary":"Standard Schnorr signatures from a two-round stateless protocol that stays unforgeable when up to \\( t-1 \\) parties are corrupted adaptively, proved in the random oracle model from DL, DDH or AOMDL alone. Every known scheme gives up at least one of these.","title":"Two-round fully adaptive threshold Schnorr"},"primaryUrl":null,"sections":[{"content":"FROST signs in two rounds with ordinary Schnorr output\n(TSIG-PAPER-2020-FROST), but its security is proved against an adversary that\nfixes the corrupted parties in advance. An adversary that\nchooses whom to corrupt after seeing transcripts is the threat NIST's call\nprefers schemes to resist (TSIG-PAPER-2026-NIST8214C, §9.2.4.2), and the\n2025 papers on threshold Schnorr pursue full adaptivity with as few rounds\nas possible from established assumptions (TSIG-PAPER-2025-CKKTZ,\nTSIG-PAPER-2025-MSFROST, TSIG-PAPER-2025-GLRS, TSIG-PAPER-2025-FAFROST).","heading":"Why this goal"},{"content":"Rows group schemes by mechanism, and each gives up one requirement: full\nadaptivity (FROST), two rounds (Glacius, FROST-Mask), standard output\n(HBTS-Mask), or the random oracle model alone (ms-FROST and FaFROST in the\nalgebraic group model; equivocal deterministic nonces with bounded signing\nor key refresh). FROST-Mask is partial on rounds because it needs state\nacross sessions to sign in two. The round count of Glacius is taken from the\ncomparison table of TSIG-PAPER-2025-CHEN.","heading":"Reading the frontier"}],"slug":"goal-2","status":"open","subtitle":"","summary":"Two-round fully adaptive threshold Schnorr","title":"Two-round fully adaptive threshold Schnorr","type":"goal","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-GOAL-002"},{"evidence":"fulltext_checked","id":"TSIG-OP-001","keywords":["ml-dsa","fips-204","threshold-signatures","lattice","interchangeable-output","nist-threshold-call"],"metadata":{"barriers":["TSIG-BARRIER-001","TSIG-BARRIER-002"],"basis":"named","caveat":null,"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-001","keywords":["ml-dsa","fips-204","threshold-signatures","lattice","interchangeable-output","nist-threshold-call"],"named_open_by":[{"locator":"Ch. 5, paragraph 'Threshold Lattice-Based Signatures', PDF p. 63 (printed p. 55) of the author PDF dated 2026-06-22","paper":"TSIG-PAPER-2026-PASSELEGUE","statement":"States that an ideal threshold Dilithium/ML-DSA protocol would combine low computational cost, few rounds, low communication, scalability to large \\( n \\) and \\( t \\), and malicious security, and that no existing approach combines all of them."},{"locator":"§1 Introduction, p. 6305 (USENIX Security 2026 proceedings)","paper":"TSIG-PAPER-2026-CELI","statement":"States that no practical threshold construction for ML-DSA existed, calling its absence a deep technical challenge caused by rejection sampling, with even the two-party case open."},{"locator":"§1, paragraph 'Difficulties in designing threshold ML-DSA', p. 2 (USENIX Security 2026 prepublication PDF)","paper":"TSIG-PAPER-2026-QUORUS","statement":"Calls a threshold version of standardized ML-DSA an elusive open problem, because generic MPC would have to evaluate SHA-3 on hidden inputs at prohibitive cost."}],"profile":{"Assumption":"MLWE and SelfTargetMSIS, or ML-DSA unforgeability; no heuristics","Efficiency":"at most three rounds per attempt; per-party cost \\( \\mathrm{poly}(n) \\); no FHE or generic MPC","Model":"random oracle model; trusted dealer allowed","Security":"unforgeability against static malicious corruption of \\( t-1 \\) parties","Setting":"ML-DSA (FIPS 204) signatures; any \\( t \\le n \\), dishonest majority"},"refuted_by":[],"related":[],"resolution_condition":"$9","resolved_by":[],"status":"open","summary":"Can any \\( t \\) of \\( n \\) parties produce ordinary ML-DSA signatures in at most three rounds, with cost polynomial in \\( n \\) and security against \\( t-1 \\) malicious parties, without homomorphic or generic secure evaluation of signing? Known protocols stop at six parties, need an honest majority and tens of rounds, or evaluate signing under threshold FHE.","title":"Few-round threshold ML-DSA for many parties"},"primaryUrl":null,"sections":[{"content":"A \\( t \\)-out-of-n threshold signature lets any \\( t \\) of \\( n \\) key-share holders sign\njointly while any \\( t-1 \\) of them cannot forge. For Schnorr and ECDSA there are\nprotocols with two rounds, or one online round after preprocessing, whose\noutput is an ordinary signature (TSIG-PAPER-2020-FROST, TSIG-PAPER-2020-CGGMP).\nML-DSA, standardized in FIPS 204, signs by Fiat–Shamir with aborts: it retries\nuntil the response is short and must hide the rejected attempts, which defeats\nthe Schnorr approach. NIST's 2026 threshold call lists ML-DSA signing as a\ntarget and requires its output to pass the standard verifier\n(TSIG-PAPER-2026-NIST8214C, Table 6 and Requirement 10.1).","heading":"Background"},{"content":"Construct a \\( t \\)-out-of-n threshold signing protocol for ML-DSA, for every\n\\( t \\le n \\), whose output is a signature accepted by the unmodified FIPS 204\nverifier under an ordinary ML-DSA public key, such that each signing attempt\ntakes at most three rounds, each party's communication and computation are\npolynomial in \\( n \\), and unforgeability holds against a static malicious\nadversary corrupting up to \\( t-1 \\) parties, from the lattice assumptions of\nML-DSA in the random oracle model and without heuristic assumptions. A trusted\ndealer may generate the key. Following the requirement of low computational\ncost in TSIG-PAPER-2026-PASSELEGUE, the parties may not evaluate the signing\nalgorithm, its hash functions, or its rejection test under fully homomorphic\nencryption or general-purpose secure computation.","heading":"Problem"},{"content":"$a","heading":"Why it is open"},{"content":"- Threshold schemes for Raccoon, Ringtail, or other lattice signatures with\n  their own verifiers, however efficient.\n- Threshold FALCON, even with the unmodified FALCON verifier: it standardizes\n  a different signature, and the known protocol runs signing in generic MPC\n  with thousands of rounds per signature (TSIG-PAPER-2026-GEPTW).\n- Protocols for a fixed small number of parties, including two-party ML-DSA.\n- Evaluating ML-DSA signing under threshold FHE or with general-purpose MPC;\n  these settle [a weaker question](TSIG-OP-005).\n- Protocols that rely on trusted hardware, on a party supplying correlated\n  randomness, or on rotating keys after a bounded number of signatures.\n- Heuristic arguments that rejected attempts leak nothing, without a proof.","heading":"What would not resolve it"},{"content":"$b","heading":"Formal target"},{"content":"$c","heading":"Research history"}],"slug":"op-1","status":"open","subtitle":"","summary":"Few-round threshold ML-DSA for many parties","title":"Few-round threshold ML-DSA for many parties","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-001"},{"evidence":"fulltext_checked","id":"TSIG-OP-002","keywords":["ml-dsa","fips-204","replicated-secret-sharing","dishonest-majority"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-002","keywords":["ml-dsa","fips-204","replicated-secret-sharing","dishonest-majority"],"profile":{"Efficiency":"at most three rounds per attempt; per-party cost \\( \\mathrm{poly}(n) \\); no FHE or generic MPC","Security":"unforgeability against static malicious corruption of \\( t-1 \\) parties","Setting":"ML-DSA (FIPS 204) signatures; at most six parties, dishonest majority"},"resolved_by":[{"locator":"Abstract and §1.1, pp. 6305-6306 (parameters up to six parties); Remark 2, p. 6312 (three rounds, first offline); Theorem 3.2, p. 6314 (unforgeability); §3.5 and Table 3, p. 6317 (USENIX Security 2026)","paper":"TSIG-PAPER-2026-CELI"}],"status":"resolved","summary":"Few-round threshold ML-DSA against a dishonest majority when there are at most six parties. Solved with short replicated secret sharing and hyperball rejection sampling in three rounds per attempt.","title":"Three-round threshold ML-DSA for at most six parties"},"primaryUrl":null,"sections":[{"content":"For at most six parties and every threshold \\( t \\le n \\), construct\nthreshold signing for ML-DSA whose output passes the unmodified verifier, with\nat most three rounds per attempt and unforgeability against a static\nmalicious adversary corrupting \\( t-1 \\) parties, in the random oracle model.","heading":"Problem"},{"content":"TSIG-PAPER-2026-CELI shares the key with short replicated secret sharing, so\neach party holds short shares, and replaces ML-DSA's rejection test by\nper-party rejection in hyperballs followed by a public check that the combined\nsignature fits ML-DSA's bounds. An attempt takes three rounds, the first of\nwhich can run offline, with at most about 1 MB of average communication per\nparty for up to six parties. Unforgeability holds against static corruption of\n\\( T-1 \\) parties from ML-DSA unforgeability and MLWE (Theorem 3.2), with a\ntrusted dealer or a posteriori sharing of an existing key; a distributed key\ngeneration is deferred to the full version. Each party holds a number of\nshares that grows with \\( \\binom{N}{T-1} \\), which is why the parameters stop\nat six parties.","heading":"Resolution"}],"slug":"op-2","status":"resolved","subtitle":"","summary":"Three-round threshold ML-DSA for at most six parties","title":"Three-round threshold ML-DSA for at most six parties","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-002"},{"evidence":"fulltext_checked","id":"TSIG-OP-003","keywords":["ml-dsa","honest-majority","round-complexity"],"metadata":{"basis":"derived","derived_from":{"gap":"With an honest majority and the ML-DSA verifier for any number of parties, the only protocol without FHE takes 16 or more online rounds per attempt.","goal":"TSIG-GOAL-001","requirements":["few_rounds_direct"]},"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-003","keywords":["ml-dsa","honest-majority","round-complexity"],"profile":{"Efficiency":"at most three rounds per attempt; per-party cost \\( \\mathrm{poly}(n) \\); no FHE or generic MPC","Security":"unforgeability against static malicious corruption of \\( t-1 \\) parties","Setting":"ML-DSA (FIPS 204) signatures; any \\( n \\), honest majority of the signers"},"recognized_by":[{"locator":"Ch. 5, paragraph 'Threshold Lattice-Based Signatures', PDF p. 63 (printed p. 55)","paper":"TSIG-PAPER-2026-PASSELEGUE","statement":"Lists few rounds and scalability to large \\( n \\) and \\( t \\) among the properties an ideal threshold ML-DSA protocol would combine, and finds that no existing approach combines them."},{"locator":"§5.1, Tables 3-5, p. 13 (USENIX Security 2026 prepublication PDF)","paper":"TSIG-PAPER-2026-QUORUS","statement":"Reports a round-optimized variant with 16 online rounds per attempt beside a communication-optimized one with 29, treating online rounds as an evaluation axis of its honest-majority protocol."}],"resolution_condition":"A protocol meeting every condition of TSIG-OP-001 except that each signing session may involve at least \\( 2t-1 \\) parties, so that the \\( t-1 \\) corrupted parties are a minority of the participants.","status":"open","summary":"Few-round threshold ML-DSA when each signing session includes an honest majority: at most three rounds, any number of parties, malicious security. The known honest-majority protocol needs tens of rounds.","title":"Few-round threshold ML-DSA with an honest majority"},"primaryUrl":null,"sections":[{"content":"Construct threshold ML-DSA for any number of parties in which at least\n\\( 2t-1 \\) parties take part in each signing session, so that the \\( t-1 \\)\ncorrupted parties are a minority, with output accepted by the unmodified\nverifier, at most three rounds per attempt, per-party cost polynomial in\n\\( n \\), no homomorphic or general-purpose secure evaluation of signing, and\nunforgeability against static malicious corruption of \\( t-1 \\) parties.","heading":"Problem"},{"content":"The honest-majority protocol of TSIG-PAPER-2026-QUORUS handles any number of\nparties but needs [16 or 29 online rounds per attempt and an offline phase\nthat grows with the number of parties](TSIG-OP-004). Most of these rounds go\nto the rejection test, which compares shared values with bounds and is\nevaluated by secure comparison on bit-decomposed shares. The two-round\nprotocol of TSIG-PAPER-2026-THED works for any \\( t \\) and \\( n \\) but\nevaluates signing under threshold FHE and is proved only against passive\nadversaries.","heading":"Why it is open"}],"slug":"op-3","status":"open","subtitle":"","summary":"Few-round threshold ML-DSA with an honest majority","title":"Few-round threshold ML-DSA with an honest majority","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-003"},{"evidence":"fulltext_checked","id":"TSIG-OP-004","keywords":["ml-dsa","mpc","honest-majority","uc-security"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-004","keywords":["ml-dsa","mpc","honest-majority","uc-security"],"profile":{"Efficiency":"16 or 29 online rounds per attempt, offline rounds grow with \\( n \\); MPC rejection test","Security":"unforgeability against static malicious corruption of \\( t-1 \\) parties","Setting":"ML-DSA (FIPS 204) signatures; any \\( n \\), honest majority of the signers"},"resolved_by":[{"locator":"Abstract and §1.1, p. 2; §2.2 and Remark 1, pp. 5-6 (\\( n = 2t + 1 \\), active security with abort); Theorem 1, p. 8, and Theorem 3, p. 11; §5.1, Tables 3-5, p. 13 (USENIX Security 2026 prepublication PDF)","paper":"TSIG-PAPER-2026-QUORUS"}],"status":"resolved","summary":"Threshold ML-DSA for any number of parties with an honest majority, when signing may take tens of rounds and evaluate the rejection test by MPC. Solved by an MPC-friendly variant of signing whose hash runs in the clear.","title":"Honest-majority threshold ML-DSA with tens of rounds"},"primaryUrl":null,"sections":[{"content":"Construct threshold ML-DSA for any number of parties, with each signing\nsession run by an honest majority, output accepted by the unmodified\nverifier, and security against an active adversary, where signing may take\ntens of rounds and may evaluate the rejection test with secure computation.","heading":"Problem"},{"content":"TSIG-PAPER-2026-QUORUS adds a short error to the commitment before rounding\nand proves that the modified scheme stays unforgeable when the high bits and\nchallenge of rejected attempts are revealed (Theorem 1, in the quantum random\noracle model, from the no-message security of ML-DSA and MLWE), so the\nchallenge hash is computed in the clear. The remaining steps run in\nhonest-majority MPC that UC-realizes a functionality computing these\nsignatures, with security with abort against an active adversary corrupting\n\\( t \\) of \\( n = 2t+1 \\) parties (Theorem 3); the signatures pass the\nstandard ML-DSA verification code. An attempt takes 29 or 16 online rounds\nafter an offline phase of 81 to 108 rounds that grows with \\( n \\), and about\nfour or five attempts are expected; parallel attempts trade communication for\nrounds.","heading":"Resolution"}],"slug":"op-4","status":"resolved","subtitle":"","summary":"Honest-majority threshold ML-DSA with tens of rounds","title":"Honest-majority threshold ML-DSA with tens of rounds","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-004"},{"evidence":"claim_audited","id":"TSIG-OP-005","keywords":["ml-dsa","threshold-fhe","universal-thresholdizer","one-round"],"metadata":{"caveat":"For ML-DSA it needs the deterministic mode of FIPS 204 (TSIG-PAPER-2026-NIST8214C) and evaluates all of signing under threshold FHE, whose LWE modulus grows exponentially in circuit depth (TSIG-PAPER-2018-BGGJKRS, Theorem 3.10).","dossier_type":"open_problem","evidence":"claim_audited","id":"TSIG-OP-005","keywords":["ml-dsa","threshold-fhe","universal-thresholdizer","one-round"],"profile":{"Efficiency":"one round after setup; signing evaluated under threshold FHE","Security":"unforgeability against static malicious corruption of \\( t-1 \\) parties","Setting":"ML-DSA (FIPS 204) signatures; any \\( t \\le n \\), dishonest majority"},"resolved_by":[{"locator":"Construction 8.16 and Theorem 8.20, §8.2.2, PDF pp. 32–33, with the unforgeability game of Definition 8.13, PDF p. 32, and the universal thresholdizer of §7.1, Construction 7.7 and Theorems 7.8–7.12, PDF pp. 26–27 (CRYPTO 2018; ePrint 2017/956, PDF downloaded 2026-10-11): one-round threshold signature from any deterministic signature scheme and a universal thresholdizer built from LWE-based threshold FHE, unforgeable against corruption of a maximal invalid party set fixed before the signing queries","paper":"TSIG-PAPER-2018-BGGJKRS"}],"status":"resolved","summary":"Few-round threshold ML-DSA for any \\( t \\) and \\( n \\) when the parties may evaluate the whole signing algorithm under threshold FHE. Solved in one round by the universal thresholdizer, which evaluates all of signing under threshold FHE.","title":"Threshold ML-DSA by homomorphic evaluation of signing"},"primaryUrl":null,"sections":[{"content":"Construct threshold ML-DSA for every \\( t \\le n \\), with output accepted by\nthe unmodified verifier, a constant number of rounds, per-party cost\npolynomial in \\( n \\), and unforgeability against static malicious\ncorruption of \\( t-1 \\) parties, when the parties may evaluate the signing\nalgorithm under threshold fully homomorphic encryption.","heading":"Problem"},{"content":"$d","heading":"Resolution"}],"slug":"op-5","status":"resolved","subtitle":"","summary":"Threshold ML-DSA by homomorphic evaluation of signing","title":"Threshold ML-DSA by homomorphic evaluation of signing","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-005"},{"evidence":"fulltext_checked","id":"TSIG-OP-006","keywords":["raccoon","lattice","large-threshold","three-round"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-006","keywords":["raccoon","lattice","large-threshold","three-round"],"profile":{"Efficiency":"at most three rounds per attempt; per-party cost \\( \\mathrm{poly}(n) \\); no FHE or generic MPC","Security":"unforgeability against static malicious corruption of \\( t-1 \\) parties","Setting":"Raccoon signatures under Raccoon's own verifier; any \\( t \\le n \\)"},"resolved_by":[{"locator":"§§1.1 and 2.3, PDF pp. 4-10 (three rounds, one-time masks); Figure 5 and Theorem 7.2, PDF pp. 20-25 (trusted key generation, static corruption below T, unforgeability); §8.3 Table 2 and §9 Table 3, PDF pp. 43-44 (thresholds up to 1024) (ePrint 2024/184)","paper":"TSIG-PAPER-2024-RACCOON"}],"status":"resolved","summary":"Few-round threshold signing for many parties when the scheme may be a lattice signature designed for thresholds, with its own verifier. Solved by Threshold Raccoon in three rounds for thresholds up to 1024.","title":"Three-round threshold lattice signatures for large thresholds"},"primaryUrl":null,"sections":[{"content":"Construct a threshold lattice signature for every \\( t \\le n \\), with its own\nverifier, in at most three rounds per attempt, with per-party cost polynomial\nin \\( n \\), and unforgeability against static malicious corruption of\n\\( t-1 \\) parties under the lattice assumptions of ML-DSA in the random oracle\nmodel.","heading":"Problem"},{"content":"TSIG-PAPER-2024-RACCOON thresholdizes Raccoon, a Dilithium-like signature\ndesigned without rejection sampling, in three rounds. Pairwise one-time\nadditive masks hide each party's partial response, so ordinary Shamir shares\ncan be used; unforgeability holds against static corruption of fewer than\n\\( T \\) parties under the assumptions underlying Dilithium, with trusted key\ngeneration (Theorem 7.2). Concrete parameters reach thresholds of 1024 with\n12.7 KB signatures and a 3.9 KB verification key. The output is accepted only\nby Raccoon's verifier, which is why this does not settle the ML-DSA question.","heading":"Resolution"}],"slug":"op-6","status":"resolved","subtitle":"","summary":"Three-round threshold lattice signatures for large thresholds","title":"Three-round threshold lattice signatures for large thresholds","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-006"},{"evidence":"fulltext_checked","id":"TSIG-OP-007","keywords":["schnorr","frost","adaptive-security","two-round","aomdl","ddh","algebraic-group-model"],"metadata":{"barriers":["TSIG-BARRIER-003"],"basis":"named","caveat":null,"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-007","keywords":["schnorr","frost","adaptive-security","two-round","aomdl","ddh","algebraic-group-model"],"named_open_by":[{"locator":"Abstract, PDF p. 1, and §1, PDF pp. 3–4 (CRYPTO 2025; ePrint 2025/1061, PDF downloaded 2026-10-11)","paper":"TSIG-PAPER-2025-CKKTZ","statement":"States that security of FROST and its variants under adaptive corruptions had remained an open problem, and that no pairing-free two-round threshold scheme with adaptive security was known before, even in the algebraic group model; it settles FROST only for half the threshold or with a new assumption in the algebraic group model."},{"locator":"Abstract, PDF p. 1, and §1, PDF p. 2 (EUROCRYPT 2026; ePrint 2025/1953, revision of 2026-09-02, PDF downloaded 2026-10-11)","paper":"TSIG-PAPER-2025-MSFROST","statement":"States that it remained open whether a two-round threshold Schnorr signature with full adaptive security can be built from assumptions more established than LDVR, and that no stateless two-round scheme of this kind existed; it answers this only in the algebraic group model."},{"locator":"Abstract, PDF p. 1; §1, PDF p. 2; §1.1, PDF p. 3 (EUROCRYPT 2026; ePrint 2025/1478, PDF downloaded 2026-10-11)","paper":"TSIG-PAPER-2025-GLRS","statement":"Calls full adaptive security against up to \\( t-1 \\) corruptions under standard assumptions a longstanding and unresolved challenge, since impossibility results rule out known proofs for deployed two-round schemes or require speculative assumptions and idealized models, and poses the question of a fully adaptively secure threshold Schnorr scheme from falsifiable assumptions with minimal round complexity; it answers this only in a model with periodic key refresh."}],"profile":{"Assumption":"DL, DDH, or AOMDL","Efficiency":"two signing rounds; stateless signers","Model":"random oracle model, no algebraic group model","Security":"unforgeability under adaptive corruption of up to \\( t-1 \\) parties, no erasures","Setting":"standard Schnorr signatures under the group key; any \\( t \\le n \\)"},"refuted_by":[],"related":[],"resolution_condition":"A threshold Schnorr scheme for all \\( 1 \\le t \\le n \\le \\mathrm{poly}(\\lambda) \\) (key generation by a trusted dealer allowed) whose signing protocol has two rounds and keeps no state across sessions, whose output (R, z) verifies as a standard Schnorr signature under the group public key, and which is unforgeable (at least TS-UF-0) against a PPT adversary that adaptively corrupts up to \\( t-1 \\) parties at any time, learning their keys and full internal state, with a proof in the random oracle model under DL, DDH, or AOMDL, without the algebraic or generic group model, without LDVR or other new assumptions, and without periodic refresh of key shares or a bound on signing queries per key.","resolved_by":[],"status":"open","summary":"Is there a two-round, stateless threshold Schnorr scheme with standard Schnorr signatures that stays unforgeable when up to \\( t-1 \\) parties are corrupted adaptively, proved in the random oracle model under DL, DDH, or AOMDL without the algebraic group model? Known schemes give up one of these.","title":"Two-round fully adaptive threshold Schnorr without the AGM"},"primaryUrl":null,"sections":[{"content":"Threshold Schnorr signing with standard Schnorr output takes two rounds in\nFROST (TSIG-PAPER-2020-FROST), whose static security is proved under the\nalgebraic one-more discrete logarithm assumption (AOMDL) in the random oracle\nmodel, without the algebraic group model (TSIG-PAPER-2023-OLAF). Adaptive\nsecurity lets the adversary choose whom to corrupt during the protocol, after\nseeing transcripts, and NIST's threshold call states a strong preference for\nit (TSIG-PAPER-2026-NIST8214C, §9.2.4.2). Rewinding proofs, the usual tool for\nSchnorr, must answer about twice as many corruptions, and \\( 2(t-1) \\) key\nshares typically determine the signing key (TSIG-PAPER-2025-CHEN, §1).","heading":"Background"},{"content":"Is there a threshold Schnorr scheme, for every \\( t \\le n \\), whose signatures\nare standard Schnorr signatures under the group public key, whose signing\nprotocol has two rounds and keeps no state across sessions, and which is\nunforgeable against an adversary that adaptively corrupts up to \\( t-1 \\)\nparties without erasures, with a proof in the random oracle model under DL,\nDDH, or AOMDL and without the algebraic group model?","heading":"Problem"},{"content":"$e","heading":"Why it is open"},{"content":"- Proofs in the algebraic or generic group model, or under LDVR or other new\n  assumptions.\n- Schemes with three or more rounds, or with two rounds and state kept across\n  sessions.\n- Schemes whose signatures are not standard Schnorr signatures.\n- Models in which key shares are refreshed, or signing queries per key are\n  bounded.\n- Adaptive security against fewer than \\( t-1 \\) corruptions.","heading":"What would not resolve it"},{"content":"Syntax: \\( \\mathsf{KeyGen}(1^\\lambda, t, n) \\) outputs a group public key\n\\( X = g^x \\), secret shares, and any public verification data, which need\nnot include public key shares (a trusted dealer is allowed). Any\n\\( S \\subseteq [n] \\) with \\( |S| \\ge t \\) runs a two-round protocol on\nmessage \\( m \\), in which each party keeps no state between sessions, and\noutputs \\( (R, z) \\) with \\( g^z = R \\cdot X^c \\) for\n\\( c = H(X, m, R) \\).\n\nSecurity: a PPT adversary with signing oracles may, at any time, corrupt a\nparty and receive its share and its entire internal state, up to \\( t-1 \\)\ncorruptions in total; it wins by outputting a valid signature on a message\nthat no honest party signed (TS-UF-0). Its advantage must be negligible in the\nrandom oracle model under DL, DDH, or AOMDL, by a reduction that does not use\nthe algebraic or generic group model.","heading":"Formal target"},{"content":"The impossibility results of TSIG-PAPER-2025-CCKM, TSIG-PAPER-2025-CKKTZ, and\nTSIG-PAPER-2025-MSFROST apply to key-unique schemes, to FROST-type schemes, and\nto particular classes of reductions (TSIG-BARRIER-003). They leave open\nschemes with hidden or non-unique key shares, as in the DDH-based\nTSIG-PAPER-2024-GLACIUS and TSIG-PAPER-2025-GLRS, and masking with pairwise\nkeys that also covers each signer's first-round nonces, as in FROST-Mask of\nTSIG-PAPER-2025-CHEN (TSIG-PAPER-2025-MSFROST, Section 2.1). Masking only the\npartial signatures, as in ms-FROST, falls under the impossibility result of\nTSIG-PAPER-2025-MSFROST. These are limits of proof techniques, not attacks.","heading":"Known obstacles"},{"content":"Adaptive security of threshold Schnorr was first studied for a three-round\nscheme, with proofs for half the threshold or in the algebraic group model\n(TSIG-PAPER-2025-CHEN, §1). Proofs of full adaptive security without that\nmodel then appeared for schemes with standard Schnorr output and four rounds\nwith state, or five without, including TSIG-PAPER-2024-GLACIUS from DDH\n(TSIG-PAPER-2025-CHEN, §1 and Table 1).\nTSIG-PAPER-2025-CHEN reduced this to three stateless rounds, and\nTSIG-PAPER-2025-CKKTZ and TSIG-PAPER-2025-CCKM explained why two-round\nkey-unique schemes resist proofs beyond half the threshold. Two-round schemes\nwith full adaptive security followed in the algebraic group model\n(TSIG-PAPER-2025-MSFROST, TSIG-PAPER-2025-FAFROST) and with periodic key\nrefresh (TSIG-PAPER-2025-GLRS).","heading":"Research history"}],"slug":"op-7","status":"open","subtitle":"","summary":"Two-round fully adaptive threshold Schnorr without the AGM","title":"Two-round fully adaptive threshold Schnorr without the AGM","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-007"},{"evidence":"fulltext_checked","id":"TSIG-OP-008","keywords":["frost","adaptive-security","aomdl"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-008","keywords":["frost","adaptive-security","aomdl"],"profile":{"Assumption":"DL, DDH, or AOMDL","Efficiency":"two signing rounds; stateless signers","Model":"random oracle model, no algebraic group model","Security":"unforgeability under adaptive corruption of about half the threshold"},"resolved_by":[{"locator":"Theorem 1, §3, PDF p. 12, with the adaptive-security game of §2.1, PDF pp. 9–10 (CRYPTO 2025; ePrint 2025/1061, PDF downloaded 2026-10-11): FROST1, FROST2 and FROST3 adaptively secure without erasures for \\( t_c = \\lfloor t/2 \\rfloor \\) with signing threshold \\( t + 1 \\), in the random oracle model under AOMDL","paper":"TSIG-PAPER-2025-CKKTZ"}],"status":"resolved","summary":"Two-round stateless threshold Schnorr in the random oracle model when the adversary adaptively corrupts only about half the threshold. Solved for FROST under AOMDL.","title":"Two-round threshold Schnorr with half-threshold adaptive security"},"primaryUrl":null,"sections":[{"content":"Construct two-round stateless threshold Schnorr with standard signatures that\nis unforgeable in the random oracle model, without the algebraic group model,\nwhen the adversary adaptively corrupts up to about half the threshold.","heading":"Problem"},{"content":"TSIG-PAPER-2025-CKKTZ proves that FROST and its variants FROST2 and FROST3 are\nadaptively secure in the random oracle model under AOMDL, the assumption of\ntheir static security, when at most \\( \\lfloor (t-1)/2 \\rfloor \\) parties are\ncorrupted. Beyond that, its proof uses the algebraic group model and the LDVR\nassumption.","heading":"Resolution"}],"slug":"op-8","status":"resolved","subtitle":"","summary":"Two-round threshold Schnorr with half-threshold adaptive security","title":"Two-round threshold Schnorr with half-threshold adaptive security","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-008"},{"evidence":"fulltext_checked","id":"TSIG-OP-009","keywords":["frost","adaptive-security","algebraic-group-model","aomdl"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-009","keywords":["frost","adaptive-security","algebraic-group-model","aomdl"],"profile":{"Assumption":"DL, DDH, or AOMDL","Efficiency":"two signing rounds; stateless signers","Model":"random oracle and algebraic group models","Security":"unforgeability under adaptive corruption of up to \\( t-1 \\) parties, no erasures"},"resolved_by":[{"locator":"Theorem 1, §4, PDF p. 13, with the adp-TS-UF-4 game of §3.3, Fig. 3, PDF p. 11 (EUROCRYPT 2026; ePrint 2025/1953, revision of 2026-09-02, PDF downloaded 2026-10-11): ms-FROST, adp-TS-UF-4 against up to \\( t-1 \\) adaptive corruptions that reveal signer state, AOMDL in the algebraic group and random oracle models","paper":"TSIG-PAPER-2025-MSFROST"},{"locator":"Theorem 1, §6, PDF p. 18, with the adaptive unforgeability game of §4, Fig. 2, PDF p. 14, and Definition 1, PDF pp. 15–16; Theorem 2, PDF p. 32 (ASIACRYPT 2026; ePrint 2025/1950, revision of 2026-09-14, PDF downloaded 2026-10-11): two-round FaFROST, TS-UF-1 adaptive unforgeability against algebraic adversaries that corrupt up to \\( t-1 \\) signers and learn their state, AOMDL in the random oracle and algebraic group models; Theorem 2 extends it to FaFROST+ with identifiable aborts","paper":"TSIG-PAPER-2025-FAFROST"}],"status":"resolved","summary":"Two-round fully adaptive threshold Schnorr with standard signatures when the proof may use the algebraic group model. Solved by a FROST variant with pairwise masking of partial signatures under AOMDL, found independently by two groups.","title":"Fully adaptive two-round threshold Schnorr in the algebraic group model"},"primaryUrl":null,"sections":[{"content":"Construct two-round stateless threshold Schnorr with standard signatures that\nis unforgeable under adaptive corruption of up to \\( t-1 \\) parties, from\nAOMDL, with the proof allowed to use the algebraic group model as well as the\nrandom oracle model.","heading":"Problem"},{"content":"TSIG-PAPER-2025-MSFROST gives ms-FROST, whose first round is message\nindependent, and proves security against any \\( t-1 < n \\) adaptive\ncorruptions under AOMDL in the algebraic group and random oracle models; the\nrevision of 2026-09-02 corrects a flaw in an earlier proof. It also shows\nthat no black-box algebraic reduction from AOMDL in the random oracle model\nalone proves this scheme adaptively secure. TSIG-PAPER-2025-FAFROST obtains\nthe same scheme independently, proves it secure against up to \\( t-1 \\)\nadaptive corruptions for every \\( t \\le n \\) under AOMDL in the same models\n(Theorem 1), and adds identifiable aborts; its ASIACRYPT 2026 full version\ncorrects an error in an earlier version of the proof. Both avoid the LDVR\nassumption that TSIG-PAPER-2025-CKKTZ needs for FROST.","heading":"Resolution"}],"slug":"op-9","status":"resolved","subtitle":"","summary":"Fully adaptive two-round threshold Schnorr in the algebraic group model","title":"Fully adaptive two-round threshold Schnorr in the algebraic group model","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-009"},{"evidence":"fulltext_checked","id":"TSIG-OP-010","keywords":["schnorr","adaptive-security","ddh","key-refresh"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-010","keywords":["schnorr","adaptive-security","ddh","key-refresh"],"profile":{"Assumption":"DL, DDH, or AOMDL","Efficiency":"two signing rounds; stateless signers","Model":"random oracle model; key shares refreshed after a bounded number of signing queries","Security":"unforgeability under adaptive corruption of up to \\( t-1 \\) parties, no erasures"},"resolved_by":[{"locator":"Theorem 1, §4, PDF p. 19, with the DDH instantiation of §4.1, PDF pp. 19–20, and Theorem 3, Appendix B, PDF pp. 35–36 (EUROCRYPT 2026; ePrint 2025/1478, PDF downloaded 2026-10-11): two-round stateless scheme, up to \\( t-1 \\) adaptive corruptions, DDH in the random oracle model, with partial public keys refreshed after a bounded number of signing queries","paper":"TSIG-PAPER-2025-GLRS"}],"status":"resolved","summary":"Two-round fully adaptive threshold Schnorr with standard signatures when signers refresh part of their public key shares after a bounded number of signing queries. Solved from DDH in the random oracle model.","title":"Fully adaptive two-round threshold Schnorr with periodic key refresh"},"primaryUrl":null,"sections":[{"content":"Construct two-round threshold Schnorr with standard signatures that is\nunforgeable under adaptive corruption of up to \\( t-1 \\) parties in the random\noracle model from a standard assumption, when each signer must refresh part of\nits public key share after a fixed number of signing queries.","heading":"Problem"},{"content":"TSIG-PAPER-2025-GLRS gives a two-round scheme from DDH in the random oracle\nmodel that withstands up to \\( t-1 \\) adaptive corruptions in this relaxed\nmodel. Refreshes use short stateless tokens and keep the standard Schnorr\nsignature format, so verifiers are unchanged. The proof uses a technique the\nauthors call equivocal deterministic nonce derivation.","heading":"Resolution"}],"slug":"op-10","status":"resolved","subtitle":"","summary":"Fully adaptive two-round threshold Schnorr with periodic key refresh","title":"Fully adaptive two-round threshold Schnorr with periodic key refresh","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-010"},{"evidence":"fulltext_checked","id":"TSIG-OP-011","keywords":["schnorr","adaptive-security","rewinding","masking","aomdl"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-011","keywords":["schnorr","adaptive-security","rewinding","masking","aomdl"],"profile":{"Assumption":"DL, DDH, or AOMDL","Efficiency":"three signing rounds; stateless signers","Model":"random oracle model, no algebraic group model","Security":"unforgeability under adaptive corruption of up to \\( t-1 \\) parties, no erasures"},"resolved_by":[{"locator":"Abstract, p. 1 (3-round AOMDL scheme with standard Schnorr output); §1.1, p. 2 (stateless three-round compilation of FROST-Mask); Theorem 1, §3.2, p. 15 (IACR CiC 2(2), 2025)","paper":"TSIG-PAPER-2025-CHEN"}],"status":"resolved","summary":"Fully adaptive threshold Schnorr with standard signatures in three stateless signing rounds, without the algebraic group model. Solved by masking FROST under AOMDL in the random oracle model; with state kept across sessions the masked scheme uses two rounds.","title":"Fully adaptive three-round threshold Schnorr without the AGM"},"primaryUrl":null,"sections":[{"content":"Construct stateless threshold Schnorr with standard signatures and three\nsigning rounds that is unforgeable under adaptive corruption of up to\n\\( t-1 \\) parties, in the random oracle model under DL, DDH, or AOMDL,\nwithout the algebraic group model.","heading":"Problem"},{"content":"TSIG-PAPER-2025-CHEN masks the partial signatures of FROST with pairwise\nkeys and proves the resulting FROST-Mask fully adaptively secure under AOMDL\nwith a rewinding proof in the random oracle model (Theorem 1). FROST-Mask\nsigns in two rounds if signers keep state across sessions to agree on fresh\nsession identifiers; a general transformation makes it stateless with three\nrounds. Earlier schemes with standard Schnorr output and full adaptive\nsecurity without the algebraic group model needed four rounds with state, or\nfive without, including TSIG-PAPER-2024-GLACIUS from DDH\n(TSIG-PAPER-2025-CHEN, §1 and Table 1). Masking makes partial signatures\nunverifiable, so non-interactive identifiable abort is lost.","heading":"Resolution"}],"slug":"op-11","status":"resolved","subtitle":"","summary":"Fully adaptive three-round threshold Schnorr without the AGM","title":"Fully adaptive three-round threshold Schnorr without the AGM","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-011"},{"evidence":"fulltext_checked","id":"TSIG-OP-012","keywords":["adaptive-security","rewinding","masking","dl","hbms"],"metadata":{"dossier_type":"open_problem","evidence":"fulltext_checked","id":"TSIG-OP-012","keywords":["adaptive-security","rewinding","masking","dl","hbms"],"profile":{"Efficiency":"two signing rounds; stateless signers","Model":"random oracle model, no algebraic group model","Security":"unforgeability under adaptive corruption of up to \\( t-1 \\) parties, no erasures","Setting":"Schnorr-type signatures with one extra scalar; any \\( t \\le n \\)"},"resolved_by":[{"locator":"Abstract, p. 1, and §1.1, p. 2 (stateless 2-round HBTS-Mask with one extra scalar); Theorem 2, §4.2, p. 26 (security under DL) (IACR CiC 2(2), 2025)","paper":"TSIG-PAPER-2025-CHEN"}],"status":"resolved","summary":"Two-round fully adaptive threshold signing when the signature may contain one more scalar than a Schnorr signature and is checked by its own verifier. Solved from DL in the random oracle model.","title":"Fully adaptive two-round threshold signatures with Schnorr-type output"},"primaryUrl":null,"sections":[{"content":"Construct a stateless two-round threshold signature, for every \\( t \\le n \\),\nthat is unforgeable under adaptive corruption of up to \\( t-1 \\) parties in\nthe random oracle model under DL, DDH, or AOMDL, when signatures may contain\none more scalar than a Schnorr signature and are checked by the scheme's own\nverifier.","heading":"Problem"},{"content":"TSIG-PAPER-2025-CHEN masks a threshold version of the two-round HBMS\nmultisignature and proves the resulting HBTS-Mask fully adaptively secure\nunder DL with a rewinding proof in the random oracle model (Theorem 2). It is\nstateless and signs in two rounds; its signatures consist of a group element\nand two scalars, one scalar more than a Schnorr signature, so standard\nSchnorr verifiers do not accept them.","heading":"Resolution"}],"slug":"op-12","status":"resolved","subtitle":"","summary":"Fully adaptive two-round threshold signatures with Schnorr-type output","title":"Fully adaptive two-round threshold signatures with Schnorr-type output","type":"open_problem","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-OP-012"},{"evidence":"bibliographic_checked","id":"TSIG-PAPER-1989-DF","keywords":["foundations","threshold","rsa","secret-sharing"],"metadata":{"authors":["Yvo Desmedt","Yair Frankel"],"dossier_type":"paper","evidence":"bibliographic_checked","id":"TSIG-PAPER-1989-DF","keywords":["foundations","threshold","rsa","secret-sharing"],"primary_url":"https://doi.org/10.1007/0-387-34805-0_28","status":"published","title":"Threshold Cryptosystems","venue":"CRYPTO 1989","versions":["conference paper"],"year":1989},"primaryUrl":"https://doi.org/10.1007/0-387-34805-0_28","sections":[{"content":"Establishes the threshold-cryptosystem paradigm and gives the classical starting point for distributing RSA-style private operations.","heading":"Atomic claims"}],"slug":"df89","status":"published","subtitle":"Yvo Desmedt, Yair Frankel · 1989","summary":"Establishes the threshold-cryptosystem paradigm and gives the classical starting point for distributing RSA-style private operations.","title":"Threshold Cryptosystems","type":"paper","venue":"CRYPTO 1989","year":1989,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-1989-DF"},{"evidence":"bibliographic_checked","id":"TSIG-PAPER-1991-PEDERSEN","keywords":["dkg","discrete-log","verifiable-secret-sharing","foundations"],"metadata":{"authors":["Torben Pryds Pedersen"],"dossier_type":"paper","evidence":"bibliographic_checked","id":"TSIG-PAPER-1991-PEDERSEN","keywords":["dkg","discrete-log","verifiable-secret-sharing","foundations"],"primary_url":"https://doi.org/10.1007/3-540-46416-6_47","status":"published","title":"A Threshold Cryptosystem without a Trusted Party","venue":"EUROCRYPT 1991","versions":["conference paper"],"year":1991},"primaryUrl":"https://doi.org/10.1007/3-540-46416-6_47","sections":[{"content":"Provides an early distributed-key-generation route for discrete-log keys without a trusted dealer.","heading":"Atomic claims"}],"slug":"pedersen91","status":"published","subtitle":"Torben Pryds Pedersen · 1991","summary":"Provides an early distributed-key-generation route for discrete-log keys without a trusted dealer.","title":"A Threshold Cryptosystem without a Trusted Party","type":"paper","venue":"EUROCRYPT 1991","year":1991,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-1991-PEDERSEN"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-1996-GJKR-DSS","keywords":["dss","discrete-log","robustness","malicious-security"],"metadata":{"authors":["Rosario Gennaro","Stanisław Jarecki","Hugo Krawczyk","Tal Rabin"],"citation_key":"GJKR96b","dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-1996-GJKR-DSS","keywords":["dss","discrete-log","robustness","malicious-security"],"primary_url":"https://doi.org/10.1007/3-540-68339-9_31","status":"published","title":"Robust Threshold DSS Signatures","venue":"EUROCRYPT 1996","versions":["EUROCRYPT 1996 paper","Information and Computation 2001 journal version"],"year":1996},"primaryUrl":"https://doi.org/10.1007/3-540-68339-9_31","sections":[{"content":"Presents threshold DSS where 2t+1 signers can produce an ordinary DSS signature for t<n/2, together with scoped robustness guarantees.","heading":"Atomic claims"},{"content":"Proceedings paper and journal abstract; exact fault bounds are kept distinct in the construction card.","heading":"Evidence locator"}],"slug":"gjkr96b","status":"published","subtitle":"Rosario Gennaro, Stanisław Jarecki, Hugo Krawczyk et al. · 1996","summary":"Presents threshold DSS where 2t+1 signers can produce an ordinary DSS signature for t<n/2, together with scoped robustness guarantees.","title":"Robust Threshold DSS Signatures","type":"paper","venue":"EUROCRYPT 1996","year":1996,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-1996-GJKR-DSS"},{"evidence":"bibliographic_checked","id":"TSIG-PAPER-1996-GJKR-RSA","keywords":["rsa","threshold","robustness","function-sharing"],"metadata":{"authors":["Rosario Gennaro","Stanisław Jarecki","Hugo Krawczyk","Tal Rabin"],"citation_key":"GJKR96a","dossier_type":"paper","evidence":"bibliographic_checked","id":"TSIG-PAPER-1996-GJKR-RSA","keywords":["rsa","threshold","robustness","function-sharing"],"primary_url":"https://doi.org/10.1007/3-540-68697-5","status":"published","title":"Robust and Efficient Sharing of RSA Functions","venue":"CRYPTO 1996","versions":["CRYPTO 1996 paper","Journal of Cryptology version"],"year":1996},"primaryUrl":"https://doi.org/10.1007/3-540-68697-5","sections":[{"content":"Develops robust sharing of RSA signing and decryption functions, providing a classical threshold-RSA branch before Shoup's later simplification.","heading":"Atomic claims"}],"slug":"gjkr96a","status":"published","subtitle":"Rosario Gennaro, Stanisław Jarecki, Hugo Krawczyk et al. · 1996","summary":"Develops robust sharing of RSA signing and decryption functions, providing a classical threshold-RSA branch before Shoup's later simplification.","title":"Robust and Efficient Sharing of RSA Functions","type":"paper","venue":"CRYPTO 1996","year":1996,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-1996-GJKR-RSA"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-1999-GJKR-DKG","keywords":["dkg","discrete-log","malicious-security","robustness"],"metadata":{"authors":["Rosario Gennaro","Stanisław Jarecki","Hugo Krawczyk","Tal Rabin"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-1999-GJKR-DKG","keywords":["dkg","discrete-log","malicious-security","robustness"],"primary_url":"https://doi.org/10.1007/3-540-48910-X_21","status":"published","title":"Secure Distributed Key Generation for Discrete-Log Based Cryptosystems","venue":"EUROCRYPT 1999","versions":["conference paper"],"year":1999},"primaryUrl":"https://doi.org/10.1007/3-540-48910-X_21","sections":[{"content":"Gives a robust distributed key-generation protocol for discrete-log cryptosystems with explicit adversarial-threshold conditions.","heading":"Atomic claims"},{"content":"Proceedings paper, abstract, model, and protocol sections.","heading":"Evidence locator"}],"slug":"gjkr99","status":"published","subtitle":"Rosario Gennaro, Stanisław Jarecki, Hugo Krawczyk et al. · 1999","summary":"Gives a robust distributed key-generation protocol for discrete-log cryptosystems with explicit adversarial-threshold conditions.","title":"Secure Distributed Key Generation for Discrete-Log Based Cryptosystems","type":"paper","venue":"EUROCRYPT 1999","year":1999,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-1999-GJKR-DKG"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2000-SHOUP","keywords":["rsa","threshold","robustness","practical"],"metadata":{"authors":["Victor Shoup"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2000-SHOUP","keywords":["rsa","threshold","robustness","practical"],"primary_url":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","status":"published","title":"Practical Threshold Signatures","venue":"EUROCRYPT 2000","versions":["conference paper"],"year":2000},"primaryUrl":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","sections":[{"content":"Presents a practical robust threshold RSA signature in which signing servers produce shares noninteractively and a combiner verifies and joins them.","heading":"Atomic claims"},{"content":"Abstract and Sections 1-4 of the proceedings paper.","heading":"Evidence locator"}],"slug":"shoup00","status":"published","subtitle":"Victor Shoup · 2000","summary":"Presents a practical robust threshold RSA signature in which signing servers produce shares noninteractively and a combiner verifies and joins them.","title":"Practical Threshold Signatures","type":"paper","venue":"EUROCRYPT 2000","year":2000,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2000-SHOUP"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2003-BOLDYREVA","keywords":["pairing","gap-diffie-hellman","bls","threshold","compact-output"],"metadata":{"authors":["Alexandra Boldyreva"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2003-BOLDYREVA","keywords":["pairing","gap-diffie-hellman","bls","threshold","compact-output"],"primary_url":"https://eprint.iacr.org/2002/118","status":"published","title":"Threshold Signatures, Multisignatures and Blind Signatures Based on the Gap-Diffie-Hellman-Group Signature Scheme","venue":"PKC 2003","versions":["ePrint 2002/118","conference paper"],"year":2003},"primaryUrl":"https://eprint.iacr.org/2002/118","sections":[{"content":"Constructs a threshold version of the BLS/GDH signature whose combined output remains an ordinary compact BLS signature.","heading":"Atomic claims"},{"content":"ePrint 2002/118, abstract and threshold-signature section.","heading":"Evidence locator"}],"slug":"boldyreva03","status":"published","subtitle":"Alexandra Boldyreva · 2003","summary":"Constructs a threshold version of the BLS/GDH signature whose combined output remains an ordinary compact BLS signature.","title":"Threshold Signatures, Multisignatures and Blind Signatures Based on the Gap-Diffie-Hellman-Group Signature Scheme","type":"paper","venue":"PKC 2003","year":2003,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2003-BOLDYREVA"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2017-LINDELL","keywords":["ecdsa","two-party","paillier","malicious-security"],"metadata":{"authors":["Yehuda Lindell"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2017-LINDELL","keywords":["ecdsa","two-party","paillier","malicious-security"],"primary_url":"https://eprint.iacr.org/2017/552","review_scope":"Local ePrint 2017/552 PDF read on 2026-10-11 for the abstract and Sections 1.1-1.3 (PDF pp. 1-5), Protocols 3.1-3.2 (PDF pp. 10-12), Theorem 4.5 (PDF p. 17) and Theorem 5.3 with the Paillier-EC assumption (PDF p. 29); the proofs, Section 6 and the CRYPTO 2017 proceedings version were not re-verified.","status":"published","title":"Fast Secure Two-Party ECDSA Signing","venue":"CRYPTO 2017","versions":["ePrint 2017/552 (revision after the 2021 Journal of Cryptology full version; fixes a zero-knowledge range-proof error and adds Appendix B on an open-source implementation)","conference paper"],"year":2017},"primaryUrl":"https://eprint.iacr.org/2017/552","sections":[{"content":"Provides a maliciously secure 2-of-2 ECDSA protocol producing standard ECDSA signatures. Key generation leaves the second party holding a Paillier encryption of the first party's multiplicative key share, so signing needs only a Diffie–Hellman-style exchange for the nonce point, one homomorphic ciphertext, and a final check that the output signature verifies.","heading":"Atomic claims"},{"content":"ePrint 2017/552 (local PDF): Section 1.2 (PDF pp. 3–4) for the Paillier ciphertext of the key share and the replacement of signing-time zero-knowledge proofs by signature verification; the Caveat paragraph (PDF p. 4) for the two-party-only scope; Protocols 3.1–3.2 (PDF pp. 10–12) for key generation and signing; Theorem 4.5 (PDF p. 17) for game-based security under Paillier IND-CPA and ECDSA unforgeability with concurrent executions and instantaneous global abort; Theorem 5.3 (PDF p. 29) for simulation security under the non-standard Paillier-EC assumption.","heading":"Evidence locator"}],"slug":"lindell17","status":"published","subtitle":"Yehuda Lindell · 2017","summary":"Provides a maliciously secure 2-of-2 ECDSA protocol producing standard ECDSA signatures. Key generation leaves the second party holding a Paillier encryption of the first party's multiplicative key share, so signing needs only a Diffie–Hellman-style exchange for the nonce point, one homomorphic ciphertext, and a final check that the output signature verifies.","title":"Fast Secure Two-Party ECDSA Signing","type":"paper","venue":"CRYPTO 2017","year":2017,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2017-LINDELL"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2018-BGGJKRS","keywords":["threshold-fhe","universal-thresholdizer","lwe","one-round","interchangeable-output"],"metadata":{"authors":["Dan Boneh","Rosario Gennaro","Steven Goldfeder","Aayush Jain","Sam Kim","Peter M. R. Rasmussen","Amit Sahai"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2018-BGGJKRS","keywords":["threshold-fhe","universal-thresholdizer","lwe","one-round","interchangeable-output"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2017/956","review_scope":"ePrint 2017/956 PDF (the PDF states no revision date; PDF metadata dated 2017-09-27; downloaded 2026-10-11) read for the abstract and Section 1 with Sections 1.1-1.2 (pp. 1-4), the overview of Section 2.2 (p. 7), Section 3.3.1 (pp. 8-9), Theorem 3.10 (p. 11), the threshold FHE definitions and constructions of Section 5 (pp. 15-20), the universal thresholdizer of Section 7 with Construction 7.7 and Theorems 7.8-7.12 (pp. 24-27), and Section 8.2 with Definitions 8.9-8.15, Construction 8.16 and Theorems 8.17-8.22 (pp. 31-33); the proofs in the appendices were not re-derived. The application to Dilithium is taken from TSIG-PAPER-2026-PASSELEGUE, Section 4.1.","status":"published","title":"Threshold Cryptosystems From Threshold Fully Homomorphic Encryption","venue":"CRYPTO 2018","versions":["ePrint 2017/956 (merges ePrint 2017/251 and 2017/257)","conference paper"],"year":2018},"primaryUrl":"https://eprint.iacr.org/2017/956","sections":[{"content":"$f","heading":"Atomic claims"},{"content":"$10","heading":"Evidence locator"}],"slug":"bgg18","status":"published","subtitle":"Dan Boneh, Rosario Gennaro, Steven Goldfeder et al. · 2018","summary":"Builds threshold fully homomorphic encryption from LWE in two ways: with linear secret sharing whose reconstruction coefficients are binary, which covers every threshold access structure, and with Shamir sharing and noise that tolerates multiplication by Lagrange coefficients (Sections 5.2-5.3). From it, with zero-knowledge proofs with preprocessing and commitments, builds a universal thresholdizer whose partial evaluations…","title":"Threshold Cryptosystems From Threshold Fully Homomorphic Encryption","type":"paper","venue":"CRYPTO 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2018-BGGJKRS"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2018-DKLS-2P","keywords":["ecdsa","two-party","2-of-n","oblivious-transfer","cdh"],"metadata":{"authors":["Jack Doerner","Yashvanth Kondi","Eysa Lee","abhi shelat"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2018-DKLS-2P","keywords":["ecdsa","two-party","2-of-n","oblivious-transfer","cdh"],"primary_url":"https://eprint.iacr.org/2018/499","review_scope":"Local ePrint 2018/499 PDF (revision dated 2023-07-18) read on 2026-10-11 for the abstract and errata (Section 1.1, PDF pp. 1-5), Section 3.3 and Theorem 4.3 of the revised protocol (PDF pp. 13-15), and the reproduced original paper's Sections I-A to I-B (PDF pp. 38-39), Sections IV-VI (PDF pp. 41-47), Section VII cost analysis and the Section VIII-A comparison with prior work (PDF pp. 48-50); the revised proofs and the appendices of the original were not re-verified.","status":"published","title":"Secure Two-party Threshold ECDSA from ECDSA Assumptions","venue":"IEEE S&P 2018","versions":["ePrint 2018/499, revision dated 2023-07-18 (errata preface, revised protocol and proof in Sections 1-5; the earlier paper is reproduced unaltered from PDF p. 37, itself a revised and expanded version of the S&P paper with a modified protocol and a full proof, per its footnote on PDF p. 37)","conference paper, doi:10.1109/SP.2018.00036 (as stated in the reproduced original, PDF p. 37)"],"year":2018},"primaryUrl":"https://eprint.iacr.org/2018/499","sections":[{"content":"Gives 2-of-n ECDSA key generation and two-message signing whose two secret multiplications use a hardened variant of Gilboa's oblivious-transfer multiplication instead of Paillier encryption, with a consistency check that ties the multiplier inputs to the key and nonce shares. Security against malicious adversaries is proved in the random-oracle model from the Computational Diffie–Hellman assumption and the assumption that ECDSA itself is unforgeable.","heading":"Atomic claims"},{"content":"ePrint 2018/499 (local PDF, revision dated 2023-07-18). Reproduced original paper: abstract (PDF p. 37); Section I-A, Our Technique (original p. 2, PDF p. 38), which takes Lindell's reduction of two-party ECDSA to two secure multiplications and replaces his Paillier computation with an OT-based multiplier; Section I-B, Our Contributions (PDF p. 39); Section IV (PDF p. 41) for the 2-of-2 protocol built on multiplicative shares as in Lindell; Section V (PDF p. 44) for 2-of-n setup and signing, with general thresholds left to future work; Section VI (PDF pp. 45–47) for the OT-extension multiplier. Revised protocol: Section 3.3 (PDF p. 13) adds a pipelineable commitment round so the protocol realizes the standard signing functionality instead of the original nonce-biasable one; Theorem 4.3 (PDF p. 15) states security from CDH, ECDSA EU-CMA security, and a non-programmable global random oracle against one static corruption.","heading":"Evidence locator"},{"content":"Earlier versions of these cards credited this paper with hash-proof-system or smooth-projective-hash machinery. The full text contains none: its multiplier is OT-based (Gilboa's technique hardened with randomized input encoding and a consistency check, over Verified Simplest OT and KOS OT extension). The hash-proof-system route to two-party ECDSA is Castagnos et al., CRYPTO 2019, which this dossier does not yet carry.","heading":"Historical correction"},{"content":"The 2023 preface (Section 1.1, PDF pp. 3–5) reports that the original two-message protocol realizes a functionality letting one party covertly bias the nonce, justified only in the generic group model; it recommends against the KOS OT extension after Roy's 2022 finding, corrects transcription errors in the reproduced KOS protocol, and states that the authors consider the work subsumed by their later three-round protocol.","heading":"Version caution"}],"slug":"dkls18","status":"published","subtitle":"Jack Doerner, Yashvanth Kondi, Eysa Lee et al. · 2018","summary":"Gives 2-of-n ECDSA key generation and two-message signing whose two secret multiplications use a hardened variant of Gilboa's oblivious-transfer multiplication instead of Paillier encryption, with a consistency check that ties the multiplier inputs to the key and nonce shares. Security against malicious adversaries is proved in the random-oracle model from the Computational Diffie–Hellman assumption and the assumption that…","title":"Secure Two-party Threshold ECDSA from ECDSA Assumptions","type":"paper","venue":"IEEE S&P 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2018-DKLS-2P"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2018-GG","keywords":["ecdsa","multiparty","paillier","dkg","dishonest-majority"],"metadata":{"authors":["Rosario Gennaro","Steven Goldfeder"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2018-GG","keywords":["ecdsa","multiparty","paillier","dkg","dishonest-majority"],"primary_url":"https://eprint.iacr.org/2019/114","review_scope":"Local ePrint 2019/114 PDF (revised version) read on 2026-10-11 for the abstract and Sections 1-2 (PDF pp. 1-5), Section 2.6 on Feldman VSS (PDF p. 8), Sections 4.1-4.2 and Theorem 1 (PDF pp. 10-12), Section 4.9 (PDF pp. 19-20), Sections 6.1-6.3 (PDF pp. 23-24) and Section 7.1 (PDF p. 25); the remaining proofs and Section 5, which the authors keep only as a historical record of an insecure variant, were not re-verified.","status":"published","title":"Fast Multiparty Threshold ECDSA with Fast Trustless Setup","venue":"ACM CCS 2018","versions":["ePrint 2019/114, revised version (adds range checks on all Paillier-encrypted values after the attacks the paper cites as [37, 32]; states that the earlier version's proof was incorrect)","conference paper, ACM CCS 2018, pp. 1179–1194 (as cited in the revision's reference [16])"],"year":2018},"primaryUrl":"https://eprint.iacr.org/2019/114","sections":[{"content":"Gives threshold-optimal t-out-of-n ECDSA for any \\( t \\le n \\) against a malicious dishonest majority, with dealerless key generation in which each player Feldman-shares its own random value, and signing by pairwise multiplicative-to-additive share conversions over Paillier encryption. Following Lindell, it checks the jointly computed signature instead of proving most steps in zero knowledge, and it proves game-based unforgeability.","heading":"Atomic claims"},{"content":"$11","heading":"Evidence locator"}],"slug":"gg18","status":"published","subtitle":"Rosario Gennaro, Steven Goldfeder · 2018","summary":"Gives threshold-optimal t-out-of-n ECDSA for any \\( t \\le n \\) against a malicious dishonest majority, with dealerless key generation in which each player Feldman-shares its own random value, and signing by pairwise multiplicative-to-additive share conversions over Paillier encryption. Following Lindell, it checks the jointly computed signature instead of proving most steps in zero knowledge, and it proves game-based…","title":"Fast Multiparty Threshold ECDSA with Fast Trustless Setup","type":"paper","venue":"ACM CCS 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2018-GG"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2019-DKLS-N","keywords":["ecdsa","threshold","oblivious-transfer","multiparty","uc-security","cdh"],"metadata":{"authors":["Jack Doerner","Yashvanth Kondi","Eysa Lee","abhi shelat"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2019-DKLS-N","keywords":["ecdsa","threshold","oblivious-transfer","multiparty","uc-security","cdh"],"primary_url":"https://eprint.iacr.org/2019/523","review_scope":"Local ePrint 2019/523 PDF (revision dated 2020-05-22) read on 2026-10-11 for the abstract and Sections 1-1.3 (PDF pp. 1-8), Section 5 with Protocols 3-4 and Theorem 5.1 (PDF pp. 21-25), and the Section 7.2 comparison table (PDF p. 32); the appendix proofs were not re-verified.","status":"published","title":"Threshold ECDSA from ECDSA Assumptions: The Multiparty Case","venue":"IEEE Symposium on Security and Privacy 2019","versions":["ePrint 2019/523, revision dated 2020-05-22","conference paper, DOI 10.1109/SP.2019.00024 (bibliographic record; not printed in the ePrint revision)"],"year":2019},"primaryUrl":"https://eprint.iacr.org/2019/523","sections":[{"content":"Extends the DKLS18 two-party protocols to t-of-n threshold ECDSA with ⌈log t⌉ + 6 signing rounds, replacing the two-party Diffie–Hellman nonce exchange with multiparty inverse sampling and the two-party consistency check with a broadcast one, and proves the protocol UC-secure against a malicious adversary statically corrupting up to \\( t-1 \\) parties under CDH in the global random-oracle model. Also improves the DKLS18 two-party multiplier by roughly 40%.","heading":"Atomic claims"},{"content":"ePrint 2019/523 (local PDF, revision dated 2020-05-22): abstract (PDF p. 1); Section 1 (PDF pp. 3–4), which names DKLS18 as limited to threshold two and describes this work as its extension to arbitrary thresholds; Section 1.1 (PDF pp. 5–6) for the setup derived from DKLS18, inverse sampling, the broadcast consistency check and the multiplier derived from DKLS18's; Section 1.2 (PDF pp. 6–7) for the contribution list; Section 1.3 (PDF pp. 7–8) comparing contemporaneous Lindell–Nof and Gennaro–Goldfeder protocols; Section 5, Protocols 3–4 and Theorem 5.1 (PDF pp. 22–25).","heading":"Evidence locator"},{"content":"The earlier card listed this paper as \"ePrint 2018/499 lineage\" with a shortened title. ePrint 2018/499 is the two-party paper (TSIG-PAPER-2018-DKLS-2P); this paper is ePrint 2019/523.","heading":"Version identity"}],"slug":"dkls19","status":"published","subtitle":"Jack Doerner, Yashvanth Kondi, Eysa Lee et al. · 2019","summary":"Extends the DKLS18 two-party protocols to t-of-n threshold ECDSA with ⌈log t⌉ + 6 signing rounds, replacing the two-party Diffie–Hellman nonce exchange with multiparty inverse sampling and the two-party consistency check with a broadcast one, and proves the protocol UC-secure against a malicious adversary statically corrupting up to \\( t-1 \\) parties under CDH in the global random-oracle model. Also improves the DKLS18…","title":"Threshold ECDSA from ECDSA Assumptions: The Multiparty Case","type":"paper","venue":"IEEE Symposium on Security and Privacy 2019","year":2019,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2019-DKLS-N"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2020-CGGMP","keywords":["ecdsa","uc-security","identifiable-abort","proactive","preprocessing"],"metadata":{"authors":["Ran Canetti","Rosario Gennaro","Steven Goldfeder","Nikolaos Makriyannis","Udi Peled"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2020-CGGMP","keywords":["ecdsa","uc-security","identifiable-abort","proactive","preprocessing"],"primary_url":"https://eprint.iacr.org/2021/060","status":"published","title":"UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts","venue":"ACM CCS 2020","versions":["ePrint 2021/060 (revised full version)","conference paper"],"year":2020},"primaryUrl":"https://eprint.iacr.org/2021/060","sections":[{"content":"Proves adaptive UC security for two threshold-ECDSA protocols in the global random-oracle model under the paper's stated assumptions. Moves every message-independent round into preprocessing, leaving one message-dependent online round. Adds identifiable abort and proactive share refresh as separate guarantees.","heading":"Atomic claims"},{"content":"ePrint 2021/060 revised full version, abstract and contribution overview. The earlier 2020/540 report is obsolete and is not used as proof evidence.","heading":"Evidence locator"}],"slug":"cggmp20","status":"published","subtitle":"Ran Canetti, Rosario Gennaro, Steven Goldfeder et al. · 2020","summary":"Proves adaptive UC security for two threshold-ECDSA protocols in the global random-oracle model under the paper's stated assumptions. Moves every message-independent round into preprocessing, leaving one message-dependent online round. Adds identifiable abort and proactive share refresh as separate guarantees.","title":"UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts","type":"paper","venue":"ACM CCS 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2020-CGGMP"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2020-FROST","keywords":["schnorr","discrete-log","two-round","preprocessing","practical"],"metadata":{"authors":["Chelsea Komlo","Ian Goldberg"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2020-FROST","keywords":["schnorr","discrete-log","two-round","preprocessing","practical"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2020/852","status":"published","title":"FROST: Flexible Round-Optimized Schnorr Threshold Signatures","venue":"SAC 2020","versions":["ePrint 2020/852","conference paper"],"year":2020},"primaryUrl":"https://eprint.iacr.org/2020/852","sections":[{"content":"Gives a true t-out-of-n Schnorr threshold protocol with two-round signing, or one online round after preprocessing, under a static-adversary security treatment.","heading":"Atomic claims"},{"content":"ePrint 2020/852, Sections 5.1–5.2 and Figures 1–3 (PDF pp. 10–15) for key generation, preprocessing, the two-round variant, the single online round, and share attribution; Section 6.2 and Theorem 6.1 (PDF pp. 16–18) for the chosen-message reduction and fewer-than-t corruption bound.","heading":"Evidence locator"}],"slug":"kg20","status":"published","subtitle":"Chelsea Komlo, Ian Goldberg · 2020","summary":"Gives a true t-out-of-n Schnorr threshold protocol with two-round signing, or one online round after preprocessing, under a static-adversary security treatment.","title":"FROST: Flexible Round-Optimized Schnorr Threshold Signatures","type":"paper","venue":"SAC 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2020-FROST"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2021-DOTT","keywords":["lattice","module-lwe","module-sis","fiat-shamir-with-aborts","n-out-of-n","two-round"],"metadata":{"authors":["Ivan Damgård","Claudio Orlandi","Akira Takahashi","Mehdi Tibouchi"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2021-DOTT","keywords":["lattice","module-lwe","module-sis","fiat-shamir-with-aborts","n-out-of-n","two-round"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2020/1110","status":"published","title":"Two-round n-out-of-n and Multi-Signatures and Trapdoor Commitment from Lattices","venue":"PKC 2021; Journal of Cryptology 2022","versions":["ePrint 2020/1110","conference paper","journal paper"],"year":2021},"primaryUrl":"https://eprint.iacr.org/2020/1110","sections":[{"content":"Constructs two-round n-out-of-n distributed lattice signing and identifies abort-transcript leakage as a security issue addressed with homomorphic trapdoor commitments.","heading":"Atomic claims"},{"content":"ePrint 2020/1110 full Journal of Cryptology version: Section 1.1 (PDF pp. 4–7) for abort leakage and homomorphic commitments; Section 3.1 and Figure 6 (PDF pp. 16–19) for DS2; Section 3.3, Theorem 1 (PDF pp. 19–26) for DS-UF-CMA security; Section 5 and Theorem 3 for the trapdoor commitment.","heading":"Evidence locator"}],"slug":"dott21","status":"published","subtitle":"Ivan Damgård, Claudio Orlandi, Akira Takahashi et al. · 2021","summary":"Constructs two-round n-out-of-n distributed lattice signing and identifies abort-transcript leakage as a security issue addressed with homomorphic trapdoor commitments.","title":"Two-round n-out-of-n and Multi-Signatures and Trapdoor Commitment from Lattices","type":"paper","venue":"PKC 2021; Journal of Cryptology 2022","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2021-DOTT"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2021-GKMN","keywords":["schnorr","deterministic-nonce","stateless","garbled-circuits","dishonest-majority"],"metadata":{"authors":["François Garillot","Yashvanth Kondi","Payman Mohassel","Valeria Nikolaenko"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2021-GKMN","keywords":["schnorr","deterministic-nonce","stateless","garbled-circuits","dishonest-majority"],"primary_url":"https://eprint.iacr.org/2021/1055","status":"published","title":"Threshold Schnorr with Stateless Deterministic Signing from Standard Assumptions","venue":"CRYPTO 2021","versions":["ePrint 2021/1055","conference paper"],"year":2021},"primaryUrl":"https://eprint.iacr.org/2021/1055","sections":[{"content":"Constructs dishonest-majority threshold Schnorr with deterministic nonce derivation and no evolving long-term state, using standardized block ciphers and zero-knowledge-from-garbled-circuits tools.","heading":"Atomic claims"},{"content":"ePrint 2021/1055, Sections 1.3–1.4 (PDF pp. 4–9) for the standard-assumption toolchain and stateless deterministic objective; Section 9 protocol rounds and Theorem 9.3 (PDF pp. 33–34) for the three-round signing flow and static n-1-corruption UC claim in the stated hybrid model.","heading":"Evidence locator"}],"slug":"gkmn21","status":"published","subtitle":"François Garillot, Yashvanth Kondi, Payman Mohassel et al. · 2021","summary":"Constructs dishonest-majority threshold Schnorr with deterministic nonce derivation and no evolving long-term state, using standardized block ciphers and zero-knowledge-from-garbled-circuits tools.","title":"Threshold Schnorr with Stateless Deterministic Signing from Standard Assumptions","type":"paper","venue":"CRYPTO 2021","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2021-GKMN"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2022-DILIZIUM2","keywords":["lattice","module-lwe","module-sis","dilithium","two-party","compression"],"metadata":{"authors":["Peeter Laud","Nikita Snetkov","Jelizaveta Vakarjuk"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2022-DILIZIUM2","keywords":["lattice","module-lwe","module-sis","dilithium","two-party","compression"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2022/644","status":"published_with_outdated_eprint","title":"DiLizium 2.0: Revisiting Two-Party Crystals-Dilithium","venue":"Journal of Computer Security final version","versions":["ePrint 2022/644","journal article"],"year":2022},"primaryUrl":"https://eprint.iacr.org/2022/644","sections":[{"content":"Refines the DOTT-style two-party line with Dilithium compression techniques and reports a three-round protocol in the audited preprint.","heading":"Atomic claims"},{"content":"ePrint 2022/644, Section 1.1 (PDF p. 2) for the three-round construction and compression delta; Theorem 1 (PDF pp. 10–11) for classical-ROM DS-UF-CMA security from the commitment properties, Module-LWE, and Module-SIS; Section 4 and Table 2 (PDF pp. 14–15) for the Java benchmark and preprint parameters.","heading":"Evidence locator"},{"content":"The ePrint page explicitly marks 2022/644 as outdated relative to the final journal version; the audited PDF's parameters and measurements remain preprint observations and must not be copied as final-journal values without a journal audit.","heading":"Version warning"}],"slug":"lsv22","status":"published_with_outdated_eprint","subtitle":"Peeter Laud, Nikita Snetkov, Jelizaveta Vakarjuk · 2022","summary":"Refines the DOTT-style two-party line with Dilithium compression techniques and reports a three-round protocol in the audited preprint.","title":"DiLizium 2.0: Revisiting Two-Party Crystals-Dilithium","type":"paper","venue":"Journal of Computer Security final version","year":2022,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2022-DILIZIUM2"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2023-GKS","keywords":["lattice","ring-lwe","sis","threshold-he","arbitrary-threshold","two-round"],"metadata":{"authors":["Kamil Doruk Gur","Jonathan Katz","Tjerand Silde"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2023-GKS","keywords":["lattice","ring-lwe","sis","threshold-he","arbitrary-threshold","two-round"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2023/1318","status":"published","title":"Two-Round Threshold Lattice-Based Signatures from Threshold Homomorphic Encryption","venue":"PQCrypto 2024","versions":["ePrint 2023/1318","conference paper"],"year":2023},"primaryUrl":"https://eprint.iacr.org/2023/1318","sections":[{"content":"Generalizes the two-round lattice line from full threshold to arbitrary t<=n by using an actively secure threshold linearly homomorphic-encryption layer.","heading":"Atomic claims"},{"content":"ePrint 2023/1318, Section 3 and Theorem 1 (PDF pp. 12–16) for threshold linear HE; Section 5, Figures 6–7, and Theorem 3 (PDF pp. 22–26) for active two-round t-out-of-n signing; Section 7 and the concrete-size table (PDF pp. 30–31) for the 3-out-of-5 estimate.","heading":"Evidence locator"}],"slug":"gks23","status":"published","subtitle":"Kamil Doruk Gur, Jonathan Katz, Tjerand Silde · 2023","summary":"Generalizes the two-round lattice line from full threshold to arbitrary t<=n by using an actively secure threshold linearly homomorphic-encryption layer.","title":"Two-Round Threshold Lattice-Based Signatures from Threshold Homomorphic Encryption","type":"paper","venue":"PQCrypto 2024","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2023-GKS"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2023-OLAF","keywords":["schnorr","frost","dkg","aomdl","random-oracle","proof-model"],"metadata":{"authors":["Hien Chu","Paul Gerhart","Tim Ruffing","Dominique Schröder"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2023-OLAF","keywords":["schnorr","frost","dkg","aomdl","random-oracle","proof-model"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2023/899","status":"published","title":"Practical Schnorr Threshold Signatures Without the Algebraic Group Model","venue":"CRYPTO 2023","versions":["ePrint 2023/899","conference paper"],"year":2023},"primaryUrl":"https://eprint.iacr.org/2023/899","sections":[{"content":"Combines FROST3 with a Pedersen-DKG variant and proves unforgeability without the algebraic group model, under AOMDL in the random-oracle model.","heading":"Atomic claims"},{"content":"ePrint 2023/899, abstract and proof overview.","heading":"Evidence locator"}],"slug":"cgrs23","status":"published","subtitle":"Hien Chu, Paul Gerhart, Tim Ruffing et al. · 2023","summary":"Combines FROST3 with a Pedersen-DKG variant and proves unforgeability without the algebraic group model, under AOMDL in the random-oracle model.","title":"Practical Schnorr Threshold Signatures Without the Algebraic Group Model","type":"paper","venue":"CRYPTO 2023","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2023-OLAF"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2024-TANG","keywords":["lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive"],"metadata":{"authors":["Guofeng Tang","Bo Pang","Long Chen","Zhenfeng Zhang"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2024-TANG","keywords":["lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive"],"maps_to":["TSIG-OP-001"],"primary_url":"https://doi.org/10.1109/TIFS.2023.3293408","status":"published","title":"Efficient Lattice-Based Threshold Signatures with Functional Interchangeability","venue":"IEEE Transactions on Information Forensics and Security 18, 4173–4187","versions":["journal article, DOI 10.1109/TIFS.2023.3293408","ePrint 2024/1067"],"year":2023},"primaryUrl":"https://doi.org/10.1109/TIFS.2023.3293408","sections":[{"content":"Reports an implemented t-out-of-n lattice threshold signature with ordinary-verifier interoperability, distributed rejection sampling, and proactive refresh.","heading":"Atomic claims"},{"content":"ePrint 2024/1067, Section 1.1 (PDF p. 4) for functional interchangeability, implementation scope, and proactive security; Sections 5–6, Definition 3, and Theorem 2 (PDF pp. 12–18) for the ordinary verifier and mobile-adversary model; Section 7, Tables 2–7 (PDF pp. 21–27) for preprocessing, 15 online signing rounds, 1.417 MB per-party communication in the reported profile, and LAN/WAN measurements.","heading":"Evidence locator"}],"slug":"tpcz23","status":"published","subtitle":"Guofeng Tang, Bo Pang, Long Chen et al. · 2023","summary":"Reports an implemented t-out-of-n lattice threshold signature with ordinary-verifier interoperability, distributed rejection sampling, and proactive refresh.","title":"Efficient Lattice-Based Threshold Signatures with Functional Interchangeability","type":"paper","venue":"IEEE Transactions on Information Forensics and Security 18, 4173–4187","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2024-TANG"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2024-AOMMLWE","keywords":["lattice","aom-mlwe","two-round","offline-online","large-threshold"],"metadata":{"authors":["Thomas Espitau","Shuichi Katsumata","Kaoru Takemure"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2024-AOMMLWE","keywords":["lattice","aom-mlwe","two-round","offline-online","large-threshold"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2024/496","status":"published","title":"Two-Round Threshold Signature from Algebraic One-More Learning with Errors","venue":"CRYPTO 2024; Journal of Cryptology revision","versions":["ePrint 2024/496","conference paper","journal version"],"year":2024},"primaryUrl":"https://eprint.iacr.org/2024/496","sections":[{"content":"Builds an efficient two-round lattice threshold signature without FHE or homomorphic trapdoor commitments, with a message- and signer-set-independent offline round.","heading":"Atomic claims"},{"content":"ePrint 2024/496, final author revision dated 2026-04-07: Sections 1.1 and 2.1, Figure 2 (PDF pp. 4–10) for the two-round offline/online construction; Theorem 4.5 (PDF pp. 27–32) for the selective AOM-UMLWE reduction from UMLWE/MSIS; Theorem 6.1 (PDF pp. 35–36) for threshold unforgeability under adaptive AOM-MLWE and PRF security; Section 8.3, Table 3 (PDF p. 58) for the threshold-1024 parameter profiles.","heading":"Evidence locator"}],"slug":"ekt24","status":"published","subtitle":"Thomas Espitau, Shuichi Katsumata, Kaoru Takemure · 2024","summary":"Builds an efficient two-round lattice threshold signature without FHE or homomorphic trapdoor commitments, with a message- and signer-set-independent offline round.","title":"Two-Round Threshold Signature from Algebraic One-More Learning with Errors","type":"paper","venue":"CRYPTO 2024; Journal of Cryptology revision","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2024-AOMMLWE"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2024-FLOOD","keywords":["lattice","hash-and-sign","mlwe","robust-dkg","noise-flooding","random-submersion"],"metadata":{"authors":["Thomas Espitau","Guilhem Niot","Thomas Prest"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2024-FLOOD","keywords":["lattice","hash-and-sign","mlwe","robust-dkg","noise-flooding","random-submersion"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2024/959","status":"published","title":"Flood and Submerse: Distributed Key Generation and Robust Threshold Signature from Lattices","venue":"CRYPTO 2024","versions":["ePrint 2024/959","conference paper"],"year":2024},"primaryUrl":"https://eprint.iacr.org/2024/959","sections":[{"content":"Introduces a robust hash-and-sign lattice threshold route using verifiable short secret sharing via random submersions and noise flooding, without FHE.","heading":"Atomic claims"},{"content":"ePrint 2024/959, abstract and framework overview.","heading":"Evidence locator"}],"slug":"enp24","status":"published","subtitle":"Thomas Espitau, Guilhem Niot, Thomas Prest · 2024","summary":"Introduces a robust hash-and-sign lattice threshold route using verifiable short secret sharing via random submersions and noise flooding, without FHE.","title":"Flood and Submerse: Distributed Key Generation and Robust Threshold Signature from Lattices","type":"paper","venue":"CRYPTO 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2024-FLOOD"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2024-GLACIUS","keywords":["schnorr","ddh","adaptive-security","identifiable-abort","constant-size-signing-key"],"metadata":{"authors":["Renas Bacho","Sourav Das","Julian Loss","Ling Ren"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2024-GLACIUS","keywords":["schnorr","ddh","adaptive-security","identifiable-abort","constant-size-signing-key"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2024/1628","status":"published","title":"Glacius: Threshold Schnorr Signatures from DDH with Full Adaptive Security","venue":"EUROCRYPT 2025","versions":["ePrint 2024/1628","conference paper"],"year":2024},"primaryUrl":"https://eprint.iacr.org/2024/1628","sections":[{"content":"Gives threshold Schnorr with full adaptive security from DDH in the random-oracle model, full t<n corruption tolerance under the paper's convention, constant-size signing keys, and identifiable abort.","heading":"Atomic claims"},{"content":"ePrint 2024/1628, abstract and security-definition discussion.","heading":"Evidence locator"}],"slug":"bdlr24","status":"published","subtitle":"Renas Bacho, Sourav Das, Julian Loss et al. · 2024","summary":"Gives threshold Schnorr with full adaptive security from DDH in the random-oracle model, full t<n corruption tolerance under the paper's convention, constant-size signing keys, and identifiable abort.","title":"Glacius: Threshold Schnorr Signatures from DDH with Full Adaptive Security","type":"paper","venue":"EUROCRYPT 2025","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2024-GLACIUS"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2024-RACCOON","keywords":["lattice","module-lwe","module-sis","large-threshold","implementation","masks"],"metadata":{"authors":["Rafael del Pino","Shuichi Katsumata","Mary Maller","Fabrice Mouhartem","Thomas Prest","Markku-Juhani Saarinen"],"citation_key":"PKM+24","citation_note":"Pin the author-year form used in Ringtail; del Pino also appears under other particle conventions in the literature.","citation_sources":["https://eprint.iacr.org/2024/1113.pdf"],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2024-RACCOON","keywords":["lattice","module-lwe","module-sis","large-threshold","implementation","masks"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2024/184","status":"published","title":"Threshold Raccoon: Practical Threshold Signatures from Standard Lattice Assumptions","venue":"EUROCRYPT 2024","versions":["ePrint 2024/184","conference paper"],"year":2024},"primaryUrl":"https://eprint.iacr.org/2024/184","sections":[{"content":"Constructs a three-round lattice threshold signature from standard lattice assumptions, with pairwise one-time additive masks and concrete parameter sets supporting thresholds up to 1024.","heading":"Atomic claims"},{"content":"ePrint 2024/184, Sections 1.1 and 2.3 (PDF pp. 4–10) for the three-round design and mask mechanism; Sections 6–7, Figure 5, and Theorem 7.2 (PDF pp. 20–25) for trusted centralized key generation, static corruption below T, and unforgeability; Section 8.3, Table 2, and Section 9, Table 3 (PDF pp. 43–44) for the 128-bit 3.9 KB verification key, 12.7 KB signature, communication, and cycle-count profiles.","heading":"Evidence locator"}],"slug":"pkm24","status":"published","subtitle":"Rafael del Pino, Shuichi Katsumata, Mary Maller et al. · 2024","summary":"Constructs a three-round lattice threshold signature from standard lattice assumptions, with pairwise one-time additive masks and concrete parameter sets supporting thresholds up to 1024.","title":"Threshold Raccoon: Practical Threshold Signatures from Standard Lattice Assumptions","type":"paper","venue":"EUROCRYPT 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2024-RACCOON"},{"evidence":"bibliographic_checked","id":"TSIG-PAPER-2025-CCKM","keywords":["adaptive-security","key-unique","impossibility","schnorr","bls","ecdsa"],"metadata":{"authors":["Michele Ciampi","Elizabeth Crites","Chelsea Komlo","Mary Maller"],"contribution_ids":[],"dossier_type":"paper","evidence":"bibliographic_checked","id":"TSIG-PAPER-2025-CCKM","keywords":["adaptive-security","key-unique","impossibility","schnorr","bls","ecdsa"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2025/943","review_scope":"ePrint 2025/943 abstract page checked 2026-10-10, with the summary in the MPTS 2026 slides of E. Crites (NIST, 2026-01-26, slides 2-13); the full text was not retrievable (HTTP 403).","status":"preprint","title":"On the Adaptive Security of Key-Unique Threshold Signatures","venue":"IACR ePrint 2025/943","versions":["ePrint 2025/943 (received 2025-05-23; fourth revision 2026-02-24)"],"year":2025},"primaryUrl":"https://eprint.iacr.org/2025/943","sections":[{"content":"For key-unique threshold signatures, in which each public key share fixes its secret share and well-formedness is efficiently checkable, shows that adaptive security cannot be proved from any non-interactive computational or decisional assumption for a broad class of reductions when the number of corruptions lies between about t/l and t (signing threshold t+1, l a constant). For threshold Schnorr, shows that adaptive security cannot be proved in the random oracle model from OMDL, AOMDL or algebraic one-more CDH with a natural class of rewinding reductions when corruptions lie between about t/2 and t. Affected schemes include threshold BLS, ECDSA and Schnorr compatible with standard signatures.","heading":"Atomic claims"},{"content":"ePrint 2025/943 abstract page (checked 2026-10-10). MPTS 2026 slides of E. Crites (https://csrc.nist.gov/presentations/2026/mpts2026-1a2), slides 6-13, for the two impossibility results and the escape through decisional assumptions with hidden or non-unique public key shares.","heading":"Evidence locator"}],"slug":"cckm25","status":"preprint","subtitle":"Michele Ciampi, Elizabeth Crites, Chelsea Komlo et al. · 2025","summary":"For key-unique threshold signatures, in which each public key share fixes its secret share and well-formedness is efficiently checkable, shows that adaptive security cannot be proved from any non-interactive computational or decisional assumption for a broad class of reductions when the number of corruptions lies between about t/l and t (signing threshold t+1, l a constant). For threshold Schnorr, shows that adaptive…","title":"On the Adaptive Security of Key-Unique Threshold Signatures","type":"paper","venue":"IACR ePrint 2025/943","year":2025,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2025-CCKM"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2025-CHEN","keywords":["schnorr","adaptive-security","rewinding","masking","aomdl","round-complexity"],"metadata":{"authors":["Yanbo Chen"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2025-CHEN","keywords":["schnorr","adaptive-security","rewinding","masking","aomdl","round-complexity"],"maps_to":["TSIG-OP-007"],"primary_url":"https://cic.iacr.org/p/2/2/16","review_scope":"CiC open-access PDF read for the abstract, Section 1 with Table 1 (pp. 1-3), and the statements of Theorems 1 and 2 (pp. 15 and 26); the proofs were not re-derived.","status":"published","title":"Round-Efficient Adaptively Secure Threshold Signatures with Rewinding","venue":"IACR Communications in Cryptology 2(2)","versions":["CiC vol. 2, no. 2, DOI 10.62056/ah893z10k (received 2025-04-08, accepted 2025-06-02)"],"year":2025},"primaryUrl":"https://cic.iacr.org/p/2/2/16","sections":[{"content":"Proves full adaptive security (up to \\( t-1 \\) adaptive corruptions) with rewinding proofs in the random oracle model, without the algebraic group model, for two schemes. FROST-Mask outputs standard Schnorr signatures, is secure under AOMDL, and signs in two rounds with state kept across sessions; the stateless version obtained by the transformation of Katsumata, Reichle and Takemure has three rounds. HBTS-Mask is stateless, signs in two rounds, is secure under DL, and outputs signatures with one more scalar than a Schnorr signature.","heading":"Atomic claims"},{"content":"CiC PDF: abstract (p. 1) for the 3-round AOMDL scheme with standard Schnorr output and the 2-round DL scheme with one extra scalar; Section 1 (pp. 1-2) for the definition of adaptive security with at most \\( t-1 \\) corruptions and the doubling of corruptions in rewinding proofs; Section 1.1 (p. 2) for the stateful 2-round FROST-Mask and its stateless 3-round compilation; Table 1 (p. 3) for rounds, state, assumptions and signature sizes of earlier adaptively secure schemes, including four-round stateful Glacius; Theorem 1 (Section 3.2, p. 15) and Theorem 2 (Section 4.2, p. 26) for the security statements.","heading":"Evidence locator"}],"slug":"chen25","status":"published","subtitle":"Yanbo Chen · 2025","summary":"Proves full adaptive security (up to \\( t-1 \\) adaptive corruptions) with rewinding proofs in the random oracle model, without the algebraic group model, for two schemes. FROST-Mask outputs standard Schnorr signatures, is secure under AOMDL, and signs in two rounds with state kept across sessions; the stateless version obtained by the transformation of Katsumata, Reichle and Takemure has three rounds. HBTS-Mask is stateless,…","title":"Round-Efficient Adaptively Secure Threshold Signatures with Rewinding","type":"paper","venue":"IACR Communications in Cryptology 2(2)","year":2025,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2025-CHEN"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2025-CKKTZ","keywords":["schnorr","frost","adaptive-security","aomdl","ldvr","algebraic-group-model"],"metadata":{"authors":["Elizabeth Crites","Jonathan Katz","Chelsea Komlo","Stefano Tessaro","Chenzhi Zhu"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2025-CKKTZ","keywords":["schnorr","frost","adaptive-security","aomdl","ldvr","algebraic-group-model"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2025/1061","review_scope":"ePrint 2025/1061 PDF (no revision date stated; downloaded 2026-10-11) read for the abstract (p. 1), Section 1 with Sections 1.1-1.2 (pp. 3-6), the adaptive-security definition of Section 2.1 (pp. 9-10), Theorem 1 (p. 12), Sections 4.1-4.2 (pp. 14-18), Theorem 2 (p. 18) and Theorem 3 (p. 27); the proofs were not re-derived. The result summary in the authors' MPTS 2026 talk (NIST, 2026-01-26) was also read.","status":"published","title":"On the Adaptive Security of FROST","venue":"CRYPTO 2025","versions":["ePrint 2025/1061","conference paper"],"year":2025},"primaryUrl":"https://eprint.iacr.org/2025/1061","sections":[{"content":"States that security of FROST and its variants under adaptive corruptions had remained an open problem. With n parties, signing threshold \\( t+1 \\), at most \\( t_c \\) corruptions that reveal a party's key and full state (no erasures), and unforgeability in the sense of TS-UF-0, proves adaptive security of FROST1, FROST2 and FROST3 in the random oracle model under AOMDL when \\( t_c = \\lfloor t/2 \\rfloor \\) (Theorem 1), and for every \\( t_c \\le t \\) in the algebraic group model and random oracle model under AOMDL and the new \\( (t_c, t, n) \\) low-dimensional vector representation (LDVR) assumption (Theorem 2). Shows that if LDVR is easy for given parameters, an adversary corrupting \\( t_c \\) parties forges against any threshold Schnorr scheme whose key shares are Shamir shares with computable commitments \\( g^{sk_i} \\), FROST included, even with erasures (Section 4.2), and that LDVR is unconditionally hard in some regimes, including some \\( t_c > t/2 \\) (Theorem 3).","heading":"Atomic claims"},{"content":"ePrint 2025/1061 PDF (downloaded 2026-10-11; the PDF states no revision date): abstract (p. 1) and Section 1 (p. 3) for the open problem; Section 1 (p. 4) for the remark that no pairing-free two-round threshold scheme with adaptive security was known before, even in the algebraic group model; Section 2.1 (pp. 9-10, Figure 3 and Definition 4) for adaptive security without erasures, corresponding to TS-UF-0; Theorem 1 (Section 3, p. 12) for \\( t_c = \\lfloor t/2 \\rfloor \\) in the random oracle model under AOMDL; Section 4.2 (pp. 16-18) for the LDVR attack; Theorem 2 (Section 4.3, p. 18) for full adaptive security in the algebraic group and random oracle models; Theorem 3 (Section 4.4, p. 27) for unconditional hardness of LDVR. The MPTS 2026 slides of E. Crites (NIST, 2026-01-26, slides 25-28) restate the two main results and the parameter regimes in which LDVR is unconditionally hard.","heading":"Evidence locator"}],"slug":"ckktz25","status":"published","subtitle":"Elizabeth Crites, Jonathan Katz, Chelsea Komlo et al. · 2025","summary":"States that security of FROST and its variants under adaptive corruptions had remained an open problem. With n parties, signing threshold \\( t+1 \\), at most \\( t_c \\) corruptions that reveal a party's key and full state (no erasures), and unforgeability in the sense of TS-UF-0, proves adaptive security of FROST1, FROST2 and FROST3 in the random oracle model under AOMDL when \\( t_c = \\lfloor t/2 \\rfloor \\) (Theorem 1), and…","title":"On the Adaptive Security of FROST","type":"paper","venue":"CRYPTO 2025","year":2025,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2025-CKKTZ"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2025-FAFROST","keywords":["schnorr","frost","adaptive-security","identifiable-abort","aomdl","algebraic-group-model"],"metadata":{"authors":["Ruben Baecker","Paul Gerhart","Davide Li Calsi","Luigi Russo","Dominique Schröder","Arkady Yerukhimovich"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2025-FAFROST","keywords":["schnorr","frost","adaptive-security","identifiable-abort","aomdl","algebraic-group-model"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2025/1950","review_scope":"ePrint 2025/1950 PDF (the 2026-09-14 revision by its PDF metadata; downloaded 2026-10-11) read for the abstract and title-page note (p. 1), Section 1 (pp. 2-3), the technical overview of Section 2 (pp. 3-11), Section 3 with Table 1 (pp. 11-12), the security games and Definitions 1-2 of Section 4 (pp. 14-17), the scheme of Section 5 with Figures 4-6 (pp. 16-20), Theorem 1 with the start of its proof (pp. 18-21), the bound on forgery matrices with Lemmas 1-2 (pp. 28-32), Theorems 2 and 3 (pp. 32-33), Section 7 and the acknowledgments (pp. 35-37); the proofs were not re-derived. The NIST TCPT2 preview slides (2026-07-07) were checked on 2026-10-10.","status":"published","title":"Fully Adaptive FROST with Identifiable Aborts from AOMDL","venue":"ASIACRYPT 2026","versions":["ePrint 2025/1950 (revised 2026-09-14; full version of the ASIACRYPT 2026 paper, which states that it is a major revision of, and supersedes, the preprint first posted as \"Fully Adaptive FROST in the Algebraic Group Model From Falsifiable Assumptions\")","NIST threshold call preview talk, TCPT2, 2026-07-07"],"year":2025},"primaryUrl":"https://eprint.iacr.org/2025/1950","sections":[{"content":"$12","heading":"Atomic claims"},{"content":"$13","heading":"Version and bibliographic notes"},{"content":"$14","heading":"Evidence locator"}],"slug":"bgc25","status":"published","subtitle":"Ruben Baecker, Paul Gerhart, Davide Li Calsi et al. · 2025","summary":"Asks for a round-optimal Schnorr threshold signature with full adaptive security under well-established assumptions, for arbitrarily large signing groups, with identifiable aborts (Section 1). Gives FaFROST, a FROST2 variant that keeps the message-independent first round and masks each second-round partial signature with pairwise blinding values derived from pairwise keys, the first-round messages, the message and the signer…","title":"Fully Adaptive FROST with Identifiable Aborts from AOMDL","type":"paper","venue":"ASIACRYPT 2026","year":2025,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2025-FAFROST"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2025-GLRS","keywords":["schnorr","adaptive-security","ddh","two-round","key-refresh"],"metadata":{"authors":["Paul Gerhart","Davide Li Calsi","Luigi Russo","Dominique Schröder"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2025-GLRS","keywords":["schnorr","adaptive-security","ddh","two-round","key-refresh"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2025/1478","review_scope":"ePrint 2025/1478 PDF (no revision date stated; downloaded 2026-10-11) read for the abstract and Section 1 (pp. 1-4), the security model of Section 3.2 (pp. 13-16), the protocol of Section 4 with Figure 3 (pp. 16-19), Theorem 1 and the instantiation of Section 4.1 (pp. 19-20), Theorem 2 (Section 5, p. 21) and Theorem 3 (Appendix B, pp. 35-36); the proofs were not re-derived.","status":"published","title":"Fully-Adaptive Two-Round Threshold Schnorr Signatures from DDH","venue":"EUROCRYPT 2026","versions":["ePrint 2025/1478 (minor revision of the EUROCRYPT 2026 paper)","conference paper"],"year":2025},"primaryUrl":"https://eprint.iacr.org/2025/1478","sections":[{"content":"$15","heading":"Atomic claims"},{"content":"ePrint 2025/1478 PDF (downloaded 2026-10-11; the PDF states no revision date): abstract (p. 1) and Section 1 (p. 2) for full adaptive security as an unresolved challenge; Section 1.1 (pp. 2-3) for the impossibility results it builds on and the posed question; Section 1.3 (p. 4) for the aim of two rounds from non-interactive assumptions without the algebraic group model; Section 3.2 (pp. 14-16, Figure 2) for the adaptive unforgeability game with at most \\( t-1 \\) corruptions and the model with key refresh after d messages; Section 4 (pp. 16-19, Figure 3) for the two-round protocol, stateless across rounds, with standard Schnorr verification; Theorem 1 (p. 19) and Section 4.1 (pp. 19-20) for security under DDH in the random oracle model; Theorem 2 (Section 5, p. 21); Theorem 3 (Appendix B, pp. 35-36). The scheme appears as \"Cryos\" in the comparison table of the FaFROST preview slides (NIST TCPT2, 2026-07-07, slide 25), marked as requiring key updates after a bounded number of signing rounds.","heading":"Evidence locator"}],"slug":"gcrs25","status":"published","subtitle":"Paul Gerhart, Davide Li Calsi, Luigi Russo et al. · 2025","summary":"Calls full adaptive security against up to \\( t-1 \\) corruptions under standard assumptions a longstanding and unresolved challenge for threshold Schnorr, since recent impossibility results rule out known proof techniques for widely deployed two-round schemes or rely on speculative assumptions and idealized models, while fully adaptive constructions from falsifiable assumptions need more rounds; it poses the question of a…","title":"Fully-Adaptive Two-Round Threshold Schnorr Signatures from DDH","type":"paper","venue":"EUROCRYPT 2026","year":2025,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2025-GLRS"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2025-MSFROST","keywords":["schnorr","frost","adaptive-security","aomdl","algebraic-group-model","impossibility"],"metadata":{"authors":["Renas Bacho","Yanbo Chen","Julian Loss","Stefano Tessaro","Chenzhi Zhu"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2025-MSFROST","keywords":["schnorr","frost","adaptive-security","aomdl","algebraic-group-model","impossibility"],"maps_to":["TSIG-OP-007"],"primary_url":"https://eprint.iacr.org/2025/1953","review_scope":"ePrint 2025/1953 PDF (the 2026-09-02 revision by its PDF metadata; downloaded 2026-10-11) read for the abstract and Section 1 with Table 1 (pp. 1-4), the technical overview of Section 2 (pp. 4-9), Section 3.3 with Figure 3 (pp. 10-12), Section 4 with Figure 4 and Theorem 1 (pp. 12-13), Theorem 2 (Section 5, p. 24) and the acknowledgments (p. 27); the proofs were not re-derived.","status":"published","title":"Adaptively Secure Partially Non-Interactive Threshold Schnorr Signatures in the AGM","venue":"EUROCRYPT 2026","versions":["ePrint 2025/1953 (received 2025-10-20; fourth revision 2026-09-02, which fixes a flaw in the security proof)","conference paper"],"year":2025},"primaryUrl":"https://eprint.iacr.org/2025/1953","sections":[{"content":"States that it remained open whether a two-round threshold Schnorr signature with full adaptive security can be built from assumptions more established than LDVR, and that no stateless two-round scheme of this kind existed. Gives ms-FROST, a partially non-interactive two-round scheme with a message-independent first round, in which each signer masks its partial signature with pairwise one-time masks and has no public key share. With ideal key generation, proves adp-TS-UF-4 security against algebraic adversaries that adaptively corrupt up to \\( t-1 < n \\) signers and learn their full state, under AOMDL in the random oracle model (Theorem 1). Shows that no algebraic black-box reduction in the random oracle model can reduce AOMDL to adaptive TS-UF-0 security of ms-FROST (Theorem 2).","heading":"Atomic claims"},{"content":"ePrint 2025/1953 PDF (the 2026-09-02 revision by its PDF metadata; downloaded 2026-10-11): abstract (p. 1) and Section 1 (p. 2) for the open problem, which the paper answers in the algebraic group model; Table 1 (p. 3) for rounds, assumptions, use of the algebraic group model, state and erasures of fully adaptive threshold Schnorr schemes; Section 3.3 (pp. 10-12, Figure 3) for adp-TS-UF-0 and adp-TS-UF-4 with at most \\( t-1 \\) corruptions that reveal the signer's state; Section 4 (pp. 12-13, Figure 4) for ms-FROST and Theorem 1; Section 2.2 (pp. 8-9) and Theorem 2 (Section 5, p. 24) for the impossibility result; acknowledgments (p. 27) for the flaw in the security analysis of an earlier version. The ePrint abstract page (checked 2026-10-10) also records the 2026-09-02 revision correcting that flaw.","heading":"Evidence locator"}],"slug":"bcltz25","status":"published","subtitle":"Renas Bacho, Yanbo Chen, Julian Loss et al. · 2025","summary":"States that it remained open whether a two-round threshold Schnorr signature with full adaptive security can be built from assumptions more established than LDVR, and that no stateless two-round scheme of this kind existed. Gives ms-FROST, a partially non-interactive two-round scheme with a message-independent first round, in which each signer masks its partial signature with pairwise one-time masks and has no public key…","title":"Adaptively Secure Partially Non-Interactive Threshold Schnorr Signatures in the AGM","type":"paper","venue":"EUROCRYPT 2026","year":2025,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2025-MSFROST"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2026-CELI","keywords":["ml-dsa","fips-204","lattice","replicated-secret-sharing","dishonest-majority","interchangeable-output"],"metadata":{"authors":["Sofía Celi","Rafael del Pino","Thomas Espitau","Guilhem Niot","Thomas Prest"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2026-CELI","keywords":["ml-dsa","fips-204","lattice","replicated-secret-sharing","dishonest-majority","interchangeable-output"],"maps_to":["TSIG-OP-001"],"primary_url":"https://www.usenix.org/system/files/usenixsecurity26-celi.pdf","review_scope":"USENIX Security 2026 final proceedings PDF read in full (pp. 6305-6324) and the Mithril preview writeup Sections 2.2-2.3; the ePrint full version with the DKG and full parameter sets was not read.","status":"published","title":"Efficient Threshold ML-DSA","venue":"USENIX Security 2026","versions":["ePrint 2026/013 (supersedes ePrint 2025/1166)","USENIX Security 2026 proceedings, pp. 6305-6324","NIST threshold call preview writeup \"Mithril\", version 1.0 (2026-01-19)"],"year":2026},"primaryUrl":"https://www.usenix.org/system/files/usenixsecurity26-celi.pdf","sections":[{"content":"Gives a T-out-of-N threshold signing protocol whose signatures are verified by the standard ML-DSA verification algorithm, with three rounds per signing attempt (the first can run offline), short replicated secret sharing, and hyperball rejection sampling. Unforgeability is proved in the ROM against a static adversary corrupting up to \\( T-1 \\) parties, from ML-DSA unforgeability and MLWE. Parameters are given for \\( N \\le 6 \\); communication grows roughly as \\( \\exp(O(T\\sqrt{\\binom{N}{T-1}})) \\).","heading":"Atomic claims"},{"content":"$16","heading":"Evidence locator"}],"slug":"cpenp26","status":"published","subtitle":"Sofía Celi, Rafael del Pino, Thomas Espitau et al. · 2026","summary":"Gives a T-out-of-N threshold signing protocol whose signatures are verified by the standard ML-DSA verification algorithm, with three rounds per signing attempt (the first can run offline), short replicated secret sharing, and hyperball rejection sampling. Unforgeability is proved in the ROM against a static adversary corrupting up to \\( T-1 \\) parties, from ML-DSA unforgeability and MLWE. Parameters are given for \\( N \\le 6…","title":"Efficient Threshold ML-DSA","type":"paper","venue":"USENIX Security 2026","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2026-CELI"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2026-GEPTW","keywords":["falcon","lattice","hash-and-sign","mpc","dishonest-majority","interchangeable-output"],"metadata":{"authors":["Radhika Garg","Daniel Escudero","Antigoni Polychroniadou","Akira Takahashi","Xiao Wang"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2026-GEPTW","keywords":["falcon","lattice","hash-and-sign","mpc","dishonest-majority","interchangeable-output"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2026/1300","review_scope":"ePrint 2026/1300 PDF supplied by the user, read 2026-10-12 for the abstract and Sections 1-2 (pp. 1-6), the security model of Section 3 (pp. 9-10), Section 6 with Theorem 2 and Remark 1 (pp. 14-18), and Section 8 with Tables 2-6 (pp. 20-24); the precision analysis of Section 5, the aVOLE protocol of Section 7 and the appendix proofs were not checked. The ePrint number comes from the file name and the coordinator, not from the PDF.","status":"preprint","title":"Thresholdizing Standardized FALCON Signatures","venue":"Cryptology ePrint Archive","versions":["ePrint 2026/1300 (43-page PDF; the PDF shows no ePrint number or revision date, PDF metadata dated 2026-07-09)"],"year":2026},"primaryUrl":"https://eprint.iacr.org/2026/1300","sections":[{"content":"Gives the first threshold signing protocol whose signatures pass the unmodified FALCON verifier. Signing replaces FALCON's fast Fourier sampler by the Klein sampler with an MPC-friendly one-dimensional Gaussian sampler on fixed-point values (73 bits of precision suffice), and is described for any MPC back end realizing an arithmetic black box; Theorem 2 shows that it UC-realizes an ideal threshold FALCON functionality, and Remark 1 reduces unforgeability to that of FALCON. The key is generated by a trusted dealer; distributed generation would need the NTRU equation solved in MPC, left open. The implementation covers N parties with up to N − 1 static malicious corruptions and semi-honest three-party signing with an honest majority. For N = 4, online Falcon-512 signing takes 7.66 s and 162.51 MB per signature amortized over 2000 signatures, about 6,189 rounds per signature, after about 310 s and 2.47 GB of estimated preprocessing per signature; time and communication grow linearly in N.","heading":"Atomic claims"},{"content":"ePrint 2026/1300 PDF: abstract (p. 1) for the unmodified FALCON verifier and the two benchmarked settings; Section 1 (pp. 1-2) for the applications named (cryptocurrency wallets, certificate authorities, credential issuance) and for FALCON's thresholdization as an open question; Section 1.1 (pp. 2-3) for the MPC-agnostic design, the AND-gate counts and the trusted key setup; Section 3, \"Security Model\" (pp. 9-10) for static active corruption of up to N − 1 parties; Section 6.1 (pp. 14-15) for key generation and the NTRU equation in MPC as an open problem; Theorem 2 (p. 17) and Remark 1 (p. 18) for UC realization and unforgeability; Section 8.1 (pp. 20-22) for the trusted dealer in the implementation and the AWS c7i.large setting with 10 Gbps and 0.1 ms latency; Section 8.2 (p. 22) and Table 3 (p. 23) for online time and communication per signature for N = 2 to 16; Table 4 (p. 23) for estimated preprocessing per signature; \"Number of Rounds\" (p. 23) for round counts.","heading":"Evidence locator"}],"slug":"geptw26","status":"preprint","subtitle":"Radhika Garg, Daniel Escudero, Antigoni Polychroniadou et al. · 2026","summary":"Gives the first threshold signing protocol whose signatures pass the unmodified FALCON verifier. Signing replaces FALCON's fast Fourier sampler by the Klein sampler with an MPC-friendly one-dimensional Gaussian sampler on fixed-point values (73 bits of precision suffice), and is described for any MPC back end realizing an arithmetic black box; Theorem 2 shows that it UC-realizes an ideal threshold FALCON functionality, and…","title":"Thresholdizing Standardized FALCON Signatures","type":"paper","venue":"Cryptology ePrint Archive","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2026-GEPTW"},{"evidence":"primary_source_checked","id":"TSIG-PAPER-2026-NIST8214C","keywords":["nist","standardization","threshold","evaluation","interoperability"],"metadata":{"authors":["National Institute of Standards and Technology"],"dossier_type":"paper","evidence":"primary_source_checked","id":"TSIG-PAPER-2026-NIST8214C","keywords":["nist","standardization","threshold","evaluation","interoperability"],"maps_to":["TSIG-OP-001"],"primary_url":"https://csrc.nist.gov/pubs/ir/8214/c/final","status":"published","title":"NIST First Call for Multi-Party Threshold Schemes","venue":"NIST Interagency/Internal Report","versions":["NIST IR 8214C final"],"year":2026},"primaryUrl":"https://csrc.nist.gov/pubs/ir/8214/c/final","sections":[{"content":"Issues NIST's first public call for multi-party threshold schemes and defines submission packages containing a technical specification, reference implementation, and experimental-evaluation report.","heading":"Atomic claims"},{"content":"NIST publication page and final report package requirements.","heading":"Evidence locator"}],"slug":"nist26","status":"published","subtitle":"National Institute of Standards and Technology · 2026","summary":"Issues NIST's first public call for multi-party threshold schemes and defines submission packages containing a technical specification, reference implementation, and experimental-evaluation report.","title":"NIST First Call for Multi-Party Threshold Schemes","type":"paper","venue":"NIST Interagency/Internal Report","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2026-NIST8214C"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2026-PASSELEGUE","keywords":["habilitation","lattice","threshold-fhe","dilithium","ml-dsa","survey"],"metadata":{"authors":["Alain Passelègue"],"citation_key":"Pas26","contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2026-PASSELEGUE","keywords":["habilitation","lattice","threshold-fhe","dilithium","ml-dsa","survey"],"maps_to":["TSIG-OP-001"],"primary_url":"https://perso.ens-lyon.fr/alain.passelegue/publications/hdr.pdf","review_scope":"Author-hosted PDF read for Chapter 4 (PDF pp. 52-61) and Chapter 5 (PDF pp. 62-63); other chapters were not reviewed.","status":"preprint","title":"Concerning Lattice-Based Cryptography, and other matters","venue":"Habilitation thesis","versions":["author-hosted manuscript (PDF metadata dated 2026-06-22)"],"year":2026},"primaryUrl":"https://perso.ens-lyon.fr/alain.passelegue/publications/hdr.pdf","sections":[{"content":"Chapter 4 surveys threshold Dilithium/ML-DSA (two-party MPC, honest-majority MPC with tens of rounds, a three-round scheme limited to t, n <= 6) and presents the THED threshold-FHE construction. Chapter 5 states that the ideal threshold protocol would combine low computational cost, few rounds, low communication, scalability to large n and t, and malicious security, and that no existing approach combines all of these properties.","heading":"Atomic claims"},{"content":"Author-hosted PDF: Section 4.1 (PDF p. 52) for the survey of verification-interchangeable threshold schemes; Section 4.2 (PDF p. 53) for \"every t and n\", two rounds and passive security; Section 4.4 (PDF pp. 58-61) for the trusted dealer, the aborted-transcript heuristic and Theorem 4.4.2; Chapter 5, \"Threshold Lattice-Based Signatures\" (PDF p. 63, printed p. 55) for the open-challenge statement. The title pages give no institution or defense date.","heading":"Evidence locator"}],"slug":"pas26","status":"preprint","subtitle":"Alain Passelègue · 2026","summary":"Chapter 4 surveys threshold Dilithium/ML-DSA (two-party MPC, honest-majority MPC with tens of rounds, a three-round scheme limited to t, n <= 6) and presents the THED threshold-FHE construction. Chapter 5 states that the ideal threshold protocol would combine low computational cost, few rounds, low communication, scalability to large n and t, and malicious security, and that no existing approach combines all of these…","title":"Concerning Lattice-Based Cryptography, and other matters","type":"paper","venue":"Habilitation thesis","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2026-PASSELEGUE"},{"evidence":"fulltext_checked","id":"TSIG-PAPER-2026-QUORUS","keywords":["ml-dsa","fips-204","mpc","honest-majority","uc-security","interchangeable-output"],"metadata":{"authors":["Alexander Bienstock","Leo de Castro","Daniel Escudero","Antigoni Polychroniadou","Akira Takahashi"],"contribution_ids":[],"dossier_type":"paper","evidence":"fulltext_checked","id":"TSIG-PAPER-2026-QUORUS","keywords":["ml-dsa","fips-204","mpc","honest-majority","uc-security","interchangeable-output"],"maps_to":["TSIG-OP-001"],"primary_url":"https://www.usenix.org/system/files/conference/usenixsecurity26/sec26_prepub_bienstock.pdf","review_scope":"USENIX Security 2026 prepublication PDF read for the abstract, Sections 1-2, Theorems 1 and 3, and Section 5 with Tables 3-7; the ePrint full version and the proofs were not read.","status":"published","title":"Quorus: Efficient, Scalable Threshold ML-DSA Signatures from MPC","venue":"USENIX Security 2026","versions":["ePrint 2025/1163 (full version, revised 2026-01-28)","USENIX Security 2026 prepublication PDF","NIST threshold call preview writeup \"Quorus\""],"year":2026},"primaryUrl":"https://www.usenix.org/system/files/conference/usenixsecurity26/sec26_prepub_bienstock.pdf","sections":[{"content":"Gives an MPC-friendly variant of ML-DSA signing whose outputs pass the same ML-DSA verification implementation, and honest-majority MPC protocols that UC-realize a functionality computing ML-DSA signatures, with security with abort against an active adversary controlling t of n = 2t + 1 parties, for any number of parties. A signing attempt takes 29 (communication-optimized) or 16 (round-optimized) online rounds, after an offline phase of 81 to 108 rounds.","heading":"Atomic claims"},{"content":"USENIX prepublication PDF: abstract (p. 1); Section 1 (p. 2), which calls a threshold version of standardized ML-DSA \"an elusive open problem\" before the paper's contribution; Section 1.1 (p. 2) for an arbitrary number of parties and exact ML-DSA verification; Section 2.2 (p. 5) for n = 2t + 1 and security with abort; Theorem 1 (p. 8) for the variant's unforgeability and Theorem 3 (p. 11) for the UC realization; Section 5.1, Tables 3-5 (p. 13) for online, offline and expected total rounds; Table 7 (p. 15) for the comparison with lattice threshold signatures by ML-DSA compatibility.","heading":"Evidence locator"}],"slug":"bcept26","status":"published","subtitle":"Alexander Bienstock, Leo de Castro, Daniel Escudero et al. · 2026","summary":"Gives an MPC-friendly variant of ML-DSA signing whose outputs pass the same ML-DSA verification implementation, and honest-majority MPC protocols that UC-realize a functionality computing ML-DSA signatures, with security with abort against an active adversary controlling t of n = 2t + 1 parties, for any number of parties. A signing attempt takes 29 (communication-optimized) or 16 (round-optimized) online rounds, after an…","title":"Quorus: Efficient, Scalable Threshold ML-DSA Signatures from MPC","type":"paper","venue":"USENIX Security 2026","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2026-QUORUS"},{"evidence":"bibliographic_checked","id":"TSIG-PAPER-2026-THED","keywords":["dilithium","ml-dsa","threshold-fhe","two-round","interchangeable-output"],"metadata":{"authors":["Jai Hyun Park","Alain Passelègue","Damien Stehlé"],"contribution_ids":[],"dossier_type":"paper","evidence":"bibliographic_checked","id":"TSIG-PAPER-2026-THED","keywords":["dilithium","ml-dsa","threshold-fhe","two-round","interchangeable-output"],"maps_to":["TSIG-OP-001"],"primary_url":"https://eprint.iacr.org/2026/638","review_scope":"ePrint 2026/638 abstract page and the description in TSIG-PAPER-2026-PASSELEGUE, Chapter 4; the full paper was not retrieved.","status":"published","title":"THED: Threshold Dilithium from FHE","venue":"ACM CCS 2026","versions":["ePrint 2026/638 (received 2026-04-01, revised 2026-09-13)","conference paper, DOI 10.1145/3830454.3846802"],"year":2026},"primaryUrl":"https://eprint.iacr.org/2026/638","sections":[{"content":"Evaluates Dilithium signing under threshold fully homomorphic encryption (CKKS) with the challenge computed in the clear, giving signatures valid for the genuine Dilithium verification algorithm, for any number of users and any threshold, in two rounds of which one can be preprocessed. Signing masks use a ring variant of the Darkmatter PRF in place of SHAKE, under an additional pseudorandomness assumption.","heading":"Atomic claims"},{"content":"ePrint 2026/638 abstract page (checked 2026-10-10). The full paper was not read. Its construction is described by one of the authors in TSIG-PAPER-2026-PASSELEGUE, Chapter 4 (PDF pp. 52-61): passive security model, trusted dealer in the presented protocol, a heuristic that Dilithium stays secure given aborted transcripts, and Theorem 4.4.2 (PDF p. 61); that chapter describes Dilithium as in the round-3 specification, so exact FIPS 204 conformance was not checked.","heading":"Evidence locator"}],"slug":"pps26","status":"published","subtitle":"Jai Hyun Park, Alain Passelègue, Damien Stehlé · 2026","summary":"Evaluates Dilithium signing under threshold fully homomorphic encryption (CKKS) with the challenge computed in the clear, giving signatures valid for the genuine Dilithium verification algorithm, for any number of users and any threshold, in two rounds of which one can be preprocessed. Signing masks use a ring variant of the Darkmatter PRF in place of SHAKE, under an additional pseudorandomness assumption.","title":"THED: Threshold Dilithium from FHE","type":"paper","venue":"ACM CCS 2026","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-PAPER-2026-THED"},{"evidence":"bibliographic_checked","id":"TSIG-RESULT-1989-DF-DISTRIBUTED-RSA-SIGNING-ROOT","keywords":["atomic-result","foundations","threshold","rsa","secret-sharing","rsa_function_sharing","round_efficient_robust_signing","capability_result"],"metadata":{"claim_slug":"distributed-rsa-signing-root","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["rsa_function_sharing"]},"historical_context":{"narrative":"Centralized signing made one private key holder a single compromise and availability point. Desmedt and Frankel recast the private operation as a quorum service: parties hold shares, and only an authorized subset can jointly produce the result. Their work established the threshold-cryptosystem interface and an early distributed RSA line, but it preceded the richer robustness and composability contracts developed by later protocols. A second node isolates the RSA instantiation, in which exponent shares support a distributed signing operation. Later GJKR and Shoup work strengthens robustness and online usability rather than being collapsed into this origin claim.","prior_boundary":"Public-key signatures assumed one signing key holder, so compromise or unavailability of that holder was a single point of failure.","significance_at_publication":"The threshold-cryptosystem abstraction made distributed private-key operations a cryptographic interface and established the RSA-signing root later robustness work refined.","technical_delta":"Secret exponent shares allowed a qualified set to produce the RSA private transformation without centralizing the exponent."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1989-DF-DISTRIBUTED-RSA-SIGNING-ROOT","keywords":["foundations","threshold","rsa","secret-sharing","rsa_function_sharing","round_efficient_robust_signing","capability_result"],"limitations":["Later work strengthens robustness and share verification."],"paper_id":"TSIG-PAPER-1989-DF","qualifiers":["RSA-style threshold operation in the paper's model."],"source_locator":{"dossier_section":"TSIG-PAPER-1989-DF § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/0-387-34805-0_28","status":"not_normalized"},"statement":"The threshold-cryptosystem framework distributes RSA-style private exponentiation across multiple servers.","statement_status":"source_normalized_statement","status":"published","title":"Distributed RSA signing from exponent shares","work_id":"TSIG-PAPER-1989-DF"},"primaryUrl":"https://doi.org/10.1007/0-387-34805-0_28","sections":[],"slug":"df89-distributed-rsa-signing","status":"published","subtitle":"Threshold Cryptosystems","summary":"The threshold-cryptosystem framework distributes RSA-style private exponentiation across multiple servers.","title":"Distributed RSA signing from exponent shares","type":"result","venue":"CRYPTO 1989","year":1989,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1989-DF-DISTRIBUTED-RSA-SIGNING-ROOT"},{"evidence":"bibliographic_checked","id":"TSIG-RESULT-1989-DF-THRESHOLD-CRYPTOSYSTEM-PARADIGM","keywords":["atomic-result","foundations","threshold","rsa","secret-sharing","threshold_foundations","definition"],"metadata":{"claim_slug":"threshold-cryptosystem-paradigm","contribution_kind":"definition","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":[],"technical_thread":["threshold_foundations"]},"historical_context":{"narrative":"Centralized signing made one private key holder a single compromise and availability point. Desmedt and Frankel recast the private operation as a quorum service: parties hold shares, and only an authorized subset can jointly produce the result. Their work established the threshold-cryptosystem interface and an early distributed RSA line, but it preceded the richer robustness and composability contracts developed by later protocols. The foundational node captures the new service boundary: a quorum performs one private-key function without reconstructing the secret at a single participant. Exact resilience and active-security guarantees remain construction-specific.","prior_boundary":"Public-key signatures assumed one signing key holder, so compromise or unavailability of that holder was a single point of failure.","significance_at_publication":"The threshold-cryptosystem abstraction made distributed private-key operations a cryptographic interface and established the RSA-signing root later robustness work refined.","technical_delta":"The paper separated a cryptographic service from any single secret-key holder and made the quorum threshold part of the primitive's interface."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1989-DF-THRESHOLD-CRYPTOSYSTEM-PARADIGM","keywords":["foundations","threshold","rsa","secret-sharing","threshold_foundations","definition"],"limitations":["Does not supply the later modern robustness contract for all threshold signatures."],"paper_id":"TSIG-PAPER-1989-DF","qualifiers":["Foundational paradigm; exact corruption and robustness guarantees are construction-specific."],"source_locator":{"dossier_section":"TSIG-PAPER-1989-DF § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/0-387-34805-0_28","status":"not_normalized"},"statement":"Desmedt and Frankel formulate threshold cryptosystems in which a quorum jointly performs a private-key operation without reconstructing the full secret at one party.","statement_status":"source_normalized_statement","status":"published","title":"Threshold cryptosystems distribute one private-key operation","work_id":"TSIG-PAPER-1989-DF"},"primaryUrl":"https://doi.org/10.1007/0-387-34805-0_28","sections":[],"slug":"df89-distributed-private-key-oper","status":"published","subtitle":"Threshold Cryptosystems","summary":"Desmedt and Frankel formulate threshold cryptosystems in which a quorum jointly performs a private-key operation without reconstructing the full secret at one party.","title":"Threshold cryptosystems distribute one private-key operation","type":"result","venue":"CRYPTO 1989","year":1989,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1989-DF-THRESHOLD-CRYPTOSYSTEM-PARADIGM"},{"evidence":"bibliographic_checked","id":"TSIG-RESULT-1991-PEDERSEN-DISTRIBUTED-KEY-GENERATION-WITHOUT-DEALER","keywords":["atomic-result","dkg","discrete-log","verifiable-secret-sharing","foundations","threshold_foundations","dealerless_setup","mechanism"],"metadata":{"claim_slug":"distributed-key-generation-without-dealer","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["dealerless_setup"],"technical_thread":["threshold_foundations"]},"historical_context":{"narrative":"Threshold signing could distribute an existing secret while still trusting one dealer to create and share it. Pedersen moved that trust boundary into a protocol among the participants themselves. By combining verifiable polynomial contributions, the parties obtained shares of a discrete-log secret and a common public key without any one party learning the full exponent. This became a reusable setup layer for many later threshold systems. The mapped contribution is dealerless generation of a shared discrete-log key, not a complete signing protocol. The present evidence remains bibliographic-level, so later attack refinements and exact robustness bounds are not inferred here.","prior_boundary":"Early threshold systems could distribute signing after a dealer generated and shared the secret, leaving setup itself as a trusted single point.","significance_at_publication":"Dealerless distributed key generation made the shared public key emerge from participant contributions and became a reusable setup layer for discrete-log threshold signatures.","technical_delta":"Participant-generated polynomial shares removed the dealer from the key-generation trust boundary."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1991-PEDERSEN-DISTRIBUTED-KEY-GENERATION-WITHOUT-DEALER","keywords":["dkg","discrete-log","verifiable-secret-sharing","foundations","threshold_foundations","dealerless_setup","mechanism"],"limitations":["This bibliographically reviewed card does not normalize all later DKG attack and repair details."],"paper_id":"TSIG-PAPER-1991-PEDERSEN","qualifiers":["Discrete-log key generation; robustness depends on the exact protocol model."],"source_locator":{"dossier_section":"TSIG-PAPER-1991-PEDERSEN § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/3-540-46416-6_47","status":"not_normalized"},"statement":"Pedersen gives a protocol in which participants jointly generate a discrete-log public key and shares of its secret without a trusted dealer.","statement_status":"source_normalized_statement","status":"published","title":"Dealerless distributed generation of discrete-log keys","work_id":"TSIG-PAPER-1991-PEDERSEN"},"primaryUrl":"https://doi.org/10.1007/3-540-46416-6_47","sections":[],"slug":"pedersen91-dealerless-discrete-log-dkg","status":"published","subtitle":"A Threshold Cryptosystem without a Trusted Party","summary":"Pedersen gives a protocol in which participants jointly generate a discrete-log public key and shares of its secret without a trusted dealer.","title":"Dealerless distributed generation of discrete-log keys","type":"result","venue":"EUROCRYPT 1991","year":1991,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1991-PEDERSEN-DISTRIBUTED-KEY-GENERATION-WITHOUT-DEALER"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-1996-GJKR-DSS-ROBUST-THRESHOLD-DSS","keywords":["atomic-result","dss","discrete-log","robustness","malicious-security","threshold_foundations","round_efficient_robust_signing","construction"],"metadata":{"claim_slug":"robust-threshold-dss","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["threshold_foundations"]},"historical_context":{"narrative":"The algebra of DSS made threshold signing more involved than merely sharing an RSA exponent: nonce inversion and multiplication had to be coordinated without exposing either nonce or key. Gennaro, Jarecki, Krawczyk, and Rabin constructed a robust protocol under an honest-majority-style bound whose output remained an ordinary DSS signature. The result opened a separate threshold line for nonlinear signing equations. The atomic construction distributes DSS's nonlinear signing equation and handles malformed behavior under the paper's precise party threshold. It does not provide a generic threshold compiler for unrelated signatures.","prior_boundary":"Thresholding RSA did not directly solve DSS signing, whose inverse and multiplicative nonce terms require coordinated computation under malicious faults.","significance_at_publication":"The work established a robust threshold DSS construction with ordinary DSS output, opening a distinct algebraic protocol line.","technical_delta":"The protocol distributed the nonlinear DSS signing equation and incorporated checks against malformed participant behavior."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1996-GJKR-DSS-ROBUST-THRESHOLD-DSS","keywords":["dss","discrete-log","robustness","malicious-security","threshold_foundations","round_efficient_robust_signing","construction"],"limitations":["The result is not a general compiler for arbitrary base signatures."],"paper_id":"TSIG-PAPER-1996-GJKR-DSS","qualifiers":["Exact party and fault thresholds follow the cited construction."],"source_locator":{"dossier_section":"TSIG-PAPER-1996-GJKR-DSS § Atomic claims and Evidence locator","primary_source":"Proceedings paper and journal abstract; exact fault bounds are kept distinct in the construction card.","primary_source_url":"https://doi.org/10.1007/3-540-68339-9_31","status":"section_checked"},"statement":"GJKR constructs threshold DSS signing for an honest-majority-style resilience bound while producing signatures accepted by ordinary DSS verification.","statement_status":"source_normalized_statement","status":"published","title":"Robust threshold DSS with ordinary DSS output","work_id":"TSIG-PAPER-1996-GJKR-DSS"},"primaryUrl":"https://doi.org/10.1007/3-540-68339-9_31","sections":[],"slug":"gjkr96b-robust-threshold-dss","status":"published","subtitle":"Robust Threshold DSS Signatures","summary":"GJKR constructs threshold DSS signing for an honest-majority-style resilience bound while producing signatures accepted by ordinary DSS verification.","title":"Robust threshold DSS with ordinary DSS output","type":"result","venue":"EUROCRYPT 1996","year":1996,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1996-GJKR-DSS-ROBUST-THRESHOLD-DSS"},{"evidence":"bibliographic_checked","id":"TSIG-RESULT-1996-GJKR-RSA-ROBUST-THRESHOLD-RSA-FUNCTION-SHARING","keywords":["atomic-result","rsa","threshold","robustness","function-sharing","rsa_function_sharing","round_efficient_robust_signing","construction"],"metadata":{"claim_slug":"robust-threshold-rsa-function-sharing","contribution_kind":"construction","dossier_type":"contribution","evidence":"bibliographic_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["rsa_function_sharing"]},"historical_context":{"narrative":"Early distributed RSA demonstrated the threshold idea but left malicious shares and disrupted executions as major operational concerns. Gennaro, Jarecki, Krawczyk, and Rabin strengthened the RSA branch with verifiable function sharing and robustness machinery. Their construction became the relevant active-adversary baseline for Shoup's later simplification, while retaining setup and protocol costs that kept practical threshold RSA an open engineering target. This node records robust, verifiable sharing of the RSA function. Its source is still bibliographic-level in the dossier, so it remains reviewed-related until theorem and page locators are normalized.","prior_boundary":"The original threshold-RSA paradigm distributed exponentiation but left stronger robustness and verifiable-share handling as protocol concerns.","significance_at_publication":"GJKR supplied robust RSA function sharing, giving later threshold-RSA work a concrete malicious-behavior baseline to simplify.","technical_delta":"The construction added malicious-share handling to the distributed RSA line."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1996-GJKR-RSA-ROBUST-THRESHOLD-RSA-FUNCTION-SHARING","keywords":["rsa","threshold","robustness","function-sharing","rsa_function_sharing","round_efficient_robust_signing","construction"],"limitations":["Later Shoup protocols target a simpler practical signing path."],"paper_id":"TSIG-PAPER-1996-GJKR-RSA","qualifiers":["RSA function sharing under the paper's setup and resilience conditions."],"source_locator":{"dossier_section":"TSIG-PAPER-1996-GJKR-RSA § Atomic claims and Evidence locator","primary_source":"Abstract and main construction or theorem discussion in the linked primary paper.","primary_source_url":"https://doi.org/10.1007/3-540-68697-5","status":"not_normalized"},"statement":"GJKR develops verifiable, robust sharing of RSA private operations for threshold signing and decryption.","statement_status":"source_normalized_statement","status":"published","title":"Robust sharing of RSA signing functions","work_id":"TSIG-PAPER-1996-GJKR-RSA"},"primaryUrl":"https://doi.org/10.1007/3-540-68697-5","sections":[],"slug":"gjkr96a-robust-rsa-function-sharing","status":"published","subtitle":"Robust and Efficient Sharing of RSA Functions","summary":"GJKR develops verifiable, robust sharing of RSA private operations for threshold signing and decryption.","title":"Robust sharing of RSA signing functions","type":"result","venue":"CRYPTO 1996","year":1996,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1996-GJKR-RSA-ROBUST-THRESHOLD-RSA-FUNCTION-SHARING"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-1999-GJKR-DKG-MALICIOUS-MINORITY-SECURITY","keywords":["atomic-result","dkg","discrete-log","malicious-security","robustness","threshold_foundations","malicious_robustness_and_blame","security_result"],"metadata":{"claim_slug":"malicious-minority-security","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["malicious_robustness_and_blame"],"technical_thread":["threshold_foundations"]},"historical_context":{"narrative":"Dealerless discrete-log key generation removed a trusted setup party, but a malicious minority could still try to bias the key, distribute inconsistent shares, or prevent honest users from agreeing. The GJKR treatment made those threats explicit and provided a robust protocol under a stated corruption threshold. It separated secure key creation from the signing algorithm and turned DKG into an independently auditable cryptographic component. The companion security node isolates the malicious-minority guarantee and its model. Separating it from the protocol prevents “robust DKG” from hiding the exact corruption threshold and assumptions.","prior_boundary":"Dealerless discrete-log key generation existed, but malicious participants could disrupt consistency or bias the resulting distributed key without a robust treatment.","significance_at_publication":"The protocol strengthened DKG against a malicious minority and clarified the adversarial conditions under which a usable shared key is produced.","technical_delta":"The proof turned dealerless setup into an adversarially analyzed component rather than an honest-execution procedure."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1999-GJKR-DKG-MALICIOUS-MINORITY-SECURITY","keywords":["dkg","discrete-log","malicious-security","robustness","threshold_foundations","malicious_robustness_and_blame","security_result"],"limitations":["Does not establish adaptive security for every protocol composed with the DKG."],"paper_id":"TSIG-PAPER-1999-GJKR-DKG","qualifiers":["Security holds under the paper's exact corruption threshold and model."],"source_locator":{"dossier_section":"TSIG-PAPER-1999-GJKR-DKG § Atomic claims and Evidence locator","primary_source":"Proceedings paper, abstract, model, and protocol sections.","primary_source_url":"https://doi.org/10.1007/3-540-48910-X_21","status":"section_checked"},"statement":"The GJKR analysis specifies when malicious participants cannot bias or make inconsistent the jointly generated discrete-log key.","statement_status":"source_normalized_statement","status":"published","title":"Malicious-minority security for discrete-log DKG","work_id":"TSIG-PAPER-1999-GJKR-DKG"},"primaryUrl":"https://doi.org/10.1007/3-540-48910-X_21","sections":[],"slug":"gjkr99-malicious-minority-security","status":"published","subtitle":"Secure Distributed Key Generation for Discrete-Log Based Cryptosystems","summary":"The GJKR analysis specifies when malicious participants cannot bias or make inconsistent the jointly generated discrete-log key.","title":"Malicious-minority security for discrete-log DKG","type":"result","venue":"EUROCRYPT 1999","year":1999,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1999-GJKR-DKG-MALICIOUS-MINORITY-SECURITY"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-1999-GJKR-DKG-ROBUST-DISCRETE-LOG-DKG","keywords":["atomic-result","dkg","discrete-log","malicious-security","robustness","threshold_foundations","dealerless_setup","malicious_robustness_and_blame","mechanism"],"metadata":{"claim_slug":"robust-discrete-log-dkg","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["dealerless_setup","malicious_robustness_and_blame"],"technical_thread":["threshold_foundations"]},"historical_context":{"narrative":"Dealerless discrete-log key generation removed a trusted setup party, but a malicious minority could still try to bias the key, distribute inconsistent shares, or prevent honest users from agreeing. The GJKR treatment made those threats explicit and provided a robust protocol under a stated corruption threshold. It separated secure key creation from the signing algorithm and turned DKG into an independently auditable cryptographic component. One contribution is the robust DKG protocol that produces a consistent public key and compatible shares despite bounded faults. It is setup infrastructure and does not independently prove a composed signature secure.","prior_boundary":"Dealerless discrete-log key generation existed, but malicious participants could disrupt consistency or bias the resulting distributed key without a robust treatment.","significance_at_publication":"The protocol strengthened DKG against a malicious minority and clarified the adversarial conditions under which a usable shared key is produced.","technical_delta":"The protocol repaired the operational robustness boundary of dealerless key generation."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-1999-GJKR-DKG-ROBUST-DISCRETE-LOG-DKG","keywords":["dkg","discrete-log","malicious-security","robustness","threshold_foundations","dealerless_setup","malicious_robustness_and_blame","mechanism"],"limitations":["It is a setup component, not a complete threshold-signature protocol."],"paper_id":"TSIG-PAPER-1999-GJKR-DKG","qualifiers":["Adversarial threshold and synchrony conditions are part of the result."],"source_locator":{"dossier_section":"TSIG-PAPER-1999-GJKR-DKG § Atomic claims and Evidence locator","primary_source":"Proceedings paper, abstract, model, and protocol sections.","primary_source_url":"https://doi.org/10.1007/3-540-48910-X_21","status":"section_checked"},"statement":"GJKR gives a distributed key-generation protocol that produces a consistent discrete-log public key despite a bounded malicious minority.","statement_status":"source_normalized_statement","status":"published","title":"Robust distributed key generation for discrete-log systems","work_id":"TSIG-PAPER-1999-GJKR-DKG"},"primaryUrl":"https://doi.org/10.1007/3-540-48910-X_21","sections":[],"slug":"gjkr99-robust-discrete-log-dkg","status":"published","subtitle":"Secure Distributed Key Generation for Discrete-Log Based Cryptosystems","summary":"GJKR gives a distributed key-generation protocol that produces a consistent discrete-log public key despite a bounded malicious minority.","title":"Robust distributed key generation for discrete-log systems","type":"result","venue":"EUROCRYPT 1999","year":1999,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-1999-GJKR-DKG-ROBUST-DISCRETE-LOG-DKG"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2000-SHOUP-NONINTERACTIVE-SHARE-GENERATION","keywords":["atomic-result","rsa","threshold","robustness","practical","rsa_function_sharing","round_efficient_robust_signing","optimization"],"metadata":{"claim_slug":"noninteractive-share-generation","contribution_kind":"optimization","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["rsa_function_sharing"]},"historical_context":{"narrative":"Robust RSA function sharing existed before Shoup, yet its interaction and machinery limited the appeal of replacing a centralized signer. Shoup reorganized the online path so each server could generate a publicly checkable share without talking to the other servers, leaving a combiner to verify and assemble the ordinary RSA result. This supplied a concrete threshold-RSA design with a much cleaner signing interface. The optimization record concerns only the post-setup signing phase: servers emit shares independently for public checking and combination. Key generation and initial distribution remain separate interactive obligations.","prior_boundary":"Robust threshold RSA constructions carried significant interaction and machinery, limiting their appeal as a practical replacement for centralized RSA signing.","significance_at_publication":"Shoup made signature-share production noninteractive and publicly checkable, giving robust threshold RSA a concrete, operationally sharper design point.","technical_delta":"The online protocol removed inter-server interaction from share generation and exposed invalid shares to the combiner."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2000-SHOUP-NONINTERACTIVE-SHARE-GENERATION","keywords":["rsa","threshold","robustness","practical","rsa_function_sharing","round_efficient_robust_signing","optimization"],"limitations":["Setup and key generation remain separate protocol obligations."],"paper_id":"TSIG-PAPER-2000-SHOUP","qualifiers":["Noninteraction is for the signing-share phase after setup."],"source_locator":{"dossier_section":"TSIG-PAPER-2000-SHOUP § Atomic claims and Evidence locator","primary_source":"Abstract and Sections 1-4 of the proceedings paper.","primary_source_url":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","status":"section_checked"},"statement":"After setup, each Shoup signing server independently produces a signature share that a combiner can verify and combine without an interactive signing round among servers.","statement_status":"source_normalized_statement","status":"published","title":"Noninteractive generation and verification of RSA signature shares","work_id":"TSIG-PAPER-2000-SHOUP"},"primaryUrl":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","sections":[],"slug":"shoup00-noninteractive-generation-an","status":"published","subtitle":"Practical Threshold Signatures","summary":"After setup, each Shoup signing server independently produces a signature share that a combiner can verify and combine without an interactive signing round among servers.","title":"Noninteractive generation and verification of RSA signature shares","type":"result","venue":"EUROCRYPT 2000","year":2000,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2000-SHOUP-NONINTERACTIVE-SHARE-GENERATION"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2000-SHOUP-PRACTICAL-ROBUST-THRESHOLD-RSA","keywords":["atomic-result","rsa","threshold","robustness","practical","rsa_function_sharing","round_efficient_robust_signing","malicious_robustness_and_blame","construction"],"metadata":{"claim_slug":"practical-robust-threshold-rsa","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing","malicious_robustness_and_blame"],"technical_thread":["rsa_function_sharing"]},"historical_context":{"narrative":"Robust RSA function sharing existed before Shoup, yet its interaction and machinery limited the appeal of replacing a centralized signer. Shoup reorganized the online path so each server could generate a publicly checkable share without talking to the other servers, leaving a combiner to verify and assemble the ordinary RSA result. This supplied a concrete threshold-RSA design with a much cleaner signing interface. The construction record captures the complete robust threshold-RSA signature and its standard output. Compatibility remains tied to the exact RSA signature relation and setup assumed by the paper.","prior_boundary":"Robust threshold RSA constructions carried significant interaction and machinery, limiting their appeal as a practical replacement for centralized RSA signing.","significance_at_publication":"Shoup made signature-share production noninteractive and publicly checkable, giving robust threshold RSA a concrete, operationally sharper design point.","technical_delta":"The design simplified earlier robust RSA sharing into a practical signing protocol with a direct combiner path."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2000-SHOUP-PRACTICAL-ROBUST-THRESHOLD-RSA","keywords":["rsa","threshold","robustness","practical","rsa_function_sharing","round_efficient_robust_signing","malicious_robustness_and_blame","construction"],"limitations":["Ordinary RSA output does not imply compatibility with every RSA encoding profile."],"paper_id":"TSIG-PAPER-2000-SHOUP","qualifiers":["RSA-based threshold signing and the paper's setup model."],"source_locator":{"dossier_section":"TSIG-PAPER-2000-SHOUP § Atomic claims and Evidence locator","primary_source":"Abstract and Sections 1-4 of the proceedings paper.","primary_source_url":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","status":"section_checked"},"statement":"Shoup constructs robust threshold RSA signing with publicly verifiable shares and ordinary RSA signature output.","statement_status":"source_normalized_statement","status":"published","title":"Robust threshold RSA with publicly verifiable shares","work_id":"TSIG-PAPER-2000-SHOUP"},"primaryUrl":"https://www.iacr.org/archive/eurocrypt2000/1807/18070209-new.pdf","sections":[],"slug":"shoup00-verifiable-share-threshold-r","status":"published","subtitle":"Practical Threshold Signatures","summary":"Shoup constructs robust threshold RSA signing with publicly verifiable shares and ordinary RSA signature output.","title":"Robust threshold RSA with publicly verifiable shares","type":"result","venue":"EUROCRYPT 2000","year":2000,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2000-SHOUP-PRACTICAL-ROBUST-THRESHOLD-RSA"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2003-BOLDYREVA-THRESHOLD-BLS-SIGNATURE","keywords":["atomic-result","pairing","gap-diffie-hellman","bls","threshold","compact-output","pairing_threshold_signatures","round_efficient_robust_signing","interoperable_output_and_evaluation","construction"],"metadata":{"claim_slug":"threshold-bls-signature","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing","interoperable_output_and_evaluation"],"technical_thread":["pairing_threshold_signatures"]},"historical_context":{"narrative":"Threshold RSA had shown that a quorum could preserve an ordinary signature interface, but BLS offered a different algebraic opportunity through its linear signing exponent. Boldyreva shared that exponent and let participants produce partial signatures that a combiner assembles without reconstructing the secret. This record captures the distributed signing mechanism itself. A companion contribution records the unique one-group-element output and ordinary BLS verification interface, keeping construction and output capability distinct. The scheme inherits the base pairing and security setting and does not address independent-key rogue-key attacks, which belong to multisignatures rather than this shared-key threshold model.","prior_boundary":"Threshold RSA produced ordinary signatures but not the one-group-element uniqueness and compactness offered by the emerging BLS signature.","significance_at_publication":"The work showed that BLS's linear exponent structure admits a direct threshold construction without reconstructing the secret key.","technical_delta":"The construction turned the BLS signing exponent into verifiable partial exponentiations that a quorum could combine."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2003-BOLDYREVA-THRESHOLD-BLS-SIGNATURE","keywords":["pairing","gap-diffie-hellman","bls","threshold","compact-output","pairing_threshold_signatures","round_efficient_robust_signing","interoperable_output_and_evaluation","construction"],"limitations":["The construction does not cover rogue-key multisignatures without their separate defenses."],"paper_id":"TSIG-PAPER-2003-BOLDYREVA","qualifiers":["Pairing-group and base BLS security setting."],"source_locator":{"dossier_section":"TSIG-PAPER-2003-BOLDYREVA § Atomic claims and Evidence locator","primary_source":"ePrint 2002/118, abstract and threshold-signature section.","primary_source_url":"https://eprint.iacr.org/2002/118","status":"section_checked"},"statement":"Boldyreva distributes the BLS secret exponent so a quorum can produce and combine partial signatures without reconstructing the signing key.","statement_status":"source_normalized_statement","status":"published","title":"Exponent-share threshold BLS signing","work_id":"TSIG-PAPER-2003-BOLDYREVA"},"primaryUrl":"https://eprint.iacr.org/2002/118","sections":[],"slug":"boldyreva03-exponent-share-threshold-bls","status":"published","subtitle":"Threshold Signatures, Multisignatures and Blind Signatures Based on the Gap-Diffie-Hellman-Group Signature Scheme","summary":"Boldyreva distributes the BLS secret exponent so a quorum can produce and combine partial signatures without reconstructing the signing key.","title":"Exponent-share threshold BLS signing","type":"result","venue":"PKC 2003","year":2003,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2003-BOLDYREVA-THRESHOLD-BLS-SIGNATURE"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2003-BOLDYREVA-UNIQUE-COMPACT-OUTPUT","keywords":["atomic-result","pairing","gap-diffie-hellman","bls","threshold","compact-output","pairing_threshold_signatures","interoperable_output_and_evaluation","capability_result"],"metadata":{"claim_slug":"unique-compact-output","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["interoperable_output_and_evaluation"],"technical_thread":["pairing_threshold_signatures"]},"historical_context":{"narrative":"Threshold RSA preserved an ordinary-verifier interface, but the emerging BLS signature offered a uniquely compact one-group-element result with especially simple exponent linearity. Boldyreva distributed that signing exponent across a quorum and retained the base verifier after combination. The construction showed directly that thresholdization need not enlarge or specialize the final signature. This capability record isolates preservation of a unique one-element result accepted by ordinary BLS verification, while its companion card carries the distributed signing mechanism. The output property is specific to the base scheme and cannot be generalized to all threshold signatures.","prior_boundary":"Threshold RSA produced ordinary signatures but not the one-group-element uniqueness and compactness offered by the emerging BLS signature.","significance_at_publication":"Threshold BLS preserved the base signature's unique compact output after share combination, showing how a concise ordinary-verifier interface could survive thresholdization.","technical_delta":"Thresholdization preserved both uniqueness and compact output instead of introducing a threshold-specific proof object."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2003-BOLDYREVA-UNIQUE-COMPACT-OUTPUT","keywords":["pairing","gap-diffie-hellman","bls","threshold","compact-output","pairing_threshold_signatures","interoperable_output_and_evaluation","capability_result"],"limitations":["Uniqueness is not a generic property of all threshold signatures."],"paper_id":"TSIG-PAPER-2003-BOLDYREVA","qualifiers":["Output compatibility is with the exact BLS/GDH scheme."],"source_locator":{"dossier_section":"TSIG-PAPER-2003-BOLDYREVA § Atomic claims and Evidence locator","primary_source":"ePrint 2002/118, abstract and threshold-signature section.","primary_source_url":"https://eprint.iacr.org/2002/118","status":"section_checked"},"statement":"Combining valid threshold BLS shares yields a unique one-group-element signature with the ordinary BLS verification interface.","statement_status":"source_normalized_statement","status":"published","title":"Unique compact threshold output compatible with BLS verification","work_id":"TSIG-PAPER-2003-BOLDYREVA"},"primaryUrl":"https://eprint.iacr.org/2002/118","sections":[],"slug":"boldyreva03-unique-compact-threshold-out","status":"published","subtitle":"Threshold Signatures, Multisignatures and Blind Signatures Based on the Gap-Diffie-Hellman-Group Signature Scheme","summary":"Combining valid threshold BLS shares yields a unique one-group-element signature with the ordinary BLS verification interface.","title":"Unique compact threshold output compatible with BLS verification","type":"result","venue":"PKC 2003","year":2003,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2003-BOLDYREVA-UNIQUE-COMPACT-OUTPUT"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2017-LINDELL-EFFICIENT-TWO-PARTY-ECDSA","keywords":["atomic-result","ecdsa","two-party","paillier","malicious-security","ecdsa_paillier","round_efficient_robust_signing","construction"],"metadata":{"claim_slug":"efficient-two-party-ecdsa","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Distributing ECDSA is hard because each signature uses the inverse of a secret nonce, so two-party protocols shared the key and nonce multiplicatively and combined them under Paillier encryption, proving each step in zero knowledge. Lindell moved the expensive proof into key generation, where the second party receives an encrypted copy of the first party's share once. During signing the parties only agree on the nonce point and exchange a single ciphertext; the first party decrypts and accepts the result only if it verifies as an ordinary signature, so no further proofs are needed. The paper proves game-based security from Paillier and ECDSA assumptions and simulation security under a new Paillier assumption. Its caveat is explicit; the protocol covers two parties only.","prior_boundary":"ECDSA's nonce inverse made two-party signing depend on Paillier-based protocols whose signers proved heavy zero-knowledge statements and ran many large-modulus exponentiations per signature.","significance_at_publication":"Lindell reported signing roughly two orders of magnitude faster than the previous best protocol while producing ordinary ECDSA signatures, fixing the Paillier-based two-party baseline later threshold work compares against.","technical_delta":"Giving the second party a Paillier encryption of the first party's key share at key generation let signing use one homomorphic ciphertext and a check that the output signature verifies."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2017-LINDELL-EFFICIENT-TWO-PARTY-ECDSA","keywords":["ecdsa","two-party","paillier","malicious-security","ecdsa_paillier","round_efficient_robust_signing","construction"],"limitations":["The protocol is not a general t-out-of-n construction; the paper leaves the general case to future work (Section 1.2, Caveat)."],"paper_id":"TSIG-PAPER-2017-LINDELL","qualifiers":["2-of-2 setting; Theorem 4.5 gives game-based security under Paillier IND-CPA and ECDSA unforgeability for concurrent executions with instantaneous global abort.","Simulation security (Theorem 5.3) additionally relies on the paper's non-standard Paillier-EC assumption."],"source_locator":{"dossier_section":"TSIG-PAPER-2017-LINDELL § Atomic claims and Evidence locator","primary_source":"ePrint 2017/552, Section 1.2 (PDF pp. 3–4), Protocols 3.1–3.2 (PDF pp. 10–12), Theorem 4.5 (PDF p. 17), and Theorem 5.3 (PDF p. 29).","primary_source_url":"https://eprint.iacr.org/2017/552","status":"theorem_checked"},"statement":"Lindell gives a Paillier-based two-party protocol that jointly computes a standard ECDSA signature without reconstructing the signing key.","statement_status":"source_normalized_statement","status":"published","title":"Paillier-based two-party ECDSA with standard verifier output","work_id":"TSIG-PAPER-2017-LINDELL"},"primaryUrl":"https://eprint.iacr.org/2017/552","sections":[],"slug":"lindell17-paillier-based-two-party","status":"published","subtitle":"Fast Secure Two-Party ECDSA Signing","summary":"Lindell gives a Paillier-based two-party protocol that jointly computes a standard ECDSA signature without reconstructing the signing key.","title":"Paillier-based two-party ECDSA with standard verifier output","type":"result","venue":"CRYPTO 2017","year":2017,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2017-LINDELL-EFFICIENT-TWO-PARTY-ECDSA"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2017-LINDELL-MALICIOUS-SECURITY","keywords":["atomic-result","ecdsa","two-party","paillier","malicious-security","ecdsa_paillier","malicious_robustness_and_blame","security_result"],"metadata":{"claim_slug":"malicious-security","contribution_kind":"security_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["malicious_robustness_and_blame"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Fast distributed ECDSA is useful only if one cheating participant cannot learn the other's key share or force a bad signature. Lindell's protocol drops most zero-knowledge proofs from signing, so its security argument must show that checking the final signature is enough. Theorem 4.5 proves security under a game-based definition from Paillier indistinguishability and ECDSA unforgeability, allowing concurrent executions that all abort together. Theorem 5.3 instead proves full simulation security for sequential composition, at the cost of a new Paillier-EC assumption. This companion record keeps those proof conditions next to the mapped construction. Static corruption of one party is the model; universal composability, proactive refresh, and adaptive corruption are outside it.","prior_boundary":"Earlier maliciously secure DSA and ECDSA signing protocols, including the two-party MacKenzie–Reiter line, protected each step with heavy zero-knowledge proofs over Paillier ciphertexts.","significance_at_publication":"The paper paired its fast protocol with a game-based proof from standard assumptions and a separate simulation proof under a new Paillier assumption, making the assumption trade-off explicit.","technical_delta":"The proofs cover a malicious party in a protocol whose only signing-time proofs are discrete-log proofs for the nonce exchange, with cheating by the second party caught by verifying the output."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2017-LINDELL-MALICIOUS-SECURITY","keywords":["ecdsa","two-party","paillier","malicious-security","ecdsa_paillier","malicious_robustness_and_blame","security_result"],"limitations":["This does not imply UC, proactive, or fully adaptive security."],"paper_id":"TSIG-PAPER-2017-LINDELL","qualifiers":["Static malicious corruption of one of the two parties; game-based security (Theorem 4.5) and simulation security under the Paillier-EC assumption (Theorem 5.3)."],"source_locator":{"dossier_section":"TSIG-PAPER-2017-LINDELL § Atomic claims and Evidence locator","primary_source":"ePrint 2017/552, Section 1.2 (PDF pp. 3–4), Theorem 4.5 (PDF p. 17), Section 5.2 Definition 5.2 and Theorem 5.3 (PDF p. 29).","primary_source_url":"https://eprint.iacr.org/2017/552","status":"theorem_checked"},"statement":"The two-party ECDSA protocol includes proofs and checks intended to preserve security when one participant deviates maliciously.","statement_status":"source_normalized_statement","status":"published","title":"Malicious security for Lindell's Paillier-based two-party ECDSA","work_id":"TSIG-PAPER-2017-LINDELL"},"primaryUrl":"https://eprint.iacr.org/2017/552","sections":[],"slug":"lindell17-malicious-security-for-linde","status":"published","subtitle":"Fast Secure Two-Party ECDSA Signing","summary":"The two-party ECDSA protocol includes proofs and checks intended to preserve security when one participant deviates maliciously.","title":"Malicious security for Lindell's Paillier-based two-party ECDSA","type":"result","venue":"CRYPTO 2017","year":2017,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2017-LINDELL-MALICIOUS-SECURITY"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2018-DKLS-2P-OT-BASED-MULTIPLICATION","keywords":["atomic-result","ecdsa","two-party","oblivious-transfer","gilboa-multiplication","ecdsa_ot_hps","proof_models_and_assumptions","mechanism"],"metadata":{"claim_slug":"ot-based-multiplication","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["proof_models_and_assumptions"],"technical_thread":["ecdsa_ot_hps"]},"historical_context":{"narrative":"Oblivious transfer gives a cheap way to turn two private factors into additive shares of their product, but Gilboa's classic protocol assumed honest behaviour. Doerner, Kondi, Lee, and shelat showed that a cheating sender could learn the receiver's secret bits through selective failures, and countered this by randomizing the receiver's encoding so that many failures would be needed. A further check compares the multiplier outputs with the public key and nonce point in the exponent, catching inconsistent inputs. The multiplier runs on a verified variant of Simplest OT and KOS extension. This record keeps that component next to the mapped protocol. The 2023 preface warns against the KOS extension after Roy's 2022 finding and corrects errors in the paper's reproduction of KOS.","prior_boundary":"Gilboa's OT-based multiplication was secure only against semi-honest parties, and even with malicious-secure OT a sender could learn bits of the receiver's input through selective failure.","significance_at_publication":"The authors offered the multiplier, built on their Verified Simplest OT and the KOS OT extension, as a technique of independent interest beyond ECDSA.","technical_delta":"Encoding the receiver's input randomly and checking multiplier inputs against the key and nonce in the exponent let the multiplier tolerate malicious parties inside ECDSA signing."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2018-DKLS-2P-OT-BASED-MULTIPLICATION","keywords":["ecdsa","two-party","oblivious-transfer","gilboa-multiplication","ecdsa_ot_hps","proof_models_and_assumptions","mechanism"],"limitations":["The component alone is not a complete threshold signature, and its OT-extension instantiation carries the KOS caution in the 2023 preface."],"paper_id":"TSIG-PAPER-2018-DKLS-2P","qualifiers":["The consistency check is stated for the paper's two-party protocol structure; the multiparty follow-up (ePrint 2019/523, Section 1.1) replaces it with a broadcast check and derives an improved multiplier from this one."],"source_locator":{"dossier_section":"TSIG-PAPER-2018-DKLS-2P § Atomic claims, Evidence locator, and Correction","primary_source":"ePrint 2018/499 (2023-07-18 revision), reproduced original paper Section I-A (PDF p. 38), Section I-B items 4–5 (PDF p. 39), and Section VI (PDF pp. 45–47); errata items 2–3 in Section 1.1 (PDF pp. 3–4).","primary_source_url":"https://eprint.iacr.org/2018/499","status":"section_checked"},"statement":"DKLS hardens Gilboa's semi-honest multiplication-by-oblivious-transfer against malicious parties with randomized input encoding and a consistency check, so the two secret multiplications in ECDSA signing need no homomorphic encryption.","statement_status":"source_normalized_statement","status":"published","title":"Hardened OT-based multiplication for ECDSA signing","work_id":"TSIG-PAPER-2018-DKLS-2P"},"primaryUrl":"https://eprint.iacr.org/2018/499","sections":[],"slug":"dkls18-hardened-ot-based-multiplica","status":"published","subtitle":"Secure Two-party Threshold ECDSA from ECDSA Assumptions","summary":"DKLS hardens Gilboa's semi-honest multiplication-by-oblivious-transfer against malicious parties with randomized input encoding and a consistency check, so the two secret multiplications in ECDSA signing need no homomorphic encryption.","title":"Hardened OT-based multiplication for ECDSA signing","type":"result","venue":"IEEE S&P 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2018-DKLS-2P-OT-BASED-MULTIPLICATION"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2018-DKLS-2P-TWO-PARTY-ECDSA-WITHOUT-PAILLIER","keywords":["atomic-result","ecdsa","two-party","2-of-n","oblivious-transfer","cdh","ecdsa_ot_hps","proof_models_and_assumptions","round_efficient_robust_signing","capability_result"],"metadata":{"claim_slug":"two-party-ecdsa-without-paillier","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["proof_models_and_assumptions","round_efficient_robust_signing"],"technical_thread":["ecdsa_ot_hps"]},"historical_context":{"narrative":"Practical threshold ECDSA had settled on Paillier encryption to multiply secret shares, which imported a factoring-type assumption foreign to elliptic curves and made each signature costly. Taking Lindell's observation that two-party signing reduces to two secret multiplications, Doerner, Kondi, Lee, and shelat computed them with oblivious transfer, hardening Gilboa's semi-honest technique against malicious parties. A check in the exponent forces both parties to use inputs consistent with their key and nonce shares. The resulting two-message protocol supports 2-of-n setups and outputs ordinary ECDSA signatures under CDH in the random-oracle model. The original version let one party bias the nonce, a gap argued away only in the generic group model; a 2023 revision adds a commitment round to remove it.","prior_boundary":"Existing threshold ECDSA protocols, including Lindell's two-party scheme and the multiparty Gennaro et al. line, relied on Paillier encryption, adding the Decisional Composite Residuosity assumption and expensive large-modulus operations.","significance_at_publication":"The paper presented the first threshold ECDSA signing based only on elliptic-curve primitives and ECDSA's own assumptions, and reported signing about eleven times faster than prior protocols.","technical_delta":"The protocol kept Lindell's multiplicative sharing of key and nonce but produced additive shares of the two products with a hardened OT-based multiplier and an exponent-side consistency check."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2018-DKLS-2P-TWO-PARTY-ECDSA-WITHOUT-PAILLIER","keywords":["ecdsa","two-party","2-of-n","oblivious-transfer","cdh","ecdsa_ot_hps","proof_models_and_assumptions","round_efficient_robust_signing","capability_result"],"limitations":["Paillier-free does not mean setup-free; the protocol needs base OT and OT extension, and the 2023 preface recommends replacing the KOS extension it originally used."],"paper_id":"TSIG-PAPER-2018-DKLS-2P","qualifiers":["Threshold two only (2-of-2 and 2-of-n); the original Section V leaves general thresholds to future work.","The original two-message protocol realizes a nonce-biasable functionality justified in the generic group model; the 2023 revision realizes the standard functionality with one extra pipelineable round (Section 3.3, Theorem 4.3)."],"source_locator":{"dossier_section":"TSIG-PAPER-2018-DKLS-2P § Atomic claims and Evidence locator","primary_source":"ePrint 2018/499 (2023-07-18 revision), reproduced original paper Sections I-A and I-B (PDF pp. 38–39), Section IV (PDF p. 41) and Section V (PDF p. 44); revised protocol Section 3.3 (PDF p. 13) and Theorem 4.3 (PDF p. 15).","primary_source_url":"https://eprint.iacr.org/2018/499","status":"theorem_checked"},"statement":"DKLS gives 2-of-n threshold ECDSA whose signing multiplications use oblivious transfer rather than Paillier encryption, proved secure against malicious adversaries in the random-oracle model from CDH and the assumptions of ECDSA itself.","statement_status":"source_normalized_statement","status":"published","title":"Two-party threshold ECDSA without Paillier encryption","work_id":"TSIG-PAPER-2018-DKLS-2P"},"primaryUrl":"https://eprint.iacr.org/2018/499","sections":[],"slug":"dkls18-ot-based-two-party","status":"published","subtitle":"Secure Two-party Threshold ECDSA from ECDSA Assumptions","summary":"DKLS gives 2-of-n threshold ECDSA whose signing multiplications use oblivious transfer rather than Paillier encryption, proved secure against malicious adversaries in the random-oracle model from CDH and the assumptions of ECDSA itself.","title":"Two-party threshold ECDSA without Paillier encryption","type":"result","venue":"IEEE S&P 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2018-DKLS-2P-TWO-PARTY-ECDSA-WITHOUT-PAILLIER"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2018-GG-DISTRIBUTED-SETUP","keywords":["atomic-result","ecdsa","multiparty","paillier","dkg","ecdsa_paillier","dealerless_setup","mechanism"],"metadata":{"claim_slug":"distributed-setup","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["dealerless_setup"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Earlier threshold-optimal ECDSA protocols shared one Paillier key among the signers, and generating that key jointly meant distributed RSA-modulus generation, which was slow and unimplemented for malicious parties. In GG18 every player instead keeps its own Paillier key, so the shared object is only the ECDSA key. Each player commits to a random group element, opens it, and runs a Feldman verifiable secret sharing of the underlying value; the sum of the received shares is a Shamir sharing of the signing key, and each player proves knowledge of its share with Schnorr's protocol and that its modulus is square-free. A complaint aborts setup because the paper assumes a dishonest majority. The procedure provides no proactive refresh.","prior_boundary":"The threshold-optimal ECDSA schemes that GG18 improves needed a distributed generation of a shared Paillier key, which the paper describes as far from scalable and never implemented for the malicious multiparty case.","significance_at_publication":"The paper's conclusion presents its efficient distributed key generation, together with faster signing, as what makes threshold ECDSA mature enough for adoption without a trusted dealer.","technical_delta":"Setup was reduced to per-player commitments, Feldman verifiable secret sharing of each player's random value, and proofs about each player's own Paillier modulus."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2018-GG-DISTRIBUTED-SETUP","keywords":["ecdsa","multiparty","paillier","dkg","ecdsa_paillier","dealerless_setup","mechanism"],"limitations":["Dealerless setup does not by itself supply proactive refresh."],"paper_id":"TSIG-PAPER-2018-GG","qualifiers":["Feldman VSS is used in an abort-on-complaint form suited to a dishonest majority (Section 2.6); the paper does not cite Pedersen's 1991 DKG for this procedure."],"source_locator":{"dossier_section":"TSIG-PAPER-2018-GG § Atomic claims and Evidence locator","primary_source":"ePrint 2019/114 (revised version), Section 1.1 (PDF p. 2), Section 2.6 (PDF p. 8), Section 4.1 (PDF p. 10), and Section 8 (PDF p. 26).","primary_source_url":"https://eprint.iacr.org/2019/114","status":"section_checked"},"statement":"GG18's key generation has each player commit to a random value, Feldman-share it, and prove knowledge of its resulting share, so the threshold ECDSA key is created without a trusted dealer and without jointly generating a Paillier modulus.","statement_status":"source_normalized_statement","status":"published","title":"Dealerless setup for multiparty threshold ECDSA","work_id":"TSIG-PAPER-2018-GG"},"primaryUrl":"https://eprint.iacr.org/2019/114","sections":[],"slug":"gg18-dealerless-setup-for-multipa","status":"published","subtitle":"Fast Multiparty Threshold ECDSA with Fast Trustless Setup","summary":"GG18's key generation has each player commit to a random value, Feldman-share it, and prove knowledge of its resulting share, so the threshold ECDSA key is created without a trusted dealer and without jointly generating a Paillier modulus.","title":"Dealerless setup for multiparty threshold ECDSA","type":"result","venue":"ACM CCS 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2018-GG-DISTRIBUTED-SETUP"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2018-GG-MULTIPARTY-THRESHOLD-ECDSA","keywords":["atomic-result","ecdsa","multiparty","paillier","dkg","ecdsa_paillier","dealerless_setup","capability_result"],"metadata":{"claim_slug":"multiparty-threshold-ecdsa","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["dealerless_setup"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Threshold ECDSA for general quorums was available before 2018, but its key generation needed a distributed RSA modulus for a shared Paillier key, which the authors blame for the absence of deployed threshold wallets. Gennaro and Goldfeder replaced the shared encryption key with pairwise conversions in the spirit of SPDZ, each signer using its own Paillier key, so setup reduces to Feldman verifiable secret sharing plus simple proofs. Signing borrows Lindell's idea of checking the final signature rather than proving every step, releasing signature shares only after a masked check that they combine correctly. Security is game-based against a static dishonest majority, without robustness. The revised ePrint adds range checks on every Paillier-encrypted value after leakage reported against the earlier version.","prior_boundary":"Threshold-optimal t-out-of-n ECDSA existed, but it required a costly distributed generation of a shared Paillier key, while the efficient protocols of Lindell and DKLS covered only two parties.","significance_at_publication":"The paper claimed the first multiparty ECDSA protocol for any \\( t \\le n \\) with efficient dealerless key generation, reporting key generation under a second and less signing time and communication than earlier threshold-optimal schemes.","technical_delta":"Each pair of signers converted multiplicative shares to additive ones with its own Paillier keys, so key generation needed only per-player Feldman sharing instead of a jointly generated RSA modulus."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2018-GG-MULTIPARTY-THRESHOLD-ECDSA","keywords":["ecdsa","multiparty","paillier","dkg","ecdsa_paillier","dealerless_setup","capability_result"],"limitations":["The revised version's range proofs are required; Section 5's proof-free variant is kept only as a historical record and is insecure.","Later work (CGGMP) strengthens composition and abort handling."],"paper_id":"TSIG-PAPER-2018-GG","qualifiers":["Static malicious corruption of up to t players with t up to n−1; the protocol aborts on detected cheating and does not aim for robustness (Section 2).","Theorem 1 is game-based unforgeability under DSA unforgeability, Strong RSA, non-malleable equivocable commitments, and DDH; simulation-based security is discussed only as an extension (Section 6.3)."],"source_locator":{"dossier_section":"TSIG-PAPER-2018-GG § Atomic claims and Evidence locator","primary_source":"ePrint 2019/114 (revised version), abstract (PDF p. 1), Sections 1–1.2 (PDF pp. 1–3), Section 2 (PDF p. 4), Sections 4.1–4.2 and Theorem 1 (PDF pp. 10–12).","primary_source_url":"https://eprint.iacr.org/2019/114","status":"theorem_checked"},"statement":"GG18 gives threshold-optimal t-out-of-n ECDSA for any \\( t \\le n \\) against a malicious dishonest majority, combining dealerless Feldman-VSS key generation with pairwise Paillier-based share conversions, and outputs signatures accepted by standard ECDSA verification.","statement_status":"source_normalized_statement","status":"published","title":"Threshold-optimal t-out-of-n ECDSA with dealerless key generation","work_id":"TSIG-PAPER-2018-GG"},"primaryUrl":"https://eprint.iacr.org/2019/114","sections":[],"slug":"gg18-multiparty-threshold-ecdsa","status":"published","subtitle":"Fast Multiparty Threshold ECDSA with Fast Trustless Setup","summary":"GG18 gives threshold-optimal t-out-of-n ECDSA for any \\( t \\le n \\) against a malicious dishonest majority, combining dealerless Feldman-VSS key generation with pairwise Paillier-based share conversions, and outputs signatures accepted by standard ECDSA verification.","title":"Threshold-optimal t-out-of-n ECDSA with dealerless key generation","type":"result","venue":"ACM CCS 2018","year":2018,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2018-GG-MULTIPARTY-THRESHOLD-ECDSA"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2019-DKLS-N-GENERAL-THRESHOLD-ECDSA","keywords":["atomic-result","ecdsa","threshold","oblivious-transfer","multiparty","uc-security","cdh","ecdsa_ot_hps","proof_models_and_assumptions","capability_result"],"metadata":{"claim_slug":"general-threshold-ecdsa","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["proof_models_and_assumptions"],"technical_thread":["ecdsa_ot_hps"]},"historical_context":{"narrative":"The OT-based route to threshold ECDSA initially worked only when two parties sign, since computing the nonce point by a Diffie–Hellman exchange does not scale to many parties without many rounds or heavy tools. Doerner, Kondi, Lee, and shelat instead let the signers jointly sample the nonce together with additive shares of its inverse, multiply those shares with the key shares pairwise, and confirm consistency through broadcast values that must sum to predictable targets. The protocol needs a logarithmic number of rounds, uses zero knowledge only during setup, and is proved secure in the UC framework. Corruptions are static, and the authors note that a constant-round variant exists at higher communication cost. Proactive refresh and identifiable abort are not claimed.","prior_boundary":"The DKLS18 protocol avoided Paillier but was limited to a threshold of two, because its Diffie–Hellman nonce exchange and consistency check were inherently two-party and it realized a nonstandard, nonce-biasable functionality.","significance_at_publication":"The protocol brought the Paillier-free OT route to arbitrary thresholds with UC security under CDH alone, an assumption the authors note is strictly weaker than the DDH used by contemporaneous threshold ECDSA protocols.","technical_delta":"Multiparty inverse sampling replaced the two-party key exchange, a broadcast consistency check replaced the asymmetric one, and the setup was modified for a dishonest majority with a proof of knowledge."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2019-DKLS-N-GENERAL-THRESHOLD-ECDSA","keywords":["ecdsa","threshold","oblivious-transfer","multiparty","uc-security","cdh","ecdsa_ot_hps","proof_models_and_assumptions","capability_result"],"limitations":["Static corruptions only; no proactive refresh, identifiable abort, or adaptive security is claimed."],"paper_id":"TSIG-PAPER-2019-DKLS-N","qualifiers":["Theorem 5.1 is a UC statement against static corruption of up to \\( t-1 \\) parties, under CDH, in a hybrid model with ideal two-party multiplication, inverse-sampling, commitment, and committed-proof functionalities; the abstract and Section 1.2 place the result in the global random-oracle model.","Signing takes ⌈log t⌉ + 6 rounds; only the final round depends on the message."],"source_locator":{"dossier_section":"TSIG-PAPER-2019-DKLS-N § Atomic claims and Evidence locator","primary_source":"ePrint 2019/523 (2020-05-22 revision), abstract (PDF p. 1), Section 1 (PDF pp. 3–4), Sections 1.1–1.2 (PDF pp. 5–7), and Section 5, Protocols 3–4 and Theorem 5.1 (PDF pp. 22–25).","primary_source_url":"https://eprint.iacr.org/2019/523","status":"theorem_checked"},"statement":"DKLS19 extends the DKLS18 protocols to t-of-n threshold ECDSA with ordinary signatures, proved UC-secure against a malicious adversary statically corrupting up to \\( t-1 \\) parties under CDH in the global random-oracle model.","statement_status":"source_normalized_statement","status":"published","title":"UC t-of-n threshold ECDSA from CDH on the OT route","work_id":"TSIG-PAPER-2019-DKLS-N"},"primaryUrl":"https://eprint.iacr.org/2019/523","sections":[],"slug":"dkls19-ot-based-t-of","status":"published","subtitle":"Threshold ECDSA from ECDSA Assumptions: The Multiparty Case","summary":"DKLS19 extends the DKLS18 protocols to t-of-n threshold ECDSA with ordinary signatures, proved UC-secure against a malicious adversary statically corrupting up to \\( t-1 \\) parties under CDH in the global random-oracle model.","title":"UC t-of-n threshold ECDSA from CDH on the OT route","type":"result","venue":"IEEE Symposium on Security and Privacy 2019","year":2019,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2019-DKLS-N-GENERAL-THRESHOLD-ECDSA"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2020-CGGMP-IDENTIFIABLE-ABORT","keywords":["atomic-result","ecdsa","uc-security","identifiable-abort","proactive","preprocessing","ecdsa_paillier","malicious_robustness_and_blame","attack_or_repair"],"metadata":{"claim_slug":"identifiable-abort","contribution_kind":"attack_or_repair","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["malicious_robustness_and_blame"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Practical multiparty ECDSA protocols still separated several desirable guarantees: composable security, accountable failure, share refresh, and a short online phase. CGGMP brought those features together by moving expensive work into preprocessing and analyzing the result in a UC framework. The protocol retained ordinary ECDSA verification while materially strengthening how applications could reason about aborts and compromise across epochs. The accountability node turns some malicious failures into evidence naming a deviating participant. It does not force an unavailable signer to continue or guarantee liveness after refusal.","prior_boundary":"Multiparty threshold ECDSA had efficient protocols, but stronger composition, proactive refresh, and accountable failure were not integrated into one online-efficient construction.","significance_at_publication":"CGGMP combined UC security, identifiable aborts, proactive security, and preprocessing into a stronger threshold-ECDSA contract.","technical_delta":"The result changed robustness from undifferentiated failure to accountable failure."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-CGGMP-IDENTIFIABLE-ABORT","keywords":["ecdsa","uc-security","identifiable-abort","proactive","preprocessing","ecdsa_paillier","malicious_robustness_and_blame","attack_or_repair"],"limitations":["Identifiable abort does not guarantee liveness after a party refuses to participate."],"paper_id":"TSIG-PAPER-2020-CGGMP","qualifiers":["Identification guarantee follows the protocol's exact blame mechanism."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-CGGMP § Atomic claims and Evidence locator","primary_source":"ePrint 2021/060 revised full version, abstract and contribution overview.","primary_source_url":"https://eprint.iacr.org/2021/060","status":"section_checked"},"statement":"When CGGMP signing aborts because of malicious behavior, the protocol provides evidence identifying a misbehaving participant under its model.","statement_status":"source_normalized_statement","status":"published","title":"Identifiable abort for malicious threshold-ECDSA failures","work_id":"TSIG-PAPER-2020-CGGMP"},"primaryUrl":"https://eprint.iacr.org/2021/060","sections":[],"slug":"cggmp20-identifiable-abort-for-malic","status":"published","subtitle":"UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts","summary":"When CGGMP signing aborts because of malicious behavior, the protocol provides evidence identifying a misbehaving participant under its model.","title":"Identifiable abort for malicious threshold-ECDSA failures","type":"result","venue":"ACM CCS 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-CGGMP-IDENTIFIABLE-ABORT"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2020-CGGMP-ONE-MESSAGE-DEPENDENT-ONLINE-ROUND","keywords":["atomic-result","ecdsa","preprocessing","online-rounds","noninteractive-online","ecdsa_paillier","round_efficient_robust_signing","optimization"],"metadata":{"claim_slug":"one-message-dependent-online-round","contribution_kind":"optimization","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Earlier practical threshold-ECDSA protocols required multiple interactions after the message to be signed was known, tying online latency to the full protocol. CGGMP separated those costs by moving every message-independent round into preprocessing. Once that material exists, only the last round depends on the message, so participants need not be online together throughout the expensive preparation. This record isolates the online interaction improvement rather than folding it into the paper's UC theorem. The complete protocols still take four or seven rounds, depending on the accountability tradeoff, and their one-round online description is valid only after the separate preprocessing phase.","prior_boundary":"Practical threshold-ECDSA protocols required several message-dependent interactions, increasing latency and forcing signers to remain online together.","significance_at_publication":"The result made online noninteraction a precisely scoped latency property for threshold ECDSA without pretending that the complete protocol had only one round.","technical_delta":"CGGMP moved every message-independent round into preprocessing so the online signing phase consists of one final message-dependent exchange."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-CGGMP-ONE-MESSAGE-DEPENDENT-ONLINE-ROUND","keywords":["ecdsa","preprocessing","online-rounds","noninteractive-online","ecdsa_paillier","round_efficient_robust_signing","optimization"],"limitations":["One online round does not mean one round from setup through signature output."],"paper_id":"TSIG-PAPER-2020-CGGMP","qualifiers":["The online count excludes message-independent preprocessing; the two complete protocols have different total round counts."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-CGGMP § Atomic claims and Evidence locator","primary_source":"ePrint 2021/060 revised full version, abstract and contribution overview.","primary_source_url":"https://eprint.iacr.org/2021/060","status":"section_checked"},"statement":"In both CGGMP protocols, all rounds except the last can be completed before the message is known, leaving one message-dependent online round.","statement_status":"source_normalized_statement","status":"published","title":"One message-dependent online round after CGGMP preprocessing","work_id":"TSIG-PAPER-2020-CGGMP"},"primaryUrl":"https://eprint.iacr.org/2021/060","sections":[],"slug":"cggmp20-one-online-cggmp-round","status":"published","subtitle":"UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts","summary":"In both CGGMP protocols, all rounds except the last can be completed before the message is known, leaving one message-dependent online round.","title":"One message-dependent online round after CGGMP preprocessing","type":"result","venue":"ACM CCS 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-CGGMP-ONE-MESSAGE-DEPENDENT-ONLINE-ROUND"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2020-CGGMP-PROACTIVE-SECURITY","keywords":["atomic-result","ecdsa","uc-security","identifiable-abort","proactive","preprocessing","ecdsa_paillier","proactive_refresh","security_result"],"metadata":{"claim_slug":"proactive-security","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["proactive_refresh"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Practical multiparty ECDSA protocols still separated several desirable guarantees: composable security, accountable failure, share refresh, and a short online phase. CGGMP brought those features together by moving expensive work into preprocessing and analyzing the result in a UC framework. The protocol retained ordinary ECDSA verification while materially strengthening how applications could reason about aborts and compromise across epochs. The proactive node records share renewal across epochs without changing the public verification key. Its benefit depends on the model's epoch separation and erasure assumptions.","prior_boundary":"Multiparty threshold ECDSA had efficient protocols, but stronger composition, proactive refresh, and accountable failure were not integrated into one online-efficient construction.","significance_at_publication":"CGGMP combined UC security, identifiable aborts, proactive security, and preprocessing into a stronger threshold-ECDSA contract.","technical_delta":"The protocol added a time/refresh dimension to the threshold-ECDSA security contract."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-CGGMP-PROACTIVE-SECURITY","keywords":["ecdsa","uc-security","identifiable-abort","proactive","preprocessing","ecdsa_paillier","proactive_refresh","security_result"],"limitations":["Refresh does not change the underlying public verification key."],"paper_id":"TSIG-PAPER-2020-CGGMP","qualifiers":["Proactive guarantees depend on the epoch and erasure assumptions in the model."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-CGGMP § Atomic claims and Evidence locator","primary_source":"ePrint 2021/060 revised full version, abstract and contribution overview.","primary_source_url":"https://eprint.iacr.org/2021/060","status":"section_checked"},"statement":"CGGMP supports refreshing distributed key shares so compromise across separated epochs need not accumulate against one static sharing.","statement_status":"source_normalized_statement","status":"published","title":"Proactive refresh for threshold ECDSA key shares","work_id":"TSIG-PAPER-2020-CGGMP"},"primaryUrl":"https://eprint.iacr.org/2021/060","sections":[],"slug":"cggmp20-proactive-ecdsa-share-refres","status":"published","subtitle":"UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts","summary":"CGGMP supports refreshing distributed key shares so compromise across separated epochs need not accumulate against one static sharing.","title":"Proactive refresh for threshold ECDSA key shares","type":"result","venue":"ACM CCS 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-CGGMP-PROACTIVE-SECURITY"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2020-CGGMP-UC-THRESHOLD-ECDSA","keywords":["atomic-result","ecdsa","uc-security","identifiable-abort","proactive","preprocessing","ecdsa_paillier","adaptive_corruption_security","proof_models_and_assumptions","security_result"],"metadata":{"claim_slug":"uc-threshold-ecdsa","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["adaptive_corruption_security","proof_models_and_assumptions"],"technical_thread":["ecdsa_paillier"]},"historical_context":{"narrative":"Practical multiparty ECDSA protocols already produced ordinary signatures, but their security contracts did not cover the adaptive UC setting reached by CGGMP. The revised full version analyzes two protocols that realize an ideal threshold-signature functionality in the global random-oracle model while adversarial corruptions may occur adaptively. This record isolates that composability and corruption-timing result. The paper's preprocessing boundary, proactive refresh, and identifiable-abort mechanism are separate contributions rather than evidence for the UC theorem by themselves. The guarantee remains tied to the specified functionalities and to Strong RSA, DDH, Paillier semantic security, and the paper's enhanced ECDSA-unforgeability assumption.","prior_boundary":"Practical multiparty ECDSA protocols existed, but their analyses did not yet provide the same adaptive UC composition contract as the CGGMP constructions.","significance_at_publication":"It made composable, adaptive security an explicit coordinate for practical threshold ECDSA rather than treating malicious security as a single undifferentiated label.","technical_delta":"The work realized an ideal threshold-signature functionality against adaptive corruptions in the global random-oracle model."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-CGGMP-UC-THRESHOLD-ECDSA","keywords":["ecdsa","uc-security","identifiable-abort","proactive","preprocessing","ecdsa_paillier","adaptive_corruption_security","proof_models_and_assumptions","security_result"],"limitations":["The claim is not a standard-model reduction from a single ECDSA assumption."],"paper_id":"TSIG-PAPER-2020-CGGMP","qualifiers":["Adaptive UC claim is in the global random-oracle model under Strong RSA, DDH, Paillier semantic security, and the paper's enhanced ECDSA-unforgeability assumption."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-CGGMP § Atomic claims and Evidence locator","primary_source":"ePrint 2021/060 revised full version, abstract and contribution overview.","primary_source_url":"https://eprint.iacr.org/2021/060","status":"section_checked"},"statement":"CGGMP realizes threshold ECDSA in the UC framework against adaptive corruptions in the global random-oracle model under its stated assumptions.","statement_status":"source_normalized_statement","status":"published","title":"Adaptively secure UC threshold ECDSA in the global random-oracle model","work_id":"TSIG-PAPER-2020-CGGMP"},"primaryUrl":"https://eprint.iacr.org/2021/060","sections":[],"slug":"cggmp20-adaptive-uc-threshold-ecdsa","status":"published","subtitle":"UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts","summary":"CGGMP realizes threshold ECDSA in the UC framework against adaptive corruptions in the global random-oracle model under its stated assumptions.","title":"Adaptively secure UC threshold ECDSA in the global random-oracle model","type":"result","venue":"ACM CCS 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-CGGMP-UC-THRESHOLD-ECDSA"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2020-FROST-IDENTIFIABLE-MISBEHAVING-PARTICIPANT","keywords":["atomic-result","schnorr","discrete-log","two-round","preprocessing","practical","schnorr_nonce_protocols","malicious_robustness_and_blame","attack_or_repair"],"metadata":{"claim_slug":"identifiable-misbehaving-participant","contribution_kind":"attack_or_repair","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["malicious_robustness_and_blame"],"technical_thread":["schnorr_nonce_protocols"]},"historical_context":{"narrative":"Schnorr's linear response makes it friendlier to threshold execution than ECDSA, yet existing protocols still paid in rounds, rigidity, or preprocessing assumptions. FROST combined nonce commitments, signer-set binding, and response aggregation into a flexible t-out-of-n workflow. The paper presents both a two-round mode and a preprocessed one-online-round mode, with security tied to its stated adversary model. The failure-handling record concerns verification of individual response shares and attribution of an invalid one. It detects malformed contributions but cannot prevent denial of service by absence.","prior_boundary":"Threshold Schnorr protocols either required more signing interaction or specialized participant assumptions despite the base signature's simple linear structure.","significance_at_publication":"FROST delivered a flexible t-out-of-n protocol with two signing rounds and a one-online-round preprocessed mode, becoming a practical Schnorr threshold baseline.","technical_delta":"The protocol made malformed-share failure attributable without changing the ordinary Schnorr output."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-FROST-IDENTIFIABLE-MISBEHAVING-PARTICIPANT","keywords":["schnorr","discrete-log","two-round","preprocessing","practical","schnorr_nonce_protocols","malicious_robustness_and_blame","attack_or_repair"],"limitations":["It does not prevent denial of service by absent signers."],"paper_id":"TSIG-PAPER-2020-FROST","qualifiers":["Covers invalid shares under the protocol transcript."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-FROST § Atomic claims and Evidence locator","primary_source":"ePrint 2020/852, Figure 3 step 7.b (PDF p. 15) and Sections 5.2–6.2 (PDF pp. 12–18).","primary_source_url":"https://eprint.iacr.org/2020/852","status":"section_checked"},"statement":"FROST's share verification lets the coordinator detect which participant supplied an invalid signing share.","statement_status":"source_normalized_statement","status":"published","title":"FROST identifies invalid signature-share senders","work_id":"TSIG-PAPER-2020-FROST"},"primaryUrl":"https://eprint.iacr.org/2020/852","sections":[],"slug":"kg20-frost-identifies-invalid-sig","status":"published","subtitle":"FROST: Flexible Round-Optimized Schnorr Threshold Signatures","summary":"FROST's share verification lets the coordinator detect which participant supplied an invalid signing share.","title":"FROST identifies invalid signature-share senders","type":"result","venue":"SAC 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-FROST-IDENTIFIABLE-MISBEHAVING-PARTICIPANT"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2020-FROST-ONE-ROUND-WITH-PREPROCESSING","keywords":["atomic-result","schnorr","discrete-log","two-round","preprocessing","practical","schnorr_nonce_protocols","round_efficient_robust_signing","optimization"],"metadata":{"claim_slug":"one-round-with-preprocessing","contribution_kind":"optimization","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["schnorr_nonce_protocols"]},"historical_context":{"narrative":"Schnorr's linear response makes it friendlier to threshold execution than ECDSA, yet existing protocols still paid in rounds, rigidity, or preprocessing assumptions. FROST combined nonce commitments, signer-set binding, and response aggregation into a flexible t-out-of-n workflow. The paper presents both a two-round mode and a preprocessed one-online-round mode, with security tied to its stated adversary model. The optimization moves nonce commitments before the message-dependent phase, leaving one online round. Counting the preprocessing makes clear that this is not an end-to-end one-round protocol.","prior_boundary":"Threshold Schnorr protocols either required more signing interaction or specialized participant assumptions despite the base signature's simple linear structure.","significance_at_publication":"FROST delivered a flexible t-out-of-n protocol with two signing rounds and a one-online-round preprocessed mode, becoming a practical Schnorr threshold baseline.","technical_delta":"The optimization shifted interaction from the online critical path into stored preprocessing material."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-FROST-ONE-ROUND-WITH-PREPROCESSING","keywords":["schnorr","discrete-log","two-round","preprocessing","practical","schnorr_nonce_protocols","round_efficient_robust_signing","optimization"],"limitations":["It is not a one-round protocol when preprocessing is counted end to end."],"paper_id":"TSIG-PAPER-2020-FROST","qualifiers":["One online round assumes fresh, correctly managed preprocessed nonces."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-FROST § Atomic claims and Evidence locator","primary_source":"ePrint 2020/852, Section 5.2 and Figures 2–3 (PDF pp. 12–15).","primary_source_url":"https://eprint.iacr.org/2020/852","status":"section_checked"},"statement":"FROST can move nonce commitments to preprocessing so the message-dependent online phase uses one round.","statement_status":"source_normalized_statement","status":"published","title":"One online signing round after FROST nonce preprocessing","work_id":"TSIG-PAPER-2020-FROST"},"primaryUrl":"https://eprint.iacr.org/2020/852","sections":[],"slug":"kg20-one-online-frost-round","status":"published","subtitle":"FROST: Flexible Round-Optimized Schnorr Threshold Signatures","summary":"FROST can move nonce commitments to preprocessing so the message-dependent online phase uses one round.","title":"One online signing round after FROST nonce preprocessing","type":"result","venue":"SAC 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-FROST-ONE-ROUND-WITH-PREPROCESSING"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2020-FROST-TWO-ROUND-THRESHOLD-SCHNORR","keywords":["atomic-result","schnorr","discrete-log","two-round","preprocessing","practical","schnorr_nonce_protocols","round_efficient_robust_signing","construction"],"metadata":{"claim_slug":"two-round-threshold-schnorr","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["schnorr_nonce_protocols"]},"historical_context":{"narrative":"Schnorr's linear response makes it friendlier to threshold execution than ECDSA, yet existing protocols still paid in rounds, rigidity, or preprocessing assumptions. FROST combined nonce commitments, signer-set binding, and response aggregation into a flexible t-out-of-n workflow. The paper presents both a two-round mode and a preprocessed one-online-round mode, with security tied to its stated adversary model. The construction record is the two-round t-out-of-n signing path with ordinary Schnorr output. DKG and participant availability are related requirements but not silently included in its round count.","prior_boundary":"Threshold Schnorr protocols either required more signing interaction or specialized participant assumptions despite the base signature's simple linear structure.","significance_at_publication":"FROST delivered a flexible t-out-of-n protocol with two signing rounds and a one-online-round preprocessed mode, becoming a practical Schnorr threshold baseline.","technical_delta":"The protocol coupled signer-set binding and nonce commitments with linear response aggregation to reach a flexible two-round design."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2020-FROST-TWO-ROUND-THRESHOLD-SCHNORR","keywords":["schnorr","discrete-log","two-round","preprocessing","practical","schnorr_nonce_protocols","round_efficient_robust_signing","construction"],"limitations":["Key generation and signer availability are separate concerns."],"paper_id":"TSIG-PAPER-2020-FROST","qualifiers":["Static-adversary security treatment in the paper."],"source_locator":{"dossier_section":"TSIG-PAPER-2020-FROST § Atomic claims and Evidence locator","primary_source":"ePrint 2020/852, Section 5.2 (PDF pp. 12–15) and Section 6.2, Theorem 6.1 (PDF pp. 16–18).","primary_source_url":"https://eprint.iacr.org/2020/852","status":"theorem_checked"},"statement":"FROST produces ordinary Schnorr signatures with two rounds of interaction among a selected threshold of signers.","statement_status":"source_normalized_statement","status":"published","title":"Two-round t-out-of-n FROST signing","work_id":"TSIG-PAPER-2020-FROST"},"primaryUrl":"https://eprint.iacr.org/2020/852","sections":[],"slug":"kg20-two-round-t-out","status":"published","subtitle":"FROST: Flexible Round-Optimized Schnorr Threshold Signatures","summary":"FROST produces ordinary Schnorr signatures with two rounds of interaction among a selected threshold of signers.","title":"Two-round t-out-of-n FROST signing","type":"result","venue":"SAC 2020","year":2020,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2020-FROST-TWO-ROUND-THRESHOLD-SCHNORR"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2021-DOTT-ABORT-LEAKAGE-COUNTERMEASURE","keywords":["atomic-result","lattice","module-lwe","module-sis","fiat-shamir-with-aborts","n-out-of-n","two-round","lattice_fswa_threshold","post_quantum_thresholding","abort_leakage_security","attack_or_repair"],"metadata":{"claim_slug":"abort-leakage-countermeasure","contribution_kind":"attack_or_repair","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding","abort_leakage_security"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Lattice Fiat–Shamir signatures could not simply add participant responses as in Schnorr: rejection events and partial transcripts risked leaking information about distributed short secrets. DOTT made that obstacle explicit and built a two-round n-out-of-n protocol around a homomorphic trapdoor commitment. The construction established an efficient lattice threshold starting point while exposing abort leakage as a mechanism-level security problem. The repair node isolates homomorphic trapdoor commitments as protection against information accumulating through aborted transcripts. It is tied to DOTT's design and does not certify every rejection-sampling protocol.","prior_boundary":"Lattice signatures had no direct analogue of linear Schnorr aggregation because rejection sampling and abort transcripts can leak distributed secret information.","significance_at_publication":"DOTT obtained two-round n-out-of-n signing and isolated abort leakage as a mechanism-level obstacle requiring a trapdoor-commitment countermeasure.","technical_delta":"The countermeasure made repeated abort behavior an explicit security object rather than an efficiency nuisance."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2021-DOTT-ABORT-LEAKAGE-COUNTERMEASURE","keywords":["lattice","module-lwe","module-sis","fiat-shamir-with-aborts","n-out-of-n","two-round","lattice_fswa_threshold","post_quantum_thresholding","abort_leakage_security","attack_or_repair"],"limitations":["It is not a generic proof that every abort-based threshold signature is safe."],"paper_id":"TSIG-PAPER-2021-DOTT","qualifiers":["Leakage defense is coupled to the DOTT protocol and commitment assumptions."],"source_locator":{"dossier_section":"TSIG-PAPER-2021-DOTT § Atomic claims and Evidence locator","primary_source":"ePrint 2020/1110 full journal version, Section 1.1 (PDF pp. 4–7), Section 2.4, and Section 3.1, Figure 6 (PDF pp. 12–19).","primary_source_url":"https://eprint.iacr.org/2020/1110","status":"section_checked"},"statement":"DOTT uses a homomorphic trapdoor-commitment mechanism so abort transcripts do not expose accumulated information about distributed lattice signing secrets.","statement_status":"source_normalized_statement","status":"published","title":"Homomorphic trapdoor commitments contain lattice abort leakage","work_id":"TSIG-PAPER-2021-DOTT"},"primaryUrl":"https://eprint.iacr.org/2020/1110","sections":[],"slug":"dott21-abort-leakage-trapdoor-commi","status":"published","subtitle":"Two-round n-out-of-n and Multi-Signatures and Trapdoor Commitment from Lattices","summary":"DOTT uses a homomorphic trapdoor-commitment mechanism so abort transcripts do not expose accumulated information about distributed lattice signing secrets.","title":"Homomorphic trapdoor commitments contain lattice abort leakage","type":"result","venue":"PKC 2021; Journal of Cryptology 2022","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2021-DOTT-ABORT-LEAKAGE-COUNTERMEASURE"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","keywords":["atomic-result","lattice","module-lwe","module-sis","fiat-shamir-with-aborts","n-out-of-n","two-round","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","construction"],"metadata":{"claim_slug":"two-round-n-out-of-n-lattice-signing","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding","round_efficient_robust_signing"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Lattice Fiat–Shamir signatures could not simply add participant responses as in Schnorr: rejection events and partial transcripts risked leaking information about distributed short secrets. DOTT made that obstacle explicit and built a two-round n-out-of-n protocol around a homomorphic trapdoor commitment. The construction established an efficient lattice threshold starting point while exposing abort leakage as a mechanism-level security problem. The construction node establishes two-round lattice signing only when all n parties participate. Arbitrary t-out-of-n capability arrived later and required different machinery.","prior_boundary":"Lattice signatures had no direct analogue of linear Schnorr aggregation because rejection sampling and abort transcripts can leak distributed secret information.","significance_at_publication":"DOTT obtained two-round n-out-of-n signing and isolated abort leakage as a mechanism-level obstacle requiring a trapdoor-commitment countermeasure.","technical_delta":"The construction established two-round feasibility for distributed rejection-sampling signatures despite abort-related leakage."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING","keywords":["lattice","module-lwe","module-sis","fiat-shamir-with-aborts","n-out-of-n","two-round","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","construction"],"limitations":["The security mechanism adds trapdoor-commitment machinery."],"paper_id":"TSIG-PAPER-2021-DOTT","qualifiers":["Full n-out-of-n participation, not arbitrary t-out-of-n."],"source_locator":{"dossier_section":"TSIG-PAPER-2021-DOTT § Atomic claims and Evidence locator","primary_source":"ePrint 2020/1110 full journal version, Section 3.1, Figure 6 (PDF pp. 16–19), and Section 3.3, Theorem 1 (PDF pp. 19–26).","primary_source_url":"https://eprint.iacr.org/2020/1110","status":"theorem_checked"},"statement":"DOTT constructs a two-round distributed lattice signature in which all n signers participate and the output follows a Fiat–Shamir-with-aborts line.","statement_status":"source_normalized_statement","status":"published","title":"Two-round n-out-of-n lattice signing","work_id":"TSIG-PAPER-2021-DOTT"},"primaryUrl":"https://eprint.iacr.org/2020/1110","sections":[],"slug":"dott21-two-round-n-out","status":"published","subtitle":"Two-round n-out-of-n and Multi-Signatures and Trapdoor Commitment from Lattices","summary":"DOTT constructs a two-round distributed lattice signature in which all n signers participate and the output follows a Fiat–Shamir-with-aborts line.","title":"Two-round n-out-of-n lattice signing","type":"result","venue":"PKC 2021; Journal of Cryptology 2022","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2021-DOTT-TWO-ROUND-N-OUT-OF-N-LATTICE-SIGNING"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2021-GKMN-STATELESS-DETERMINISTIC-THRESHOLD-SCHNORR","keywords":["atomic-result","schnorr","deterministic-nonce","stateless","garbled-circuits","dishonest-majority","schnorr_nonce_protocols","round_efficient_robust_signing","capability_result"],"metadata":{"claim_slug":"stateless-deterministic-threshold-schnorr","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["schnorr_nonce_protocols"]},"historical_context":{"narrative":"Threshold Schnorr implementations often relied on fresh randomized nonces, preprocessed state, or careful continuity of state across sessions. Garillot, Kondi, Mohassel, and Nikolaenko pursued a different operational contract: deterministic nonce derivation without evolving signer state. Their protocol used standardized block-cipher and garbled-circuit tools to protect the derivation, trading extra machinery for a more robust nonce-management interface. The capability change is deterministic, stateless nonce handling for dishonest-majority threshold Schnorr. That operational improvement does not eliminate artifact-level side-channel and fault obligations in practice.","prior_boundary":"Fast threshold Schnorr signing typically relied on randomized nonce generation, preprocessing state, or protocols whose state-management contract complicated robust deployment.","significance_at_publication":"The work achieved deterministic stateless threshold signing under standard assumptions by using block-cipher and garbled-circuit tools for nonce handling.","technical_delta":"The protocol changed the nonce/state interface rather than only reducing rounds."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2021-GKMN-STATELESS-DETERMINISTIC-THRESHOLD-SCHNORR","keywords":["schnorr","deterministic-nonce","stateless","garbled-circuits","dishonest-majority","schnorr_nonce_protocols","round_efficient_robust_signing","capability_result"],"limitations":["Determinism does not eliminate all implementation or side-channel obligations."],"paper_id":"TSIG-PAPER-2021-GKMN","qualifiers":["Uses block-cipher and garbled-circuit/zero-knowledge machinery."],"source_locator":{"dossier_section":"TSIG-PAPER-2021-GKMN § Atomic claims and Evidence locator","primary_source":"ePrint 2021/1055, Sections 1.3–1.4 (PDF pp. 4–9), Section 9 signing protocol, and Theorem 9.3 (PDF pp. 33–34).","primary_source_url":"https://eprint.iacr.org/2021/1055","status":"theorem_checked"},"statement":"GKMN constructs threshold Schnorr with deterministic nonce derivation and no evolving long-term signing state under its standard-assumption toolchain.","statement_status":"source_normalized_statement","status":"published","title":"Stateless deterministic threshold Schnorr signing","work_id":"TSIG-PAPER-2021-GKMN"},"primaryUrl":"https://eprint.iacr.org/2021/1055","sections":[],"slug":"gkmn21-stateless-deterministic-thre","status":"published","subtitle":"Threshold Schnorr with Stateless Deterministic Signing from Standard Assumptions","summary":"GKMN constructs threshold Schnorr with deterministic nonce derivation and no evolving long-term signing state under its standard-assumption toolchain.","title":"Stateless deterministic threshold Schnorr signing","type":"result","venue":"CRYPTO 2021","year":2021,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2021-GKMN-STATELESS-DETERMINISTIC-THRESHOLD-SCHNORR"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2022-DILIZIUM2-TWO-PARTY-DILITHIUM-LINE","keywords":["atomic-result","lattice","module-lwe","module-sis","dilithium","two-party","compression","lattice_fswa_threshold","post_quantum_thresholding","construction"],"metadata":{"claim_slug":"two-party-dilithium-line","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"DOTT established a commitment-based route to distributed lattice signing, but direct use with Dilithium's compression conventions and a focused two-party workflow required different choices. DiLizium 2.0 revisited that line, incorporated Dilithium-style encoding techniques, and reported a revised three-round protocol. It remains a two-party construction rather than an arbitrary-threshold ML-DSA package. The mapped object is a three-round two-party construction using Dilithium-oriented compression. It neither supplies arbitrary thresholds nor claims byte compatibility with the later ML-DSA standard or its normative parameter profiles.","prior_boundary":"DOTT established a lattice multisignature route, but direct compatibility with Dilithium's compression choices and a focused two-party workflow remained unsettled.","significance_at_publication":"DiLizium 2.0 adapted the commitment-based approach to a two-party Dilithium-oriented construction and revised its round and encoding tradeoffs.","technical_delta":"The work changed the concrete encoding and round tradeoff for a focused two-party post-quantum protocol."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2022-DILIZIUM2-TWO-PARTY-DILITHIUM-LINE","keywords":["lattice","module-lwe","module-sis","dilithium","two-party","compression","lattice_fswa_threshold","post_quantum_thresholding","construction"],"limitations":["It is not an arbitrary-threshold ML-DSA package."],"paper_id":"TSIG-PAPER-2022-DILIZIUM2","qualifiers":["Two-party setting and the audited preprint version."],"source_locator":{"dossier_section":"TSIG-PAPER-2022-DILIZIUM2 § Atomic claims and Evidence locator","primary_source":"ePrint 2022/644, Section 1.1 (PDF p. 2), Theorem 1 (PDF pp. 10–11), and Section 4, Table 2 (PDF pp. 14–15).","primary_source_url":"https://eprint.iacr.org/2022/644","status":"theorem_checked"},"statement":"DiLizium 2.0 revisits two-party lattice signing and incorporates Dilithium compression techniques into the DOTT-related construction line.","statement_status":"source_normalized_statement","status":"published_with_outdated_eprint","title":"Three-round two-party signing with Dilithium-style compression","work_id":"TSIG-PAPER-2022-DILIZIUM2"},"primaryUrl":"https://eprint.iacr.org/2022/644","sections":[],"slug":"lsv22-three-round-two-party","status":"published_with_outdated_eprint","subtitle":"DiLizium 2.0: Revisiting Two-Party Crystals-Dilithium","summary":"DiLizium 2.0 revisits two-party lattice signing and incorporates Dilithium compression techniques into the DOTT-related construction line.","title":"Three-round two-party signing with Dilithium-style compression","type":"result","venue":"Journal of Computer Security final version","year":2022,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2022-DILIZIUM2-TWO-PARTY-DILITHIUM-LINE"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2023-GKS-ACTIVELY-SECURE-THRESHOLD-LINEAR-HE","keywords":["atomic-result","lattice","ring-lwe","sis","threshold-he","arbitrary-threshold","two-round","lattice_fswa_threshold","post_quantum_thresholding","mechanism"],"metadata":{"claim_slug":"actively-secure-threshold-linear-he","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Two-round lattice signing had been achieved when every participant was required, leaving arbitrary quorums without a secure way to combine masked linear values. GKS introduced an actively secure threshold linearly homomorphic encryption layer for that role. The resulting protocol retained two signing rounds while allowing t-out-of-n participation, at the cost of a more substantial homomorphic setup and component stack. The mechanism node isolates that actively secure linear-homomorphic layer and its role in reconstructing masked signing values. It is not independently a signature scheme.","prior_boundary":"Two-round lattice signing was available for n-out-of-n participation, while arbitrary thresholds required a way to reconstruct masked linear operations securely.","significance_at_publication":"GKS introduced an actively secure threshold linearly homomorphic-encryption layer to reach arbitrary t-out-of-n signing in two rounds.","technical_delta":"The component supplied the missing reconstruction mechanism between full-participation lattice signing and t-out-of-n signing."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2023-GKS-ACTIVELY-SECURE-THRESHOLD-LINEAR-HE","keywords":["lattice","ring-lwe","sis","threshold-he","arbitrary-threshold","two-round","lattice_fswa_threshold","post_quantum_thresholding","mechanism"],"limitations":["It is not a standalone signature scheme."],"paper_id":"TSIG-PAPER-2023-GKS","qualifiers":["Component security is tied to the GKS protocol and parameters."],"source_locator":{"dossier_section":"TSIG-PAPER-2023-GKS § Atomic claims and Evidence locator","primary_source":"ePrint 2023/1318, Section 3 and Theorem 1 (PDF pp. 12–16), plus Section 5.1, Figures 6–7 (PDF pp. 22–25).","primary_source_url":"https://eprint.iacr.org/2023/1318","status":"theorem_checked"},"statement":"GKS builds an actively secure threshold linearly homomorphic-encryption layer to aggregate masked lattice signing values for arbitrary thresholds.","statement_status":"source_normalized_statement","status":"published","title":"Actively secure threshold linear-HE as a signing component","work_id":"TSIG-PAPER-2023-GKS"},"primaryUrl":"https://eprint.iacr.org/2023/1318","sections":[],"slug":"gks23-actively-secure-threshold-li","status":"published","subtitle":"Two-Round Threshold Lattice-Based Signatures from Threshold Homomorphic Encryption","summary":"GKS builds an actively secure threshold linearly homomorphic-encryption layer to aggregate masked lattice signing values for arbitrary thresholds.","title":"Actively secure threshold linear-HE as a signing component","type":"result","venue":"PQCrypto 2024","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2023-GKS-ACTIVELY-SECURE-THRESHOLD-LINEAR-HE"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2023-GKS-TWO-ROUND-ARBITRARY-THRESHOLD-LATTICE-SIGNATURE","keywords":["atomic-result","lattice","ring-lwe","sis","threshold-he","arbitrary-threshold","two-round","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","capability_result"],"metadata":{"claim_slug":"two-round-arbitrary-threshold-lattice-signature","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding","round_efficient_robust_signing"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Two-round lattice signing had been achieved when every participant was required, leaving arbitrary quorums without a secure way to combine masked linear values. GKS introduced an actively secure threshold linearly homomorphic encryption layer for that role. The resulting protocol retained two signing rounds while allowing t-out-of-n participation, at the cost of a more substantial homomorphic setup and component stack. The capability node records two-round signing for a late-chosen t-out-of-n quorum. It relies on the threshold-encryption component rather than avoiding homomorphic machinery.","prior_boundary":"Two-round lattice signing was available for n-out-of-n participation, while arbitrary thresholds required a way to reconstruct masked linear operations securely.","significance_at_publication":"GKS introduced an actively secure threshold linearly homomorphic-encryption layer to reach arbitrary t-out-of-n signing in two rounds.","technical_delta":"The result generalized the two-round lattice line beyond n-out-of-n signers."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2023-GKS-TWO-ROUND-ARBITRARY-THRESHOLD-LATTICE-SIGNATURE","keywords":["lattice","ring-lwe","sis","threshold-he","arbitrary-threshold","two-round","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","capability_result"],"limitations":["The protocol does not avoid homomorphic-encryption machinery."],"paper_id":"TSIG-PAPER-2023-GKS","qualifiers":["Threshold-LHE setup and active-security assumptions are part of the construction."],"source_locator":{"dossier_section":"TSIG-PAPER-2023-GKS § Atomic claims and Evidence locator","primary_source":"ePrint 2023/1318, Section 5, Figure 7 (PDF pp. 22–25), and Theorem 3 (PDF p. 26).","primary_source_url":"https://eprint.iacr.org/2023/1318","status":"theorem_checked"},"statement":"GKS constructs a two-round lattice signature for arbitrary t-out-of-n participation using threshold linearly homomorphic encryption.","statement_status":"source_normalized_statement","status":"published","title":"Two-round arbitrary-threshold lattice signing","work_id":"TSIG-PAPER-2023-GKS"},"primaryUrl":"https://eprint.iacr.org/2023/1318","sections":[],"slug":"gks23-two-round-t-out","status":"published","subtitle":"Two-Round Threshold Lattice-Based Signatures from Threshold Homomorphic Encryption","summary":"GKS constructs a two-round lattice signature for arbitrary t-out-of-n participation using threshold linearly homomorphic encryption.","title":"Two-round arbitrary-threshold lattice signing","type":"result","venue":"PQCrypto 2024","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2023-GKS-TWO-ROUND-ARBITRARY-THRESHOLD-LATTICE-SIGNATURE"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2023-OLAF-PROOF-WITHOUT-AGM","keywords":["atomic-result","schnorr","frost","dkg","aomdl","random-oracle","proof-model","schnorr_nonce_protocols","proof_models_and_assumptions","security_result"],"metadata":{"claim_slug":"proof-without-agm","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["proof_models_and_assumptions"],"technical_thread":["schnorr_nonce_protocols"]},"historical_context":{"narrative":"FROST offered an attractive protocol shape, but its strongest efficient analyses used the algebraic group model. Olaf combined a FROST variant with a Pedersen-style DKG and proved unforgeability without that model, relying instead on AOMDL in the random-oracle setting. The result changed the proof foundation of practical threshold Schnorr without claiming a plain-model reduction from ordinary discrete log. The exact advance is a FROST-style proof without the algebraic group model. Random oracles and the AOMDL assumption remain, so the node does not assert a standard-model proof from plain discrete log.","prior_boundary":"FROST-style efficiency was accompanied by proofs using the algebraic group model, leaving a proof-model gap for deployable threshold Schnorr.","significance_at_publication":"Olaf paired a FROST variant with Pedersen-style DKG and established unforgeability without the algebraic group model under its stated AOMDL/ROM assumptions.","technical_delta":"The analysis changed the proof-model coordinate while retaining a practical Schnorr protocol shape."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2023-OLAF-PROOF-WITHOUT-AGM","keywords":["schnorr","frost","dkg","aomdl","random-oracle","proof-model","schnorr_nonce_protocols","proof_models_and_assumptions","security_result"],"limitations":["Removing AGM does not yield a standard-model proof from plain discrete log."],"paper_id":"TSIG-PAPER-2023-OLAF","qualifiers":["AOMDL assumption and random-oracle model remain explicit."],"source_locator":{"dossier_section":"TSIG-PAPER-2023-OLAF § Atomic claims and Evidence locator","primary_source":"ePrint 2023/899, abstract and proof overview.","primary_source_url":"https://eprint.iacr.org/2023/899","status":"section_checked"},"statement":"Olaf combines a FROST variant with Pedersen-style DKG and proves unforgeability without the algebraic group model under AOMDL in the random-oracle model.","statement_status":"source_normalized_statement","status":"published","title":"FROST-style threshold Schnorr proof without the algebraic group model","work_id":"TSIG-PAPER-2023-OLAF"},"primaryUrl":"https://eprint.iacr.org/2023/899","sections":[],"slug":"cgrs23-frost-proof-without-agm","status":"published","subtitle":"Practical Schnorr Threshold Signatures Without the Algebraic Group Model","summary":"Olaf combines a FROST variant with Pedersen-style DKG and proves unforgeability without the algebraic group model under AOMDL in the random-oracle model.","title":"FROST-style threshold Schnorr proof without the algebraic group model","type":"result","venue":"CRYPTO 2023","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2023-OLAF-PROOF-WITHOUT-AGM"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-TANG-FUNCTIONAL-INTERCHANGEABILITY","keywords":["atomic-result","lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive","threshold_package_interfaces","interoperable_output_and_evaluation","post_quantum_thresholding","capability_result"],"metadata":{"claim_slug":"functional-interchangeability","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["interoperable_output_and_evaluation","post_quantum_thresholding"],"technical_thread":["threshold_package_interfaces"]},"historical_context":{"narrative":"Post-quantum threshold proposals frequently changed the verifier interface or lacked a package joining arbitrary quorums, implementation evidence, and long-lived share management. Tang and coauthors targeted functional interchangeability with an ordinary lattice signature, implemented t-out-of-n signing, and added proactive refresh. Their specialized MPC and rejection-sampling route therefore spans capability and realization. Section 5 states that DSign outputs a signature accepted by the conventional Section 4 verifier, with public-key and signature sizes independent of the participant count. The capability is relative to the paper's base signature and is not an ML-DSA interoperability claim.","prior_boundary":"Threshold post-quantum schemes often changed the verification interface or lacked a package combining arbitrary thresholds, implementation evidence, and refresh.","significance_at_publication":"Tang et al. targeted functional interchangeability with the ordinary signature, implemented t-out-of-n signing, and added proactive refresh through specialized MPC.","technical_delta":"Functional interchangeability made thresholdization invisible to relying-party verification rather than defining a separate threshold format."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-TANG-FUNCTIONAL-INTERCHANGEABILITY","keywords":["lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive","threshold_package_interfaces","interoperable_output_and_evaluation","post_quantum_thresholding","capability_result"],"limitations":["This base-scheme interchangeability does not imply byte-for-byte compatibility with ML-DSA."],"paper_id":"TSIG-PAPER-2024-TANG","qualifiers":["Interchangeability is with the paper's selected base construction and package."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-TANG § Atomic claims and Evidence locator","primary_source":"ePrint 2024/1067, Section 1.1 (PDF p. 4) and Section 5 DSign interface (PDF pp. 12–17).","primary_source_url":"https://eprint.iacr.org/2024/1067","status":"section_checked"},"statement":"Tang et al. design threshold lattice signatures whose combined output is accepted through the corresponding ordinary-signature verification interface.","statement_status":"source_normalized_statement","status":"published","title":"Threshold lattice signing with ordinary-verifier interchangeability","work_id":"TSIG-PAPER-2024-TANG"},"primaryUrl":"https://doi.org/10.1109/TIFS.2023.3293408","sections":[],"slug":"tpcz23-ordinary-verifier-lattice-th","status":"published","subtitle":"Efficient Lattice-Based Threshold Signatures with Functional Interchangeability","summary":"Tang et al. design threshold lattice signatures whose combined output is accepted through the corresponding ordinary-signature verification interface.","title":"Threshold lattice signing with ordinary-verifier interchangeability","type":"result","venue":"IEEE Transactions on Information Forensics and Security 18, 4173–4187","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-TANG-FUNCTIONAL-INTERCHANGEABILITY"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-TANG-IMPLEMENTED-T-OUT-OF-N-LATTICE-SIGNATURE","keywords":["atomic-result","lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive","threshold_package_interfaces","interoperable_output_and_evaluation","post_quantum_thresholding","implementation_result"],"metadata":{"claim_slug":"implemented-t-out-of-n-lattice-signature","contribution_kind":"implementation_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["interoperable_output_and_evaluation","post_quantum_thresholding"],"technical_thread":["threshold_package_interfaces"]},"historical_context":{"narrative":"Post-quantum threshold proposals frequently changed the verifier interface or lacked a package joining arbitrary quorums, implementation evidence, and long-lived share management. Tang and coauthors targeted functional interchangeability with an ordinary lattice signature, implemented t-out-of-n signing, and added proactive refresh. Their specialized MPC and rejection-sampling route therefore spans capability and realization. Under Table 4's 123-classical/112-quantum-bit parameters, Table 3 reports 15 online rounds and 1.417 MB sent per party; Table 5 reports 0.5-second two-party LAN signing. These measurements establish executable feasibility in the paper's MP-SPDZ-derived environment, not a normalized cross-paper ranking.","prior_boundary":"Threshold post-quantum schemes often changed the verification interface or lacked a package combining arbitrary thresholds, implementation evidence, and refresh.","significance_at_publication":"Tang et al. targeted functional interchangeability with the ordinary signature, implemented t-out-of-n signing, and added proactive refresh through specialized MPC.","technical_delta":"The artifact moved functional interchangeability from a theorem-level property to an executable protocol instance."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-TANG-IMPLEMENTED-T-OUT-OF-N-LATTICE-SIGNATURE","keywords":["lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive","threshold_package_interfaces","interoperable_output_and_evaluation","post_quantum_thresholding","implementation_result"],"limitations":["Implementation existence is not a normalized performance ranking."],"paper_id":"TSIG-PAPER-2024-TANG","qualifiers":["Artifact version and benchmark context remain paper-specific."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-TANG § Atomic claims and Evidence locator","primary_source":"ePrint 2024/1067, Section 7, Tables 3–7 and Figures 2–3 (PDF pp. 21–27).","primary_source_url":"https://eprint.iacr.org/2024/1067","status":"section_checked"},"statement":"Tang et al. implement arbitrary-threshold lattice signing and report a 15-round, 1.417 MB-per-party online profile with 0.5-second LAN signing for two parties under their stated parameters.","statement_status":"source_normalized_statement","status":"published","title":"Implemented t-out-of-n lattice threshold signing","work_id":"TSIG-PAPER-2024-TANG"},"primaryUrl":"https://doi.org/10.1109/TIFS.2023.3293408","sections":[],"slug":"tpcz23-implemented-t-out-of","status":"published","subtitle":"Efficient Lattice-Based Threshold Signatures with Functional Interchangeability","summary":"Tang et al. implement arbitrary-threshold lattice signing and report a 15-round, 1.417 MB-per-party online profile with 0.5-second LAN signing for two parties under their stated parameters.","title":"Implemented t-out-of-n lattice threshold signing","type":"result","venue":"IEEE Transactions on Information Forensics and Security 18, 4173–4187","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-TANG-IMPLEMENTED-T-OUT-OF-N-LATTICE-SIGNATURE"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-TANG-PROACTIVE-REFRESH","keywords":["atomic-result","lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive","threshold_package_interfaces","proactive_refresh","capability_result"],"metadata":{"claim_slug":"proactive-refresh","contribution_kind":"capability_result","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["proactive_refresh"],"technical_thread":["threshold_package_interfaces"]},"historical_context":{"narrative":"Post-quantum threshold proposals frequently changed the verifier interface or lacked a package joining arbitrary quorums, implementation evidence, and long-lived share management. Tang and coauthors targeted functional interchangeability with an ordinary lattice signature, implemented t-out-of-n signing, and added proactive refresh. Their specialized MPC and rejection-sampling route therefore spans capability and realization. Definition 3 models a mobile adversary and Theorem 2 proves proactive security when at most \\( t-1 \\) parties are corrupted in each period between refreshes. The lifecycle node isolates renewal of lattice key shares while the public key remains stable; it does not cover threshold compromise within one period.","prior_boundary":"Threshold post-quantum schemes often changed the verification interface or lacked a package combining arbitrary thresholds, implementation evidence, and refresh.","significance_at_publication":"Tang et al. targeted functional interchangeability with the ordinary signature, implemented t-out-of-n signing, and added proactive refresh through specialized MPC.","technical_delta":"The capability extended the lifetime security model of the post-quantum threshold package across epochs."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-TANG-PROACTIVE-REFRESH","keywords":["lattice","t-out-of-n","mpc","rejection-sampling","interchangeable-output","proactive","threshold_package_interfaces","proactive_refresh","capability_result"],"limitations":["Refresh does not repair a key already compromised beyond the modeled threshold within one epoch."],"paper_id":"TSIG-PAPER-2024-TANG","qualifiers":["Refresh security depends on epoch separation and the paper's corruption model."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-TANG § Atomic claims and Evidence locator","primary_source":"ePrint 2024/1067, Section 5.1, Definition 3 (PDF pp. 13–14), and Section 6, Theorem 2 (PDF pp. 17–18).","primary_source_url":"https://eprint.iacr.org/2024/1067","status":"theorem_checked"},"statement":"The Tang et al. package refreshes distributed lattice signing shares while preserving the public verification key and threshold functionality.","statement_status":"source_normalized_statement","status":"published","title":"Proactive refresh for lattice threshold-signature shares","work_id":"TSIG-PAPER-2024-TANG"},"primaryUrl":"https://doi.org/10.1109/TIFS.2023.3293408","sections":[],"slug":"tpcz23-proactive-lattice-share-refr","status":"published","subtitle":"Efficient Lattice-Based Threshold Signatures with Functional Interchangeability","summary":"The Tang et al. package refreshes distributed lattice signing shares while preserving the public verification key and threshold functionality.","title":"Proactive refresh for lattice threshold-signature shares","type":"result","venue":"IEEE Transactions on Information Forensics and Security 18, 4173–4187","year":2023,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-TANG-PROACTIVE-REFRESH"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-AOMMLWE-OFFLINE-ONLINE-SIGNING","keywords":["atomic-result","lattice","aom-mlwe","two-round","offline-online","large-threshold","lattice_fswa_threshold","round_efficient_robust_signing","optimization"],"metadata":{"claim_slug":"offline-online-signing","contribution_kind":"optimization","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["round_efficient_robust_signing"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Arbitrary-threshold lattice protocols used threshold homomorphic encryption or heavy commitment machinery to contain distributed response leakage. The AOM-MLWE construction replaced those components with a new algebraic one-more lattice assumption and a two-round protocol. Its first phase can be prepared before either the message or signer subset is known, creating a useful offline/online boundary while introducing a less standard assumption. The optimization node isolates preprocessing that is independent of both message and eventual signer set. The complete protocol still has two phases when offline work is counted.","prior_boundary":"Arbitrary-threshold lattice signatures used threshold homomorphic encryption or heavy commitment machinery to control distributed response leakage.","significance_at_publication":"The AOM-MLWE route achieved a two-round protocol with an offline message- and signer-set-independent phase without FHE, at the cost of a new algebraic one-more assumption.","technical_delta":"The optimization made preprocessing reusable across late-bound message and signer-set choices."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-AOMMLWE-OFFLINE-ONLINE-SIGNING","keywords":["lattice","aom-mlwe","two-round","offline-online","large-threshold","lattice_fswa_threshold","round_efficient_robust_signing","optimization"],"limitations":["Two rounds still count when the offline phase is included."],"paper_id":"TSIG-PAPER-2024-AOMMLWE","qualifiers":["Offline material and reuse rules follow the exact protocol."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-AOMMLWE § Atomic claims and Evidence locator","primary_source":"ePrint 2024/496 final author revision, Sections 2.1 and 6.1, Figures 2 and 8 (PDF pp. 8–10 and 33–35), plus Table 3 (PDF p. 58).","primary_source_url":"https://eprint.iacr.org/2024/496","status":"section_checked"},"statement":"The first AOM-MLWE signing round can be computed before the message and participating signer set are known, leaving a short online completion phase.","statement_status":"source_normalized_statement","status":"published","title":"Signer-set-independent offline phase for two-round lattice signing","work_id":"TSIG-PAPER-2024-AOMMLWE"},"primaryUrl":"https://eprint.iacr.org/2024/496","sections":[],"slug":"ekt24-signer-independent-offline-l","status":"published","subtitle":"Two-Round Threshold Signature from Algebraic One-More Learning with Errors","summary":"The first AOM-MLWE signing round can be computed before the message and participating signer set are known, leaving a short online completion phase.","title":"Signer-set-independent offline phase for two-round lattice signing","type":"result","venue":"CRYPTO 2024; Journal of Cryptology revision","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-AOMMLWE-OFFLINE-ONLINE-SIGNING"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-AOMMLWE-TWO-ROUND-LATTICE-THRESHOLD-WITHOUT-FHE","keywords":["atomic-result","lattice","aom-mlwe","two-round","offline-online","large-threshold","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","construction"],"metadata":{"claim_slug":"two-round-lattice-threshold-without-fhe","contribution_kind":"construction","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding","round_efficient_robust_signing"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Arbitrary-threshold lattice protocols used threshold homomorphic encryption or heavy commitment machinery to contain distributed response leakage. The AOM-MLWE construction replaced those components with a new algebraic one-more lattice assumption and a two-round protocol. Its first phase can be prepared before either the message or signer subset is known, creating a useful offline/online boundary while introducing a less standard assumption. The construction node records the two-round, no-FHE route to threshold lattice signing. Avoiding FHE should not be confused with relying only on standard MLWE, because AOM-MLWE is central.","prior_boundary":"Arbitrary-threshold lattice signatures used threshold homomorphic encryption or heavy commitment machinery to control distributed response leakage.","significance_at_publication":"The AOM-MLWE route achieved a two-round protocol with an offline message- and signer-set-independent phase without FHE, at the cost of a new algebraic one-more assumption.","technical_delta":"A new algebraic one-more LWE route replaced the heavier homomorphic components of earlier arbitrary-threshold constructions."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-AOMMLWE-TWO-ROUND-LATTICE-THRESHOLD-WITHOUT-FHE","keywords":["lattice","aom-mlwe","two-round","offline-online","large-threshold","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","construction"],"limitations":["Avoiding FHE does not mean relying only on standard MLWE, and the remaining adaptive-versus-selective assumption gap is explicit."],"paper_id":"TSIG-PAPER-2024-AOMMLWE","qualifiers":["Threshold unforgeability relies on adaptive AOM-MLWE, while Theorem 4.5 reduces only the selective AOM-UMLWE variant to UMLWE and MSIS."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-AOMMLWE § Atomic claims and Evidence locator","primary_source":"ePrint 2024/496 final author revision, Section 6.1, Figure 8, Theorem 6.1 (PDF pp. 33–36), and Theorem 4.5 (PDF pp. 27–32).","primary_source_url":"https://eprint.iacr.org/2024/496","status":"theorem_checked"},"statement":"The AOM-MLWE construction obtains two-round threshold lattice signing without fully homomorphic encryption or homomorphic trapdoor commitments.","statement_status":"source_normalized_statement","status":"published","title":"Two-round lattice threshold signatures without FHE","work_id":"TSIG-PAPER-2024-AOMMLWE"},"primaryUrl":"https://eprint.iacr.org/2024/496","sections":[],"slug":"ekt24-two-round-lattice-signing","status":"published","subtitle":"Two-Round Threshold Signature from Algebraic One-More Learning with Errors","summary":"The AOM-MLWE construction obtains two-round threshold lattice signing without fully homomorphic encryption or homomorphic trapdoor commitments.","title":"Two-round lattice threshold signatures without FHE","type":"result","venue":"CRYPTO 2024; Journal of Cryptology revision","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-AOMMLWE-TWO-ROUND-LATTICE-THRESHOLD-WITHOUT-FHE"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2024-FLOOD-FIRST-HASH-AND-SIGN-LATTICE-THRESHOLD-SIGNATURE","keywords":["atomic-result","lattice","hash-and-sign","mlwe","robust-dkg","noise-flooding","random-submersion","lattice_hash_sign_threshold","post_quantum_thresholding","construction"],"metadata":{"claim_slug":"first-hash-and-sign-lattice-threshold-signature","contribution_kind":"construction","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding"],"technical_thread":["lattice_hash_sign_threshold"]},"historical_context":{"narrative":"Most efficient threshold lattice signatures followed the Fiat–Shamir-with-aborts family, whereas GPV-style hash-and-sign lacked robust distributed tools for short trapdoor secrets. Flood and Submerse opened that second route through random submersions, verifiable short sharing, robust key generation, and noise flooding. The work broadened the mechanism landscape without claiming a generic compiler for every lattice signature. The construction node captures robust GPV-style threshold hash-and-sign as a distinct lineage. Its assumptions and distributed trapdoor procedures do not automatically threshold every related lattice scheme.","prior_boundary":"Efficient threshold lattice signatures largely followed abort-based Fiat–Shamir designs, while GPV-style hash-and-sign lacked robust distributed short-secret machinery.","significance_at_publication":"Flood and Submerse created a separate hash-and-sign lineage using random submersions, verifiable short sharing, and noise flooding.","technical_delta":"The result opened a threshold lattice lineage distinct from Fiat–Shamir-with-aborts constructions."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-FLOOD-FIRST-HASH-AND-SIGN-LATTICE-THRESHOLD-SIGNATURE","keywords":["lattice","hash-and-sign","mlwe","robust-dkg","noise-flooding","random-submersion","lattice_hash_sign_threshold","post_quantum_thresholding","construction"],"limitations":["The paper does not claim to threshold every lattice hash-and-sign scheme generically."],"paper_id":"TSIG-PAPER-2024-FLOOD","qualifiers":["Hash-and-sign assumptions, DKG, and noise-flooding parameters are integral."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-FLOOD § Atomic claims and Evidence locator","primary_source":"ePrint 2024/959, abstract and framework overview.","primary_source_url":"https://eprint.iacr.org/2024/959","status":"section_checked"},"statement":"The Flood and Submerse work constructs a robust threshold signature from a GPV-style lattice hash-and-sign route using distributed short-secret machinery.","statement_status":"source_normalized_statement","status":"published","title":"Robust lattice threshold hash-and-sign","work_id":"TSIG-PAPER-2024-FLOOD"},"primaryUrl":"https://eprint.iacr.org/2024/959","sections":[],"slug":"enp24-robust-lattice-threshold-has","status":"published","subtitle":"Flood and Submerse: Distributed Key Generation and Robust Threshold Signature from Lattices","summary":"The Flood and Submerse work constructs a robust threshold signature from a GPV-style lattice hash-and-sign route using distributed short-secret machinery.","title":"Robust lattice threshold hash-and-sign","type":"result","venue":"CRYPTO 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-FLOOD-FIRST-HASH-AND-SIGN-LATTICE-THRESHOLD-SIGNATURE"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2024-FLOOD-RANDOM-SUBMERSIONS","keywords":["atomic-result","lattice","hash-and-sign","mlwe","robust-dkg","noise-flooding","random-submersion","lattice_hash_sign_threshold","post_quantum_thresholding","mechanism"],"metadata":{"claim_slug":"random-submersions","contribution_kind":"mechanism","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding"],"technical_thread":["lattice_hash_sign_threshold"]},"historical_context":{"narrative":"Most efficient threshold lattice signatures followed the Fiat–Shamir-with-aborts family, whereas GPV-style hash-and-sign lacked robust distributed tools for short trapdoor secrets. Flood and Submerse opened that second route through random submersions, verifiable short sharing, robust key generation, and noise flooding. The work broadened the mechanism landscape without claiming a generic compiler for every lattice signature. The component node records random submersions as a way to verify and reconstruct short shared secrets. Noise flooding and parameter constraints remain integral to its use.","prior_boundary":"Efficient threshold lattice signatures largely followed abort-based Fiat–Shamir designs, while GPV-style hash-and-sign lacked robust distributed short-secret machinery.","significance_at_publication":"Flood and Submerse created a separate hash-and-sign lineage using random submersions, verifiable short sharing, and noise flooding.","technical_delta":"The mechanism addressed the conflict between public verifiability and preserving the shortness needed for trapdoor sampling."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-FLOOD-RANDOM-SUBMERSIONS","keywords":["lattice","hash-and-sign","mlwe","robust-dkg","noise-flooding","random-submersion","lattice_hash_sign_threshold","post_quantum_thresholding","mechanism"],"limitations":["The component is not a complete DKG or signature by itself."],"paper_id":"TSIG-PAPER-2024-FLOOD","qualifiers":["Used with noise flooding and the paper's lattice parameter regime."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-FLOOD § Atomic claims and Evidence locator","primary_source":"ePrint 2024/959, abstract and framework overview.","primary_source_url":"https://eprint.iacr.org/2024/959","status":"section_checked"},"statement":"Random submersions support verifiable sharing and reconstruction of short lattice secrets used by the Flood and Submerse threshold hash-and-sign construction.","statement_status":"source_normalized_statement","status":"published","title":"Random submersions verify shares of short lattice secrets","work_id":"TSIG-PAPER-2024-FLOOD"},"primaryUrl":"https://eprint.iacr.org/2024/959","sections":[],"slug":"enp24-random-submersions-verify-sh","status":"published","subtitle":"Flood and Submerse: Distributed Key Generation and Robust Threshold Signature from Lattices","summary":"Random submersions support verifiable sharing and reconstruction of short lattice secrets used by the Flood and Submerse threshold hash-and-sign construction.","title":"Random submersions verify shares of short lattice secrets","type":"result","venue":"CRYPTO 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-FLOOD-RANDOM-SUBMERSIONS"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2024-GLACIUS-FULLY-ADAPTIVE-THRESHOLD-SCHNORR-FROM-DDH","keywords":["atomic-result","schnorr","ddh","adaptive-security","identifiable-abort","constant-size-signing-key","schnorr_nonce_protocols","adaptive_corruption_security","proof_models_and_assumptions","security_result"],"metadata":{"claim_slug":"fully-adaptive-threshold-schnorr-from-ddh","contribution_kind":"security_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["adaptive_corruption_security","proof_models_and_assumptions"],"technical_thread":["schnorr_nonce_protocols"]},"historical_context":{"narrative":"Efficient threshold Schnorr protocols mainly addressed static corruption or relied on specialized proof assumptions. Glacius targeted the stronger case in which the adversary chooses corruptions during execution. Under the paper's model, it obtained full adaptive security from DDH in the random-oracle model while keeping constant-size signing keys and adding identifiable abort. The result strengthens corruption timing without becoming a plain-model proof. The security record isolates adaptive corruption tolerance from DDH together with identifiable abort. Its exact claim still depends on the paper's full-threshold convention and random-oracle proof.","prior_boundary":"Practical threshold Schnorr protocols mainly treated static corruption or used stronger proof-model assumptions, leaving full adaptive security from a standard group assumption unresolved.","significance_at_publication":"Glacius reached full adaptive security from DDH in the random-oracle model while retaining compact Schnorr output and identifiable abort.","technical_delta":"The result strengthened the corruption-timing boundary without relying on the algebraic group model."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-GLACIUS-FULLY-ADAPTIVE-THRESHOLD-SCHNORR-FROM-DDH","keywords":["schnorr","ddh","adaptive-security","identifiable-abort","constant-size-signing-key","schnorr_nonce_protocols","adaptive_corruption_security","proof_models_and_assumptions","security_result"],"limitations":["The claim is not a plain-model proof."],"paper_id":"TSIG-PAPER-2024-GLACIUS","qualifiers":["Full adaptivity supports the paper's full threshold t<n and is proved from DDH in the random-oracle model."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-GLACIUS § Atomic claims and Evidence locator","primary_source":"ePrint 2024/1628, abstract and security-definition discussion.","primary_source_url":"https://eprint.iacr.org/2024/1628","status":"section_checked"},"statement":"Glacius proves threshold Schnorr secure against fully adaptive corruptions from DDH in the random-oracle model, with constant-size signing keys and identifiable abort.","statement_status":"source_normalized_statement","status":"published","title":"Fully adaptive threshold Schnorr from DDH","work_id":"TSIG-PAPER-2024-GLACIUS"},"primaryUrl":"https://eprint.iacr.org/2024/1628","sections":[],"slug":"bdlr24-fully-adaptive-ddh-threshold","status":"published","subtitle":"Glacius: Threshold Schnorr Signatures from DDH with Full Adaptive Security","summary":"Glacius proves threshold Schnorr secure against fully adaptive corruptions from DDH in the random-oracle model, with constant-size signing keys and identifiable abort.","title":"Fully adaptive threshold Schnorr from DDH","type":"result","venue":"EUROCRYPT 2025","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-GLACIUS-FULLY-ADAPTIVE-THRESHOLD-SCHNORR-FROM-DDH"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-RACCOON-EFFICIENT-LARGE-THRESHOLD-LATTICE-SIGNING","keywords":["atomic-result","lattice","module-lwe","module-sis","large-threshold","implementation","masks","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","optimization"],"metadata":{"claim_slug":"efficient-large-threshold-lattice-signing","contribution_kind":"optimization","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding","round_efficient_robust_signing"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Abort-aware lattice threshold signing often required costly homomorphic commitments and had limited evidence at large quorum sizes. Threshold Raccoon used pairwise one-time additive masks and comparatively simple lattice operations to protect partial signing material. Table 2 gives a 128-bit parameter set supporting T up to 1024 with a 3.9 KB verification key, 12.7 KB signature, and 40.8 KB transcript contribution per signer under its accounting. Table 3 measures all three ShareSign phases and reports per-signer computation at T=1024; the implementation section separately gives 40800+16T bytes when pairwise MACs are included. These are paper-specific scale measurements, not a cross-paper ranking.","prior_boundary":"Earlier abort-aware lattice threshold signing used costly homomorphic commitments or did not scale to large threshold sizes with practical communication.","significance_at_publication":"Threshold Raccoon replaced that machinery with one-time additive masks and reported a large-threshold performance point under standard lattice assumptions.","technical_delta":"The implementation-aware protocol moved the abort-based lattice line toward large committees using simple lattice operations."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-RACCOON-EFFICIENT-LARGE-THRESHOLD-LATTICE-SIGNING","keywords":["lattice","module-lwe","module-sis","large-threshold","implementation","masks","lattice_fswa_threshold","post_quantum_thresholding","round_efficient_robust_signing","optimization"],"limitations":["The parameter and implementation profiles are not normalized as cross-paper benchmarks."],"paper_id":"TSIG-PAPER-2024-RACCOON","qualifiers":["Concrete figures are reported for the paper's parameter and network profile."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-RACCOON § Atomic claims and Evidence locator","primary_source":"ePrint 2024/184, Section 8.3, Table 2, and Section 9, Table 3 (PDF pp. 43–44).","primary_source_url":"https://eprint.iacr.org/2024/184","status":"section_checked"},"statement":"Threshold Raccoon gives concrete 128-bit parameters up to threshold 1024 with a 3.9 KB verification key, 12.7 KB signature, and a three-round implementation profile.","statement_status":"source_normalized_statement","status":"published","title":"Lattice signing reported at threshold sizes up to 1024","work_id":"TSIG-PAPER-2024-RACCOON"},"primaryUrl":"https://eprint.iacr.org/2024/184","sections":[],"slug":"pkm24-three-round-lattice-signing","status":"published","subtitle":"Threshold Raccoon: Practical Threshold Signatures from Standard Lattice Assumptions","summary":"Threshold Raccoon gives concrete 128-bit parameters up to threshold 1024 with a 3.9 KB verification key, 12.7 KB signature, and a three-round implementation profile.","title":"Lattice signing reported at threshold sizes up to 1024","type":"result","venue":"EUROCRYPT 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-RACCOON-EFFICIENT-LARGE-THRESHOLD-LATTICE-SIGNING"},{"evidence":"fulltext_checked","id":"TSIG-RESULT-2024-RACCOON-ONE-TIME-ADDITIVE-MASK-DEFENSE","keywords":["atomic-result","lattice","module-lwe","module-sis","large-threshold","implementation","masks","lattice_fswa_threshold","post_quantum_thresholding","abort_leakage_security","attack_or_repair"],"metadata":{"claim_slug":"one-time-additive-mask-defense","contribution_kind":"attack_or_repair","dossier_type":"contribution","evidence":"fulltext_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["post_quantum_thresholding","abort_leakage_security"],"technical_thread":["lattice_fswa_threshold"]},"historical_context":{"narrative":"Abort-aware lattice threshold signing often required costly homomorphic commitments and had limited evidence at large quorum sizes. Threshold Raccoon uses pairwise one-time additive masks, derived non-interactively from pairwise PRF seeds and a unique session identifier, to hide response shares while allowing the masks to cancel under aggregation. Section 2.3 and Figure 5 make session uniqueness and retained state explicit. The repair is protocol-specific: it requires unique session identifiers, and the paper leaves stateless signing, robustness, and identifiable abort as future work.","prior_boundary":"Earlier abort-aware lattice threshold signing used costly homomorphic commitments or did not scale to large threshold sizes with practical communication.","significance_at_publication":"Threshold Raccoon replaced that machinery with one-time additive masks and reported a large-threshold performance point under standard lattice assumptions.","technical_delta":"The defense replaced heavier homomorphic-commitment machinery with a protocol-specific masking discipline."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2024-RACCOON-ONE-TIME-ADDITIVE-MASK-DEFENSE","keywords":["lattice","module-lwe","module-sis","large-threshold","implementation","masks","lattice_fswa_threshold","post_quantum_thresholding","abort_leakage_security","attack_or_repair"],"limitations":["This protocol-specific masking record does not generalize to every lattice threshold signature."],"paper_id":"TSIG-PAPER-2024-RACCOON","qualifiers":["Unique session identifiers and non-reuse of PRF-derived masks are security-critical."],"source_locator":{"dossier_section":"TSIG-PAPER-2024-RACCOON § Atomic claims and Evidence locator","primary_source":"ePrint 2024/184, Sections 2.2–2.4 (PDF pp. 8–10), Sections 6.1–6.2, Figure 5 (PDF pp. 20–23), and Remark 6.1.","primary_source_url":"https://eprint.iacr.org/2024/184","status":"section_checked"},"statement":"Threshold Raccoon uses fresh additive masks to prevent repeated partial-signature and abort information from accumulating against a participant's lattice secret.","statement_status":"source_normalized_statement","status":"published","title":"One-time additive masks protect partial lattice signing keys","work_id":"TSIG-PAPER-2024-RACCOON"},"primaryUrl":"https://eprint.iacr.org/2024/184","sections":[],"slug":"pkm24-additive-mask-abort-leakage","status":"published","subtitle":"Threshold Raccoon: Practical Threshold Signatures from Standard Lattice Assumptions","summary":"Threshold Raccoon uses fresh additive masks to prevent repeated partial-signature and abort information from accumulating against a participant's lattice secret.","title":"One-time additive masks protect partial lattice signing keys","type":"result","venue":"EUROCRYPT 2024","year":2024,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2024-RACCOON-ONE-TIME-ADDITIVE-MASK-DEFENSE"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2026-NIST8214C-INTEROPERABLE-OUTPUT-EMPHASIS","keywords":["atomic-result","nist","standardization","threshold","evaluation","interoperability","threshold_package_interfaces","interoperable_output_and_evaluation","standardization_result"],"metadata":{"claim_slug":"interoperable-output-emphasis","contribution_kind":"standardization_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["interoperable_output_and_evaluation"],"technical_thread":["threshold_package_interfaces"]},"historical_context":{"narrative":"Threshold proposals often described compatibility informally, leaving unclear whether a combined output could be consumed by the same subsequent operation as the ordinary primitive. NIST IR 8214C makes this functional interchangeability part of the call's package contract. For signatures, the relevant question is whether the threshold output can be used through the reference verification operation under the declared interface. This is an eligibility and evaluation coordinate, not a new cryptographic construction. Two interchangeable packages may still differ in setup, corruption model, abort behavior, performance, and assumptions, so interface compatibility must not be read as overall equivalence.","prior_boundary":"Threshold constructions were compared paper by paper, without a common package contract connecting specifications, implementations, interfaces, and evaluation artifacts.","significance_at_publication":"It gave ordinary-verifier compatibility a precise place in the submission and evaluation process without turning that property into a security or performance ranking.","technical_delta":"The call made interchangeability with a designated reference operation an explicit package coordinate instead of an informal deployment preference."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2026-NIST8214C-INTEROPERABLE-OUTPUT-EMPHASIS","keywords":["nist","standardization","threshold","evaluation","interoperability","threshold_package_interfaces","interoperable_output_and_evaluation","standardization_result"],"limitations":["Interface compatibility does not make protocols security- or performance-equivalent."],"paper_id":"TSIG-PAPER-2026-NIST8214C","qualifiers":["This is a requirement of the public call, not a claim that a submitted scheme has been selected or standardized."],"source_locator":{"dossier_section":"TSIG-PAPER-2026-NIST8214C § Atomic claims and Evidence locator","primary_source":"NIST publication page and final report package requirements.","primary_source_url":"https://csrc.nist.gov/pubs/ir/8214/c/final","status":"section_checked"},"statement":"NIST IR 8214C requires submitted threshold schemes to specify how their outputs are interchangeable with a reference non-threshold primitive in the subsequent operation.","statement_status":"source_normalized_statement","status":"published","title":"Functional interchangeability as a threshold-call eligibility coordinate","work_id":"TSIG-PAPER-2026-NIST8214C"},"primaryUrl":"https://csrc.nist.gov/pubs/ir/8214/c/final","sections":[],"slug":"nist26-functional-interchangeabilit","status":"published","subtitle":"NIST First Call for Multi-Party Threshold Schemes","summary":"NIST IR 8214C requires submitted threshold schemes to specify how their outputs are interchangeable with a reference non-threshold primitive in the subsequent operation.","title":"Functional interchangeability as a threshold-call eligibility coordinate","type":"result","venue":"NIST Interagency/Internal Report","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2026-NIST8214C-INTEROPERABLE-OUTPUT-EMPHASIS"},{"evidence":"primary_source_checked","id":"TSIG-RESULT-2026-NIST8214C-NIST-THRESHOLD-CRYPTOGRAPHY-PACKAGE-FRAMEWORK","keywords":["atomic-result","nist","standardization","threshold","evaluation","interoperability","threshold_package_interfaces","interoperable_output_and_evaluation","standardization_result"],"metadata":{"claim_slug":"nist-threshold-cryptography-package-framework","contribution_kind":"standardization_result","dossier_type":"contribution","evidence":"primary_source_checked","facet_status":"normalized_for_research_map","facets":{"problem_lens":["interoperable_output_and_evaluation"],"technical_thread":["threshold_package_interfaces"]},"historical_context":{"narrative":"Threshold schemes had usually been presented as papers or isolated implementations, without a common package contract joining interfaces, specifications, reference code, and experimental evidence. NIST IR 8214C changed the process by issuing a public call whose submissions must contain a technical specification, a reference implementation, and an evaluation report. The contribution is procedural and architectural rather than a new signing theorem. It creates an assessable unit for later public analysis, but it neither approves existing constructions nor standardizes every scheme that enters the process. Technical originality remains attributable to each submitted protocol and its source papers.","prior_boundary":"Threshold constructions were compared paper by paper, without a common package contract connecting specifications, implementations, interfaces, and evaluation artifacts.","significance_at_publication":"It shifted NIST's threshold effort from general criteria toward a public collection and analysis process for assessable scheme packages.","technical_delta":"The call made a technical specification, reference implementation, and experimental-evaluation report the required parts of one submission package."},"historical_context_status":"curator_synthesis","id":"TSIG-RESULT-2026-NIST8214C-NIST-THRESHOLD-CRYPTOGRAPHY-PACKAGE-FRAMEWORK","keywords":["nist","standardization","threshold","evaluation","interoperability","threshold_package_interfaces","interoperable_output_and_evaluation","standardization_result"],"limitations":["The report is not itself a threshold-signature security proof."],"paper_id":"TSIG-PAPER-2026-NIST8214C","qualifiers":["Evaluation framework rather than an approval of every referenced construction."],"source_locator":{"dossier_section":"TSIG-PAPER-2026-NIST8214C § Atomic claims and Evidence locator","primary_source":"NIST publication page and final report package requirements.","primary_source_url":"https://csrc.nist.gov/pubs/ir/8214/c/final","status":"section_checked"},"statement":"NIST IR 8214C calls for threshold-scheme packages containing a technical specification, reference implementation, and experimental-evaluation report.","statement_status":"source_normalized_statement","status":"published","title":"NIST call requirements for threshold-scheme submission packages","work_id":"TSIG-PAPER-2026-NIST8214C"},"primaryUrl":"https://csrc.nist.gov/pubs/ir/8214/c/final","sections":[],"slug":"nist26-nist-call-requirements-for","status":"published","subtitle":"NIST First Call for Multi-Party Threshold Schemes","summary":"NIST IR 8214C calls for threshold-scheme packages containing a technical specification, reference implementation, and experimental-evaluation report.","title":"NIST call requirements for threshold-scheme submission packages","type":"result","venue":"NIST Interagency/Internal Report","year":2026,"sourcePath":"data/threshold-signature-catalog.json#TSIG-RESULT-2026-NIST8214C-NIST-THRESHOLD-CRYPTOGRAPHY-PACKAGE-FRAMEWORK"},{"evidence":"source_grounded_route","id":"TSIG-ROUTE-001","keywords":[],"metadata":{"current_bottleneck":"General t-out-of-n sharing, rejection probability, output interoperability, robustness, and proof assumptions move differently across the constructions.","dossier_type":"route","entry_results":["TSIG-PAPER-2021-DOTT","TSIG-PAPER-2022-DILIZIUM2","TSIG-PAPER-2024-RACCOON","TSIG-PAPER-2024-TANG"],"evidence":"source_grounded_route","falsifiable_next_test":"Fix one ML-DSA parameter set and signer matrix, then account for every setup, presigning, online, abort, refresh, and verification byte while testing whether the output passes the unmodified ML-DSA verifier.","id":"TSIG-ROUTE-001","mechanism":"Distribute the linear lattice response while hiding signer-dependent abort and rejection information through commitments, masks, or a jointly sampled response distribution.","status":"proposed","targets":["TSIG-OP-001"],"title":"Distributed Fiat-Shamir-with-aborts with explicit leakage control"},"primaryUrl":null,"sections":[{"content":"Sharing a Dilithium-like linear equation does not by itself give ML-DSA interoperability or a secure distributed rejection sampler.","heading":"Route boundary"}],"slug":"distributed-fiat-shamir-with","status":"proposed","subtitle":"","summary":"Sharing a Dilithium-like linear equation does not by itself give ML-DSA interoperability or a secure distributed rejection sampler.","title":"Distributed Fiat-Shamir-with-aborts with explicit leakage control","type":"route","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-ROUTE-001"},{"evidence":"source_grounded_route","id":"TSIG-ROUTE-002","keywords":[],"metadata":{"current_bottleneck":"Ciphertexts, proofs, and DKG make the route heavier than direct masked signing, and the resulting signature is not automatically a standardized scheme output.","dossier_type":"route","entry_results":["TSIG-PAPER-2023-GKS"],"evidence":"source_grounded_route","falsifiable_next_test":"Implement the same t-out-of-n parameter matrix as the direct-masking route and compare total DKG, proof, ciphertext, online, and recovery costs under identical active-security semantics.","id":"TSIG-ROUTE-002","mechanism":"Keep the signing secret protected under actively secure threshold linearly homomorphic encryption so the parties can form a correctly distributed short response at arbitrary threshold.","status":"active","targets":["TSIG-OP-001"],"title":"Threshold homomorphic encryption for short-share handling"},"primaryUrl":null,"sections":[{"content":"This route uses a specialized threshold linear-HE layer; it does not require evaluating the entire signing circuit with generic FHE.","heading":"Route boundary"}],"slug":"threshold-homomorphic-encryp","status":"active","subtitle":"","summary":"This route uses a specialized threshold linear-HE layer; it does not require evaluating the entire signing circuit with generic FHE.","title":"Threshold homomorphic encryption for short-share handling","type":"route","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-ROUTE-002"},{"evidence":"source_grounded_route","id":"TSIG-ROUTE-003","keywords":[],"metadata":{"current_bottleneck":"The route has scheme-specific verification and concrete signature/communication costs; interoperability with an existing standardized hash-and-sign verifier is not inherited.","dossier_type":"route","entry_results":["TSIG-PAPER-2024-FLOOD"],"evidence":"source_grounded_route","falsifiable_next_test":"Instantiate a fixed threshold matrix, reproduce DKG and signing failures, and compare total bytes and robustness against both the FSwA and threshold-HE routes.","id":"TSIG-ROUTE-003","mechanism":"Use random submersions and noise flooding to share and verify short trapdoor-related secrets, then run a distributed hash-and-sign protocol with robust DKG.","status":"active","targets":[],"title":"Verifiable short secret sharing for lattice hash-and-sign"},"primaryUrl":null,"sections":[{"content":"Hash-and-sign here refers to a lattice trapdoor/preimage paradigm, not the stateless hash-only SLH-DSA family.","heading":"Route boundary"}],"slug":"verifiable-short-secret-shar","status":"active","subtitle":"","summary":"Hash-and-sign here refers to a lattice trapdoor/preimage paradigm, not the stateless hash-only SLH-DSA family.","title":"Verifiable short secret sharing for lattice hash-and-sign","type":"route","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#TSIG-ROUTE-003"},{"evidence":"registry","id":"ASM-AOM-MLWE","keywords":["lattice","interactive"],"metadata":{"aliases":["lattice_one_more"],"falsifiable":true,"family":"lattice","id":"ASM-AOM-MLWE","implied_by":[],"implied_by_records":[],"implies":[],"implies_records":[],"introduced_in":{"citation":"Thomas Espitau, Shuichi Katsumata, Kaoru Takemure, Two-Round Threshold Signature from Algebraic One-More Learning with Errors, CRYPTO 2024","url":"https://eprint.iacr.org/2024/496"},"kind":"interactive","name":"Algebraic one-more Module-LWE (AOM-MLWE)","post_quantum":true,"references":[{"citation":"Thomas Espitau, Shuichi Katsumata, Kaoru Takemure, Two-Round Threshold Signature from Algebraic One-More Learning with Errors, CRYPTO 2024; J. Cryptology 2025","url":"https://eprint.iacr.org/2024/496"},{"citation":"Chenzhi Zhu and Stefano Tessaro, The Algebraic One-More MISIS Problem and Applications to Threshold Signatures, CRYPTO 2025","url":"https://eprint.iacr.org/2025/436"}],"status":"As of 2026-10-10 the adaptive form of AOM-MLWE used for threshold unforgeability is implied by Module-SIS and Module-LWE together (Zhu and Tessaro, CRYPTO 2025), closing the gap left by the introducing paper, which reduced only a selective form; no attack is known."},"primaryUrl":"https://eprint.iacr.org/2024/496","sections":[{"content":"The instance is a uniform matrix \\( A \\) over \\( R_q \\) and\n\\( T = [\\, t_0 \\mid \\cdots \\mid t_Q \\,] = A S \\) for a secret matrix \\( S \\)\nwith short entries, so each column of \\( T \\) is a Module-LWE-type sample with\nthe error folded into \\( S \\). The adversary may make \\( Q \\) algebraic queries:\nit submits a vector \\( b_i \\) and receives\n\n\\[\nz_i = S \\cdot b_i ,\n\\]\n\nsubject to the restriction that the query vectors lie in a prescribed set of\naccepted linear combinations (in the threshold signature, those arising from\nsigning sessions). It wins by outputting a short \\( S' \\) with\n\\( A S' = T \\), i.e. by solving one more instance than its queries trivially\nallow. In the selective variant all queries are fixed in advance; in the\nadaptive variant they are chosen online.","heading":"Definition"},{"content":"Espitau, Katsumata and Takemure (`TSIG-PAPER-2024-AOMMLWE`) reduced selective\nAOM-MLWE, for specific sets of accepted combinations, to Module-LWE and\nModule-SIS, and proved their two-round threshold signature unforgeable under\nthe adaptive variant, for which they gave only a cryptanalytic argument. Zhu\nand Tessaro (2025) introduced the related AOM-MISIS problem, proved it hard\nunder Module-SIS and Module-LWE for suitable parameters, and noted that its\nhardness implies that of AOM-MLWE; they thereby re-proved the threshold scheme\nsecure under Module-LWE and Module-SIS, in the strongest unforgeability notion\nof the Bellare et al. hierarchy.","heading":"Status"},{"content":"AOM-MLWE is a lattice analogue of one-more discrete-log assumptions\n(One-more discrete logarithm (OMDL), ASM-AOMDL). Its hardness follows from Module-LWE (ASM-MLWE) and\nModule-SIS (ASM-MSIS) jointly, by the 2025 result; because the implication\nneeds both assumptions at once, AOM-MLWE is not known to follow from either\none alone.","heading":"Relations"}],"slug":"aom-mlwe","status":"registry","subtitle":"lattice","summary":"The instance is a uniform matrix \\( A \\) over \\( R_q \\) and \\( T = [\\, t_0 \\mid \\cdots \\mid t_Q \\,] = A S \\) for a secret matrix \\( S \\) with short entries, so each column of \\( T \\) is a Module-LWE-type sample with the error folded into \\( S \\).","tags":["lattice","interactive"],"title":"Algebraic one-more Module-LWE (AOM-MLWE)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-AOM-MLWE"},{"evidence":"registry","id":"ASM-AOMDL","keywords":["group","interactive"],"metadata":{"aliases":[],"falsifiable":true,"family":"group","id":"ASM-AOMDL","implied_by":["ASM-OMDL"],"implied_by_records":[{"id":"ASM-OMDL","name":"One-more discrete logarithm (OMDL)"}],"implies":["ASM-DLOG"],"implies_records":[{"id":"ASM-DLOG","name":"Discrete logarithm (DL)"}],"introduced_in":{"citation":"Jonas Nick, Tim Ruffing, Yannick Seurin, MuSig2: Simple Two-Round Schnorr Multi-signatures, CRYPTO 2021","url":"https://doi.org/10.1007/978-3-030-84242-0_8"},"kind":"interactive","name":"Algebraic one-more discrete logarithm (AOMDL)","post_quantum":false,"references":[{"citation":"Jonas Nick, Tim Ruffing, Yannick Seurin, MuSig2: Simple Two-Round Schnorr Multi-signatures, CRYPTO 2021 (ePrint 2020/1261)","url":"https://doi.org/10.1007/978-3-030-84242-0_8"},{"citation":"Hien Chu, Paul Gerhart, Tim Ruffing, Dominique Schröder, Practical Schnorr Threshold Signatures Without the Algebraic Group Model, CRYPTO 2023","url":"https://doi.org/10.1007/978-3-031-38557-5_24"}],"status":"As of 2026-10-10 AOMDL is implied by OMDL and no attack beyond computing discrete logarithms is known; it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/978-3-030-84242-0_8","sections":[{"content":"AOMDL is OMDL with a restricted adversary: every group element the\nadversary submits to the discrete-logarithm oracle must be accompanied by its\nrepresentation as a linear combination of the generator and the challenges\nreceived so far,\n\n\\[\nz = g^{\\alpha} \\prod_{i} h_i^{\\beta_i},\n\\]\n\nwith the coefficients \\( (\\alpha, \\beta_i) \\) given explicitly. The adversary\nwins by outputting the discrete logarithms of \\( q + 1 \\) challenges after at\nmost \\( q \\) oracle queries. This is a falsifiable assumption about a\nrestricted class of adversaries, distinct from proofs in the algebraic group\nmodel, which restrict the adversary attacking the scheme.","heading":"Definition"},{"content":"Nick, Ruffing and Seurin (2021) introduced AOMDL as a weaker variant of OMDL\nthat suffices for their MuSig2 proofs. Chu, Gerhart, Ruffing and Schröder\n(2023) proved the FROST3 threshold Schnorr variant with Pedersen-style key\ngeneration, Olaf (`TSIG-PAPER-2023-OLAF`), unforgeable under AOMDL in the random\noracle model without the algebraic group model. No attack beyond discrete\nlogarithms is known.","heading":"Status"},{"content":"OMDL implies AOMDL because AOMDL restricts the adversary; AOMDL implies DL\n(ASM-DLOG). Proofs that need only AOMDL and random oracles (ASM-ROM) rest on a\nweaker assumption than those using OMDL.","heading":"Relations"}],"slug":"aomdl","status":"registry","subtitle":"group","summary":"AOMDL is OMDL with a restricted adversary: every group element the adversary submits to the discrete-logarithm oracle must be accompanied by its representation as a linear combination of the generator and the challenges received so far, \\[ z = g^{\\alpha} \\prod_{i} h_i^{\\beta_i}, \\] with the coefficients \\( (\\alpha, \\beta_i) \\) given explicitly.","tags":["group","interactive"],"title":"Algebraic one-more discrete logarithm (AOMDL)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-AOMDL"},{"evidence":"registry","id":"ASM-CDH","keywords":["group","standard"],"metadata":{"aliases":["computational Diffie-Hellman in pairing groups"],"falsifiable":true,"family":"group","id":"ASM-CDH","implied_by":["ASM-DDH","ASM-DLIN","ASM-KLIN","ASM-DBDH","ASM-GDH","ASM-QBDHE","ASM-RW13-Q1"],"implied_by_records":[{"id":"ASM-DDH","name":"Decisional Diffie-Hellman (DDH)"},{"id":"ASM-DLIN","name":"Decision linear (DLIN)"},{"id":"ASM-KLIN","name":"k-linear assumption (k-Lin)"},{"id":"ASM-DBDH","name":"Decisional bilinear Diffie-Hellman (DBDH)"},{"id":"ASM-GDH","name":"Gap Diffie-Hellman (GDH)"},{"id":"ASM-QBDHE","name":"Decisional q-bilinear Diffie-Hellman exponent (q-BDHE)"},{"id":"ASM-RW13-Q1","name":"Rouselakis–Waters q-1 assumption (q-1)"}],"implies":["ASM-DLOG"],"implies_records":[{"id":"ASM-DLOG","name":"Discrete logarithm (DL)"}],"introduced_in":{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},"kind":"standard","name":"Computational Diffie-Hellman (CDH)","post_quantum":false,"references":[{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},{"citation":"Bert den Boer, Diffie-Hellman is as Strong as Discrete Log for Certain Primes, CRYPTO 1988","url":"https://doi.org/10.1007/0-387-34799-2_38"},{"citation":"Ueli M. Maurer, Towards the Equivalence of Breaking the Diffie-Hellman Protocol and Computing Discrete Logarithms, CRYPTO 1994","url":"https://doi.org/10.1007/3-540-48658-5_26"},{"citation":"Ueli M. Maurer and Stefan Wolf, The Relationship Between Breaking the Diffie-Hellman Protocol and Computing Discrete Logarithms, SIAM J. Comput. 28(5), 1999","url":"https://doi.org/10.1137/S0097539796302749"},{"citation":"Antoine Joux and Kim Nguyen, Separating Decision Diffie-Hellman from Computational Diffie-Hellman in Cryptographic Groups, J. Cryptology 16, 2003","url":"https://doi.org/10.1007/s00145-003-0052-4"}],"status":"As of 2026-10-10 no algorithm for CDH is known that does not compute discrete logarithms, CDH is believed hard in pairing groups where DDH is easy, and it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1109/TIT.1976.1055638","sections":[{"content":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order\n\\( p \\). The CDH assumption states that, given \\( (g, g^{a}, g^{b}) \\) for\nuniform \\( a, b \\in \\mathbb{Z}_p \\), no probabilistic polynomial-time algorithm\noutputs \\( g^{ab} \\) with non-negligible probability. In a bilinear group the\nsame problem is posed in a source group; for asymmetric pairings the\ntwo-group version is co-CDH (ASM-CO-CDH).","heading":"Definition"},{"content":"Computing discrete logarithms solves CDH, and no other general method is\nknown. Den Boer (1988), Maurer (1994) and Maurer and Wolf (1999) showed that\nCDH is equivalent to DL in groups where suitable auxiliary groups (for\nexample, elliptic curves of smooth order over \\( \\mathbb{F}_p \\)) are known.\nIn groups with a symmetric pairing, DDH is easy while CDH is believed hard\n(Joux and Nguyen 2003); such \"gap\" groups underlie BLS signatures\n(`[BLS01]`).","heading":"Status"},{"content":"CDH implies DL (ASM-DLOG). DDH (ASM-DDH), DLIN, k-Lin, DBDH, gap DH (ASM-GDH), q-BDHE and the\nRouselakis-Waters q-1 assumption each imply CDH: a CDH oracle\nbreaks each of them. BLS signatures are proven secure from CDH in a gap group\nin the random oracle model (ASM-ROM).","heading":"Relations"}],"slug":"cdh","status":"registry","subtitle":"group","summary":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order \\( p \\).","tags":["group","standard"],"title":"Computational Diffie-Hellman (CDH)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-CDH"},{"evidence":"registry","id":"ASM-CO-CDH","keywords":["pairing","standard"],"metadata":{"aliases":[],"falsifiable":true,"family":"pairing","id":"ASM-CO-CDH","implied_by":[],"implied_by_records":[],"implies":["ASM-DLOG"],"implies_records":[{"id":"ASM-DLOG","name":"Discrete logarithm (DL)"}],"introduced_in":{"citation":"Dan Boneh, Ben Lynn, Hovav Shacham, Short Signatures from the Weil Pairing, J. Cryptology 17, 2004 (full version of ASIACRYPT 2001)","url":"https://doi.org/10.1007/s00145-004-0314-9"},"kind":"standard","name":"Computational co-Diffie-Hellman (co-CDH)","post_quantum":false,"references":[{"citation":"Dan Boneh, Ben Lynn, Hovav Shacham, Short Signatures from the Weil Pairing, J. Cryptology 17, 2004","url":"https://doi.org/10.1007/s00145-004-0314-9"},{"citation":"Dan Boneh, Ben Lynn, Hovav Shacham, Short Signatures from the Weil Pairing, ASIACRYPT 2001","url":"https://doi.org/10.1007/3-540-45682-1_30"},{"citation":"Steven D. Galbraith, Kenneth G. Paterson, Nigel P. Smart, Pairings for Cryptographers, Discrete Applied Mathematics 156, 2008","url":"https://doi.org/10.1016/j.dam.2007.12.010"}],"status":"As of 2026-10-10 no attack on co-CDH is known beyond computing discrete logarithms in the source groups or in the target field of the pairing, whose concrete security was lowered by the extended tower number field sieve (2016); it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/s00145-004-0314-9","sections":[{"content":"Let \\( (\\mathbb{G}_1, \\mathbb{G}_2) \\) be groups of prime order \\( p \\) with\ngenerators \\( g_1, g_2 \\) and a pairing into \\( \\mathbb{G}_T \\). The co-CDH\nassumption states that, given \\( g_2, g_2^{a} \\in \\mathbb{G}_2 \\) and\n\\( h \\in \\mathbb{G}_1 \\), no probabilistic polynomial-time algorithm outputs\n\\( h^{a} \\in \\mathbb{G}_1 \\) with non-negligible probability. When\n\\( \\mathbb{G}_1 = \\mathbb{G}_2 \\) this is CDH (ASM-CDH). The co-GDH variant\nadditionally gives the adversary a co-DDH oracle, which the pairing provides.","heading":"Definition"},{"content":"The journal version of the BLS paper defines co-CDH and co-GDH pairs and\nproves BLS signatures with public keys in \\( \\mathbb{G}_2 \\) and signatures in\n\\( \\mathbb{G}_1 \\) secure under co-CDH in the random oracle model. Its concrete\nsecurity depends on discrete logarithms in \\( \\mathbb{G}_1 \\), \\( \\mathbb{G}_2 \\)\nand the target field; see ASM-DLOG for the effect of the extended tower number\nfield sieve on common pairing curves.","heading":"Status"},{"content":"co-CDH implies DL in the groups involved (ASM-DLOG). It generalizes CDH to\nasymmetric pairings (Type II and Type III in the classification of Galbraith,\nPaterson and Smart); gap DH (ASM-GDH) is the symmetric analogue used by\n`TSIG-PAPER-2003-BOLDYREVA`. Threshold BLS signatures and their aggregate and\nmulti-signature variants rely on co-CDH in the random oracle model.","heading":"Relations"}],"slug":"co-cdh","status":"registry","subtitle":"pairing","summary":"Let \\( (\\mathbb{G}_1, \\mathbb{G}_2) \\) be groups of prime order \\( p \\) with generators \\( g_1, g_2 \\) and a pairing into \\( \\mathbb{G}_T \\).","tags":["pairing","standard"],"title":"Computational co-Diffie-Hellman (co-CDH)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-CO-CDH"},{"evidence":"registry","id":"ASM-DCR","keywords":["factoring","standard"],"metadata":{"aliases":["Decisional Composite Residuosity","composite_residuosity"],"falsifiable":true,"family":"factoring","id":"ASM-DCR","implied_by":[],"implied_by_records":[],"implies":["ASM-FACTORING"],"implies_records":[{"id":"ASM-FACTORING","name":"Integer factorization (factoring)"}],"introduced_in":{"citation":"Pascal Paillier, Public-Key Cryptosystems Based on Composite Degree Residuosity Classes, EUROCRYPT 1999","url":"https://doi.org/10.1007/3-540-48910-X_16"},"kind":"standard","name":"Decisional composite residuosity (DCR)","post_quantum":false,"references":[{"citation":"Pascal Paillier, Public-Key Cryptosystems Based on Composite Degree Residuosity Classes, EUROCRYPT 1999","url":"https://doi.org/10.1007/3-540-48910-X_16"}],"status":"As of 2026-10-10 no way to decide composite residuosity is known other than factoring the modulus; it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/3-540-48910-X_16","sections":[{"content":"Let \\( N = pq \\) be an RSA modulus. An element \\( z \\in \\mathbb{Z}_{N^2}^* \\) is\nan \\( N \\)-th residue if \\( z = y^{N} \\bmod N^2 \\) for some\n\\( y \\in \\mathbb{Z}_{N^2}^* \\). The decisional composite residuosity assumption\nstates that, given \\( N \\), no probabilistic polynomial-time algorithm\ndistinguishes a uniformly random \\( N \\)-th residue modulo \\( N^2 \\) from a\nuniformly random element of \\( \\mathbb{Z}_{N^2}^* \\) with non-negligible\nadvantage.","heading":"Definition"},{"content":"Factoring \\( N \\) breaks DCR, and no other attack is known. DCR gives\nsemantic security of Paillier encryption (`[Paillier99]`), which is\nadditively homomorphic, and is the encryption assumption in Paillier-based\ntwo-party and threshold ECDSA (`TSIG-PAPER-2017-LINDELL`, `TSIG-PAPER-2018-GG`,\n`TSIG-PAPER-2020-CGGMP`) and in the LWE-to-Paillier compression of\n`[ADK26]`.","heading":"Status"},{"content":"DCR implies factoring; the converse is open. Paillier (1999)\nalso defines the computational composite residuosity class problem and shows it\nis no harder than RSA with exponent \\( N \\). DCR and quadratic residuosity are not known to be related.","heading":"Relations"}],"slug":"dcr","status":"registry","subtitle":"factoring","summary":"Let \\( N = pq \\) be an RSA modulus.","tags":["factoring","standard"],"title":"Decisional composite residuosity (DCR)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-DCR"},{"evidence":"registry","id":"ASM-DDH","keywords":["group","standard"],"metadata":{"aliases":["Decisional Diffie-Hellman","decisional Diffie-Hellman","Decisional Diffie–Hellman","ddh"],"falsifiable":true,"family":"group","id":"ASM-DDH","implied_by":["ASM-SXDH"],"implied_by_records":[{"id":"ASM-SXDH","name":"Symmetric external Diffie-Hellman (SXDH)"}],"implies":["ASM-CDH","ASM-DLIN","ASM-KLIN"],"implies_records":[{"id":"ASM-CDH","name":"Computational Diffie-Hellman (CDH)"},{"id":"ASM-DLIN","name":"Decision linear (DLIN)"},{"id":"ASM-KLIN","name":"k-linear assumption (k-Lin)"}],"introduced_in":{"citation":"Stefan Brands, An Efficient Off-line Electronic Cash System Based on the Representation Problem, CWI Technical Report CS-R9323, 1993","url":"https://ir.cwi.nl/pub/5303"},"kind":"standard","name":"Decisional Diffie-Hellman (DDH)","post_quantum":false,"references":[{"citation":"Dan Boneh, The Decision Diffie-Hellman Problem, ANTS-III 1998","url":"https://doi.org/10.1007/BFb0054851"},{"citation":"Stefan Brands, An Efficient Off-line Electronic Cash System Based on the Representation Problem, CWI Technical Report CS-R9323, 1993","url":"https://ir.cwi.nl/pub/5303"},{"citation":"Antoine Joux and Kim Nguyen, Separating Decision Diffie-Hellman from Computational Diffie-Hellman in Cryptographic Groups, J. Cryptology 16, 2003","url":"https://doi.org/10.1007/s00145-003-0052-4"},{"citation":"Alex Escala, Gottfried Herold, Eike Kiltz, Carla Ràfols, Jorge Villar, An Algebraic Framework for Diffie-Hellman Assumptions, CRYPTO 2013","url":"https://doi.org/10.1007/978-3-642-40084-1_8"}],"status":"As of 2026-10-10 DDH is believed hard in prime-order elliptic-curve groups without an efficient pairing and in prime-order subgroups of finite fields; it is false in groups with a symmetric pairing and in full groups \\( \\mathbb{Z}_p^* \\), and it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://ir.cwi.nl/pub/5303","sections":[{"content":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order\n\\( p \\). The DDH assumption states that no probabilistic polynomial-time\nalgorithm distinguishes\n\n\\[\n(g, g^{a}, g^{b}, g^{ab}) \\quad \\text{from} \\quad (g, g^{a}, g^{b}, g^{c})\n\\]\n\nfor uniform \\( a, b, c \\in \\mathbb{Z}_p \\) with non-negligible advantage. In the\nmatrix Diffie-Hellman framework DDH is the case \\( k = 1 \\) of k-Lin.","heading":"Definition"},{"content":"DDH fails whenever a group has extra structure that tests the relation: in the\nfull group \\( \\mathbb{Z}_p^* \\) the Legendre symbol leaks whether exponents are\neven, so DDH is used in prime-order subgroups; in groups with an efficiently\ncomputable symmetric pairing \\( e(g^a, g^b) = e(g, g^{ab}) \\) tests the tuple,\nso DDH is easy while CDH may remain hard (Joux and Nguyen 2003). In\nprime-order elliptic-curve groups without an efficient pairing, and in the\nsource groups of asymmetric (Type III) pairings, no attack better than\ncomputing discrete logarithms is known. Boneh's 1998 survey credits Brands\n(1993) with observing that earlier undeniable-signature proposals implicitly\nrelied on DDH.","heading":"Status"},{"content":"DDH implies CDH (ASM-CDH) and hence DL. It implies k-Lin for every \\( k \\ge 1 \\)\nin the same group, in particular DLIN; the converse fails\nin groups with symmetric pairings, where DLIN is believed to hold but DDH does\nnot. SXDH is DDH in both source groups of an asymmetric pairing.\nElGamal (`[ElGamal85]`) and Cramer-Shoup (`[CS98]`)\nencryption, TreePIR (`[LP23b]`) and the Glacius threshold\nSchnorr signature (`TSIG-PAPER-2024-GLACIUS`) rely on DDH.","heading":"Relations"}],"slug":"ddh","status":"registry","subtitle":"group","summary":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order \\( p \\).","tags":["group","standard"],"title":"Decisional Diffie-Hellman (DDH)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-DDH"},{"evidence":"registry","id":"ASM-DLOG","keywords":["group","standard"],"metadata":{"aliases":["discrete logarithm","discrete logarithm in the Edwards-curve group"],"falsifiable":true,"family":"group","id":"ASM-DLOG","implied_by":["ASM-CDH","ASM-CO-CDH","ASM-QSDH","ASM-AOMDL","ASM-DSA-EUF"],"implied_by_records":[{"id":"ASM-CDH","name":"Computational Diffie-Hellman (CDH)"},{"id":"ASM-CO-CDH","name":"Computational co-Diffie-Hellman (co-CDH)"},{"id":"ASM-QSDH","name":"q-strong Diffie-Hellman (q-SDH)"},{"id":"ASM-AOMDL","name":"Algebraic one-more discrete logarithm (AOMDL)"},{"id":"ASM-DSA-EUF","name":"Unforgeability of DSA and ECDSA ((EC)DSA EUF-CMA)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},"kind":"standard","name":"Discrete logarithm (DL)","post_quantum":false,"references":[{"citation":"Whitfield Diffie and Martin E. Hellman, New Directions in Cryptography, IEEE Trans. Inf. Theory 22(6), 1976","url":"https://doi.org/10.1109/TIT.1976.1055638"},{"citation":"Victor Shoup, Lower Bounds for Discrete Logarithms and Related Problems, EUROCRYPT 1997","url":"https://doi.org/10.1007/3-540-69053-0_18"},{"citation":"Peter W. Shor, Algorithms for Quantum Computation: Discrete Logarithms and Factoring, FOCS 1994","url":"https://doi.org/10.1109/SFCS.1994.365700"},{"citation":"Razvan Barbulescu, Pierrick Gaudry, Antoine Joux, Emmanuel Thomé, A Heuristic Quasi-Polynomial Algorithm for Discrete Logarithm in Finite Fields of Small Characteristic, EUROCRYPT 2014","url":"https://doi.org/10.1007/978-3-642-55220-5_1"},{"citation":"Taechan Kim and Razvan Barbulescu, Extended Tower Number Field Sieve: A New Complexity for the Medium Prime Case, CRYPTO 2016","url":"https://doi.org/10.1007/978-3-662-53018-4_20"},{"citation":"Razvan Barbulescu and Sylvain Duquesne, Updating Key Size Estimations for Pairings, J. Cryptology 32, 2019","url":"https://doi.org/10.1007/s00145-018-9280-5"}],"status":"As of 2026-10-10 discrete logarithms in well-chosen elliptic-curve groups need about \\( \\sqrt{p} \\) operations, finite-field discrete logarithms are subexponential (quasi-polynomial in small characteristic), the extended tower number field sieve (2016) lowered the security of common pairing curves, and Shor's algorithm solves all cases in quantum polynomial time."},"primaryUrl":"https://doi.org/10.1109/TIT.1976.1055638","sections":[{"content":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order\n\\( p \\) output by a group generator (a subgroup of \\( \\mathbb{F}_q^* \\), or the\ngroup of points of an elliptic curve such as Curve25519 or its twisted Edwards\nform used by Ed25519). The discrete logarithm assumption states that, given\n\\( g \\) and \\( h = g^{x} \\) for uniform \\( x \\in \\mathbb{Z}_p \\), no\nprobabilistic polynomial-time algorithm outputs \\( x \\) with non-negligible\nprobability.","heading":"Definition"},{"content":"Generic algorithms such as Pollard's rho need \\( \\Theta(\\sqrt p) \\) group\noperations, which is optimal for generic algorithms (Shoup 1997; Generic group model (GGM), including the generic bilinear group model). For\nelliptic curves chosen to avoid known weak classes (anomalous curves, curves of\nsmall embedding degree outside pairing use), nothing better than generic\nattacks is known. In finite fields, index-calculus and number-field-sieve\nalgorithms are subexponential, and in small characteristic Barbulescu, Gaudry,\nJoux and Thomé (2014) gave a heuristic quasi-polynomial algorithm. For pairing\ngroups the discrete logarithm in the target field \\( \\mathbb{F}_{q^k} \\) also\nmatters: the extended tower number field sieve (Kim and Barbulescu 2016)\nlowered the estimated security of Barreto-Naehrig curves over 254-bit fields\nfrom about 128 to about 100 bits, and Barbulescu and Duquesne (2019) updated\npairing key sizes accordingly. Shor (1994) computes discrete logarithms in any\ngroup in quantum polynomial time.","heading":"Status"},{"content":"Every Diffie-Hellman-type assumption implies DL, directly or\nthrough CDH (ASM-CDH): if DL is easy, CDH, DDH and their pairing and q-type\nvariants are easy. The one-more assumptions (One-more discrete logarithm (OMDL), ASM-AOMDL) and\nunforgeability of (EC)DSA (ASM-DSA-EUF) also imply DL. Schnorr signatures\n(`[Schnorr91]`) and Ed25519 (`[BDLSY11]`) are proven\nsecure from DL in the random oracle model (ASM-ROM). Proofs for threshold\nSchnorr signatures use a range of assumptions, for example AOMDL for Olaf\n(`TSIG-PAPER-2023-OLAF`) and DDH for Glacius (`TSIG-PAPER-2024-GLACIUS`).","heading":"Relations"}],"slug":"dlog","status":"registry","subtitle":"group","summary":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) be a cyclic group of prime order \\( p \\) output by a group generator (a subgroup of \\( \\mathbb{F}_q^* \\), or the group of points of an elliptic curve such as Curve25519 or its twisted Edwards form used by Ed25519).","tags":["group","standard"],"title":"Discrete logarithm (DL)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-DLOG"},{"evidence":"registry","id":"ASM-DSA-EUF","keywords":["group","interactive"],"metadata":{"aliases":["hardness of forging the underlying DSS signature under the paper model"],"falsifiable":true,"family":"group","id":"ASM-DSA-EUF","implied_by":[],"implied_by_records":[],"implies":["ASM-DLOG"],"implies_records":[{"id":"ASM-DLOG","name":"Discrete logarithm (DL)"}],"introduced_in":{"citation":"NIST, FIPS 186: Digital Signature Standard (DSS), May 1994","url":"https://doi.org/10.6028/NIST.FIPS.186"},"kind":"interactive","name":"Unforgeability of DSA and ECDSA ((EC)DSA EUF-CMA)","post_quantum":false,"references":[{"citation":"NIST, FIPS 186: Digital Signature Standard (DSS), 1994","url":"https://doi.org/10.6028/NIST.FIPS.186"},{"citation":"NIST, FIPS 186-5: Digital Signature Standard (DSS), February 2023","url":"https://doi.org/10.6028/NIST.FIPS.186-5"},{"citation":"Daniel R. L. Brown, Generic Groups, Collision Resistance, and ECDSA, Des. Codes Cryptogr. 35, 2005","url":"https://doi.org/10.1007/s10623-003-6154-z"},{"citation":"Manuel Fersch, Eike Kiltz, Bertram Poettering, On the Provable Security of (EC)DSA Signatures, ACM CCS 2016","url":"https://doi.org/10.1145/2976749.2978413"},{"citation":"Ran Canetti, Rosario Gennaro, Steven Goldfeder, Nikolaos Makriyannis, Udi Peled, UC Non-Interactive, Proactive, Threshold ECDSA with Identifiable Aborts, ACM CCS 2020","url":"https://doi.org/10.1145/3372297.3423367"},{"citation":"Jack Doerner, Yashvanth Kondi, Eysa Lee, abhi shelat, Secure Two-party Threshold ECDSA from ECDSA Assumptions, IEEE S&P 2018","url":"https://eprint.iacr.org/2018/499"}],"status":"As of 2026-10-10 no attack on DSA or ECDSA with properly generated keys and nonces is known beyond computing discrete logarithms, but no reduction of their unforgeability to DL in the standard model is known; proofs exist only in idealized models."},"primaryUrl":"https://doi.org/10.6028/NIST.FIPS.186","sections":[{"content":"DSA (over a prime-order subgroup of \\( \\mathbb{F}_q^* \\)) and ECDSA (over an\nelliptic-curve group of prime order \\( n \\)) sign a message \\( m \\) with secret\nkey \\( x \\) by choosing a nonce \\( k \\), computing \\( r = f(g^{k}) \\bmod n \\)\nfor a conversion function \\( f \\) (reduction of an integer, or of the\n\\( x \\)-coordinate of a curve point), and\n\n\\[\ns = k^{-1} \\big( H(m) + x r \\big) \\bmod n .\n\\]\n\nThe assumption is that the scheme is existentially unforgeable under\nchosen-message attack: given the public key \\( g^{x} \\) and signatures on\nmessages of its choice, no probabilistic polynomial-time adversary outputs a\nvalid signature on a new message. Some threshold protocols use strengthened\n(\"enhanced\") variants in which the adversary also sees the nonce commitment\n\\( g^{k} \\) before choosing the message.","heading":"Definition"},{"content":"DSA was standardized in FIPS 186 (1994) and ECDSA later; FIPS 186-5 (2023) is\nthe current version of the standard (`[NIST23]`). Breaking DL\nbreaks both schemes, but no standard-model reduction from DL is known, because\nthe conversion function mixes the group and the exponent ring. Brown (2005)\nproved ECDSA secure in the generic group model under assumptions on the hash\nand conversion functions, and Fersch, Kiltz and Poettering (2016) gave proofs\nin idealized models of the conversion function. Practical breaks of deployed\n(EC)DSA have come from biased or repeated nonces, which violate the scheme's\nrequirements rather than the assumption.","heading":"Status"},{"content":"(EC)DSA unforgeability implies DL (ASM-DLOG). Threshold and two-party ECDSA\nprotocols assume it in addition to other assumptions: Doerner, Kondi, Lee and\nshelat (`TSIG-PAPER-2019-DKLS-N` and its two-party predecessor) use only\nassumptions of ECDSA itself plus CDH (ASM-CDH) in the random oracle model;\nCanetti, Gennaro, Goldfeder, Makriyannis and Peled\n(`TSIG-PAPER-2020-CGGMP`) use an enhanced unforgeability variant together with\nstrong RSA (ASM-STRONG-RSA), DDH (ASM-DDH) and the semantic security of\nPaillier encryption (ASM-DCR); `TSIG-PAPER-2017-LINDELL` and\n`TSIG-PAPER-2018-GG` combine it with Paillier-based assumptions.","heading":"Relations"}],"slug":"dsa-euf","status":"registry","subtitle":"group","summary":"DSA (over a prime-order subgroup of \\( \\mathbb{F}_q^* \\)) and ECDSA (over an elliptic-curve group of prime order \\( n \\)) sign a message \\( m \\) with secret key \\( x \\) by choosing a nonce \\( k \\), computing \\( r = f(g^{k}) \\bmod n \\) for a conversion function \\( f \\) (reduction of an integer, or of the \\( x \\)-coordinate of a curve point), and \\[ s = k^{-1} \\big( H(m) + x r \\big) \\bmod n .","tags":["group","interactive"],"title":"Unforgeability of DSA and ECDSA ((EC)DSA EUF-CMA)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-DSA-EUF"},{"evidence":"registry","id":"ASM-GDH","keywords":["group","interactive"],"metadata":{"aliases":[],"falsifiable":true,"family":"group","id":"ASM-GDH","implied_by":[],"implied_by_records":[],"implies":["ASM-CDH"],"implies_records":[{"id":"ASM-CDH","name":"Computational Diffie-Hellman (CDH)"}],"introduced_in":{"citation":"Tatsuaki Okamoto and David Pointcheval, The Gap-Problems: A New Class of Problems for the Security of Cryptographic Schemes, PKC 2001","url":"https://doi.org/10.1007/3-540-44586-2_8"},"kind":"interactive","name":"Gap Diffie-Hellman (GDH)","post_quantum":false,"references":[{"citation":"Tatsuaki Okamoto and David Pointcheval, The Gap-Problems: A New Class of Problems for the Security of Cryptographic Schemes, PKC 2001","url":"https://doi.org/10.1007/3-540-44586-2_8"},{"citation":"Dan Boneh, Ben Lynn, Hovav Shacham, Short Signatures from the Weil Pairing, J. Cryptology 17, 2004 (ASIACRYPT 2001)","url":"https://doi.org/10.1007/s00145-004-0314-9"},{"citation":"Alexandra Boldyreva, Threshold Signatures, Multisignatures and Blind Signatures Based on the Gap-Diffie-Hellman-Group Signature Scheme, PKC 2003","url":"https://doi.org/10.1007/3-540-36288-6_3"}],"status":"As of 2026-10-10 no attack on gap Diffie-Hellman is known beyond computing discrete logarithms; in groups with an efficient symmetric pairing it coincides with CDH, and it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/3-540-44586-2_8","sections":[{"content":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) have prime order \\( p \\). The gap\nDiffie-Hellman assumption states that CDH remains hard for an adversary that\nmay query a DDH oracle: given \\( (g, g^{a}, g^{b}) \\) and oracle access to\n\\( \\mathcal{O}(g^{x}, g^{y}, g^{z}) = [\\, z = xy \\bmod p \\,] \\), no probabilistic\npolynomial-time algorithm outputs \\( g^{ab} \\) with non-negligible probability.\nA group in which DDH is easy but CDH is hard is called a gap Diffie-Hellman\ngroup.","heading":"Definition"},{"content":"Okamoto and Pointcheval (2001) introduced gap problems to capture schemes whose\nsecurity proofs need a decision oracle. In a group with an efficiently\ncomputable symmetric pairing the DDH oracle can be implemented, so GDH there is\nthe same as CDH; this is the setting of the original BLS signature\n(`[BLS01]`) and of Boldyreva's threshold, multi- and blind\nsignatures (`TSIG-PAPER-2003-BOLDYREVA`). No attack beyond discrete\nlogarithms is known.","heading":"Status"},{"content":"GDH implies CDH (ASM-CDH), since the adversary may ignore the oracle. In\nasymmetric pairing groups the corresponding notions are co-CDH (ASM-CO-CDH)\nand co-GDH, introduced in the journal version of the BLS paper; Boldyreva's\nanalysis is in the gap Diffie-Hellman group setting.","heading":"Relations"}],"slug":"gdh","status":"registry","subtitle":"group","summary":"Let \\( \\mathbb{G} = \\langle g \\rangle \\) have prime order \\( p \\).","tags":["group","interactive"],"title":"Gap Diffie-Hellman (GDH)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-GDH"},{"evidence":"registry","id":"ASM-HINT-MLWE","keywords":["lattice","new"],"metadata":{"aliases":[],"falsifiable":true,"family":"lattice","id":"ASM-HINT-MLWE","implied_by":["ASM-MLWE"],"implied_by_records":[{"id":"ASM-MLWE","name":"Module learning with errors (Module-LWE)"}],"implies":["ASM-MLWE"],"implies_records":[{"id":"ASM-MLWE","name":"Module learning with errors (Module-LWE)"}],"introduced_in":{"citation":"Duhyeong Kim, Dongwon Lee, Jinyeong Seo, Yongsoo Song, Toward Practical Lattice-Based Proof of Knowledge from Hint-MLWE, CRYPTO 2023","url":"https://doi.org/10.1007/978-3-031-38554-4_18"},"kind":"new","name":"Module learning with errors with hints (Hint-MLWE)","post_quantum":true,"references":[{"citation":"Duhyeong Kim, Dongwon Lee, Jinyeong Seo, Yongsoo Song, Toward Practical Lattice-Based Proof of Knowledge from Hint-MLWE, CRYPTO 2023 (ePrint 2023/623)","url":"https://eprint.iacr.org/2023/623"},{"citation":"Yisol Hwang, Shuichi Katsumata, Seonhong Min, Guilhem Niot, Yongsoo Song, Proving Threshold Regev PKE from Adaptive Hint-MLWE: Efficient, Non-interactive, and CCA Secure, IACR ePrint 2026/1585","url":"https://eprint.iacr.org/2026/1585"},{"citation":"Rafael del Pino, Shuichi Katsumata, Mary Maller, Fabrice Mouhartem, Thomas Prest, Markku-Juhani Saarinen, Threshold Raccoon: Practical Threshold Signatures from Standard Lattice Assumptions, EUROCRYPT 2024","url":"https://eprint.iacr.org/2024/184"}],"status":"As of 2026-10-10 Hint-MLWE is reduced to Module-LWE for discrete Gaussian secrets, errors and hints (2023), and an adaptive variant was reduced tightly to Module-LWE in a 2026 preprint; no separate attack is known."},"primaryUrl":"https://doi.org/10.1007/978-3-031-38554-4_18","sections":[{"content":"Let \\( A \\leftarrow R_q^{k \\times \\ell} \\) be uniform and let\n\\( s \\in R^{\\ell} \\), \\( e \\in R^{k} \\) have discrete Gaussian entries. In\naddition to the Module-LWE sample \\( b = A s + e \\), the adversary receives\nhints\n\n\\[\nz = H \\cdot \\begin{pmatrix} s \\\\ e \\end{pmatrix} + e' ,\n\\]\n\nfor public matrices \\( H \\) (in applications, challenge polynomials of\nzero-knowledge proofs or signatures) and fresh discrete Gaussian noise\n\\( e' \\). Hint-MLWE states that \\( b \\) remains pseudorandom (or \\( s \\) hard to\nrecover) given these hints. The hints model the leakage of masked responses in\nproofs of knowledge and threshold signatures when noise flooding or rejection\nsampling is avoided.","heading":"Definition"},{"content":"Kim, Lee, Seo and Song (2023) gave an efficient reduction from Module-LWE to\nHint-MLWE when secret, error and hint noise are discrete Gaussians, for\nsuitable parameters. Threshold Raccoon (`TSIG-PAPER-2024-RACCOON`), whose\nauthors describe its security as resting on the same assumptions as\nDilithium, is analysed with Hint-MLWE to bound the leakage of signature shares.\nHwang, Katsumata, Min, Niot and Song (ePrint 2026/1585) reduce an adaptive\nvariant, in which the adversary chooses the hint coefficients adaptively,\ntightly to Module-LWE.","heading":"Status"},{"content":"Hint-MLWE gives the adversary strictly more information than Module-LWE\n(ASM-MLWE), so it implies Module-LWE; the reduction above gives the converse\nfor the stated parameters. It is unrelated to the hint-free structured\nassumptions such as Module-SIS (ASM-MSIS), which Threshold Raccoon uses\nseparately for unforgeability.","heading":"Relations"}],"slug":"hint-mlwe","status":"registry","subtitle":"lattice","summary":"Let \\( A \\leftarrow R_q^{k \\times \\ell} \\) be uniform and let \\( s \\in R^{\\ell} \\), \\( e \\in R^{k} \\) have discrete Gaussian entries.","tags":["lattice","new"],"title":"Module learning with errors with hints (Hint-MLWE)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-HINT-MLWE"},{"evidence":"registry","id":"ASM-MLWE","keywords":["lattice","standard"],"metadata":{"aliases":["Module-LWE"],"falsifiable":true,"family":"lattice","id":"ASM-MLWE","implied_by":["ASM-HINT-MLWE"],"implied_by_records":[{"id":"ASM-HINT-MLWE","name":"Module learning with errors with hints (Hint-MLWE)"}],"implies":["ASM-MSIS","ASM-HINT-MLWE"],"implies_records":[{"id":"ASM-MSIS","name":"Module short integer solution (Module-SIS)"},{"id":"ASM-HINT-MLWE","name":"Module learning with errors with hints (Hint-MLWE)"}],"introduced_in":{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},"kind":"standard","name":"Module learning with errors (Module-LWE)","post_quantum":true,"references":[{"citation":"Zvika Brakerski, Craig Gentry, Vinod Vaikuntanathan, (Leveled) Fully Homomorphic Encryption without Bootstrapping, ITCS 2012","url":"https://doi.org/10.1145/2090236.2090262"},{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},{"citation":"NIST, FIPS 203: Module-Lattice-Based Key-Encapsulation Mechanism Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.203"},{"citation":"NIST, FIPS 204: Module-Lattice-Based Digital Signature Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.204"}],"status":"As of 2026-10-10 no attack on Module-LWE with the parameters of ML-KEM (FIPS 203) or ML-DSA (FIPS 204), both published on 13 August 2024, is known to beat generic lattice reduction."},"primaryUrl":"https://doi.org/10.1007/s10623-014-9938-4","sections":[{"content":"Let \\( R = \\mathbb{Z}[x]/(x^n + 1) \\) (or another ring of integers of degree\n\\( n \\)), \\( R_q = R/qR \\), and let \\( d \\ge 1 \\) be the module rank. For a\nsecret \\( s \\in R_q^{d} \\), a sample is\n\n\\[\n(a, \\; b = \\langle a, s \\rangle + e) \\in R_q^{d} \\times R_q, \\qquad a \\leftarrow R_q^{d},\\; e \\leftarrow \\chi ,\n\\]\n\nwith \\( \\chi \\) a narrow error distribution on \\( R \\) (in ML-KEM, a centered\nbinomial distribution). Search Module-LWE asks for \\( s \\); decision Module-LWE\nasks to distinguish samples from uniform. With \\( d = 1 \\) this is Ring-LWE\n(ASM-RLWE); with \\( n = 1 \\) and \\( R = \\mathbb{Z} \\) it is LWE in\ndimension \\( d \\).","heading":"Definition"},{"content":"Langlois and Stehlé (2015) gave worst-case to average-case reductions for\nmodule lattices, from approximate SVP on module lattices of rank \\( d \\) to\nModule-LWE (quantum) and to Module-SIS (classical). Module-LWE is the hardness\nassumption of ML-KEM (`[NIST24/FIPS203]`, derived from\n`[BDK+17]`) and, together with Module-SIS, of ML-DSA\n(`[NIST24/FIPS204]`, derived from `[DKL+18]`). Concrete\nsecurity of these parameter sets is estimated by primal and dual lattice\nattacks, treating the module structure as giving no extra advantage; no\nalgebraic attack exploiting the module structure is known for these rings.","heading":"Status"},{"content":"Module-LWE interpolates between LWE and Ring-LWE. Brakerski, Gentry and\nVaikuntanathan (2012) had already defined a general LWE problem (GLWE)\ncovering both, without studying the intermediate ranks. Module-LWE with\nmatching parameters implies Module-SIS (ASM-MSIS) by the same argument as for\nLWE and SIS. Hint-MLWE (ASM-HINT-MLWE), which reveals additional noisy linear\ninformation about the secret, implies Module-LWE trivially and is reduced to\nModule-LWE for suitable parameters by its authors.","heading":"Relations"}],"slug":"mlwe","status":"registry","subtitle":"lattice","summary":"Let \\( R = \\mathbb{Z}[x]/(x^n + 1) \\) (or another ring of integers of degree \\( n \\)), \\( R_q = R/qR \\), and let \\( d \\ge 1 \\) be the module rank.","tags":["lattice","standard"],"title":"Module learning with errors (Module-LWE)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-MLWE"},{"evidence":"registry","id":"ASM-MSIS","keywords":["lattice","standard"],"metadata":{"aliases":["module-sis"],"falsifiable":true,"family":"lattice","id":"ASM-MSIS","implied_by":["ASM-MLWE"],"implied_by_records":[{"id":"ASM-MLWE","name":"Module learning with errors (Module-LWE)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},"kind":"standard","name":"Module short integer solution (Module-SIS)","post_quantum":true,"references":[{"citation":"Adeline Langlois and Damien Stehlé, Worst-Case to Average-Case Reductions for Module Lattices, Des. Codes Cryptogr. 75(3), 2015","url":"https://doi.org/10.1007/s10623-014-9938-4"},{"citation":"NIST, FIPS 204: Module-Lattice-Based Digital Signature Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.204"}],"status":"As of 2026-10-10 no attack on Module-SIS with the parameters of ML-DSA (FIPS 204, August 2024) is known to beat generic lattice reduction."},"primaryUrl":"https://doi.org/10.1007/s10623-014-9938-4","sections":[{"content":"Let \\( R_q = \\mathbb{Z}_q[x]/(x^n + 1) \\). Given a uniformly random matrix\n\\( A \\in R_q^{k \\times \\ell} \\), find a nonzero \\( z \\in R^{\\ell} \\) with\n\n\\[\nA z \\equiv 0 \\pmod q, \\qquad \\lVert z \\rVert \\le \\beta ,\n\\]\n\nfor a norm bound \\( \\beta \\) (Euclidean or infinity norm, depending on the\napplication). In Dilithium-style schemes the matrix is written\n\\( [A \\mid I] \\) and the solution is split accordingly.","heading":"Definition"},{"content":"Langlois and Stehlé (2015) reduce worst-case approximate SVP on module lattices\nto Module-SIS by a classical reduction. Module-SIS, together with Module-LWE,\nunderlies ML-DSA (`[NIST24/FIPS204]`) and the threshold and two-party\nvariants in `TSIG-PAPER-2021-DOTT`, `TSIG-PAPER-2022-DILIZIUM2` and\n`TSIG-PAPER-2024-TANG`, and the lattice polynomial commitments of\n`[CMNW24]`. Concrete security is estimated with BKZ-based\nshort-vector attacks on the corresponding \\( n\\ell \\)-dimensional lattice.","heading":"Status"},{"content":"Module-SIS is the module analogue of SIS; with \\( k = 1 \\) it is\nRing-SIS (ASM-RSIS). Module-LWE (ASM-MLWE) with matching parameters implies\nModule-SIS. SelfTargetMSIS (ASM-SELFTARGET-MSIS), used for Fiat-Shamir\nsignatures in the quantum random oracle model, is a hash-dependent variant\nthat reduces to Module-SIS only in the classical random oracle model.","heading":"Relations"}],"slug":"msis","status":"registry","subtitle":"lattice","summary":"Let \\( R_q = \\mathbb{Z}_q[x]/(x^n + 1) \\).","tags":["lattice","standard"],"title":"Module short integer solution (Module-SIS)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-MSIS"},{"evidence":"registry","id":"ASM-PRF","keywords":["symmetric","standard"],"metadata":{"aliases":["Pseudorandom functions","pseudorandom-function"],"falsifiable":true,"family":"symmetric","id":"ASM-PRF","implied_by":["ASM-PRG","ASM-AES-PRP","ASM-CHACHA20"],"implied_by_records":[{"id":"ASM-PRG","name":"Pseudorandom generators (PRG)"},{"id":"ASM-AES-PRP","name":"AES as a pseudorandom permutation (AES PRP)"},{"id":"ASM-CHACHA20","name":"ChaCha20 block function as a PRF (ChaCha20)"}],"implies":["ASM-PRG"],"implies_records":[{"id":"ASM-PRG","name":"Pseudorandom generators (PRG)"}],"introduced_in":{"citation":"Oded Goldreich, Shafi Goldwasser, Silvio Micali, How to Construct Random Functions, J. ACM 33(4), 1986 (FOCS 1984)","url":"https://doi.org/10.1145/6490.6503"},"kind":"standard","name":"Pseudorandom functions (PRF)","post_quantum":true,"references":[{"citation":"Oded Goldreich, Shafi Goldwasser, Silvio Micali, How to Construct Random Functions, J. ACM 33(4), 1986","url":"https://doi.org/10.1145/6490.6503"},{"citation":"Johan Håstad, Russell Impagliazzo, Leonid A. Levin, Michael Luby, A Pseudorandom Generator from any One-way Function, SIAM J. Comput. 28(4), 1999","url":"https://doi.org/10.1137/S0097539793244708"},{"citation":"Mark Zhandry, How to Construct Quantum Random Functions, FOCS 2012; J. ACM 2021","url":"https://doi.org/10.1109/FOCS.2012.37"}],"status":"As of 2026-10-10 PRFs exist if and only if one-way functions exist, the Goldreich-Goldwasser-Micali construction is secure against quantum queries, and practical instantiations (AES, ChaCha20, SHA-2/SHA-3-based PRFs) have no known attacks on full rounds."},"primaryUrl":"https://doi.org/10.1145/6490.6503","sections":[{"content":"A keyed function family \\( F : \\{0,1\\}^{\\lambda} \\times \\{0,1\\}^{n} \\to\n\\{0,1\\}^{m} \\) is a pseudorandom function if, for a uniformly random key\n\\( k \\), no probabilistic polynomial-time adversary with oracle access to\n\\( F(k, \\cdot) \\) distinguishes it from a uniformly random function\n\\( \\{0,1\\}^n \\to \\{0,1\\}^m \\) with non-negligible advantage. Quantum-secure\nPRFs require indistinguishability even when the adversary queries the oracle\nin superposition.\n\nAs used in topic results, the assumption is that some efficient PRF exists,\ntypically instantiated with a block cipher, a stream-cipher core, or a hash\nfunction in a keyed mode.","heading":"Definition"},{"content":"Goldreich, Goldwasser and Micali (1984) built PRFs from any length-doubling\npseudorandom generator; with Håstad, Impagliazzo, Levin and Luby\n(1999) this shows PRFs exist if and only if one-way functions exist. Zhandry\n(2012) proved the GGM construction secure against quantum superposition\nqueries when the underlying generator is quantum-secure. For concrete\ninstantiations, see AES and ChaCha20.","heading":"Status"},{"content":"PRFs and PRGs imply each other. Concrete primitives modelled as PRFs (AES via\nthe PRP/PRF switching lemma, the ChaCha20 block function) imply that PRFs\nexist. PRFs are the assumption behind client-preprocessing PIR such as\n`[ZPSZ24]` and `[LP24]`, behind the\nsymmetric-key pseudorandom correlation functions of `[IKR26]`,\nand behind the PRF and PRF_msg components of SPHINCS+ (`[HKB+19]`).","heading":"Relations"}],"slug":"prf","status":"registry","subtitle":"symmetric","summary":"A keyed function family \\( F : \\{0,1\\}^{\\lambda} \\times \\{0,1\\}^{n} \\to \\{0,1\\}^{m} \\) is a pseudorandom function if, for a uniformly random key \\( k \\), no probabilistic polynomial-time adversary with oracle access to \\( F(k, \\cdot) \\) distinguishes it from a uniformly random function \\( \\{0,1\\}^n \\to \\{0,1\\}^m \\) with non-negligible advantage.","tags":["symmetric","standard"],"title":"Pseudorandom functions (PRF)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-PRF"},{"evidence":"registry","id":"ASM-RLWE","keywords":["lattice","standard"],"metadata":{"aliases":["Ring Learning With Errors","Ring-LWE","ring-lwe","rlwe"],"falsifiable":true,"family":"lattice","id":"ASM-RLWE","implied_by":["ASM-IDEAL-SVP"],"implied_by_records":[{"id":"ASM-IDEAL-SVP","name":"Worst-case approximate SVP on ideal lattices (Ideal-SVP)"}],"implies":["ASM-RSIS"],"implies_records":[{"id":"ASM-RSIS","name":"Ring short integer solution (Ring-SIS)"}],"introduced_in":{"citation":"Vadim Lyubashevsky, Chris Peikert, Oded Regev, On Ideal Lattices and Learning with Errors over Rings, EUROCRYPT 2010; J. ACM 60(6), 2013","url":"https://doi.org/10.1007/978-3-642-13190-5_1"},"kind":"standard","name":"Ring learning with errors (Ring-LWE)","post_quantum":true,"references":[{"citation":"Vadim Lyubashevsky, Chris Peikert, Oded Regev, On Ideal Lattices and Learning with Errors over Rings, J. ACM 60(6), 2013","url":"https://doi.org/10.1145/2535925"},{"citation":"Damien Stehlé, Ron Steinfeld, Keisuke Tanaka, Keita Xagawa, Efficient Public Key Encryption Based on Ideal Lattices, ASIACRYPT 2009","url":"https://doi.org/10.1007/978-3-642-10366-7_36"},{"citation":"Yara Elias, Kristin E. Lauter, Ekin Ozman, Katherine E. Stange, Provably Weak Instances of Ring-LWE, CRYPTO 2015","url":"https://doi.org/10.1007/978-3-662-47989-6_4"},{"citation":"Chris Peikert, How (Not) to Instantiate Ring-LWE, SCN 2016","url":"https://doi.org/10.1007/978-3-319-44618-9_22"},{"citation":"Ronald Cramer, Léo Ducas, Benjamin Wesolowski, Short Stickelberger Class Relations and Application to Ideal-SVP, EUROCRYPT 2017","url":"https://doi.org/10.1007/978-3-319-56620-7_12"}],"status":"As of 2026-10-10 no attack on Ring-LWE over cyclotomic rings with error distributions covered by the worst-case reduction is known to beat generic lattice reduction; known breaks apply only to non-standard rings or error distributions narrower than the reductions require."},"primaryUrl":"https://doi.org/10.1007/978-3-642-13190-5_1","sections":[{"content":"Let \\( K \\) be a number field of degree \\( n \\) with ring of integers\n\\( R \\) (the standard choice is the power-of-two cyclotomic ring\n\\( R = \\mathbb{Z}[x]/(x^n + 1) \\)), let \\( q \\) be a modulus and\n\\( R_q = R / qR \\). Let \\( \\chi \\) be an error distribution on \\( R \\) (a\ndiscrete Gaussian in the canonical embedding, on \\( R \\) or on its dual\n\\( R^\\vee \\)). For a secret \\( s \\in R_q \\), a sample is\n\n\\[\n(a, \\; b = a \\cdot s + e) \\in R_q \\times R_q, \\qquad a \\leftarrow R_q,\\; e \\leftarrow \\chi .\n\\]\n\nSearch Ring-LWE asks to recover \\( s \\) from polynomially many samples.\nDecision Ring-LWE asks to distinguish such samples from uniform pairs in\n\\( R_q \\times R_q \\).","heading":"Definition"},{"content":"Lyubashevsky, Peikert and Regev (2010) gave a quantum reduction from the\nworst-case approximate shortest vector problem on ideal lattices in \\( K \\) to search Ring-LWE, and a search-to-decision reduction for\ncyclotomic rings and suitable moduli. Each sample gives \\( n \\) correlated LWE\nsamples, which is the source of the efficiency gain over plain LWE.\n\nElias, Lauter, Ozman and Stange (2015) broke decision Ring-LWE for explicit\nfamilies of non-cyclotomic fields; Peikert (2016) showed these weak instances\nuse spherical errors far narrower than the hardness theorems require, and that\ninstantiations meeting the worst-case reduction are immune to that attack.\nQuantum algorithms for Ideal-SVP with approximation factor\n\\( 2^{\\tilde O(\\sqrt n)} \\) in cyclotomic fields (Cramer, Ducas and Wesolowski\n2017) do not reach the polynomial factors behind Ring-LWE, and that paper states\nthat Ring-LWE does not appear to be directly affected.","heading":"Status"},{"content":"Worst-case Ideal-SVP hardness implies Ring-LWE by a quantum reduction. Ring-LWE\nis the rank-1 case of Module-LWE (ASM-MLWE). As with LWE and SIS, a Ring-SIS\nsolver (ASM-RSIS) with small enough norm distinguishes Ring-LWE samples, so\nRing-LWE with matching parameters implies Ring-SIS. Hardness of plain LWE is not known to imply Ring-LWE, and conversely.","heading":"Relations"}],"slug":"rlwe","status":"registry","subtitle":"lattice","summary":"Let \\( K \\) be a number field of degree \\( n \\) with ring of integers \\( R \\) (the standard choice is the power-of-two cyclotomic ring \\( R = \\mathbb{Z}[x]/(x^n + 1) \\)), let \\( q \\) be a modulus and \\( R_q = R / qR \\).","tags":["lattice","standard"],"title":"Ring learning with errors (Ring-LWE)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-RLWE"},{"evidence":"registry","id":"ASM-ROM","keywords":["idealized_model","idealized_model"],"metadata":{"aliases":[],"falsifiable":false,"family":"idealized_model","id":"ASM-ROM","implied_by":[],"implied_by_records":[],"implies":[],"implies_records":[],"introduced_in":{"citation":"Mihir Bellare and Phillip Rogaway, Random Oracles are Practical: A Paradigm for Designing Efficient Protocols, ACM CCS 1993","url":"https://doi.org/10.1145/168588.168596"},"kind":"idealized_model","name":"Random oracle model (ROM)","post_quantum":"not_applicable","references":[{"citation":"Mihir Bellare and Phillip Rogaway, Random Oracles are Practical: A Paradigm for Designing Efficient Protocols, ACM CCS 1993","url":"https://doi.org/10.1145/168588.168596"},{"citation":"Ran Canetti, Oded Goldreich, Shai Halevi, The Random Oracle Methodology, Revisited, STOC 1998; J. ACM 51(4), 2004","url":"https://doi.org/10.1145/1008731.1008734"},{"citation":"Dan Boneh, Özgür Dagdelen, Marc Fischlin, Anja Lehmann, Christian Schaffner, Mark Zhandry, Random Oracles in a Quantum World, ASIACRYPT 2011","url":"https://doi.org/10.1007/978-3-642-25385-0_3"}],"status":"As of 2026-10-10 the random oracle heuristic is not known to fail for any natural scheme in wide use, but there are artificial schemes that are secure in the ROM and insecure under every concrete hash function (Canetti, Goldreich, Halevi 1998)."},"primaryUrl":"https://doi.org/10.1145/168588.168596","sections":[{"content":"A proof in the random oracle model gives every party, honest or adversarial,\noracle access to a uniformly random function\n\\( H : \\{0,1\\}^* \\to \\{0,1\\}^{\\ell} \\) (or to a random function into a group or\nanother range). The reduction may observe the adversary's oracle queries and\nchoose the answers (\"programming\"), as long as the answers are distributed\nuniformly. A scheme is then deployed with \\( H \\) replaced by a concrete hash\nfunction such as SHA-2 or SHA-3. The model is a heuristic: it is not a\nhardness assumption about any concrete function.\n\nIn the quantum random oracle model (QROM) the adversary may query \\( H \\) in\nsuperposition, which is the appropriate model when the adversary is quantum\nand \\( H \\) is a public hash function.","heading":"Definition"},{"content":"Canetti, Goldreich and Halevi constructed signature and encryption schemes that\nare secure in the random oracle model but insecure for every efficiently\ncomputable instantiation of the oracle. Their schemes are artificial; no\ncomparable failure is known for natural schemes such as RSA-OAEP\n(`[BR94]`), Fiat-Shamir signatures (`[FS86]`) or the\nFujisaki-Okamoto transform (`[FO99]`) when instantiated with\nstandard hash functions. Because the instantiation claim is not a\nstatement about a fixed computational problem, it is not falsifiable in the\nusual sense.\n\nClassical ROM proofs that rewind the adversary or inspect its queries do not\nautomatically carry over to quantum adversaries; Boneh et al. (2011)\nintroduced the QROM for that reason, and many Fiat-Shamir and\nFujisaki-Okamoto results have since been re-proved there.","heading":"Status"},{"content":"The ROM is often combined with a concrete assumption (for example RSA with\nrandom oracles for OAEP, ASM-RSA; or generic groups with random oracles,\nGeneric group model (GGM), including the generic bilinear group model). A security proof \"in the ROM under assumption X\" assumes both the\nidealized hash function and the hardness of X; it says nothing about security\nwith a concrete hash function beyond the heuristic.","heading":"Relations"}],"slug":"rom","status":"registry","subtitle":"idealized model","summary":"A proof in the random oracle model gives every party, honest or adversarial, oracle access to a uniformly random function \\( H : \\{0,1\\}^* \\to \\{0,1\\}^{\\ell} \\) (or to a random function into a group or another range).","tags":["idealized_model","idealized_model"],"title":"Random oracle model (ROM)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-ROM"},{"evidence":"registry","id":"ASM-RSA","keywords":["factoring","standard"],"metadata":{"aliases":["RSA inversion"],"falsifiable":true,"family":"factoring","id":"ASM-RSA","implied_by":["ASM-STRONG-RSA"],"implied_by_records":[{"id":"ASM-STRONG-RSA","name":"Strong RSA assumption (strong RSA)"}],"implies":["ASM-FACTORING","ASM-TDP"],"implies_records":[{"id":"ASM-FACTORING","name":"Integer factorization (factoring)"},{"id":"ASM-TDP","name":"Trapdoor one-way permutations (TDP)"}],"introduced_in":{"citation":"Ronald L. Rivest, Adi Shamir, Leonard Adleman, A Method for Obtaining Digital Signatures and Public-Key Cryptosystems, Commun. ACM 21(2), 1978","url":"https://doi.org/10.1145/359340.359342"},"kind":"standard","name":"RSA assumption (RSA)","post_quantum":false,"references":[{"citation":"Ronald L. Rivest, Adi Shamir, Leonard Adleman, A Method for Obtaining Digital Signatures and Public-Key Cryptosystems, Commun. ACM 21(2), 1978","url":"https://doi.org/10.1145/359340.359342"},{"citation":"Dan Boneh and Ramarathnam Venkatesan, Breaking RSA May Not Be Equivalent to Factoring, EUROCRYPT 1998","url":"https://doi.org/10.1007/BFb0054117"},{"citation":"Divesh Aggarwal and Ueli Maurer, Breaking RSA Generically Is Equivalent to Factoring, EUROCRYPT 2009","url":"https://doi.org/10.1007/978-3-642-01001-9_2"},{"citation":"Michael J. Wiener, Cryptanalysis of Short RSA Secret Exponents, IEEE Trans. Inf. Theory 36(3), 1990","url":"https://doi.org/10.1109/18.54902"},{"citation":"Dan Boneh and Glenn Durfee, Cryptanalysis of RSA with Private Key d Less than N^0.292, EUROCRYPT 1999","url":"https://doi.org/10.1007/3-540-48910-X_1"}],"status":"As of 2026-10-10 no way to invert RSA with properly generated keys is known other than factoring the modulus; it is broken in quantum polynomial time by Shor's algorithm, and it is open whether RSA is as hard as factoring."},"primaryUrl":"https://doi.org/10.1145/359340.359342","sections":[{"content":"Let \\( N = pq \\) be a product of two random primes of equal length and let\n\\( e \\) be an exponent with \\( \\gcd(e, \\varphi(N)) = 1 \\) (fixed small values\nsuch as \\( e = 65537 \\), or random). The RSA assumption states that, given\n\\( (N, e) \\) and a uniformly random \\( y \\in \\mathbb{Z}_N^* \\), no\nprobabilistic polynomial-time algorithm computes \\( x \\) with\n\n\\[\nx^{e} \\equiv y \\pmod N\n\\]\n\nwith non-negligible probability. The function \\( x \\mapsto x^e \\bmod N \\) is a\npermutation of \\( \\mathbb{Z}_N^* \\) with trapdoor \\( d = e^{-1} \\bmod \\varphi(N) \\).","heading":"Definition"},{"content":"Factoring \\( N \\) breaks RSA, and no better general attack is known; Integer factorization (factoring)\ndescribes the current factoring frontier and\nShor's quantum algorithm. Whether RSA inversion is as hard as factoring is\nopen: Boneh and Venkatesan (1998) show that for small \\( e \\) an algebraic\nreduction from factoring is unlikely, while Aggarwal and Maurer (2009) show\nthat breaking RSA with generic ring algorithms is equivalent to factoring.\nAttacks on key generation choices, such as a small private exponent\n\\( d < N^{0.292} \\) (Wiener 1990; Boneh and Durfee 1999), or on unpadded use\nwith small \\( e \\), concern parameter or usage choices rather than the\nassumption itself.","heading":"Status"},{"content":"RSA implies factoring and gives a candidate trapdoor permutation.\nStrong RSA (ASM-STRONG-RSA), where the adversary may choose the exponent,\nimplies RSA. RSA-OAEP (`[BR94]`), RSA-PSS (`[BR96]`)\nand Shoup's threshold RSA (`TSIG-PAPER-2000-SHOUP`) are proven secure from RSA\nin the random oracle model (ASM-ROM).","heading":"Relations"}],"slug":"rsa","status":"registry","subtitle":"factoring","summary":"Let \\( N = pq \\) be a product of two random primes of equal length and let \\( e \\) be an exponent with \\( \\gcd(e, \\varphi(N)) = 1 \\) (fixed small values such as \\( e = 65537 \\), or random).","tags":["factoring","standard"],"title":"RSA assumption (RSA)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-RSA"},{"evidence":"registry","id":"ASM-RSIS","keywords":["lattice","standard"],"metadata":{"aliases":["Ring-SIS (SIS over ideal lattices)"],"falsifiable":true,"family":"lattice","id":"ASM-RSIS","implied_by":["ASM-IDEAL-SVP","ASM-RLWE"],"implied_by_records":[{"id":"ASM-IDEAL-SVP","name":"Worst-case approximate SVP on ideal lattices (Ideal-SVP)"},{"id":"ASM-RLWE","name":"Ring learning with errors (Ring-LWE)"}],"implies":[],"implies_records":[],"introduced_in":{"citation":"Vadim Lyubashevsky and Daniele Micciancio, Generalized Compact Knapsacks Are Collision Resistant, ICALP 2006","url":"https://doi.org/10.1007/11787006_13"},"kind":"standard","name":"Ring short integer solution (Ring-SIS)","post_quantum":true,"references":[{"citation":"Daniele Micciancio, Generalized Compact Knapsacks, Cyclic Lattices, and Efficient One-Way Functions, Computational Complexity 16(4), 2007 (FOCS 2002)","url":"https://doi.org/10.1007/s00037-007-0234-9"},{"citation":"Vadim Lyubashevsky and Daniele Micciancio, Generalized Compact Knapsacks Are Collision Resistant, ICALP 2006","url":"https://doi.org/10.1007/11787006_13"},{"citation":"Chris Peikert and Alon Rosen, Efficient Collision-Resistant Hashing from Worst-Case Assumptions on Cyclic Lattices, TCC 2006","url":"https://doi.org/10.1007/11681878_8"}],"status":"As of 2026-10-10 no attack on Ring-SIS over rings with irreducible defining polynomial (such as \\( x^n + 1 \\)) is known to beat generic lattice reduction; over \\( \\mathbb{Z}[x]/(x^n - 1) \\) the problem is easy, which is why that ring is excluded."},"primaryUrl":"https://doi.org/10.1007/11787006_13","sections":[{"content":"Let \\( R = \\mathbb{Z}[x]/(f(x)) \\) with \\( f \\) monic, irreducible and of degree\n\\( n \\) (the standard choice is \\( f = x^n + 1 \\) with \\( n \\) a power of two),\nand \\( R_q = R/qR \\). Given \\( m \\) uniformly random elements\n\\( a_1, \\dots, a_m \\in R_q \\), find \\( z_1, \\dots, z_m \\in R \\), not all zero,\nwith\n\n\\[\n\\sum_{i=1}^{m} a_i z_i \\equiv 0 \\pmod q, \\qquad \\lVert (z_1, \\dots, z_m) \\rVert \\le \\beta .\n\\]\n\nEquivalently, find a collision in the compact knapsack function\n\\( (z_i) \\mapsto \\sum_i a_i z_i \\) restricted to short inputs.","heading":"Definition"},{"content":"Micciancio (2002) showed one-wayness of the compact knapsack from worst-case\nproblems on cyclic lattices. Lyubashevsky and Micciancio (2006) and,\nindependently, Peikert and Rosen (2006) showed that the knapsack is\ncollision resistant, i.e. that Ring-SIS is hard on average, assuming the\nworst-case hardness of approximate SVP on ideal lattices in \\( R \\) for\nirreducible \\( f \\); for \\( f = x^n - 1 \\) collisions are easy to find, which\nshows that the irreducibility condition is needed. Attacks on cryptographic\nparameters use generic lattice reduction.","heading":"Status"},{"content":"Worst-case Ideal-SVP hardness implies Ring-SIS by classical\nreductions. Ring-LWE (ASM-RLWE) with matching parameters implies Ring-SIS.\nRing-SIS is the rank-1 case of Module-SIS (ASM-MSIS) and the ring analogue of\nSIS. The Falcon signature (`[FHK+20]`) relies on SIS over\nNTRU lattices, which combines Ring-SIS with the NTRU assumption;\nthe two-round threshold signature `TSIG-PAPER-2023-GKS` relies on Ring-LWE and\nRing-SIS.","heading":"Relations"}],"slug":"rsis","status":"registry","subtitle":"lattice","summary":"Let \\( R = \\mathbb{Z}[x]/(f(x)) \\) with \\( f \\) monic, irreducible and of degree \\( n \\) (the standard choice is \\( f = x^n + 1 \\) with \\( n \\) a power of two), and \\( R_q = R/qR \\).","tags":["lattice","standard"],"title":"Ring short integer solution (Ring-SIS)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-RSIS"},{"evidence":"registry","id":"ASM-SELFTARGET-MSIS","keywords":["lattice","new"],"metadata":{"aliases":[],"falsifiable":true,"family":"lattice","id":"ASM-SELFTARGET-MSIS","implied_by":[],"implied_by_records":[],"implies":[],"implies_records":[],"introduced_in":{"citation":"Eike Kiltz, Vadim Lyubashevsky, Christian Schaffner, A Concrete Treatment of Fiat-Shamir Signatures in the Quantum Random-Oracle Model, EUROCRYPT 2018","url":"https://doi.org/10.1007/978-3-319-78372-7_18"},"kind":"new","name":"Self-target Module-SIS (SelfTargetMSIS)","post_quantum":true,"references":[{"citation":"Eike Kiltz, Vadim Lyubashevsky, Christian Schaffner, A Concrete Treatment of Fiat-Shamir Signatures in the Quantum Random-Oracle Model, EUROCRYPT 2018 (ePrint 2017/916)","url":"https://eprint.iacr.org/2017/916"},{"citation":"Kelsey A. Jackson, Carl A. Miller, Daochen Wang, Evaluating the Security of CRYSTALS-Dilithium in the Quantum Random Oracle Model, EUROCRYPT 2024 (arXiv:2312.16619)","url":"https://arxiv.org/abs/2312.16619"},{"citation":"NIST, FIPS 204: Module-Lattice-Based Digital Signature Standard, August 2024","url":"https://doi.org/10.6028/NIST.FIPS.204"}],"status":"As of 2026-10-10 SelfTargetMSIS reduces to Module-SIS in the classical random oracle model by forking, and a quantum random oracle reduction from Module-LWE is known for a restricted parameter family (2024); no attack is known for the ML-DSA parameters."},"primaryUrl":"https://doi.org/10.1007/978-3-319-78372-7_18","sections":[{"content":"Let \\( A \\leftarrow R_q^{k \\times \\ell} \\) and \\( t \\leftarrow R_q^{k} \\) be\nuniform, and let \\( H : \\{0,1\\}^* \\to B_\\tau \\) be a hash function onto\npolynomials with \\( \\tau \\) coefficients in \\( \\{\\pm 1\\} \\) and the rest zero,\nmodelled as a (quantum) random oracle. SelfTargetMSIS asks for a message\n\\( \\mu \\) and a short vector \\( y = (z, c, v) \\) with\n\n\\[\nH\\big(\\mu \\,\\|\\, [\\, A \\mid t \\mid I \\,] \\cdot y \\big) = c, \\qquad \\lVert y \\rVert_\\infty \\le \\beta .\n\\]\n\nThe target \\( c \\) is produced by hashing the solver's own output, hence the\nname. Forging a Dilithium signature yields such a solution.","heading":"Definition"},{"content":"Kiltz, Lyubashevsky and Schaffner (2018) introduced the problem to give a\ntight security proof of Dilithium in the quantum random oracle model from\nModule-LWE plus SelfTargetMSIS. In the classical random oracle model a\nnon-tight forking-lemma argument reduces it to Module-SIS (ASM-MSIS); forking\ndoes not carry over to quantum adversaries. Jackson, Miller and Wang (2024)\ngave a quantum random oracle reduction from Module-LWE for moduli\n\\( q \\equiv 1 \\bmod 2n \\) and parameters with larger keys and signatures than\nthose of ML-DSA. The security of ML-DSA (`[NIST24/FIPS204]`) at its\nstandardized parameters is estimated by treating SelfTargetMSIS as hard as\nModule-SIS.","heading":"Status"},{"content":"SelfTargetMSIS depends on the hash function, so its relation to Module-SIS\n(ASM-MSIS) and Module-LWE (ASM-MLWE) holds only in idealized models (ASM-ROM)\nand is not an unconditional implication. Threshold Raccoon\n(`TSIG-PAPER-2024-RACCOON`) and Dilithium (`[DKL+18]`) use it\nfor unforgeability.","heading":"Relations"}],"slug":"selftarget-msis","status":"registry","subtitle":"lattice","summary":"Let \\( A \\leftarrow R_q^{k \\times \\ell} \\) and \\( t \\leftarrow R_q^{k} \\) be uniform, and let \\( H : \\{0,1\\}^* \\to B_\\tau \\) be a hash function onto polynomials with \\( \\tau \\) coefficients in \\( \\{\\pm 1\\} \\) and the rest zero, modelled as a (quantum) random oracle.","tags":["lattice","new"],"title":"Self-target Module-SIS (SelfTargetMSIS)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-SELFTARGET-MSIS"},{"evidence":"registry","id":"ASM-STRONG-RSA","keywords":["factoring","standard"],"metadata":{"aliases":["strong RSA assumption"],"falsifiable":true,"family":"factoring","id":"ASM-STRONG-RSA","implied_by":[],"implied_by_records":[],"implies":["ASM-RSA"],"implies_records":[{"id":"ASM-RSA","name":"RSA assumption (RSA)"}],"introduced_in":{"citation":"Niko Barić and Birgit Pfitzmann, Collision-Free Accumulators and Fail-Stop Signature Schemes Without Trees, EUROCRYPT 1997","url":"https://doi.org/10.1007/3-540-69053-0_33"},"kind":"standard","name":"Strong RSA assumption (strong RSA)","post_quantum":false,"references":[{"citation":"Niko Barić and Birgit Pfitzmann, Collision-Free Accumulators and Fail-Stop Signature Schemes Without Trees, EUROCRYPT 1997","url":"https://doi.org/10.1007/3-540-69053-0_33"},{"citation":"Eiichiro Fujisaki and Tatsuaki Okamoto, Statistical Zero Knowledge Protocols to Prove Modular Polynomial Relations, CRYPTO 1997","url":"https://doi.org/10.1007/BFb0052225"},{"citation":"Ronald Cramer and Victor Shoup, Signature Schemes Based on the Strong RSA Assumption, ACM TISSEC 3(3), 2000 (ACM CCS 1999)","url":"https://doi.org/10.1145/357830.357847"}],"status":"As of 2026-10-10 no attack on strong RSA is known other than factoring the modulus; it is broken in quantum polynomial time by Shor's algorithm."},"primaryUrl":"https://doi.org/10.1007/3-540-69053-0_33","sections":[{"content":"Let \\( N \\) be an RSA modulus (often a product of two safe primes). Given\n\\( N \\) and a uniformly random \\( y \\in \\mathbb{Z}_N^* \\), the strong RSA\nassumption states that no probabilistic polynomial-time algorithm outputs a\npair \\( (x, e) \\) with \\( e > 1 \\) and\n\n\\[\nx^{e} \\equiv y \\pmod N .\n\\]\n\nUnlike the RSA assumption, the adversary chooses the exponent \\( e \\).","heading":"Definition"},{"content":"Factoring \\( N \\) breaks the assumption, and no other attack is known.\nBarić and Pfitzmann (1997) and, independently, Fujisaki and Okamoto (1997)\nintroduced it. It underlies the Cramer-Shoup signature scheme without random\noracles (`[CS99]`), RSA accumulators, and the integer commitments\nand range proofs over RSA groups used in Paillier-based threshold ECDSA\nprotocols such as `TSIG-PAPER-2020-CGGMP`.","heading":"Status"},{"content":"Strong RSA implies RSA (ASM-RSA) for every fixed exponent, hence also\nfactoring. The converse is not known: an algorithm for strong\nRSA may output roots only for exponents of its own choosing, which does not\ninvert RSA for a prescribed exponent.","heading":"Relations"}],"slug":"strong-rsa","status":"registry","subtitle":"factoring","summary":"Let \\( N \\) be an RSA modulus (often a product of two safe primes).","tags":["factoring","standard"],"title":"Strong RSA assumption (strong RSA)","type":"assumption","venue":null,"year":null,"sourcePath":"data/threshold-signature-catalog.json#ASM-STRONG-RSA"}],"notation":[{"aliases":[{"paper":"TSIG-PAPER-2020-FROST","writes":"n"},{"paper":"TSIG-PAPER-2024-RACCOON","writes":"N"},{"paper":"TSIG-PAPER-2000-SHOUP","writes":"l"}],"meaning":"Total number of key-share holders.","regime":"Threshold signing.","symbol":"n"},{"aliases":[{"paper":"TSIG-PAPER-2020-FROST","writes":"t"},{"paper":"TSIG-PAPER-2024-RACCOON","writes":"T"},{"paper":"TSIG-PAPER-2025-CKKTZ","writes":"t+1"},{"paper":"TSIG-PAPER-2000-SHOUP","writes":"k"}],"meaning":"Minimum number of shares/signers required to sign.","regime":"Threshold signing; this is not the tolerated-corruption count.","symbol":"t"},{"aliases":[{"paper":"TSIG-PAPER-2025-CKKTZ","writes":"t_c"},{"paper":"TSIG-PAPER-2025-FAFROST","writes":"t_c"}],"meaning":"Number of tolerated corruptions, as stated by the security theorem.","regime":"Threshold signing; it need not equal \\(t-1\\).","symbol":"t_c"},{"aliases":[],"meaning":"Computational security parameter.","regime":"Threshold-signature security.","symbol":"\\lambda"},{"aliases":[{"paper":"TSIG-PAPER-2020-FROST","writes":"q"}],"meaning":"Prime order of the signing group.","regime":"Schnorr groups.","symbol":"q"},{"aliases":[],"meaning":"Depth of the circuit evaluated inside the generic threshold construction.","regime":"BGGJKRS circuit-based construction.","symbol":"d"},{"aliases":[{"paper":"TSIG-PAPER-2025-FAFROST","writes":"q_{sig}"}],"meaning":"Number of signing queries/sessions counted by the source theorem.","regime":"Threshold-signature reductions.","symbol":"q_{\\mathrm{sig}}"}],"primer":{"id":"TSIG-PRIMER","keyProblems":["TSIG-OP-001","TSIG-OP-007"],"sections":[{"content":"In a \\(t\\)-out-of-\\(n\\) threshold signature scheme, the signing key of a\nsignature scheme is secret-shared among \\(n\\) parties. Any authorized set runs\na signing protocol whose output verifies under the single public key; the key\nis never reconstructed. Unforgeability must hold against an adversary that\ncorrupts fewer parties than the threshold and takes part in arbitrarily many\nsigning sessions. The paradigm goes back to threshold cryptosystems\n(TSIG-PAPER-1989-DF). A threshold signature uses one shared key; a\nmultisignature combines independent keys.","heading":"What it is"},{"content":"$17","heading":"Core notions"},{"content":"$18","heading":"Main approaches"},{"content":"$19","heading":"Notation"},{"content":"This topic covers protocols in which one signing key is secret-shared and an\nauthorized subset produces a publicly verifiable signature without\nreconstructing it, including DKG, refresh, and identifiable-abort results that\nchange the protocol. Multisignatures, aggregate signatures, threshold\nencryption, and generic MPC are outside it; ordinary signatures have their own\ntopic.","heading":"Scope of this atlas"}],"sources":["TSIG-PAPER-1999-GJKR-DKG","TSIG-PAPER-2000-SHOUP","TSIG-PAPER-2003-BOLDYREVA","TSIG-PAPER-2020-FROST","TSIG-PAPER-2020-CGGMP","TSIG-PAPER-2024-RACCOON","TSIG-PAPER-1989-DF","TSIG-PAPER-1991-PEDERSEN","TSIG-PAPER-1996-GJKR-RSA","TSIG-PAPER-2023-OLAF","TSIG-PAPER-2021-GKMN","TSIG-PAPER-2024-GLACIUS","TSIG-PAPER-2017-LINDELL","TSIG-PAPER-2018-GG","TSIG-PAPER-2019-DKLS-N","TSIG-PAPER-2021-DOTT","TSIG-PAPER-2023-GKS","TSIG-PAPER-2024-FLOOD","TSIG-PAPER-2024-AOMMLWE","TSIG-PAPER-2024-TANG","TSIG-PAPER-2026-CELI","TSIG-PAPER-2026-QUORUS","TSIG-PAPER-2026-THED","TSIG-PAPER-2026-NIST8214C","TSIG-PAPER-2026-PASSELEGUE","TSIG-PAPER-2026-GEPTW","TSIG-PAPER-2018-BGGJKRS","TSIG-PAPER-2025-CKKTZ","TSIG-PAPER-2025-CCKM","TSIG-PAPER-2025-CHEN","TSIG-PAPER-2025-MSFROST","TSIG-PAPER-2025-FAFROST","TSIG-PAPER-2025-GLRS"],"startHere":["TSIG-PAPER-1999-GJKR-DKG","TSIG-PAPER-2000-SHOUP","TSIG-PAPER-2003-BOLDYREVA","TSIG-PAPER-2020-FROST","TSIG-PAPER-2020-CGGMP","TSIG-PAPER-2024-RACCOON"],"summary":"A signing key is secret-shared among n parties so that authorized subsets jointly produce a signature under one public key, while smaller coalitions can neither sign nor learn the key.","title":"Threshold signatures"},"propertyAssertions":[{"dimension":"setup_model","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2021-DOTT.md","id":"TSIG-PROP-01A7AF7F59CE8F","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2021-DOTT","value":"distributed public key and lattice trapdoor commitment machinery"},{"dimension":"threshold_policy","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2019-DKLSN.md","id":"TSIG-PROP-01E0DBC3BC39D0","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2019-DKLSN","value":"general t-out-of-n"},{"dimension":"resilience","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2003-BOLDYREVA.md","id":"TSIG-PROP-02D2F4F9CAB20F","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2003-BOLDYREVA","value":"threshold unforgeability under the stated bound"},{"dimension":"post_quantum_mechanism","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2021-DOTT.md","id":"TSIG-PROP-05D02995582C7D","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2021-DOTT","value":"Module-SIS and Module-LWE"},{"dimension":"communication","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2017-LINDELL.md","id":"TSIG-PROP-068606658DD3B6","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2017-LINDELL","value":"constant number of two-party messages; exact bytes parameter-dependent"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2020-CGGMP.md","id":"TSIG-PROP-06A4E91DAFB2AA","review_status":"scheme_declared","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2020-CGGMP","value":"noninteractive-online"},{"dimension":"post_quantum_mechanism","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-1996-GJKR-RSA.md","id":"TSIG-PROP-079D1E967A49BA","review_status":"bibliographic_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-1996-GJKR-RSA","value":"none"},{"dimension":"communication","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2018-GG.md","id":"TSIG-PROP-085B092E95C3A1","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2018-GG","value":"multiparty interactive protocol; exact accounting parameter-dependent"},{"dimension":"threshold_policy","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2024-GLACIUS.md","id":"TSIG-PROP-08811D68029BEB","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2024-GLACIUS","value":"full threshold range t<n under the paper's convention"},{"dimension":"primitive","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2024-AOMMLWE.md","id":"TSIG-PROP-0953B5E1A80D95","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2024-AOMMLWE","value":"threshold_signature"},{"dimension":"setup_model","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2022-DILIZIUM2.md","id":"TSIG-PROP-09BAD269FF15C8","review_status":"fulltext_preprint_reviewed_final_pending","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2022-DILIZIUM2","value":"two-party shared module-lattice secret and additively homomorphic commitment"},{"dimension":"adaptive_security","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2020-CGGMP.md","id":"TSIG-PROP-09E35D24F1150E","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2020-CGGMP","value":"UC/proactive profile; exact adaptive clauses follow paper"},{"dimension":"output_compatibility","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2020-CGGMP.md","id":"TSIG-PROP-0AA50D2FE4F5E5","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2020-CGGMP","value":"ordinary ECDSA signature"},{"dimension":"setup_model","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2018-DKLS2.md","id":"TSIG-PROP-0B8F6F45036AF1","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2018-DKLS2","value":"dealerless key generation with multiplicative (2-of-2) or Shamir-derived (2-of-n) ECDSA key shares; no Paillier encryption"},{"dimension":"preprocessing","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2024-RACCOON.md","id":"TSIG-PROP-0D661D44B4B95E","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2024-RACCOON","value":"pairwise PRF seeds provisioned at key generation; per-session additive masks are generated online"},{"dimension":"preprocessing","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2023-OLAF.md","id":"TSIG-PROP-0E1FF79AE4DB54","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2023-OLAF","value":"FROST-family nonce preprocessing options"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-1996-GJKR-DSS.md","id":"TSIG-PROP-0EB123718D8731","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-1996-GJKR-DSS","value":"threshold_dss"},{"dimension":"signing_rounds","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2024-GLACIUS.md","id":"TSIG-PROP-0F0843B6BCCE68","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2024-GLACIUS","value":"exact protocol phases follow paper"},{"dimension":"signing_rounds","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2018-GG.md","id":"TSIG-PROP-0F6D08596AF29C","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2018-GG","value":"interactive signing in Phases 1-5 with a masked signature check before shares are released (Section 4.2)"},{"dimension":"primitive","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2024-GLACIUS.md","id":"TSIG-PROP-0F80E5C3BA02BB","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2024-GLACIUS","value":"threshold_signature"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2020-CGGMP.md","id":"TSIG-PROP-0F8CBA62B974B0","review_status":"scheme_declared","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2020-CGGMP","value":"ordinary-verifier-output"},{"dimension":"threshold_policy","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2024-TANG.md","id":"TSIG-PROP-0FCF49193E8592","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2024-TANG","value":"arbitrary t-out-of-n"},{"dimension":"preprocessing","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2018-GG.md","id":"TSIG-PROP-117D0137819B5E","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2018-GG","value":"none claimed beyond key generation"},{"dimension":"post_quantum_mechanism","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2000-SHOUP.md","id":"TSIG-PROP-11E150AC59CEEB","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2000-SHOUP","value":"none"},{"dimension":"setup_model","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2023-OLAF.md","id":"TSIG-PROP-1227A803B6AACA","review_status":"primary_source_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2023-OLAF","value":"Pedersen-DKG variant composed with FROST3"},{"dimension":"communication","evidence_ref":"knowledge/primitives/threshold-signature/schemes/TSIG-CONSTRUCTION-2018-DKLS2.md","id":"TSIG-PROP-1315B9B4F8EA70","review_status":"fulltext_reviewed","scope":"construction","subject_id":"TSIG-CONSTRUCTION-2018-DKLS2","value":"dominated by OT extension; Table II of the reproduced paper reports 169.8 KiB per 2-of-2 signature at k
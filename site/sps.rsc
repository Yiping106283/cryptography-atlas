0:{"__route":"route:/abe","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/abe":"$L1","layout:/":[[[["$","link","css:/cryptography-atlas/assets/index-wKyRDquD.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/cryptography-atlas/assets/index-wKyRDquD.css","data-rsc-css-href":"/cryptography-atlas/assets/index-wKyRDquD.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"route:/abe":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Cryptography Landscape Atlas"}],["$","meta","1",{"name":"description","content":"Source-backed literature graphs, proof-system stacks, open-problem maps, and comparison workspaces across nine cryptography research dossiers."}],["$","meta","2",{"property":"og:title","content":"Cryptography Landscape Atlas"}],["$","meta","3",{"property":"og:description","content":"Source-backed literature graphs, proof-system stacks, open-problem maps, and comparison workspaces across nine cryptography research dossiers."}],["$","meta","4",{"property":"og:type","content":"website"}],["$","meta","5",{"property":"og:image","content":"/cryptography-atlas/og.png"}],["$","meta","6",{"property":"og:image:width","content":"1200"}],["$","meta","7",{"property":"og:image:height","content":"630"}],["$","meta","8",{"property":"og:image:alt","content":"Cryptography Landscape Atlas"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Cryptography Landscape Atlas"}],["$","meta","11",{"name":"twitter:description","content":"Source-backed literature graphs, proof-system stacks, open-problem maps, and comparison workspaces across nine cryptography research dossiers."}],["$","meta","12",{"name":"twitter:image","content":"/cryptography-atlas/og.png"}],["$","link","13",{"rel":"shortcut icon","href":"/cryptography-atlas/favicon.svg"}],["$","link","14",{"rel":"icon","href":"/cryptography-atlas/favicon.svg"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["abe"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/abe"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:14wa4i41g1agtc","deploymentVersion":"741276b2-712f-43b2-bc83-35139d5779a3","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}

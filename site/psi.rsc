-STASH","target":"ASM-PRF","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0B8BB5355E313D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-RR-CCS-SM","target":"PSI-CONTRIB-2017-RR-CCS-MALICIOUS-DUAL-EXECUTION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0BB78473A42DA7","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2018-PSWW","target":"PSI-CONTRIB-2018-PSWW-ALMOST-LINEAR-CIRCUIT","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0BF1E10D75899D","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2018-CHLR","target":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BFV","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0D756434ADE75C","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-KRSSW-NR","target":"PSI-CONTRIB-2019-KRSSW-CUCKOO-FILTER-COMPRESSION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0DAEB7EF2E45BB","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG-FROBENIUS","target":"PSI-CONTRIB-2021-CONG-FROBENIUS-POWERS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0DC548A07B7C16","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-BMRR","target":"PSI-CONTRIB-2021-BMRR-TAHE-THRESHOLD-PSI","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0DD1F945B8F6B1","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR-MAL-LEAKAGE","target":"PSI-CONTRIB-2018-CHLR-LABELED-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"PSTY19 §1 (p. 2), §3.2 (p. 12), and §3.3 (pp. 13-15), IACR ePrint 2019/241, PDF dated 2019-02-28","evidenceUrl":"https://eprint.iacr.org/2019/241","id":"PSI-REL-0DE1B85497C887","note":"PSTY19 adapts the polynomial OPPRF of KMPRT17 to a one-query definition that allows correlated targets and batches the hints of all bins into one polynomial of total size linear in the programmed points.","resultId":"PSI-CONTRIB-2017-KMPRT-OPPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-OPPRF","target":"PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF","type":"EXTENDS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0E881255D1D09D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-GS-FHE","target":"PSI-CONTRIB-2019-GS-FHE-UPPER-BOUND","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"PRTY20 §1.1 (pp. 2-3); Table 1 (p. 21); Table 2 (p. 24); Appendix D (pp. 34-35), IACR ePrint 2020/193, PDF dated 2020-02-16","evidenceUrl":"https://eprint.iacr.org/2020/193","id":"PSI-REL-0E9F2741697D11","note":"PaXoS-PSI improves on the communication of Rindal-Rosulek dual-execution malicious PSI from \\( O(\\kappa n \\log n) \\) to \\( O(\\kappa n) \\), replacing hashing into small bins with a PaXoS encoding over OOS; for \\( 2^{20} \\) items it reports 202.04 MB against 22,183 MB for the dual-execution variant with 64-bit items and 1,322 MB for the encode-commit variant.","resultId":"PSI-CONTRIB-2017-RR-CCS-MALICIOUS-DUAL-EXECUTION","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-RR-CCS-MALICIOUS-DUAL-EXECUTION","target":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0EB24F224A3E47","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2017-KMPRT","target":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-0F1B2A2BDC43E0","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR","target":"PSI-CONTRIB-2018-CHLR-OPRF-MALICIOUS-RECEIVER","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"RT21 abstract (p. 1), §1 (p. 2), §1.2 (pp. 5-6), IACR ePrint 2021/1159, version of October 17, 2021","evidenceUrl":"https://eprint.iacr.org/2021/1159","id":"PSI-REL-0FD49B8B26ED69","note":"RT21 present their malicious protocol as an improvement of the classic Diffie-Hellman protocol of Huberman, Franklin, and Hogg: \\( n + 1 \\) group elements plus n hashes against \\( 2n \\) group elements plus n hashes, while security rises from semi-honest to malicious.","resultId":"PSI-CONTRIB-1999-HFH-DH-PREFERENCE-MATCHING","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-1999-HFH-DH-PREFERENCE-MATCHING","target":"PSI-CONTRIB-2021-RT-KA-TO-MALICIOUS-PSI","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-10240C4087B03D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-CIRCUIT","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1042463AC082B8","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2019-KRSSW","target":"PSI-CONTRIB-2019-KRSSW-MOBILE-IMPLEMENTATION","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-111E952AAAF33A","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-SD","target":"PSI-CONTRIB-2021-RS-VOLE-OPRF","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-113D14CA5C332D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-SCS-HE","target":"PSI-CONTRIB-2012-HEK-SORT-COMPARE-SHUFFLE","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"PSTY19 §1 (p. 2), §1.4 (p. 7), and §5 (p. 19), IACR ePrint 2019/241, PDF dated 2019-02-28","evidenceUrl":"https://eprint.iacr.org/2019/241","id":"PSI-REL-113ED311360FE6","note":"PSTY19 reduces the \\( \\omega(n) \\) comparisons of the PSWW18 construction, \\( s \\cdot n \\) of which serve a stash of size \\( \\omega(1) \\), to \\( O(n) \\) comparisons and linear communication.","resultId":"PSI-CONTRIB-2018-PSWW-ALMOST-LINEAR-CIRCUIT","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2018-PSWW-ALMOST-LINEAR-CIRCUIT","target":"PSI-CONTRIB-2019-PSTY-LINEAR-COMMUNICATION","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"CMGD21 §4.1-4.2 (pp. 12-14), IACR ePrint 2021/1116, PDF dated 2021-11-14","evidenceUrl":"https://eprint.iacr.org/2021/1116","id":"PSI-REL-115A95705F25E1","note":"CMGD21 builds its labeled mode on the CHLR18 approach of encrypting labels under part of the OPRF output and interpolating the encrypted labels, adapting it to prime-field chunks.","resultId":"PSI-CONTRIB-2018-CHLR-LABELED-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2018-CHLR-LABELED-PSI","target":"PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-13D800CD82DAEB","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-BWA","target":"PSI-CONTRIB-2012-HEK-SIZE-AUDITING","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-13F94721DD9605","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2010-DT-BLIND-RSA","target":"PSI-PAPER-2010-DT","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1499A382DB9300","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2023-GS-TWO-PARTY","target":"PSI-PAPER-2019-GS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1583ABCE9B3C3A","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2004-FNP-CARDINALITY","target":"PSI-PAPER-2004-FNP","type":"DESCRIBED_IN"},{"evidenceLocator":"FNP04 §4.2 (pp. 6-8), EUROCRYPT 2004, LNCS 3027, printed pages","evidenceUrl":"https://doi.org/10.1007/978-3-540-24676-3_1","id":"PSI-REL-163DB9BD653BBB","note":"Balanced-allocation hashing splits the client's polynomial into low-degree bin polynomials, reducing the server's exponentiations from \\( O(k_C k_S) \\) to \\( O(k_C + k_S \\ln \\ln k_C) \\).","resultId":"PSI-CONTRIB-2004-FNP-OPE-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2004-FNP-OPE-PSI","target":"PSI-CONTRIB-2004-FNP-BALANCED-ALLOCATION-HASHING","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1690D4B82E4EB5","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-RS-SH","target":"PSI-PAPER-2021-RS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-16DA6BBAE47009","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-RT-SH-V2","target":"PSI-ASSUMPTION-ORACLE-DIFFIE-HELLMAN-WITH-ELLIGATOR-ENCODING-AND-RANDOM-ORACLES","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-17536F7E7FD8DE","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","target":"PSI-CONTRIB-2021-GPRTY-3H-GCT","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1781913A053D67","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-RT","target":"PSI-CONTRIB-2021-RT-SEMI-HONEST-DH-COMMUNICATION","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-182BFDE485D343","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR-LABELED","target":"PSI-CONTRIB-2018-CHLR-LONG-ITEMS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"PSTY19 abstract (p. 1), Table 3 (p. 25), and Table 5 (p. 27), IACR ePrint 2019/241, PDF dated 2019-02-28","evidenceUrl":"https://eprint.iacr.org/2019/241","id":"PSI-REL-199B0E702E23FB","note":"The stash-less OPPRF protocol communicates 2.6 to 12.8 times less and runs 2.8 to 5.8 times faster than the 2D cuckoo-hashing protocol, the previous best circuit-based PSI.","resultId":"PSI-CONTRIB-2018-PSWW-2D-CUCKOO-HASHING","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2018-PSWW-2D-CUCKOO-HASHING","target":"PSI-CONTRIB-2019-PSTY-LINEAR-COMMUNICATION","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"GS23 §1.3, paper outline paragraph, and footnote 5 (p. 4), IACR ePrint 2023/919, PDF dated 2023-06-12","evidenceUrl":"https://eprint.iacr.org/2023/919","id":"PSI-REL-19F72B2422AE70","note":"GS23 credit the two-party \\( O(\\lambda t \\,\\mathrm{polylog}\\, t) \\) bound without FHE to the GS19 construction combined with an observation of BMRR, and say their own two-party protocol does not improve on it asymptotically.","resultId":"PSI-CONTRIB-2021-BMRR-TAHE-THRESHOLD-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-BMRR-TAHE-THRESHOLD-PSI","target":"PSI-CONTRIB-2023-GS-PICT-COMPILER","type":"ANALYZES"},{"evidenceLocator":"RR22 §1 (p. 3); §5.1 and Table 1 (pp. 23-25), IACR ePrint 2022/320, PDF dated 2022-11-02","evidenceUrl":"https://eprint.iacr.org/2022/320","id":"PSI-REL-19FB02DBD7F11B","note":"The triangulation OKVS keeps weight-3 rows but replaces the three-hash table's wholesale 2-core solving and two traversals by greedy triangulation with a few dense columns; encoding \\( 2^{20} \\) items is 13 times faster and the expansion is 1.23 rather than 1.3.","resultId":"PSI-CONTRIB-2021-GPRTY-3H-GCT","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-GPRTY-3H-GCT","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1A252939674628","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2020-PRTY","target":"PSI-CONTRIB-2020-PRTY-PAXOS","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1AC44A104AB678","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-BMRR","target":"PSI-CONTRIB-2021-BMRR-FUNCTIONALITIES","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1B0E9C63D831BF","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-KRSSW-GC","target":"PSI-CONTRIB-2019-KRSSW-LOWMC-OPRF","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"RT21 Appendix A.1 (pp. 23-24) and A.2 (p. 26), IACR ePrint 2021/1159, version of October 17, 2021","evidenceUrl":"https://eprint.iacr.org/2021/1159","id":"PSI-REL-1C5D3C4A4E6179","note":"The semi-honest variants keep the malicious protocol's structure and drop the random oracles H1 and H2 used only for extraction, shortening the sender's keys; variant 2 also drops the ideal permutation.","resultId":"PSI-CONTRIB-2021-RT-KA-TO-MALICIOUS-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-RT-KA-TO-MALICIOUS-PSI","target":"PSI-CONTRIB-2021-RT-SEMI-HONEST-DH-COMMUNICATION","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1DAED6C0B8196F","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2020-ION-ROT","target":"PSI-ASSUMPTION-CPA-SECURE-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-AND-BATCHED-RANDOM-OT","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1DBE53C1A65874","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT","target":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"FNP04 §5 (pp. 9-13), EUROCRYPT 2004, LNCS 3027, printed pages","evidenceUrl":"https://doi.org/10.1007/978-3-540-24676-3_1","id":"PSI-REL-1E751F5208AE4C","note":"The malicious-client and malicious-server protocols modify PM-Semi-Honest, with balanced-allocation hashing, by cut-and-choose and by random-oracle derandomization.","resultId":"PSI-CONTRIB-2004-FNP-OPE-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2004-FNP-OPE-PSI","target":"PSI-CONTRIB-2004-FNP-MALICIOUS-OPE","type":"HARDENS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1EAF28445EF974","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-PSTY-NO-STASH","target":"PSI-PAPER-2019-PSTY","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1EFCB7B25CDB94","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2023-GS","target":"PSI-CONTRIB-2023-GS-MULTIPARTY-QUASILINEAR","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-1F3499DEEC553C","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2019-PSTY","target":"PSI-CONTRIB-2019-PSTY-LINEAR-COMMUNICATION","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-20147A6D0E2E38","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2017-RR-CCS-EC-ROM","target":"PSI-ASSUMPTION-RANDOM-ORACLE-COMMITMENT-H-X-R-AND-ORR-ORSINI-SCHOLL-OT-EXTENSION-IN-THE-PROGRAMMABLE-RANDOM-ORACLE-MODEL","type":"RELIES_ON"},{"evidenceLocator":"GS23 abstract (p. 1), §1 (p. 1), §1.2 (p. 2), and Corollary 6 (p. 16), IACR ePrint 2023/919, PDF dated 2023-06-12","evidenceUrl":"https://eprint.iacr.org/2023/919","id":"PSI-REL-2058D89E3B9920","note":"GS23 reuses the GS19 step for computing a large intersection and replaces the quadratic dependence on t of cardinality testing from additive HE by a quasilinear one, now for ℓ parties.","resultId":"PSI-CONTRIB-2019-GS-AHE-THRESHOLD-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2019-GS-AHE-THRESHOLD-PSI","target":"PSI-CONTRIB-2023-GS-MULTIPARTY-QUASILINEAR","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-20686C9D399B85","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-CONG","target":"PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER","type":"HAS_RESULT"},{"evidenceLocator":"CHLR18 §1.3 (p. 3), §4.1-4.2 (pp. 9-10), Theorem 1 (p. 15), IACR ePrint 2018/787, PDF dated 2018-08-27","evidenceUrl":"https://eprint.iacr.org/2018/787","id":"PSI-REL-206A9B2C15332E","note":"CHLR18 applies an OPRF to both sets before the CLR17 homomorphic intersection, which removes noise flooding, bin padding, and polynomial randomization and raises security from semi-honest to a malicious receiver (with privacy against a malicious sender).","resultId":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","target":"PSI-CONTRIB-2018-CHLR-OPRF-MALICIOUS-RECEIVER","type":"CHANGES_SECURITY_MODEL"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-20BD79B63F3E24","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MULTIPARTY","target":"PSI-CONTRIB-2021-GPRTY-OKVS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-22658F17999AAC","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-SCS-WN","target":"PSI-PAPER-2012-HEK","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-227F21C087CB5E","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2023-GS-MULTIPARTY","target":"PSI-PAPER-2023-GS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-234F766894EABD","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2004-FNP-MAL-SERVER","target":"PSI-ASSUMPTION-SEMANTICALLY-SECURE-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-AND-RANDOM-ORACLES","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-23FEB805CEE3D3","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2016-KKRT","target":"PSI-CONTRIB-2016-KKRT-ITEM-LENGTH-INDEPENDENT-PSI","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-243ADDD9FB3588","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2023-GS-TWO-PARTY","target":"PSI-CONTRIB-2019-GS-AHE-THRESHOLD-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"GS23 §1 (pp. 1-2), IACR ePrint 2023/919, PDF dated 2023-06-12","evidenceUrl":"https://eprint.iacr.org/2023/919","id":"PSI-REL-24B59806086C6C","note":"GS23 note that the BMRR \\( \\tilde O(\\lambda \\ell t) \\) protocol without FHE is equivalent to two-party threshold PSI for \\( \\ell = 2 \\) but for \\( \\ell > 2 \\) requires fewer than t distinct elements outside the intersection among all sets, a condition GS23's large-intersection protocol does not impose.","resultId":"PSI-CONTRIB-2021-BMRR-TAHE-THRESHOLD-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-BMRR-TAHE-THRESHOLD-PSI","target":"PSI-CONTRIB-2023-GS-MULTIPARTY-QUASILINEAR","type":"ANALYZES"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2574B49E930B76","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR-LABELED","target":"PSI-PAPER-2018-CHLR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-25CD94C7799A49","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-GPRTY","target":"PSI-CONTRIB-2021-GPRTY-AMPLIFICATION","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-26351E821018C3","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-FAST","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-26CA1CB064C7FF","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TFHE-INT","target":"PSI-PAPER-2021-BMRR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-26CC9B3AAA4283","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-PSWW-MIRROR","target":"PSI-CONTRIB-2018-PSWW-ALMOST-LINEAR-CIRCUIT","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2701D13374293D","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2017-KMPRT-SH","target":"PSI-ASSUMPTION-PRF-AND-RANDOM-ORACLE-WITH-THE-OPPRF-INSTANTIATED-FROM-THE-KKRT-BATCHED-OPRF","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-28D8D84A94AAC1","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR","target":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-296F6A56575366","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-GPRTY","target":"PSI-CONTRIB-2021-GPRTY-OKVS","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2BB6578D017FE1","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-PSZ-OT","target":"PSI-CONTRIB-2018-PSZ-BIT-LENGTH-INDEPENDENT-OT-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2D2B9AEFDD5DD3","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG","target":"PSI-CONTRIB-2018-CHLR-OPRF-MALICIOUS-RECEIVER","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2E0A9D8898C455","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2020-PRTY-MAL","target":"PSI-PAPER-2020-PRTY","type":"DESCRIBED_IN"},{"evidenceLocator":"NTY §5.1 and Tables 3-4 (pp. 11-12), IACR ePrint 2021/1221, PDF dated 2021-09-17","evidenceUrl":"https://eprint.iacr.org/2021/1221","id":"PSI-REL-2E0B17EADDFFFE","note":"NTY report 10-23 times lower client running time and 1.2-8.5 times lower total running time than the semi-honest KMPRT protocol, while being maliciously secure.","resultId":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","target":"PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2E1132920FB8BE","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-RR-CCS-DE-ROM","target":"PSI-PAPER-2017-RR-CCS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2E8E45BE32AE36","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2020-ION-DDH","target":"PSI-PAPER-2020-ION","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2E99B75DCFA85E","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2020-PRTY-MAL","target":"PSI-CONTRIB-2020-PRTY-RECEIVER-SET-SIZE-BOUND","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2EEED1619C4EEF","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2004-FNP-SH","target":"PSI-ASSUMPTION-SEMANTIC-SECURITY-OF-AN-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-SCHEME-PAILLIER-NAMED-AS-AN-INSTANCE","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-2F2F78778A5311","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-KRSSW-NR","target":"PSI-CONTRIB-2019-KRSSW-COT-PRECOMPUTATION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"RR22 §1.2 (p. 4); §4 (pp. 21-23); Figure 9 (p. 23); Table 2 (p. 25), IACR ePrint 2022/320, PDF dated 2022-11-02","evidenceUrl":"https://eprint.iacr.org/2022/320","id":"PSI-REL-2FA4627ED3F8E6","note":"Raghuraman and Rindal extend the VOLE-PSI protocol to subfield VOLE, so that the OKVS lives in a base field of about \\( \\lambda + \\log(n_x n_y) \\) bits; for \\( 2^{20} \\) items they report \\( 180n \\) bits against \\( 426n \\).","resultId":"PSI-CONTRIB-2021-RS-VOLE-OPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-RS-VOLE-OPRF","target":"PSI-CONTRIB-2022-RR-SUBFIELD-VOLE","type":"EXTENDS"},{"evidenceLocator":"RS21 §5 (p. 21); Figure 8 (p. 38), IACR ePrint 2021/266, PDF dated 2024-08-08","evidenceUrl":"https://eprint.iacr.org/2021/266","id":"PSI-REL-30B319AD9FC89F","note":"The OPPRF of the circuit-PSI is built on the VOLE-based OPRF of the same paper.","resultId":"PSI-CONTRIB-2021-RS-VOLE-OPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-RS-VOLE-OPRF","target":"PSI-CONTRIB-2021-RS-CIRCUIT-PSI","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-311AC61A5C7B4E","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-BMRR-AHE-TWO-PARTY","target":"PSI-ASSUMPTION-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-AND-YAO-GARBLED-CIRCUITS-NO-FURTHER-ASSUMPTION-STATED-FOR-THE-TWO-PARTY-CASE","type":"RELIES_ON"},{"evidenceLocator":"NTY §1.1.1 (p. 2), §2.0.3 (p. 5), Appendix B (p. 14), IACR ePrint 2021/1221, PDF dated 2021-09-17","evidenceUrl":"https://eprint.iacr.org/2021/1221","id":"PSI-REL-328E7C954B2CD2","note":"NTY instantiate the OPPRF of ZeroXOR with the maliciously secure PaXoS-based OPPRF, which resists a sender that programs a point in only some cuckoo bins.","resultId":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","target":"PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-32B2495F31622C","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-PSZ-OT","target":"PSI-CONTRIB-2018-PSZ-HASHING-PARAMETERS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"Ion et al. §4.3.1 (p. 9) and §5.1 (p. 11), IACR ePrint 2019/723, PDF dated 2020-09-05","evidenceUrl":"https://eprint.iacr.org/2019/723","id":"PSI-REL-3430B9E7A26F0F","note":"The random-OT protocol follows the batched-OPRF PSI of KKRT16, with its batched random OT, and adds a shuffle and re-masking of the OPRF outputs plus homomorphic tags so that the intersection stays hidden while its sum is computed.","resultId":"PSI-CONTRIB-2016-KKRT-ITEM-LENGTH-INDEPENDENT-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2016-KKRT-ITEM-LENGTH-INDEPENDENT-PSI","target":"PSI-CONTRIB-2020-ION-ROT-INTERSECTION-SUM","type":"EXTENDS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-3602C1B36BFC2F","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2019-KRSSW-GC","target":"PSI-ASSUMPTION-LOWMC-AS-A-PSEUDORANDOM-FUNCTION-AND-MALICIOUSLY-SECURE-OT-WITHOUT-A-PROOF","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-3885DC88C2D13E","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-FAST","target":"PSI-PAPER-2021-RS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-395BC637FEF55D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-PSWW-2D","target":"PSI-CONTRIB-2018-PSWW-2D-CUCKOO-HASHING","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"CMGD21 §1.2 (p. 3) and §3.1 (p. 7), IACR ePrint 2021/1116, PDF dated 2021-11-14","evidenceUrl":"https://eprint.iacr.org/2021/1116","id":"PSI-REL-3992B625BB8FD9","note":"CMGD21 replaces the extension-field SIMD slots that CHLR18 used for arbitrary-length items with items split over prime-field slots.","resultId":"PSI-CONTRIB-2018-CHLR-LONG-ITEMS","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2018-CHLR-LONG-ITEMS","target":"PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS","type":"CHANGES_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-39BC172EAE9C97","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-RS-SH","target":"PSI-ASSUMPTION-RANDOM-ORACLES-IN-THE-VECTOR-OLE-HYBRID-MODEL-VOLE-FROM-LPN-WITH-REGULAR-NOISE","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-3A8F3501F70E97","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","target":"PSI-PAPER-2020-PRTY",
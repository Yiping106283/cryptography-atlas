SI-PROP-A5A1C7C1415E7B","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2012-HEK-SCS-WN","value":"garbled_circuit_sort_compare_shuffle"},{"dimension":"adversary_scope","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2012-HEK-BWA.md","id":"PSI-PROP-A5EE56C5559673","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2012-HEK-BWA","value":"semi-honest parties; because set sizes are not restricted, a dishonest party could input all 1s and learn the other set, so the protocol should not be used standalone (§3, pp. 4-5)"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2023-GS-MULTIPARTY.md","id":"PSI-PROP-A60E9F0912F30E","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2023-GS-MULTIPARTY","value":"additively_homomorphic_encryption"},{"dimension":"output","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2022-RR-MAL.md","id":"PSI-PROP-A6528D1607840E","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2022-RR-MAL","value":"intersection"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF.md","id":"PSI-PROP-A65619D795E518","review_status":"scheme_declared","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","value":"no-fhe"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-KRSSW-GC.md","id":"PSI-PROP-A65FFABEB8ACBD","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-KRSSW-GC","value":"garbled_circuits"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF.md","id":"PSI-PROP-A66EFACE8786E6","review_status":"scheme_declared","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","value":"sublinear-in-set-size"},{"dimension":"setup","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-1999-HFH.md","id":"PSI-PROP-A685DEA413F63F","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-1999-HFH","value":"system-wide large prime p with a large prime factor q of \\( p - 1 \\) (Appendix A, p. 85); a cryptographic hash whose output cannot be easily influenced or predicted (§2, p. 79)"},{"dimension":"primitive","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-RS-SH.md","id":"PSI-PROP-A6DDFD0FAA0C17","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-RS-SH","value":"two-party PSI"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-CONG-LABELED.md","id":"PSI-PROP-A734022D92CCAC","review_status":"scheme_declared","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-CONG-LABELED","value":"labels-for-matching-items"},{"dimension":"adversary_scope","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2010-DT-FIG3.md","id":"PSI-PROP-A79F4A7DB750D5","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2010-DT-FIG3","value":"honest-but-curious client and server (§5.1, p. 6; Appendix B.2, p. 15)"},{"dimension":"set_size_regime","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2022-RR-SD.md","id":"PSI-PROP-A7B25462D54A8E","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2022-RR-SD","value":"balanced"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-CONG.md","id":"PSI-PROP-A815F7EBCB1FAE","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-CONG","value":"cuckoo_hashing"},{"dimension":"rounds","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION.md","id":"PSI-PROP-A8ADFEBB12C9CF","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION","value":"4 rounds: keys and OKVSs in parallel, then ZeroXOR with one zero-sharing round plus the OPPRF rounds (§4.2.1, p. 11; Table 1, p. 2)"},{"dimension":"primitive","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2020-ION-DDH.md","id":"PSI-PROP-A8D59FE33E9123","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2020-ION-DDH","value":"PSI cardinality and intersection-sum"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR.md","id":"PSI-PROP-A8D66439B3B295","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","value":"ot_extension"},{"dimension":"output_recipients","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2022-RR-FAST.md","id":"PSI-PROP-A8D95EA7F8A978","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2022-RR-FAST","value":"receiver only (Figure 9, step 5, p. 23; Figure 11, p. 32)"},{"dimension":"output","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2020-ION-ROT.md","id":"PSI-PROP-A94B7A9B4EDCA0","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2020-ION-ROT","value":"sum"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-GPRTY-VOLE.md","id":"PSI-PROP-A963B321B8DEA2","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-GPRTY-VOLE","value":"okvs_vole"},{"dimension":"security_model","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-RT-MAL.md","id":"PSI-PROP-A9C4E411B367FC","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-RT-MAL","value":"ideal_permutation_model"},{"dimension":"adversary_scope","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-CONG.md","id":"PSI-PROP-A9D93319C61A81","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-CONG","value":"security against a malicious receiver and privacy against a malicious sender, with the security proof of the earlier labeled-PSI paper carried over unchanged (§3, p. 6)"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-PSTY-BASIC.md","id":"PSI-PROP-A9FD2A70E58100","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-PSTY-BASIC","value":"batched_oprf"},{"dimension":"setup","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2017-RR-CCS-SM.md","id":"PSI-PROP-AA037348BBA519","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2017-RR-CCS-SM","value":"F_encode realized by σ chosen-message 1-out-of-2 OTs with the Keller-Orsini-Scholl OT extension and a PRF per encoding (§4, pp. 6-7; §7, p. 18); items of 32 or 64 bits, since hashing to a smaller domain needs a random oracle for extraction (§7, p. 18)"},{"dimension":"security_model","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2017-RR-CCS-DE-ROM.md","id":"PSI-PROP-AA236AFB95C0B5","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2017-RR-CCS-DE-ROM","value":"random_oracle_model"},{"dimension":"output","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-PSTY-BASIC.md","id":"PSI-PROP-AA2D4C3E30FA86","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-PSTY-BASIC","value":"circuit"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-GPRTY-MULTIPARTY.md","id":"PSI-PROP-AAD5CB809BDBBB","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-GPRTY-MULTIPARTY","value":"secret_sharing"},{"dimension":"output_recipients","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-BMRR-AHE-TWO-PARTY.md","id":"PSI-PROP-AAE470E52DE0BB","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-BMRR-AHE-TWO-PARTY","value":"both parties receive the intersection if the symmetric difference is at most T, otherwise ⊥ (Figure 2, p. 6; §2.3, p. 6)"},{"dimension":"setup","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT.md","id":"PSI-PROP-AAE4B277D5C9FA","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT","value":"OOS OT extension with codewords of 627, 616, and 605 bits and \\( H_2 \\) outputs of 256 bits for \\( n = 2^{12}, 2^{16}, 2^{20} \\) (Figure 4, p. 23); three-hash table with \\( 1.3n \\) nodes, a heuristic parameter choice (§8.1, p. 23; Table 2, p. 29)"},{"dimension":"adversary_scope","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF.md","id":"PSI-PROP-ABEE689699A3F5","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","value":"semi-honest environment corrupting any proper subset of the parties (§2.2, p. 5; Theorem 7.1, p. 28)"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-BMRR-TFHE-DIFF.md","id":"PSI-PROP-AC14C97C0C118D","review_status":"scheme_declared","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-BMRR-TFHE-DIFF","value":"sublinear-in-set-size"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-GS-AHE.md","id":"PSI-PROP-ACF6D461E8FAD8","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-GS-AHE","value":"additively_homomorphic_encryption"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2004-FNP-CARDINALITY.md","id":"PSI-PROP-AD082FE30854C9","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2004-FNP-CARDINALITY","value":"oblivious_polynomial_evaluation"},{"dimension":"setup","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2023-GS-MULTIPARTY.md","id":"PSI-PROP-AD11923CFAA932","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2023-GS-MULTIPARTY","value":"pairwise authenticated private channels and a broadcast channel of unit cost (§2.1, p. 4); \\( \\epsilon \\) public random functions into \\( t \\) buckets, replaceable by PRFs with a public key (footnote 4, p. 3); inner multiparty cardinality test of Branco, Döttling, and Pu with generic secure computation (§4.1, p. 16)"},{"dimension":"technique","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-KRSSW-NR.md","id":"PSI-PROP-AD1FEC53517611","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-KRSSW-NR","value":"oprf"},{"dimension":"adversary","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2018-PSWW-2D.md","id":"PSI-PROP-AD887E09676028","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2018-PSWW-2D","value":"semi_honest"},{"dimension":"security_model","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-NTY-NO-COLLUSION.md","id":"PSI-PROP-AD891433D9643E","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-NTY-NO-COLLUSION","value":"random_oracle_model"},{"dimension":"set_size_regime","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION.md","id":"PSI-PROP-AD8E27A5B80ECB","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION","value":"balanced"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-PSTY-NO-STASH.md","id":"PSI-PROP-ADB27EAE2EE458","review_status":"scheme_declared","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-PSTY-NO-STASH","value":"linear-communication"},{"dimension":"capability_tag","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2019-GS-FHE.md","id":"PSI-PROP-ADB505A3C441F1","review_status":"scheme_declared","scope":"construction","subject_id":"PSI-CONSTRUCTION-2019-GS-FHE","value":"sublinear-in-set-size"},{"dimension":"output_recipients","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2010-DT-BLIND-RSA.md","id":"PSI-PROP-ADD6F9B89838CE","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2010-DT-BLIND-RSA","value":"the client only; mutual PSI by two one-way runs (§2, p. 2)"},{"dimension":"primitive","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF.md","id":"PSI-PROP-ADD977B761FE9C","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","value":"multiparty threshold PSI"},{"dimension":"setup","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2018-PSZ-OT.md","id":"PSI-PROP-ADF6118946FCF0","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2018-PSZ-OT","value":"512 base OTs for the 1-out-of-N OT extension with a \\( [2^{77}, 512, 129] \\) BCH code (§2.2.3, p. 11; §6.2.2, pp. 28-29); the proof assumes an ideal 1-out-of-N random OT functionality, whose efficient instantiation uses a hash modeled as a random oracle (§5, p. 23; §2.1, p. 8)"},{"dimension":"construction_family","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CONSTRUCTION-2021-RT-SH-V2.md","id":"PSI-PROP-AE7B2C9E293011","review_status":"fulltext_checked","scope":"construction","subject_id":"PSI-CONSTRUCTION-2021-RT-SH-V2","value":"key_agreement_polynomial_encoding"},{"dimension":"set_size_regime","evidence_ref":"knowledge/primitives/psi/schemes/PSI-CON
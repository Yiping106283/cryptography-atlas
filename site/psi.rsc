ESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-436A5CF0FA871B","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-BWA","target":"PSI-CONTRIB-2012-HEK-GC-VERSUS-CUSTOM","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-43AA1AB2062FA9","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2022-RR","target":"PSI-CONTRIB-2022-RR-SUBFIELD-VOLE","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-43EBC17D3F680D","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-RT-MAL","target":"PSI-ASSUMPTION-ORACLE-DIFFIE-HELLMAN-WITH-ELLIGATOR-ENCODING-IDEAL-PERMUTATION-AND-RANDOM-ORACLES","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-443D1D2ACD6943","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-KMPRT-AUG","target":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-45547468E78DD3","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","target":"PSI-CONTRIB-2021-GPRTY-AMPLIFICATION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-45A1370CC6C4A4","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-1999-HFH","target":"PSI-ASSUMPTION-NOT-STATED-DISCRETE-LOG-SETTING-MODULO-A-PRIME-WITH-AN-UNPREDICTABLE-HASH","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-46DADD89D2AF5E","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-FAST","target":"PSI-CONTRIB-2021-RS-VOLE-OPRF","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-476DA4AB3F7609","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-KMPRT-AUG","target":"PSI-CONTRIB-2017-KMPRT-OPPRF","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-486EE26B16B9CD","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-VOLE","target":"PSI-PAPER-2021-GPRTY","type":"DESCRIBED_IN"},{"evidenceLocator":"VCE Table 3 (p. 13) and Appendix B.2 (p. 18), IACR ePrint 2023/1777, PDF dated 2023-11-16","evidenceUrl":"https://eprint.iacr.org/2023/1777","id":"PSI-REL-4A93689FF262F2","note":"VCE count \\( 7(n - 1)k \\) OTs at the leader, \\( 3.5(n - 1)k \\) per assistant, and \\( 3.5(n + 1)(n - 1)k \\) in total for the KMPRT protocol, from its OPPRF calls at 3.5 OTs each.","resultId":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","target":"PSI-CONTRIB-2024-VCE-ANALYTICAL-COST-COMPARISON","type":"ANALYZES"},{"evidenceLocator":"RS21 §1.4 (p. 6); §7.1 (pp. 25-26); Table 1 (p. 25); Table 3 (p. 29), IACR ePrint 2021/266, PDF dated 2024-08-08","evidenceUrl":"https://eprint.iacr.org/2021/266","id":"PSI-REL-4A94D8760D86BD","note":"VOLE-PSI builds on PaXoS-PSI but replaces OT extension with sublinear VOLE, sending κ rather than about \\( 5\\kappa \\) bits per encoding position with malicious security; for \\( 2^{20} \\) items it reports 57.86 MB against 247.6 MB.","resultId":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","target":"PSI-CONTRIB-2021-RS-VOLE-OPRF","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4ABB6AB5282544","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","target":"PSI-CONTRIB-2021-BMRR-FUNCTIONALITIES","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4B71BB97FCE1DF","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TFHE-DIFF","target":"PSI-CONTRIB-2021-BMRR-FUNCTIONALITIES","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4B7EB07397A196","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2023-GS","target":"PSI-CONTRIB-2023-GS-PICT-COMPILER","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4C34B8190BC86A","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-PWC","target":"PSI-PAPER-2012-HEK","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4D5364555A8086","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-FAST","target":"PSI-PAPER-2022-RR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4D873CF56D8DCE","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-CIRCUIT","target":"PSI-PAPER-2022-RR","type":"DESCRIBED_IN"},{"evidenceLocator":"GPRTY21 §1.2 (p. 3); §5 (p. 13), IACR ePrint 2021/883, PDF dated 2021-11-30","evidenceUrl":"https://eprint.iacr.org/2021/883","id":"PSI-REL-4DAF969B43E99E","note":"GPRTY21 responds to the practice, as in PSZ18, of extrapolating cuckoo-hashing failure probabilities from large experiments, by amplifying an empirically validated OKVS failure rate instead.","resultId":"PSI-CONTRIB-2018-PSZ-HASHING-PARAMETERS","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2018-PSZ-HASHING-PARAMETERS","target":"PSI-CONTRIB-2021-GPRTY-AMPLIFICATION","type":"ANALYZES"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4DE5C9FE2F8ECA","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2017-CLR","target":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-4F6B114C82B1A9","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-PSTY-ADVANCED","target":"PSI-PAPER-2019-PSTY","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-50B949A6D7652B","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-CONG","target":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BFV","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-50D7E964475902","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TFHE-INT","target":"PSI-ASSUMPTION-THRESHOLD-FHE-WITH-DISTRIBUTED-SETUP-FROM-CIRCULAR-SECURE-LWE-WITH-THRESHOLD-ADDITIVELY-HOMOMORPHIC-ENCRYPTION","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-50E106E328F87A","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-CONG-FROBENIUS","target":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BGV","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-51318CCC55D8D2","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-KMPRT-SH","target":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"RS21 §2 (pp. 10-11); Figure 1 (p. 7); Theorem 5.1 (pp. 21-22), IACR ePrint 2021/266, PDF dated 2024-08-08","evidenceUrl":"https://eprint.iacr.org/2021/266","id":"PSI-REL-525FE648B15A66","note":"XoPaXoS modifies the PaXoS solver to sample its free positions at random, so that the encoding is uniform for uniform values, as the OPPRF requires.","resultId":"PSI-CONTRIB-2020-PRTY-GARBLED-CUCKOO","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2020-PRTY-GARBLED-CUCKOO","target":"PSI-CONTRIB-2021-RS-CIRCUIT-PSI","type":"EXTENDS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5296D3F7381FE5","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG-LABELED","target":"PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-53BD65696B5082","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-RS-MAL","target":"PSI-ASSUMPTION-PROGRAMMABLE-RANDOM-ORACLES-IN-THE-VECTOR-OLE-HYBRID-MODEL-VOLE-FROM-LPN-WITH-REGULAR-NOISE","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5426E79FBE5D32","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-CONG","target":"PSI-CONTRIB-2021-CONG-FROBENIUS-POWERS","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-545DA0AFD7D042","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2019-KRSSW","target":"PSI-CONTRIB-2019-KRSSW-LOWMC-OPRF","type":"HAS_RESULT"},{"evidenceLocator":"GS23 §1 (pp. 1-2) and Corollary 6 (p. 16), IACR ePrint 2023/919, PDF dated 2023-06-12","evidenceUrl":"https://eprint.iacr.org/2023/919","id":"PSI-REL-5594AAE20F9322","note":"For the large-intersection condition, where BMRR reach \\( O(nT) \\) only from threshold FHE, GS23 reach \\( O(\\lambda^{2} \\ell t \\,\\mathrm{polylog}\\, t) \\) from oblivious transfer or additively homomorphic encryption, at an extra security-parameter and polylog factor.","resultId":"PSI-CONTRIB-2021-BMRR-TFHE-UPPER-BOUND","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-BMRR-TFHE-UPPER-BOUND","target":"PSI-CONTRIB-2023-GS-MULTIPARTY-QUASILINEAR","type":"CHANGES_ASSUMPTION"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-56468CC22251A4","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-KMPRT-AUG","target":"PSI-PAPER-2017-KMPRT","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5795F460859E5F","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2010-DT-FIG3","target":"PSI-ASSUMPTION-ONE-MORE-GAP-DH-AND-RANDOM-ORACLES","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF--RELIES_ON--ASM-DDH","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","target":"ASM-DDH","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF--RELIES_ON--ASM-DCR","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","target":"ASM-DCR","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF--RELIES_ON--ASM-PRG","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TAHE-DIFF","target":"ASM-PRG","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-58592D6C49A943","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2018-PSWW-2D","target":"PSI-ASSUMPTION-SEMI-HONEST-GENERIC-TWO-PARTY-COMPUTATION-GMW-OR-YAO-NO-ASSUMPTION-STATED","type":"RELIES_ON"},{"evidenceLocator":"KKRT16 §5.1 (p. 11), §5.3 (p. 12), Figure 3 (p. 13), IACR ePrint 2016/799, PDF dated 2016-08-20","evidenceUrl":"https://eprint.iacr.org/2016/799","id":"PSI-REL-5953C40F632A15","note":"The PSI protocol runs one BaRK-OPRF instance per cuckoo bin and stash position, so each bin consumes one row of a 424-448-bit OT-extension matrix.","resultId":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","target":"PSI-CONTRIB-2016-KKRT-ITEM-LENGTH-INDEPENDENT-PSI","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5961054A301428","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2016-KKRT","target":"PSI-ASSUMPTION-HAMMING-CORRELATION-ROBUST-HASH-AND-PSEUDORANDOM-CODE-WITH-IDEAL-BASE-OTS","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5AB2F45CB65ED1","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2004-FNP","target":"PSI-CONTRIB-2004-FNP-BALANCED-ALLOCATION-HASHING","type":"HAS_RESULT"},{"evidenceLocator":"CMGD21 §1.2 (p. 3) and §3.1 (pp. 11-12), IACR ePrint 2021/1116, PDF dated 2021-11-14","evidenceUrl":"https://eprint.iacr.org/2021/1116","id":"PSI-REL-5AB3DAF3D493F4","note":"CMGD21 lowers the number of encrypted query powers from \\( O(\\log B) \\), as with CLR17 windowing, to \\( O(1) \\) using depth-free Frobenius operations, reducing communication from \\( \\tilde O(2^{C} C^{2}) \\) to \\( \\tilde O(C^{2}) \\) with \\( C = \\log \\log |X| \\).","resultId":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","target":"PSI-CONTRIB-2021-CONG-FROBENIUS-POWERS","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"FNP04 §7 (pp. 15-17), EUROCRYPT 2004, LNCS 3027, printed pages","evidenceUrl":"https://doi.org/10.1007/978-3-540-24676-3_1","id":"PSI-REL-5AE307BB062E79","note":"Each client encodes its items as in the two-party protocol, and the leader evaluates all client polynomials with XOR-shared payloads.","resultId":"PSI-CONTRIB-2004-FNP-OPE-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2004-FNP-OPE-PSI","target":"PSI-CONTRIB-2004-FNP-MULTIPARTY-OPE","type":"EXTENDS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2012-HEK-BWA--RELIES_ON--ASM-DDH","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2012-HEK-BWA","target":"ASM-DDH","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2012-HEK-BWA--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2012-HEK-BWA","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"NTY §1.1.1 (p. 2), §1.2 (p. 4), IACR ePrint 2021/1221, PDF dated 2021-09-17","evidenceUrl":"https://eprint.iacr.org/2021/1221","id":"PSI-REL-5C4198F6422A15","note":"At \\( t = n - 1 \\) the NTY protocol coincides with that of Garimella et al. up to the OKVS instantiation, with the same performance; for smaller t it removes clients from the zero test and becomes cheaper.","resultId":"PSI-CONTRIB-2021-GPRTY-MALICIOUS-MULTIPARTY","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-GPRTY-MALICIOUS-MULTIPARTY","target":"PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED","type":"GENERALIZES"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5C63429C5E1295","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG-LABELED","target":"PSI-PAPER-2021-CONG","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5E44F52934BE20","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION","target":"PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-5E5D9A47579DAF","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2018-PSWW-MIRROR","target":"PSI-ASSUMPTION-SEMI-HONEST-GENERIC-TWO-PARTY-COMPUTATION-GMW-OR-YAO-NO-ASSUMPTION-STATED","type":"RELIES_ON"},{"evidenceLocator":"GPRTY21 §2.4, Definition 4 and Lemma 5 (pp. 6-7), IACR ePrint 2021/883, PDF dated 2021-11-30","evidenceUrl":"https://eprint.iacr.org/2021/883","id":"PSI-REL-5F0F33CB2352B3","note":"GPRTY21 observes that the PaXoS bound on encodable random-oracle values uses only correctness, restates it for any key-value store, and formalizes it as the (n, n')-overfitting game.","resultId":"PSI-CONTRIB-2020-PRTY-RECEIVER-SET-SIZE-BOUND","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2020-PRTY-RECEIVER-SET-SIZE-BOUND","target":"PSI-CONTRIB-2021-GPRTY-OKVS","type":"GENERALIZES"},{"evidenceLocator":"KMPRT §5.1-5.2 (pp. 11-12) and Figure 8 (p. 12), IACR ePrint 2017/799, PDF dated 2017-08-24","evidenceUrl":"https://eprint.iacr.org/2017/799","id":"PSI-REL-5FBADF6DF8D147","note":"Conditional zero-sharing and conditional reconstruction are both realized as multi-query OPPRF instances, between every pair of parties and from each party to the leader.","resultId":"PSI-CONTRIB-2017-KMPRT-OPPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-OPPRF","target":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-608B2F41B87049","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2024-VCE","target":"PSI-CONTRIB-2024-VCE-ANALYTICAL-COST-COMPARISON","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-62CAF492A6B895","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2017-KMPRT","target":"PSI-CONTRIB-2017-KMPRT-OPPRF","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-64C848D9D59073","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-SCS-HE","target":"PSI-CONTRIB-2012-HEK-GC-VERSUS-CUSTOM","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"PSTY19 Protocol 7 (p. 16) and §7.3 (p. 24), IACR ePrint 2019/241, PDF dated 2019-02-28","evidenceUrl":"https://eprint.iacr.org/2019/241","id":"PSI-REL-64EA78C08DB134","note":"The batched OPPRF is built in the F_OPRF-hybrid model, and its cost is estimated with the BaRK-OPRF at no more than 450 bits per evaluation.","resultId":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","target":"PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6505BF0B4DB78B","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR-MAL-LEAKAGE","target":"PSI-PAPER-2018-CHLR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-65D15F1320AB27","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2020-ION-BF","target":"PSI-ASSUMPTION-CPA-SECURE-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-EXPONENTIAL-ELGAMAL-AND-RING-LWE-IN-THE-MEASUREMENTS","type":"RELIES_ON"},{"evidenceLocator":"GPRTY21 §6.2 (p. 19), IACR ePrint 2021/883, PDF dated 2021-11-30","evidenceUrl":"https://eprint.iacr.org/2021/883","id":"PSI-REL-6689776221FC63","note":"GPRTY21 observes that the VOLE-PSI OPRF combines vector OLE with PaXoS and that any OKVS can replace PaXoS there; its own vector-OLE protocol is derived from PaXoS-PSI.","resultId":"PSI-CONTRIB-2021-RS-VOLE-OPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-RS-VOLE-OPRF","target":"PSI-CONTRIB-2021-GPRTY-LINEAR-OKVS-VOLE","type":"GENERALIZES"},{"evidenceLocator":"BMRR Theorems 4.1 and 4.3 with proofs (pp. 15-17), IACR ePrint 2020/600, PDF dated 2021-02-25","evidenceUrl":"https://eprint.iacr.org/2020/600","id":"PSI-REL-6760BCDBD515B5","note":"BMRR derive the per-party \\( \\Omega(T) \\) and total \\( \\Omega(nT) \\) bounds for multiparty threshold PSI by reducing from the two-party \\( \\Omega(T) \\) bound of GS19.","resultId":"PSI-CONTRIB-2019-GS-LOWER-BOUND","reviewStatus":"theorem_checked","source":"PSI-CONTRIB-2019-GS-LOWER-BOUND","target":"PSI-CONTRIB-2021-BMRR-LOWER-BOUND","type":"EXTENDS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6852828FE741DF","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2023-GS-TWO-PARTY","target":"PSI-PAPER-2023-GS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6896F7BABE1416","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","target":"PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-68C8B44D413083","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-VOLE","target":"PSI-CONTRIB-2021-GPRTY-LINEAR-OKVS-VOLE","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-699883E2F310D4","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-PSTY-NO-STASH","target":"PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6A411E78BA35BA","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TFHE-DIFF","target":"PSI-CONTRIB-2021-BMRR-TFHE-UPPER-BOUND","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6A7ED31B057834","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-SCS-WN","target":"PSI-CONTRIB-2012-HEK-SORT-COMPARE-SHUFFLE","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6A8B2A32C5E23F","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-MAL","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6A8E59A4E03B7F","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG-LABELED","target":"PSI-CONTRIB-2021-CONG-POSTAGE-STAMP-BASES","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6A9D2899E4A873","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-BMRR","target":"PSI-CONTRIB-2021-BMRR-LOWER-BOUND","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6B2DA213947C87","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-RS","target":"PSI-CONTRIB-2021-RS-VOLE-OPRF","type":"HAS_RESULT"},{"evidenceLocator":"GS19 §1 (p. 1) and §3 (pp. 7-8), IACR ePrint 2019/175, PDF dated 2020-05-27","evidenceUrl":"https://eprint.iacr.org/2019/175","id":"PSI-REL-6B9B3A5526164C","note":"Ghosh and Simkin reduce threshold PSI to PSI on padded sets and so turn the disjointness-based linear lower bound that they attribute to Freedman, Nissim, and Pinkas into an \\( \\Omega(t) \\) bound in the threshold.","resultId":"PSI-CONTRIB-2004-FNP-APPROX-LOWER-BOUND","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2004-FNP-APPROX-LOWER-BOUND","target":"PSI-CONTRIB-2019-GS-LOWER-BOUND","type":"EXTENDS"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-6C83A543FC895A","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR-LABELED","target":"PSI-CONTRIB-2018-CHLR-OPRF-MALICIOUS-RECEIVER","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"GPRTY21 §7.2 (pp. 21-22); Appendix B.2 (p. 30); Appendix B.6 (pp. 36-37), IACR ePrint 2021/883, PDF dated 2021-11-30","evidenceUrl":"https://eprint.iacr.org/2021/883","id":"PSI-REL-703E7986960F4D","note":"GPRTY21 shows that this protocol, with each OPRF output hashed together with the item by a random oracle and written over any OKVS, is secure against malicious adversaries.","resultId":"PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING","target":"PSI-CONTRIB-2021-GPRTY-MALICIOUS-MULTIPARTY","type":"HARDENS"},{"evidenceLocator":"RR17 §5.3 (pp. 8-10), §6.4 (pp. 15-16), IACR ePrint 2017/769, full version of August 9, 2017","evidenceUrl":"https://eprint.iacr.org/2017/769","id":"PSI-REL-7157E27A648ACB","note":"Viewing the sender's encodings in dual execution as commitments, the encode-commit protocol replaces them with a standard commitment and masked decommitments.","resultId":"PSI-CONTRIB-2017-RR-CCS-MALICIOUS-DUAL-EXECUTION","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-RR-CCS-MALICIOUS-DUAL-EXECUTION","target":"PSI-CONTRIB-2017-RR-CCS-ENCODE-COMMIT","type":"CHANGES_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-735E701D86EA30","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2020-ION-ROT","target":"PSI-PAPER-2016-KKRT","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7372FB6531F902","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-KRSSW-GC","target":"PSI-CONTRIB-2019-KRSSW-CUCKOO-FILTER-COMPRESSION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"RR22 §5.1 (p. 24), IACR ePrint 2022/320, PDF dated 2022-11-02","evidenceUrl":"https://eprint.iacr.org/2022/320","id":"PSI-REL-74B3190AACFDC3","note":"Raghuraman and Rindal argue that the empirical 2-core bound behind the star instantiation is in error, likely costing a few bits (λ about 27 rather than 29), and replace amplification by direct parameter selection at expansion 1.23 to 1.28 instead of 1.32.","resultId":"PSI-CONTRIB-2021-GPRTY-AMPLIFICATION","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-GPRTY-AMPLIFICATION","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"ANALYZES"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-750702C579DA68","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-BMRR-AHE-TWO-PARTY","target":"PSI-PAPER-2019-GS","type":"DESCRIBED_IN"},{"evidenceLocator":"RR22 abstract (p. 1); §1 (p. 2); Table 2 (p. 25), IACR ePrint 2022/320, PDF dated 2022-11-02","evidenceUrl":"https://eprint.iacr.org/2022/320","id":"PSI-REL-76ACFB69145BB5","note":"With the new OKVS, RR22's fast semi-honest PSI runs in 369 ms for \\( 2^{20} \\) items against 2,073 ms for KKRT16 on the same laptop.","resultId":"PSI-CONTRIB-2016-KKRT-ITEM-LENGTH-INDEPENDENT-PSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2016-KKRT-ITEM-LENGTH-INDEPENDENT-PSI","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-78850EB718F4FA","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG","target":"PSI-PAPER-2017-CLR","type":"DESCRIBED_IN"},{"evidenceLocator":"RS21 §1.4 (p. 6); §5 (p. 21); §6 (p. 22), IACR ePrint 2021/266, PDF dated 2024-08-08","evidenceUrl":"https://eprint.iacr.org/2021/266","id":"PSI-REL-7910E67D93EC17","note":"VOLE-PSI replaces the polynomial-interpolation OPPRF of PSTY19 with an OPPRF built from the VOLE-based OPRF and a XoPaXoS encoding of the sender's corrections.","resultId":"PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF","target":"PSI-CONTRIB-2021-RS-CIRCUIT-PSI","type":"CHANGES_MECHANISM"},{"evidenceLocator":"NTY §2.0.5 (p. 5), §4.1 and Protocol 4.2 (p. 10), Protocol C.1 (p. 14), IACR ePrint 2021/1221, PDF dated 2021-09-17","evidenceUrl":"https://eprint.iacr.org/2021/1221","id":"PSI-REL-79B8B9E816B9C4","note":"ZeroXOR masks each OPPRF-programmed value with the unconditional zero-sharing of KMPRT, which NTY restate as a functionality and protocol, and uses it against a malicious adversary.","resultId":"PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING","target":"PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED","type":"BUILDS_ON_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7C09EF78B36C91","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2017-CLR","target":"PSI-ASSUMPTION-IND-CPA-LEVELED-FHE-WITH-CIRCUIT-PRIVACY-FV-OVER-RING-LWE","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2012-HEK-PWC--RELIES_ON--ASM-DDH","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2012-HEK-PWC","target":"ASM-DDH","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2012-HEK-PWC--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2012-HEK-PWC","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"RR22 §1 (p. 2); Appendix A.1-A.2, Definitions 1-3 and Theorems 1-2 (pp. 30-31), IACR ePrint 2022/320, PDF dated 2022-11-02","evidenceUrl":"https://eprint.iacr.org/2022/320","id":"PSI-REL-7C2E8EB7762AEC","note":"The triangulation construction is a linear OKVS in the sense of the OKVS abstraction, and RR22 adds a doubly oblivious variant for circuit PSI.","resultId":"PSI-CONTRIB-2021-GPRTY-OKVS","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2021-GPRTY-OKVS","target":"PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","type":"INSTANTIATES"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7C53ED3545109C","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-RT-SH-V1","target":"PSI-PAPER-2021-RT","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7D106CCE1FA51A","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2004-FNP-CARDINALITY","target":"PSI-CONTRIB-2004-FNP-CARDINALITY-THRESHOLD","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7D1F92F6E2A051","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT","target":"PSI-PAPER-2020-PRTY","type":"DESCRIBED_IN"},{"evidenceLocator":"GS19 abstract (p. 1) and §1 (p. 2), IACR ePrint 2019/175, PDF dated 2020-05-27","evidenceUrl":"https://eprint.iacr.org/2019/175","id":"PSI-REL-7DC5B628F3963A","note":"Earlier threshold PSI, including the FNP04 threshold decision on the intersection size, communicates at least linearly in the smaller set; GS19 reaches communication depending mainly on t.","resultId":"PSI-CONTRIB-2004-FNP-CARDINALITY-THRESHOLD","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2004-FNP-CARDINALITY-THRESHOLD","target":"PSI-CONTRIB-2019-GS-AHE-THRESHOLD-PSI","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7DECC3E0B9B575","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG","target":"PSI-PAPER-2018-CHLR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7E03D36E227D8F","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-KMPRT-SH","target":"PSI-PAPER-2017-KMPRT","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7F3ABD60915625","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-SD","target":"PSI-PAPER-2022-RR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7FD148EE6A5CF8","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2017-RR-CCS-DE-ROM","target":"PSI-CONTRIB-2017-RR-CCS-MALICIOUS-DUAL-EXECUTION","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-7FFB4F8554B928","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2019-PSTY","target":"PSI-CONTRIB-2019-PSTY-PAYLOAD","type":"HAS_RESULT"},{"evidenceLocator":"PSZ18 §1.2 'OT-Based PSI' (pp. 4-5), Table 1 (p. 5), §5 (p. 22), IACR ePrint 2016/930, PDF dated 2019-07-28","evidenceUrl":"https://eprint.iacr.org/2016/930","id":"PSI-REL-8093770807288B","note":"PSZ18 contrasts its fixed BCH code with KKRT16's pseudorandom code for the same OPRF role, reporting 1.10-1.15 times the communication and noting that its code admits a malicious-receiver extension that the pseudorandom code does not.","resultId":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2016-KKRT-BATCHED-OPRF","target":"PSI-CONTRIB-2018-PSZ-BIT-LENGTH-INDEPENDENT-OT-PSI","type":"CHANGES_MECHANISM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-8240F7C3E5982C","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2010-DT-BLIND-RSA","target":"PSI-CONTRIB-2010-DT-BLIND-RSA","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-82848B2DEAEA36","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-1999-HFH","target":"PSI-CONTRIB-1999-HFH-DH-PREFERENCE-MATCHING","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-837415A871C9BD","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-BMRR-AHE-TWO-PARTY","target":"PSI-CONTRIB-2021-BMRR-TAHE-THRESHOLD-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"PSZ18 §1.3 (p. 5), §3 (p. 12), IACR ePrint 2016/930, PDF dated 2019-07-28; FNP04 §4.2 (pp. 7-8)","evidenceUrl":"https://eprint.iacr.org/2016/930","id":"PSI-REL-84C9E0993A1B27","note":"PSZ18 supplies concrete parameters for the hashing-to-bins approach that FNP04 introduced for PSI with only an asymptotic analysis.","resultId":"PSI-CONTRIB-2004-FNP-BALANCED-ALLOCATION-HASHING","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2004-FNP-BALANCED-ALLOCATION-HASHING","target":"PSI-CONTRIB-2018-PSZ-HASHING-PARAMETERS","type":"ANALYZES"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-87BB2A28DEAF53","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG-LABELED","target":"PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-897CD355CC8060","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2018-CHLR","target":"PSI-PAPER-2017-CLR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-898AA8A0EDBC53","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2012-HEK-PWC","target":"PSI-CONTRIB-2012-HEK-GC-VERSUS-CUSTOM","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-8AD0AF1346BECF","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2020-PRTY-MAL","target":"PSI
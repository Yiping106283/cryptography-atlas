standard_model"],"set_size_regime":"balanced","setup":"n-out-of-n threshold FHE with distributed setup for the cardinality test (Figure 5, p. 18) and threshold additively homomorphic encryption with distributed setup for the second phase (Figure 10, p. 41); star network with central party P1 (§2.3, p. 6)","technique":["threshold_fhe","additively_homomorphic_encryption","set_reconciliation"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"UC, semi-honest, up to \\( n - 1 \\) corruptions; Theorem B.1 in the F_CTest-int-hybrid model, instantiated by Theorem 5.1 (pp. 17, 40)","security_notion":"multiparty threshold PSI, functionality F_TPSI-int","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The F_TPSI-int protocol of Appendix B (pp. 39-41), with the cardinality test of §5.1. It realizes PSI-CONTRIB-2021-BMRR-TFHE-UPPER-BOUND for the functionality defined in PSI-CONTRIB-2021-BMRR-FUNCTIONALITIES.","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-BMRR","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"mixed","assumption_id":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BFV","assumption_name":"One-More-Gap-Diffie-Hellman in the random oracle model, and semantically secure leveled FHE (BFV)","authors":["Kelong Cong","Radames Cruz Moreno","Mariana Botelho da Gama","Wei Dai","Ilia Iliashenko","Kim Laine","Michael Rosenberg"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["communication-sublinear-in-larger-set","square-root-homomorphic-multiplications","updatable-sender-preprocessing","malicious-receiver-security"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER","PSI-CONTRIB-2021-CONG-POSTAGE-STAMP-BASES","PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS","PSI-CONTRIB-2018-CHLR-OPRF-MALICIOUS-RECEIVER"],"client_storage":null,"communication":null,"complexity":{"communication":"sublinear in \\( |X| \\) (abstract, p. 1); \\( O(1) \\) ciphertexts from the sender per bin set before partitioning, and receiver-to-sender powers bounded by Lemma 1 for a target depth (§3.1, p. 9)","computation":"\\( O(\\sqrt{|X|}) \\) homomorphic multiplications (abstract, p. 1); per bin \\( L_\\alpha + (\\alpha + 1) H_\\alpha - (\\alpha + 3) \\) non-scalar multiplications with \\( \\alpha \\) partitions (eq. (4), p. 8)","reported_measurement":"\\( |X| = 2^{28} \\), \\( |Y| = 2048 \\): sender online 4.75 s on 24 threads, online communication 15.09 MB, sender offline 2,211 s; \\( |X| = 2^{24} \\), \\( |Y| = 4096 \\): sender online 11.0 s single-threaded, 5.1 MB receiver to sender and 2.5 MB sender to receiver; Intel Xeon Platinum 8272CL with 24 cores and 192 GB RAM, false-positive probability at most \\( 2^{-40} \\) per execution (Tables 1-2, pp. 16-17; §5, p. 14; §5.1, p. 16)"},"construction_family":"oprf_fhe_polynomial_evaluation_cuckoo_hashing","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-CONG","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-CONG","PSI-PAPER-2018-CHLR","PSI-PAPER-2017-CLR"],"paper_title":"Labeled PSI from Homomorphic Encryption with Reduced Computation and Communication","paper_url":"https://eprint.iacr.org/2021/1116","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"unbalanced PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"security against a malicious receiver and privacy against a malicious sender, with the security proof of the earlier labeled-PSI paper carried over unchanged (§3, p. 6)","output":["intersection"],"output_recipients":"receiver only (§2.2, p. 4; §3, p. 5)","parties":"two_party","rounds":"an OPRF exchange, then the receiver's encrypted query powers and the sender's reply (§3, pp. 5-6); no round count is stated","security_model":["random_oracle_model"],"set_size_regime":"unbalanced","setup":"the sender samples the OPRF key and pre-processes its OPRF-processed set offline; the precomputation is updatable (§3, p. 6; §4.2, p. 13); OMGDH-based OPRF over the FourQ curve with a random-oracle hash to the curve (§3.1, p. 12)","technique":["oprf","fully_homomorphic_encryption","cuckoo_hashing"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"as in the earlier labeled-PSI paper's Theorem 1: malicious receiver; privacy against a malicious sender (§3, p. 6)","security_notion":"PSI with output to the receiver","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This row is the unlabeled protocol of §3 (pp. 5-6) with the optimizations of §3.1 as configured in the SEAL implementation. Both sets pass through the OPRF of PSI-CONTRIB-2018-CHLR-OPRF-MALICIOUS-RECEIVER, now mandatory; items are split over prime-field slots (PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS); the receiver sends encrypted query powers chosen by postage-stamp bases (PSI-CONTRIB-2021-CONG-POSTAGE-STAMP-BASES); and the…","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-CONG","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"mixed","assumption_id":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BGV","assumption_name":"One-More-Gap-Diffie-Hellman in the random oracle model, and semantically secure leveled FHE (BGV)","authors":["Kelong Cong","Radames Cruz Moreno","Mariana Botelho da Gama","Wei Dai","Ilia Iliashenko","Kim Laine","Michael Rosenberg"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["communication-nearly-constant-in-larger-set","cacheable-evaluation-keys"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-CONG-FROBENIUS-POWERS","PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( \\tilde O(C^{2}) \\) with \\( C = \\log \\log |X| \\) (§1.2, p. 3); \\( O(1) \\) query ciphertexts for depth \\( O(\\log \\log |X|) \\) (§3.1, p. 11)","computation":"Paterson-Stockmeyer evaluation with powers obtained by Frobenius operations and non-scalar multiplications (§3.1, pp. 11-12); impractically high on current CPUs (abstract, p. 1)","reported_measurement":"\\( |Y| = 210 \\): online communication 0.72 MB at \\( |X| = 2^{20} \\) and 0.76 MB at \\( 2^{22} \\), \\( 2^{24} \\), and \\( 2^{26} \\); evaluation keys 6.22 to 9.17 MB sent once; at \\( |X| = 2^{24} \\) sender online 354 s and offline 305 s on 24 threads; 80-bit hashed items, at least 128-bit security for this parameter set, without OPRF or networking (Tables 5-6, pp. 19-20; Table 8, p. 27; §5, p. 15)"},"construction_family":"oprf_fhe_polynomial_evaluation_cuckoo_hashing","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-CONG-FROBENIUS","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-CONG"],"paper_title":"Labeled PSI from Homomorphic Encryption with Reduced Computation and Communication","paper_url":"https://eprint.iacr.org/2021/1116","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"unbalanced PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"the protocol keeps the OPRF step and its guarantees, a malicious receiver and privacy against a malicious sender (§3, p. 6); the proof-of-concept implementation omits the OPRF (§5, p. 15)","output":["intersection"],"output_recipients":"receiver only (§3, p. 5)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"unbalanced","setup":"the receiver sends Frobenius evaluation keys once, independent of its set and cacheable by the sender (§3.1, p. 12; §5.4, p. 19)","technique":["oprf","fully_homomorphic_encryption","cuckoo_hashing"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"as in the SEAL protocol (§3, p. 6); the measured implementation omits the OPRF (§5, p. 15)","security_notion":"PSI with output to the receiver","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This row is the low-communication configuration of §3.1 (pp. 11-12) and §5.4 (pp. 18-20), realizing PSI-CONTRIB-2021-CONG-FROBENIUS-POWERS. The receiver sends a constant number of encrypted powers; the sender obtains the low and high powers of Paterson-Stockmeyer evaluation (PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER) with Frobenius operations and a few non-scalar multiplications, and returns the intersection results.","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-CONG","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"mixed","assumption_id":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BFV","assumption_name":"One-More-Gap-Diffie-Hellman in the random oracle model, and semantically secure leveled FHE (BFV)","authors":["Kelong Cong","Radames Cruz Moreno","Mariana Botelho da Gama","Wei Dai","Ilia Iliashenko","Kim Laine","Michael Rosenberg"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["labels-for-matching-items","communication-sublinear-in-larger-set","updatable-labels"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS","PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER","PSI-CONTRIB-2021-CONG-POSTAGE-STAMP-BASES","PSI-CONTRIB-2018-CHLR-LABELED-PSI"],"client_storage":null,"communication":null,"complexity":{"communication":"receiver to sender as in unlabeled PSI; sender to receiver grows linearly in the number of item-length label fragments (§5.3, p. 18)","computation":"offline interpolation \\( O(B^{2}) \\) field operations per bin (§4.2, p. 13); online one polynomial evaluation per label fragment on the same query powers (§5.3, p. 18)","reported_measurement":"label length 288 bytes, \\( |X| = 2^{20} \\), \\( |Y| = 256 \\): sender online 0.66 s with 16 sender threads, client encryption 0.05 s single-threaded, communication 11.2 MB, against 4.6 s, 0.77 s, and 17.6 MB for the earlier labeled protocol (Table 3, p. 18); Table 4 (p. 19) adds 16- and 32-byte labels"},"construction_family":"oprf_fhe_polynomial_evaluation_cuckoo_hashing","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-CONG-LABELED","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-CONG","PSI-PAPER-2018-CHLR"],"paper_title":"Labeled PSI from Homomorphic Encryption with Reduced Computation and Communication","paper_url":"https://eprint.iacr.org/2021/1116","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"labeled PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"security against a malicious receiver, argued as a straightforward extension of the earlier unlabeled proof with labels encrypted under OPRF-derived keys (§4.2, p. 14); privacy against a malicious sender as in the unlabeled case (§3, p. 6)","output":["labeled"],"output_recipients":"receiver only, which learns the labels of matching items together with the intersection result (§2.2, p. 4; §4.2, p. 14)","parties":"two_party","rounds":"as in the unlabeled protocol, with one or more label results returned per item fragment (§4.2, p. 14); no round count is stated","security_model":["random_oracle_model"],"set_size_regime":"unbalanced","setup":"offline interpolation of encrypted-label chunks per bin and partition, with collision-aware insertion; updates use a fresh random nonce per label (§4.2, pp. 13-14)","technique":["oprf","fully_homomorphic_encryption","cuckoo_hashing"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"proof sketch extending the earlier unlabeled proof (§4.2, p. 14)","security_notion":"labeled PSI with output to the receiver","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This row is the labeled protocol of §4 (pp. 12-14) as configured in the SEAL implementation. It replaces the extension-field label interpolation of PSI-CONTRIB-2018-CHLR-LABELED-PSI by prime-field chunks (PSI-CONTRIB-2021-CONG-PRIME-FIELD-SLOTS) and evaluates the label polynomials with the Paterson-Stockmeyer method on the same query powers as the intersection polynomials (PSI-CONTRIB-2021-CONG-PATERSON-STOCKMEYER).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-CONG","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"ASM-ROM","assumption_ids":["ASM-ROM"],"assumption_name":"Random oracles, in the OOS OT-extension hybrid model","authors":["Gayathri Garimella","Benny Pinkas","Mike Rosulek","Ni Trieu","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["heuristic-error-analysis"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-GPRTY-3H-GCT","PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI"],"client_storage":null,"communication":null,"complexity":{"communication":"136.66 MB for \\( n = 2^{20} \\) (Table 1, p. 24); the protocol invokes \\( 1.3n \\) OTs, against \\( 2.4n \\) for PaXoS-PSI, and sends 1.61 times less than PaXoS-PSI (§8.2, p. 23)","computation":"three-hash table encoding and batch decoding in \\( O(n\\lambda) \\) (Figure 1, p. 8); 4,996 ms to encode and 1,034 ms to decode \\( 2^{20} \\) elements of \\( \\mathrm{GF}(2^{128}) \\) (Table 2, p. 29)","reported_measurement":"136.66 MB; 5,855 ms (4.6 Gbit/s), 10,417 ms (260 Mbit/s), 37,695 ms (33 Mbit/s) for \\( n = 2^{20} \\) and 128-bit items, one thread per party on AWS c5d.2xlarge (Table 1, p. 24; §8, pp. 22-23)"},"construction_family":"okvs_ot_extension","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-GPRTY","PSI-PAPER-2020-PRTY"],"paper_title":"Oblivious Key-Value Stores and Amplification for Private Set Intersection","paper_url":"https://eprint.iacr.org/2021/883","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious sender or receiver, through the PaXoS-PSI protocol and proofs, which are written for an arbitrary binary OKVS (§6.3, p. 19)","output":["intersection"],"output_recipients":"receiver only, as in PaXoS-PSI (§6.3, p. 19)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"OOS OT extension with codewords of 627, 616, and 605 bits and \\( H_2 \\) outputs of 256 bits for \\( n = 2^{12}, 2^{16}, 2^{20} \\) (Figure 4, p. 23); three-hash table with \\( 1.3n \\) nodes, a heuristic parameter choice (§8.1, p. 23; Table 2, p. 29)","technique":["okvs","ot_extension"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious two-party, random oracle model, OOS-hybrid, via the PaXoS-PSI proofs (§6.3, p. 19)","security_notion":"PSI with output to the receiver; corrupt parties may use larger sets","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The protocol is PaXoS-PSI (PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI) with the three-hash garbled cuckoo table of PSI-CONTRIB-2021-GPRTY-3H-GCT as its binary OKVS. Because PaXoS-PSI's protocol and proofs are written for an arbitrary binary OKVS, a smaller table directly reduces the number of OTs and the receiver's communication (§6.3, p. 19; §8.2, p. 23).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-GPRTY","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"ASM-ROM","assumption_ids":["ASM-ROM"],"assumption_name":"Random oracles, in the OOS OT-extension hybrid model","authors":["Gayathri Garimella","Benny Pinkas","Mike Rosulek","Ni Trieu","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["empirical-error-analysis"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-GPRTY-AMPLIFICATION","PSI-CONTRIB-2021-GPRTY-3H-GCT","PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI"],"client_storage":null,"communication":null,"complexity":{"communication":"145.42 MB for \\( n = 2^{20} \\) (Table 1, p. 24); the protocol invokes \\( 1.41n \\) OTs and sends 1.43 times less than PaXoS-PSI (§8.2, p. 23); OKVS size about \\( 1.3n \\) (§5.4, p. 18)","computation":"2,915 ms to encode and 1,625 ms to decode \\( 2^{20} \\) elements of \\( \\mathrm{GF}(2^{128}) \\) (Table 2, p. 29); encoding makes up to \\( 2q + 1 \\) calls to the leaf encoder (§5.2, p. 16)","reported_measurement":"145.42 MB; 4,987 ms (4.6 Gbit/s), 9,631 ms (260 Mbit/s), 36,871 ms (33 Mbit/s) for \\( n = 2^{20} \\) and 128-bit items, one thread per party on AWS c5d.2xlarge (Table 1, p. 24; §8, pp. 22-23)"},"construction_family":"okvs_ot_extension","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-GPRTY","PSI-PAPER-2020-PRTY"],"paper_title":"Oblivious Key-Value Stores and Amplification for Private Set Intersection","paper_url":"https://eprint.iacr.org/2021/883","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious sender or receiver, through the PaXoS-PSI protocol and proofs, which are written for an arbitrary binary OKVS (§6.3, p. 19)","output":["intersection"],"output_recipients":"receiver only, as in PaXoS-PSI (§6.3, p. 19)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"OOS OT extension with codewords of 627, 616, and 605 bits and \\( H_2 \\) outputs of 256 bits for \\( n = 2^{12}, 2^{16}, 2^{20} \\) (Figure 4, p. 23); star architecture with \\( q = 10 \\) leaves for \\( n = 2^{16} \\) and \\( q = 160 \\) for \\( n = 2^{20} \\), leaves of \\( 1.3n' + \\lambda + 0.5 \\log n' \\) positions, OKVS failure probability \\( 2^{-52.9} \\) and \\( 2^{-45.05} \\) from an empirically measured leaf failure rate of \\( 2^{-29.355} \\) (§5.4, pp. 17-18)","technique":["okvs","ot_extension"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious two-party, random oracle model, OOS-hybrid, via the PaXoS-PSI proofs (§6.3, p. 19)","security_notion":"PSI with output to the receiver; corrupt parties may use larger sets","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The protocol is PaXoS-PSI (PSI-CONTRIB-2020-PRTY-MALICIOUS-PAXOS-PSI) with the star-architecture OKVS of PSI-CONTRIB-2021-GPRTY-AMPLIFICATION, whose components are the three-hash tables of PSI-CONTRIB-2021-GPRTY-3H-GCT. The authors describe the star construction as the only OKVS in their comparison with an empirically proven error probability (Appendix A.2, p. 28).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-GPRTY","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"ASM-ROM","assumption_ids":["ASM-ROM","ASM-PRF"],"assumption_name":"Random oracle and PRF-based zero sharing, in the malicious two-party OPRF hybrid model","authors":["Gayathri Garimella","Benny Pinkas","Mike Rosulek","Ni Trieu","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["any-okvs"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-GPRTY-MALICIOUS-MULTIPARTY","PSI-CONTRIB-2021-GPRTY-OKVS"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( O(n^{2} \\kappa + nm(\\kappa + \\lambda + \\log m)) + o(nm) \\) for \\( n \\) parties with sets of size \\( m \\) (Table 4, p. 36); \\( O(n^{2} \\kappa + n \\cdot |\\mathrm{OPRF}| + n \\cdot m \\cdot \\log |\\mathbb{F}|) \\) (Appendix B.3, p. 30)","computation":"\\( \\Omega(nm) \\) field multiplications (Table 4, p. 36); each party encodes one OKVS of \\( m \\) points, and \\( P_0 \\) decodes \\( m \\) points in each received OKVS (Appendix B.3, p. 30)"},"construction_family":"oprf_okvs_zero_sharing","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-GPRTY-MULTIPARTY","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-GPRTY"],"paper_title":"Oblivious Key-Value Stores and Amplification for Private Set Intersection","paper_url":"https://eprint.iacr.org/2021/883","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"multiparty PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious; corrupt parties may contribute sets of up to about \\( 2m \\) items (Theorem 9, p. 31; Appendix B.4, p. 34)","corruption_threshold":"robust against \\( n - 1 \\) corruptions among \\( n \\) parties (Table 4 caption, p. 36); any subset of parties, including the central party, may be corrupt (Appendix B.4, p. 31)","output":["intersection"],"output_recipients":"the central party \\( P_0 \\) only (Figure 5, p. 39); an extension gives output to all parties under a weaker functionality (Appendix B.7, p. 38)","parties":"multiparty","rounds":"\\( |\\mathrm{OPRF}| + 1 \\) rounds (Appendix B.3, p. 30); 4 in the comparison of Table 4 (p. 36)","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"F_oprf-hybrid model with a malicious-secure two-party OPRF between \\( P_0 \\) and each party, instantiated with vOLE in Table 4 (p. 36); pairwise PRF keys for zero sharing exchanged in one input-independent round (Figure 5, step 1, p. 39; Appendix B.5, p. 35); exponentially large field \\( \\mathbb{F} \\)","technique":["okvs","vole","secret_sharing"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious, F_oprf-hybrid, random oracle model (Theorem 9, p. 31)","security_notion":"UC-secure multiparty PSI with output to a central party; corrupt parties may use larger sets","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This is the protocol of PSI-CONTRIB-2021-GPRTY-MALICIOUS-MULTIPARTY, written over an arbitrary OKVS (PSI-CONTRIB-2021-GPRTY-OKVS): Kolesnikov et al.'s zero-sharing construction with each OPRF output hashed together with the item by a random oracle (Appendix B.2, p. 30; Figure 5, p. 39).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-GPRTY","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"ASM-ROM","assumption_ids":["ASM-ROM"],"assumption_name":"Random oracles, in the vector-OLE hybrid model","authors":["Gayathri Garimella","Benny Pinkas","Mike Rosulek","Ni Trieu","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["any-linear-okvs"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-GPRTY-LINEAR-OKVS-VOLE"],"client_storage":null,"communication":null,"complexity":{"communication":"not quantified; the paper states that, since no error-correcting code is needed, communication is reduced relative to PaXoS-PSI (§7.1, p. 21)","computation":"not reported; the protocol was not implemented because no malicious-secure vOLE implementation existed (§7.1, p. 21)"},"construction_family":"okvs_vole","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-GPRTY-VOLE","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-GPRTY"],"paper_title":"Oblivious Key-Value Stores and Amplification for Private Set Intersection","paper_url":"https://eprint.iacr.org/2021/883","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious sender or receiver (Theorem 7, p. 21)","output":["intersection"],"output_recipients":"receiver only (Figure 3, step 3, p. 22)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"vOLE functionality in which the sender inputs a random \\( s \\in \\{0,1\\}^{\\ell_1} \\) and the receiver its OKVS (Figure 3, step 1, p. 22); requires a malicious-secure vOLE protocol (§7.1, p. 21); random oracles \\( H_1 \\), \\( H_2 \\) with \\( \\ell_1 \\), \\( \\ell_2 \\) as in PaXoS-PSI (Theorem 7, p. 21)","technique":["okvs","vole"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious two-party, random oracle model, vOLE-hybrid (Theorem 7, p. 21)","security_notion":"PSI with output to the receiver","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This is the protocol of PSI-CONTRIB-2021-GPRTY-LINEAR-OKVS-VOLE: PaXoS-PSI with the OOS correlation replaced by vector OLE, so that the receiver's encoding may be any linear OKVS and no error-correcting code is used (§7.1, pp. 20-22).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-GPRTY","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"symmetric","assumption_id":"PSI-ASSUMPTION-PRF-AND-RANDOM-ORACLE-WITH-OKVS-OBLIVIOUSNESS-AND-IDEAL-OPPRF-AND-ZERO-SHARING-FUNCTIONALITIES","assumption_name":"PRF and random oracle, with OKVS obliviousness and ideal OPPRF and zero-sharing functionalities","authors":["Ofri Nevo","Ni Trieu","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["corruption-threshold-calibration","lightweight-clients"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED","PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( O(m \\kappa) \\) per client and \\( O(m \\kappa \\max\\{t, n - t\\}) \\) for the leader (Table 1, p. 2); servers \\( P_{v+1}, \\ldots, P_{n-1} \\) communicate \\( O(m) \\) and \\( P_n \\) \\( O(mt) \\), with \\( \\kappa \\) omitted (§4.2.1, pp. 10-11)","computation":"\\( O(m t \\kappa) \\) per client and \\( O(m \\kappa (n - t)) \\) for the leader (Table 1, p. 2); pivot and servers \\( O(m (n - t)) \\), with \\( \\kappa \\) omitted (§4.2.1, pp. 10-11)","reported_measurement":"\\( n = 15, t = 7, m = 2^{20} \\) on LAN: client 3.48 s and total 32.56 s; client 41.94 MB and total 1,416.9 MB (Tables 3-4, p. 12); \\( n = 15, m = 2^{20} \\): 7.2, 22.8, 32.5, and 58.23 s for \\( t = 1, 4, 7, 14 \\) (§1.2, p. 4); 128-bit items, \\( \\lambda = 40 \\), \\( \\kappa = 128 \\), PaXoS with expansion 2.5, table-based OPPRF code of Kolesnikov et al., 2x 36-core Intel Xeon 2.30 GHz with 256 GB RAM, simulated LAN with 0.02 ms RTT and 10 Gbps, one thread per peer (§5, p. 11)"},"construction_family":"okvs_zeroxor","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-NTY","PSI-PAPER-2017-KMPRT"],"paper_title":"Simple, Fast Malicious Multiparty Private Set Intersection","paper_url":"https://eprint.iacr.org/2021/1221","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"multiparty PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious adversary statically corrupting any strict subset of the parties (abstract, p. 1; §1, p. 1; Theorem 4.5, p. 11)","corruption_threshold":"\\( t < n \\), chosen as a parameter; clients \\( n - t - 1 \\), one pivot, \\( t \\) servers (Protocol 4.4, p. 10; Theorem 4.5, p. 11)","output":["intersection"],"output_recipients":"\\( P_n \\) only (Functionality 2.1, p. 4; Protocol 4.4, step 6, p. 10)","parties":"multiparty","rounds":"4 rounds: keys and OKVSs in parallel, then ZeroXOR with one zero-sharing round plus the OPPRF rounds (§4.2.1, p. 11; Table 1, p. 2)","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"Theorem 4.5 is in the F_zeroXOR-hybrid and random oracle model (p. 11); ZeroXOR is in the F_zeroShare and F_opprf hybrid model (Theorem 4.3, p. 10); unconditional zero-sharing seeds are exchanged once (§2.0.5, p. 5; Protocol C.1, p. 14)","technique":["okvs","paxos","opprf","secret_sharing"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious, \\( t < n \\) corrupted, F_zeroXOR-hybrid and random oracle model (Theorem 4.5, p. 11)","security_notion":"\\( n \\)-party PSI with output to \\( P_n \\) (Functionality 2.1, p. 4)","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"Clients deliver a conditional zero-sharing to the pivot and the \\( t \\) servers through one OKVS and \\( t \\) PRF keys each, and the \\( t + 1 \\) parties run ZeroXOR (PSI-CONTRIB-2021-NTY-MALICIOUS-THRESHOLD-CALIBRATED; Protocol 4.4, p. 10). ZeroXOR masks each programmed value with the unconditional zero-sharing of PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING (§2.0.5, p. 5; §4.1, p. 10). At \\( t = n - 1 \\) there are no…","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-NTY","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"symmetric","assumption_id":"PSI-ASSUMPTION-PRF-AND-RANDOM-ORACLE-WITH-OKVS-OBLIVIOUSNESS-AND-AN-IDEAL-TWO-PARTY-PSI-FUNCTIONALITY","assumption_name":"PRF and random oracle, with OKVS obliviousness and an ideal two-party PSI functionality","authors":["Ofri Nevo","Ni Trieu","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["symmetric-key-primitives-only","no-collusion"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-NTY-MALICIOUS-NO-COLLUSION"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( O(m \\kappa) \\) per client and \\( O((m + n) \\kappa) \\) for the leader (Table 1, p. 2); each of \\( P_1, \\ldots, P_{n-2} \\) sends one OKVS of \\( O(m) \\) values and \\( P_1 \\) also sends \\( O(n) \\) keys of \\( \\kappa \\) bits (§3.2.2, p. 8)","computation":"\\( O(m \\kappa) \\) per client and \\( O(n m \\kappa) \\) for the leader (Table 1, p. 2); \\( P_1 \\) makes \\( O(nm) \\) PRF calls and \\( P_{n-1} \\) decodes \\( O(n) \\) OKVSs on \\( O(m) \\) values (§3.2.2, p. 8)","reported_measurement":"\\( n = 15, t = 1, m = 2^{20} \\) on LAN: client 3.95 s and total 7.25 s; client 41.94 MB and total 662.7 MB (Tables 3-4, p. 12); \\( n = 32, t = 1, m = 2^{20} \\): 10.71 s for \\( P_n \\) on LAN (Table 5, p. 12); 128-bit items, \\( \\lambda = 40 \\), \\( \\kappa = 128 \\), PaXoS with expansion 2.5, AES-NI PRF, 2x 36-core Intel Xeon 2.30 GHz with 256 GB RAM, simulated LAN with 0.02 ms RTT and 10 Gbps (§5, p. 11)"},"construction_family":"okvs_reduction_to_server_aided_psi","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-NTY-NO-COLLUSION","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-NTY"],"paper_title":"Simple, Fast Malicious Multiparty Private Set Intersection","paper_url":"https://eprint.iacr.org/2021/1221","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"multiparty PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious adversary corrupting at most one party (§3, p. 6; Theorem 3.4, p. 8)","corruption_threshold":"no collusion, \\( t \\le 1 \\) (§1.2, p. 4); \\( t = 1 \\) (Table 1, p. 2); a collusion of two parties such as \\( P_1 \\) and \\( P_{n-1} \\) breaks the protocol (§3.2.1, p. 8)","output":["intersection"],"output_recipients":"\\( P_n \\) only (Functionality 2.1, p. 4; Protocol 3.3, step 6, p. 8)","parties":"multiparty","rounds":"4 rounds, two plus the two rounds of the server-aided PSI of Kamara et al. (§3.2.2, p. 8); Table 1 lists 5 (p. 2)","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"Theorem 3.4 is in the \\( F_{\\mathrm{psi}}^{2,1,m} \\)-hybrid model (p. 8); the malicious variant hashes items with a random oracle (Protocol 3.3, note a, p. 8); the two-party PSI is instantiated with the server-aided PSI of Kamara et al., whose server is another party assumed not to collude (§3.1.1, p. 6; §3.2.2, p. 8; Appendix A, pp. 13-14); no oblivious transfer is used (§1.2, p. 4)","technique":["okvs","paxos","server_aided_psi"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious, at most one corrupted party, \\( F_{\\mathrm{psi}}^{2,1,m} \\)-hybrid (Theorem 3.4, p. 8)","security_notion":"\\( n \\)-party PSI with output to \\( P_n \\) (Functionality 2.1, p. 4)","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"PRF keys from \\( P_1 \\) and OKVS encodings reduce the \\( n \\)-party intersection to a two-party PSI between \\( P_{n-1} \\) and \\( P_n \\) (PSI-CONTRIB-2021-NTY-MALICIOUS-NO-COLLUSION; Protocol 3.3, p. 8). Each party appends its decoded value to its plain item so that a malicious \\( P_1 \\) cannot force false matches (§3.2, p. 7). The server-aided two-party PSI of Kamara et al. replicates every item \\( \\lambda \\) times and adds…","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-NTY","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"PSI-ASSUMPTION-RANDOM-ORACLES-IN-THE-OPPRF-AND-GENERIC-TWO-PARTY-COMPUTATION-HYBRID-MODELS-VOLE-FROM-LPN-WITH-REGULAR-NOISE","assumption_name":"Random oracles, in the OPPRF and generic two-party computation hybrid models; VOLE from LPN with regular noise","authors":["Peter Rindal","Phillipp Schoppmann"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["associated-values","secret-shared-output"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-RS-CIRCUIT-PSI","PSI-CONTRIB-2021-RS-VOLE-OPRF"],"client_storage":null,"communication":null,"complexity":{"communication":"13.4 MB (IKNP) and 4.79 MB (SilentOT) for \\( n = 2^{12} \\); 171 MB and 21.1 MB for \\( n = 2^{16} \\); 2,830 MB and 277 MB for \\( n = 2^{20} \\) (Table 4, p. 29)","computation":"one OPPRF over the cuckoo-table bins and one equality circuit per bin (§6, pp. 23-24; Figure 10, pp. 38-39)","reported_measurement":"for \\( n = 2^{20} \\): 23.3 s (IKNP) and 103 s (SilentOT) at 5 Gbps, 149 s and 120 s at 100 Mbps, one core per party on AWS M5.2xlarge (Table 4, p. 29; §7.2, p. 26)"},"construction_family":"opprf_cuckoo_circuit","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-RS-CIRCUIT","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-RS"],"paper_title":"VOLE-PSI: Fast OPRF and Circuit-PSI from Vector-OLE","paper_url":"https://eprint.iacr.org/2021/266","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"circuit-PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"semi-honest (abstract, p. 1); the OPPRF is proved in the F_oprf-hybrid model (Theorem 5.1, p. 21), and the circuit-PSI proof is deferred to Pinkas, Schneider, Tkachenko, and Yanai (§6, p. 23)","output":["circuit"],"output_recipients":"both parties receive secret shares of a membership bit and of associated values for each cuckoo-table bin (Figure 9, p. 38)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"cuckoo hashing with expansion 1.27 and three hash functions, following Pinkas, Schneider, Tkachenko, and Yanai (§7.2, pp. 29-30); OPPRF from the VOLE-based OPRF, whose security uses random oracles, and XoPaXoS (Figure 8, p. 38); generic two-party computation for the comparison, implemented with GMW whose OTs come from IKNP or SilentOT (§7.2, p. 30)","technique":["opprf","vole","paxos","cuckoo_hashing","gmw"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"semi-honest two-party; OPPRF in the F_oprf-hybrid model (Theorem 5.1, p. 21); composition argued by reference to Pinkas, Schneider, Tkachenko, and Yanai (§6, p. 23)","security_notion":"circuit-PSI with secret-shared output","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This is the protocol of PSI-CONTRIB-2021-RS-CIRCUIT-PSI: the circuit-PSI of Pinkas, Schneider, Tkachenko, and Yanai with their OPPRF replaced by one built from PSI-CONTRIB-2021-RS-VOLE-OPRF and XoPaXoS (§6, pp. 22-24).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-RS","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"PSI-ASSUMPTION-PROGRAMMABLE-RANDOM-ORACLES-IN-THE-VECTOR-OLE-HYBRID-MODEL-VOLE-FROM-LPN-WITH-REGULAR-NOISE","assumption_name":"Programmable random oracles, in the vector-OLE hybrid model; VOLE from LPN with regular noise","authors":["Peter Rindal","Phillipp Schoppmann"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["data-independent-setup"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-RS-VOLE-OPRF","PSI-CONTRIB-2021-RS-SHORT-OPRF-OUTPUTS"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( 2^{24} n_x^{0.05} + 307n_x + 128n_y \\) bits for \\( \\kappa = 128 \\), about \\( 960n \\), \\( 474n \\), and \\( 438n \\) bits for \\( n = 2^{16}, 2^{20}, 2^{24} \\) (Table 1, p. 25); the sender sends \\( \\kappa \\) bits per item (§7.1, p. 26)","computation":"\\( O(n) \\) (abstract, p. 1): PaXoS encoding by a linear pass plus \\( O(\\lambda^{3}) \\) Gaussian elimination on the 2-core (§2, pp. 9-10), and an LPN-based VOLE expansion with a consistency check (§3.1, p. 14)","reported_measurement":"57.86 MB; 5.150 s (LAN, 5 Gbps), 9.599 s (100 Mbps), 54.09 s (10 Mbps), 495.0 s (1 Mbps) for \\( n = 2^{20} \\) with setup excluded, and 58.79 MB and 6.157 s (LAN) with setup; one core per party on AWS M5.2xlarge (Table 3, p. 29; §7.2, p. 26)"},"construction_family":"vole_okvs_oprf","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-RS-MAL","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-RS"],"paper_title":"VOLE-PSI: Fast OPRF and Circuit-PSI from Vector-OLE","paper_url":"https://eprint.iacr.org/2021/266","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious sender or receiver (Theorem 3.1, p. 16; Theorem 4.1, p. 20); a malicious receiver's effective set is bounded by \\( n' = O(n) \\) through the PaXoS size bound, and by \\( m \\) under the authors' Strong OKVS Extraction Conjecture (§2, pp. 11-12; Lemma 3.3, p. 18)","output":["intersection"],"output_recipients":"receiver only (Figure 5, p. 37; Figure 6, step 4, p. 37)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"programmable random oracles (the simulators program \\( H \\), Lemmas 3.2-3.3, pp. 16-18); coin tossing for the offset \\( w \\) (Figure 4, steps 1 and 5, p. 36); F_vole-hybrid, implemented with LPN-based VOLE and the malicious consistency check of Weng et al. (§3.1, p. 14; §7.2, p. 26); OPRF outputs of \\( \\kappa \\) bits (Figure 6, p. 37)","technique":["batched_oprf","vole","paxos"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious two-party, programmable random oracle model, F_vole-hybrid (Theorem 3.1, p. 16; Theorem 4.1, p. 20)","security_notion":"PSI with output to the receiver; a corrupt receiver may use a larger set","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The OPRF is PSI-CONTRIB-2021-RS-VOLE-OPRF, and the transformation uses the analysis of PSI-CONTRIB-2021-RS-SHORT-OPRF-OUTPUTS, so the sender's values are \\( \\kappa \\) bits long (§4, pp. 19-20). The authors attribute the gap to the malicious PaXoS-PSI protocol to the \\( \\kappa \\) bits per encoding position and the κ-bit outputs (§7.1, p. 26).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-RS","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"PSI-ASSUMPTION-RANDOM-ORACLES-IN-THE-VECTOR-OLE-HYBRID-MODEL-VOLE-FROM-LPN-WITH-REGULAR-NOISE","assumption_name":"Random oracles, in the vector-OLE hybrid model; VOLE from LPN with regular noise","authors":["Peter Rindal","Phillipp Schoppmann"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["data-independent-setup"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-RS-VOLE-OPRF"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( \\rho\\kappa n_x + (\\lambda + \\log(n_x n_y)) n_y \\) bits plus the VOLE, with \\( \\rho = 2.4 \\) for PaXoS (§7.1, p. 24); \\( 2.4\\kappa n_x + (\\lambda + \\log(n_x n_y)) n_y + 2^{17} \\kappa n_x^{0.05} \\) bits in total, about \\( 914n \\), \\( 426n \\), and \\( 398n \\) bits for \\( n = 2^{16}, 2^{20}, 2^{24} \\) with \\( \\kappa = 128 \\), \\( \\lambda = 40 \\) (Table 1, p. 25)","computation":"\\( O(n) \\) (abstract, p. 1): PaXoS encoding by a linear pass over the cuckoo graph plus Gaussian elimination of \\( O(\\lambda^{3}) \\) on its 2-core (§2, pp. 9-10), and an LPN-based VOLE expansion (§3.1, pp. 13-14)","reported_measurement":"52.61 MB; 4.398 s (LAN, 5 Gbps), 8.496 s (100 Mbps), 48.69 s (10 Mbps), 449.7 s (1 Mbps) for \\( n = 2^{20} \\) with setup excluded, and 53.55 MB and 5.396 s (LAN) with setup; one core per party on AWS M5.2xlarge (Table 2, p. 28; §7.2, p. 26)"},"construction_family":"vole_okvs_oprf","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-RS-SH","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-RS"],"paper_title":"VOLE-PSI: Fast OPRF and Circuit-PSI from Vector-OLE","paper_url":"https://eprint.iacr.org/2021/266","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"semi-honest sender and receiver; OPRF outputs of \\( \\lambda + \\log_2(n_x) + \\log_2(n_y) \\) bits (Figure 6, p. 37)","output":["intersection"],"output_recipients":"receiver only (Figure 5, p. 37; Figure 6, step 4, p. 37)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"F_vole-hybrid with a random VOLE of length \\( m = 2.4n + d + \\lambda \\) over a field of about \\( 2^{\\kappa} \\) elements (Figure 1, p. 7; Figure 4, p. 36); the implementation uses LPN-based VOLE with iterative bootstrapping, part of which runs in a one-time, data-independent setup (§3.1, p. 14; §7.2, pp. 26-27); random oracles \\( H \\) and \\( H_F \\)","technique":["batched_oprf","vole","paxos"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"semi-honest two-party, random oracle model, F_vole-hybrid (Theorem 3.1, p. 16; Theorem 4.1, p. 20)","security_notion":"PSI with output to the receiver","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The OPRF is PSI-CONTRIB-2021-RS-VOLE-OPRF with the PaXoS solver of PSI-PAPER-2020-PRTY; the PSI step is the standard OPRF-to-PSI transformation with outputs just long enough to make false matches unlikely (§4, p. 19; Figure 6, p. 37). The authors observe that the VOLE overhead is highly sublinear, so the protocol is best suited to large sets, for example \\( n_x \\ge 2^{16} \\) (§7.1, p. 25).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-RS","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"discrete_log","assumption_id":"PSI-ASSUMPTION-ORACLE-DIFFIE-HELLMAN-WITH-ELLIGATOR-ENCODING-IDEAL-PERMUTATION-AND-RANDOM-ORACLES","assumption_name":"oracle Diffie-Hellman with elligator encoding, ideal permutation, and random oracles","authors":["Mike Rosulek","Ni Trieu"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["low-communication","small-sets"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-RT-KA-TO-MALICIOUS-PSI"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( 2\\kappa n_1 + \\phi n_2 + \\phi \\) bits, with \\( \\kappa = 128 \\) and \\( \\phi = 256 \\): one key-agreement message, \\( n \\) field elements for \\( P \\), and \\( n \\) outputs of \\( H_2 \\) of \\( 2\\kappa \\) bits (Table 1, p. 4; §4, 'Costs', p. 15)","computation":"sender one key-agreement message and \\( n \\) keys; receiver \\( n \\) responses and \\( n \\) keys; interpolation and multi-point evaluation of a degree-\\( n \\) polynomial in \\( O(n \\log^{2} n) \\) field operations (§4, 'Costs', p. 15)","reported_measurement":"\\( n = 2^{8} \\): 16.38 KB and 119.5 ms total on a simulated 10 Gbps network; \\( n = 2^{20} \\): 67.11 MB and 251.06 s total on 10 Gbps; 128-bit items, \\( \\kappa = 128 \\), \\( \\lambda = 40 \\), one Intel Xeon at 2.30 GHz with 256 GB RAM (Table 2, p. 17; Table 3, p. 18; §5.1-5.2, p. 19)"},"construction_family":"key_agreement_polynomial_encoding","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-RT-MAL","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-RT"],"paper_title":"Compact and Malicious Private Set Intersection for Small Sets","paper_url":"https://eprint.iacr.org/2021/1159","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious"],"adversary_scope":"malicious sender or malicious receiver, UC security (Lemma 5, p. 10; Lemma 6, p. 12)","output":["intersection"],"output_recipients":"the receiver only (Figure 2, p. 6; Figure 4, step 7, p. 11)","parties":"two_party","rounds":"two rounds for a one-round key agreement such as Diffie-Hellman: \\( P \\) from the receiver, then \\( m \\) and \\( K \\) from the sender (§4, 'Optimizations', p. 15)","security_model":["ideal_permutation_model","random_oracle_model"],"set_size_regime":"balanced","setup":"ideal permutation \\( \\Pi \\) on \\( \\{0,1\\}^{256} \\) instantiated with fixed-key Rijndael-256; random oracles instantiated with SHA2; Curve25519 with elligator encoding of the receiver's messages (§5.1, pp. 16-18; Appendix B, p. 28)","technique":["key_agreement"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious, UC, ideal permutation plus random oracle model (abstract, p. 1; Lemmas 5-7, pp. 10-14; §4.1, pp. 15-16)","security_notion":"PSI with output to the receiver; a corrupt receiver may input more than \\( n \\) items (\\( n' < 8n + 4 \\) for \\( n = 2^{10} \\), \\( |F| = 2^{256} \\))","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The receiver encodes \\( \\Pi^{-1} \\) of fresh Diffie-Hellman responses at the points \\( H_1(y_i) \\) of a polynomial; the sender sends its single Diffie-Hellman message and \\( H_2(x_i, k_i) \\) for the key \\( k_i \\) it derives from \\( \\Pi(P(H_1(x_i))) \\) (Figure 4, p. 11). The mechanism is PSI-CONTRIB-2021-RT-KA-TO-MALICIOUS-PSI.","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2021-RT","year":2021},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"discrete_log","assumption_id":"PSI-ASSUMPTION-CDH-WITH-ELLIGATOR-ENCODING-IDEAL-PERMUTATION-AND-RANDOM-ORACLES","assumption_name":"CDH with elligator encoding, ideal permutation, and random oracles","authors":["Mike Rosulek","Ni Trieu"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["low-communication","small-sets"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2021-RT-SEMI-HONEST-DH-COMMUNICATION"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( (\\lambda + \\log(n_1 n_2)) n_1 + \\phi n_2 + \\phi \\) bits, with \\( \\lambda = 40 \\) and \\( \\phi = 256 \\) (Table 1, p. 4)","computation":"\\( 3n \\) fixed-base and \\( 2n \\) variable-base exponentiations and two degree-\\( n \\) interpolation or multi-point evaluation steps in total (§1.2, p. 6)","reported_measurement":"semi-honest 'Ours' rows: \\( n = 2^{8} \\), 9.98 KB and 116.5 ms total on 10 Gbps; \\( n_1 = n_2 = 2^{20} \\), 44.04 MB and 245.06 s total on 10 Gbps (Table 2, p. 17; Table 3, p. 18). The paper does not say which semi-honest variant it benchmarked; its implementation section describes an ideal permutation, which variant 2 does not use (§5.1, p. 18)."},"construction_family":"key_agreement_polynomial_encoding","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2021-RT-SH-V1","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2021-RT"],"paper_title":"Compact and Malicious Private Set Intersection for Small Sets","paper_url":"https://eprint.iacr.org/2021/1159","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"semi-honest sender and receiver (Lemmas 11-12, pp. 24-25)","output":["intersection"],"output_recipients":"the receiver only (Figure 5, step 7, p. 24)","parties":"two_party","rounds":"three messages \\( m \\), \\( P \\), \\( K \\) (Figure 5, p. 24); for a one-round key agreement the paper combines \\( m \\) and \
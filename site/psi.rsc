n sort-compare-shuffle without its shuffle phase for \\( n = 2^{12} \\) and \\( 2^{16} \\), where that circuit was the previous best.","resultId":"PSI-CONTRIB-2012-HEK-SORT-COMPARE-SHUFFLE","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2012-HEK-SORT-COMPARE-SHUFFLE","target":"PSI-CONTRIB-2018-PSWW-2D-CUCKOO-HASHING","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-C4AD98566FA73D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-GS-FHE","target":"PSI-PAPER-2019-GS","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-C5550FB52B2CA3","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-NTY-NO-COLLUSION","target":"PSI-ASSUMPTION-PRF-AND-RANDOM-ORACLE-WITH-OKVS-OBLIVIOUSNESS-AND-AN-IDEAL-TWO-PARTY-PSI-FUNCTIONALITY","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-C5DC58B6908BF8","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2021-RS","target":"PSI-CONTRIB-2021-RS-CIRCUIT-PSI","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-C61EC95DA2A9F8","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2016-KKRT","target":"PSI-PAPER-2016-KKRT","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-C73DBB28A3B106","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-CONG-LABELED","target":"PSI-ASSUMPTION-ONE-MORE-GAP-DIFFIE-HELLMAN-IN-THE-RANDOM-ORACLE-MODEL-AND-SEMANTICALLY-SECURE-LEVELED-FHE-BFV","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-C88F7EE27991D5","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-BMRR-TFHE-DIFF","target":"PSI-ASSUMPTION-THRESHOLD-FHE-WITH-DISTRIBUTED-SETUP-FROM-CIRCULAR-SECURE-LWE-WITH-THRESHOLD-ADDITIVELY-HOMOMORPHIC-ENCRYPTION","type":"RELIES_ON"},{"evidenceLocator":"",
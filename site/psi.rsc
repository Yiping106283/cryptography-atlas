_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2022-RR","year":2022},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"idealized_model","assumption_id":"ASM-ROM","assumption_ids":["ASM-ROM"],"assumption_name":"Random oracles, in the vector-OLE hybrid model (malicious protocol of VOLE-PSI)","authors":["Srinivasan Raghuraman","Peter Rindal"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["multi-threaded"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","PSI-CONTRIB-2021-RS-VOLE-OPRF","PSI-CONTRIB-2021-RS-SHORT-OPRF-OUTPUTS"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( 1.3\\kappa n_x + \\kappa n_y + 2^{14.5} \\kappa \\) bits; \\( 343n \\), \\( 302n \\), and \\( 300n \\) bits for \\( n = 2^{16}, 2^{20}, 2^{24} \\) (Table 2, p. 25)","computation":"OKVS encoding in \\( O(m + g^{2}) \\) after linear-time triangulation (§2, p. 6), plus the VOLE","reported_measurement":"62 ms, 439 ms, and 8,055 ms for \\( n = 2^{16}, 2^{20}, 2^{24} \\) on one thread, and 65 ms, 222 ms, and 3,984 ms with 4 threads, on an Intel i7 9750H laptop over a local network of about 1 Gbps (Table 2, p. 25; §5, p. 23)"},"construction_family":"vole_okvs_oprf","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2022-RR-MAL","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2022-RR","PSI-PAPER-2021-RS"],"paper_title":"Blazing Fast PSI from Improved OKVS and Subf
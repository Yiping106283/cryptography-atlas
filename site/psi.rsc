 semi-honest security.","resultId":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-KMPRT-SYMMETRIC-KEY-MPSI","target":"PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2021-GPRTY-VOLE--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-VOLE","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-A04F9991339FFC","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MULTIPARTY","target":"PSI-CONTRIB-2021-GPRTY-MALICIOUS-MULTIPARTY","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR--RELIES_ON--ASM-ROM","note":"","resultId":null,"reviewStatus":"scheme_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-STAR","target":"ASM-ROM","type":"RELIES_ON"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-A1C066B0315B3D","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2020-ION-BF","target":"PSI-PAPER-2020-ION","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-A216A5D791D7B4","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2019-GS-AHE","target":"PSI-CONTRIB-2019-GS-AHE-THRESHOLD-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-A424EB9C307447","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-CONG-LABELED","target":"PSI-PAPER-2018-CHLR","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-A53D97F4D33FAE","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-GPRTY-MAL-3HGCT","target":"PSI-PAPER-2021-GPRTY","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-A593AA0DC56F66"
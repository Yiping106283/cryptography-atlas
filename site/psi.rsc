:"Random oracles, in the subfield-VOLE hybrid model; VOLE following Couteau-Rindal-Raghuraman 2021 and Boyle et al. 2019","authors":["Srinivasan Raghuraman","Peter Rindal"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["multi-threaded"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2022-RR-SUBFIELD-VOLE","PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS","PSI-CONTRIB-2021-RS-VOLE-OPRF"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( 1.2 \\log(n_x n_y) n_x + (\\lambda + \\log(n_x n_y)) n_y + 2^{14.5} \\kappa \\) bits as printed; \\( 206n \\), \\( 180n \\), and \\( 196n \\) bits for \\( n = 2^{16}, 2^{20}, 2^{24} \\) (Table 2, p. 25); \\( O(n\\lambda + n \\log n) \\) (abstract, p. 1)","computation":"OKVS encoding in \\( O(m + g^{2}) \\) after linear-time triangulation (§2, p. 6), without clustering (§4, p. 22)","reported_measurement":"63 ms, 1,353 ms, and 27,681 ms for \\( n = 2^{16}, 2^{20}, 2^{24} \\) on one thread, and 61 ms, 1,107 ms, and 25,325 ms with 4 threads, on an Intel i7 9750H laptop over a local network of about 1 Gbps (Table 2, p. 25; §5, p. 23)"},"construction_family":"subfield_vole_okvs","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2022-RR-SD","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2022-RR","PSI-PAPER-2021-RS"],"paper_title":"Blazing Fast PSI from Improved OKVS and Subfield VOLE","paper_url":"https://eprint.iacr.org/2022/320","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"semi-honest sender and receiver (Theorem 3, p. 33)","output":["intersection"],"output_recipients":"receiver only (Figure 9, step 5, p. 23; Figure 11, p. 32)","parties":"two_party","rounds":"not_reported","security_model":["random_oracle_model"],"set_size_regime":"balanced","setup":"F_sub-vole-hybrid with base field \\( B \\) the smallest field with \\( |B| \\ge 2^{\\lambda + \\log_2(n_x n_y)} \\) and extension \\( F \\) the smallest with \\( |F| \\ge 2^{\\kappa} \\) (§4, p. 22; Theorem 3, p. 33); VOLE following Couteau, Rindal, and Raghuraman and Boyle et al. (§4, p. 22); random oracles \\( H_B \\) and \\( H_o \\)","technique":["subfield_vole","okvs","batched_oprf"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"semi-honest two-party, random oracle model, F_sub-vole-hybrid (Theorem 3, p. 33)","security_notion":"PSI with output to the receiver","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This is the protocol of PSI-CONTRIB-2022-RR-SUBFIELD-VOLE (Figure 9, p. 23) with the OKVS of PSI-CONTRIB-2022-RR-TRIANGULATION-OKVS tuned for size (§4, p. 22).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2022-RR","year":2022},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"generic","assumption_id":"PSI-ASSUMPTION-OBLIVIOUS-TRANSFER-OR-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-ANY-ASSUMPTION-IMPLYING-SECURE-COMPUTATION","assumption_name":"Oblivious transfer or additively homomorphic encryption (any assumption implying secure computation)","authors":["Satrajit Ghosh","Mark Simkin"],"bas
ial_sparsity_test","set_reconciliation"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"UC, static passive adversary; Theorem 4 in the (F_PICT, F_NPA)-hybrid model and Theorem 5 in the F_OLE-hybrid model (pp. 14, 16)","security_notion":"threshold PSI (intersection if the symmetric difference is at most \\( 2t \\))","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The main protocol of the paper, PSI-CONTRIB-2019-GS-AHE-THRESHOLD-PSI: a private intersection cardinality test, then noisy polynomial addition and local interpolation (§§5-7, pp. 10-17).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-GS","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"lattice","assumption_id":"ASM-LWE","assumption_ids":["ASM-LWE","ASM-RLWE"],"assumption_name":"LWE or Ring-LWE","authors":["Satrajit Ghosh","Mark Simkin"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["sublinear-in-set-size"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2019-GS-FHE-UPPER-BOUND"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( 2t + 1 \\) ciphertexts from Alice and t ciphertexts from Bob, \\( O(t \\log p) \\) bits for elements of \\( \\mathbb{F}_p \\) (§3, p. 8)","computation":"Bob interpolates a rational function homomorphically from \\( 2t \\) encrypted points, which the authors call far from practical (§3, p. 8)"},"construction_family":"polynomial_threshold_psi","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2019-GS-FHE","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2019-GS"],"paper_title":"The Communication Complexity of Threshold Private Set Intersection","paper_url":"https://eprint.iacr.org/2019/175","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"two-party threshold PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"static passive adversary (§2.2, p. 6)","output":["threshold"],"output_recipients":"Alice receives the numerator polynomial \\( p_{A \\setminus B} \\), from which she computes the intersection, or ⊥ (§3, p. 8)","parties":"two_party","rounds":"two messages, Alice to Bob and Bob to Alice (§3, p. 8)","security_model":"not_reported","set_size_regime":"balanced","setup":"Alice's FHE key pair; public evaluation points \\( \\alpha_1, \\dots, \\alpha_{2t} \\) and a uniformly random z sent in the clear (§3, p. 8)","technique":["fully_homomorphic_encryption","set_reconciliation"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"passive adversary; security follows from the security of FHE, stated without a formal proof (§3, p. 8)","security_notion":"threshold PSI","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The FHE upper bound of §3 (p. 8), PSI-CONTRIB-2019-GS-FHE-UPPER-BOUND.","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-GS","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"symmetric","assumption_id":"PSI-ASSUMPTION-LOWMC-AS-A-PSEUDORANDOM-FUNCTION-AND-MALICIOUSLY-SECURE-OT-WITHOUT-A-PROOF","assumption_name":"LowMC as a pseudorandom function and maliciously secure OT, without a proof","authors":["Daniel Kales","Christian Rechberger","Thomas Schneider","Matthias Senker","Christian Weinert"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["precomputation","server-set-updates","malicious-client-security","no-online-server-cryptography","client-storage-linear-in-server-set"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2019-KRSSW-LOWMC-OPRF","PSI-CONTRIB-2019-KRSSW-COT-PRECOMPUTATION","PSI-CONTRIB-2019-KRSSW-CUCKOO-FILTER-COMPRESSION","PSI-CONTRIB-2019-KRSSW-MOBILE-IMPLEMENTATION"],"client_storage":null,"communication":null,"complexity":{"communication":"online: one correction bit per input bit from the client and one masked label per input bit from the server, 2 KiB server to client per client item (Figure 1, p. 9; Table 5, p. 13); base: one garbled circuit of 624 AND gates per precomputed item (Table 2, p. 8); setup: a filter linear in the server set, 1,072 MiB for \\( 2^{28} \\) items (Table 4, p. 13)","computation":"online: the client evaluates one garbled circuit per item and looks it up in the filter, and the server performs no cryptographic operations (§6.2, p. 13); setup: the server evaluates LowMC on every item of its set (Table 4, p. 13)","reported_measurement":"\\( N_s = 2^{28} \\), \\( N_c = 1024 \\), 128-bit items: base plus online 3.54 s (WiFi) and 8.59 s (LTE), 22.01 MiB server to client and 2.02 MiB client to server; setup transfer 1,072 MiB and server setup 1,869.13 s; one thread each, server Intel Core i7-4600U, client Google Pixel XL 2 (Table 6, p. 14; §6, p. 12)"},"construction_family":"oprf_cuckoo_filter_precomputation","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2019-KRSSW-GC","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2019-KRSSW"],"paper_title":"Mobile Private Contact Discovery at Scale","paper_url":"https://eprint.iacr.org/2019/517","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"unbalanced PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious","semi_honest"],"adversary_scope":"malicious client, using maliciously secure base OTs and OT extension; semi-honest server; argued in prose without a proof (§4.5, pp. 10-11; §5.1, pp. 11-12)","output":["intersection"],"output_recipients":"client only (Figure 1, p. 9)","parties":"two_party","rounds":"online phase: the client sends correction bits and the server answers with masked labels, after which the client evaluates the precomputed circuits and queries the filter locally (Figure 1, p. 9); no round count is stated","security_model":"not_reported","set_size_regime":"unbalanced","setup":"base phase: random correlated OTs by OT extension and one garbled LowMC circuit per future client item, repeated once the precomputed items are used up; setup phase: the server sends a compressed cuckoo filter of PRF values of its whole set, which the client stores; update phase: one tag and bucket index per changed item (Figure 1, p. 9; §3.5, p. 6)","technique":["garbled_circuits","oprf","ot_extension","cuckoo_filter"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious client and semi-honest server, argued informally (§4.5, pp. 10-11)","security_notion":"PSI with output to the client, with precomputation","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This row is the GC-PSI protocol of Figure 1 (p. 9), based on the precomputation protocol of Kiss et al. and the cuckoo filters of Resende and Aranha. It uses the LowMC parameters of PSI-CONTRIB-2019-KRSSW-LOWMC-OPRF, the correlated-OT precomputation of PSI-CONTRIB-2019-KRSSW-COT-PRECOMPUTATION, and the filter encoding of PSI-CONTRIB-2019-KRSSW-CUCKOO-FILTER-COMPRESSION, as implemented in…","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-KRSSW","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"group","assumption_id":"PSI-ASSUMPTION-NAOR-REINGOLD-PRF-OVER-P-256-AND-MALICIOUSLY-SECURE-OT-WITHOUT-A-PROOF","assumption_name":"Naor-Reingold PRF over P-256 and maliciously secure OT, without a proof","authors":["Daniel Kales","Christian Rechberger","Thomas Schneider","Matthias Senker","Christian Weinert"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["precomputation","server-set-updates","malicious-client-security","client-storage-linear-in-server-set"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2019-KRSSW-COT-PRECOMPUTATION","PSI-CONTRIB-2019-KRSSW-CUCKOO-FILTER-COMPRESSION","PSI-CONTRIB-2019-KRSSW-MOBILE-IMPLEMENTATION"],"client_storage":null,"communication":null,"complexity":{"communication":"online: per client item one correction bit and one correlated message per input bit and one group element \\( \\tilde g_i \\) (Figure 2, p. 10), 4,147 KiB server to client for \\( 2^{10} \\) items (Table 5, p. 13); base: 0.01 MiB server to client for \\( 2^{10} \\) items (Table 3, p. 13); setup: 1,072 MiB filter for \\( 2^{28} \\) items (Table 4, p. 13)","computation":"online: per client item the server computes \\( g^{a_0 \\cdot r_{\\mathrm{inv}}} \\) and the client one exponentiation (point multiplication) and a filter lookup (Figure 2, p. 10); setup: the server computes the Naor-Reingold PRF on every item, 52,332.38 s for \\( 2^{28} \\) items single-threaded (Table 4, p. 13)","reported_measurement":"\\( N_s = 2^{28} \\), \\( N_c = 1024 \\), 128-bit items: base plus online 2.92 s (WiFi) and 6.53 s (LTE), 4.07 MiB server to client and 2.00 MiB client to server; setup transfer 1,072 MiB and server setup 52,332.38 s; one thread each, server Intel Core i7-4600U, client Google Pixel XL 2 (Table 6, p. 14; §6, p. 12)"},"construction_family":"oprf_cuckoo_filter_precomputation","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2019-KRSSW-NR","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2019-KRSSW"],"paper_title":"Mobile Private Contact Discovery at Scale","paper_url":"https://eprint.iacr.org/2019/517","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"unbalanced PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["malicious","semi_honest"],"adversary_scope":"malicious client, using maliciously secure base OTs and OT extension; semi-honest server; argued in prose without a proof (§4.5, pp. 10-11; §5.1, pp. 11-12)","output":["intersection"],"output_recipients":"client only (Figure 2, p. 10)","parties":"two_party","rounds":"online phase: the client sends correction bits, the server answers with one correlated message per input bit and one group element per item, and the client queries the filter locally (Figure 2, p. 10); no round count is stated","security_model":"not_reported","set_size_regime":"unbalanced","setup":"base phase: random OTs by OT extension, α per future client item; setup phase: the server sends a compressed cuckoo filter of Naor-Reingold PRF values of its whole set, which the client stores; updates as in GC-PSI (Figure 2, p. 10; §3.5, p. 6)","technique":["oprf","ot_extension","cuckoo_filter"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"malicious client and semi-honest server, argued informally (§4.5, pp. 10-11)","security_notion":"PSI with output to the client, with precomputation","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"This row is the NR-PSI protocol of Figure 2 (p. 10), based on the protocols of Hazay and Lindell and of Kiss et al. and on the cuckoo filters of Resende and Aranha. It uses the correlated-OT precomputation of PSI-CONTRIB-2019-KRSSW-COT-PRECOMPUTATION and the filter encoding of PSI-CONTRIB-2019-KRSSW-CUCKOO-FILTER-COMPRESSION, as implemented in PSI-CONTRIB-2019-KRSSW-MOBILE-IMPLEMENTATION. For each input bit the client…","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-KRSSW","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"symmetric","assumption_id":"ASM-PRF","assumption_ids":["ASM-PRF"],"assumption_name":"Pseudorandom functions","authors":["Benny Pinkas","Thomas Schneider","Oleksandr Tkachenko","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["linear-communication","role-reversal-for-stash"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2019-PSTY-LINEAR-COMMUNICATION","PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( O(n\\kappa) \\) for the two OPPRF phases and \\( 2n + s^{2} \\) comparisons of γ-bit values, \\( O(n) \\) comparisons for a stash of size \\( O(\\log n) \\) (§5.1, p. 19); concretely the stash step of the basic protocol is replaced by \\( B \\cdot (450 + (\\gamma - 1) \\cdot 256) \\) bits (§7.3, p. 25); 10,277 MB for \\( n = 2^{20} \\) (Table 3, p. 25)","computation":"two batched OPPRF executions and their polynomial interpolations (Protocol 10, p. 20)","reported_measurement":"estimated, not measured: 148,436 ms (LAN) and 597,885 ms (WAN) for \\( n = 2^{20} \\) with arbitrary bitlength and one thread (Table 5, p. 27; §7.4, p. 26)"},"construction_family":"opprf_cuckoo_hashing_circuit_psi","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2019-PSTY-ADVANCED","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2019-PSTY"],"paper_title":"Efficient Circuit-based PSI with Linear Communication","paper_url":"https://eprint.iacr.org/2019/241","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"circuit-PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"semi-honest P1 and P2 (§2.2, p. 8)","output":["circuit"],"output_recipients":"both parties obtain \\( f(X \\cap Y) \\) for the agreed function f (§1, p. 1)","parties":"two_party","rounds":"three phases: OPPRF with P1 as receiver, OPPRF with roles reversed on P1's stashed items, then one circuit (Protocol 10, p. 20); circuit depth \\( \\max(\\log \\sigma, \\log \\gamma) \\) (§7.3, p. 26)","security_model":["standard_model"],"set_size_regime":"balanced","setup":"batched OPPRF in the F_OPRF-hybrid model (Theorem 8, p. 15); generic two-party computation (Functionality 1, p. 9); cost estimates assume the OPRF of Kolesnikov et al. at 450 bits per evaluation and GMW (§7.3, p. 24; §7.4, p. 26)","technique":["opprf","batched_oprf","cuckoo_hashing","gmw"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"semi-honest two-party; security from the OPPRF and 2PC functionalities (§5.1, p. 20); failure negligible in the statistical parameter (§5, p. 19)","security_notion":"\\( f(X \\cap Y) \\) for a symmetric function f","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The asymptotically linear protocol of §5.1 (pp. 19-20), which the paper calls dual execution; here the second execution handles the stash and is not a malicious-security technique. It realizes the asymptotic part of PSI-CONTRIB-2019-PSTY-LINEAR-COMMUNICATION.","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-PSTY","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"symmetric","assumption_id":"ASM-PRF","assumption_ids":["ASM-PRF"],"assumption_name":"Pseudorandom functions","authors":["Benny Pinkas","Thomas Schneider","Oleksandr Tkachenko","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["payloads"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( B \\cdot 450 \\) bits for the OPRFs, hints of \\( B \\cdot \\max_b \\cdot \\gamma \\) bits, \\( B(\\gamma - 1) \\cdot 256 \\) bits for the bin comparisons, and \\( sn(\\sigma - 1) \\cdot 256 \\) bits for comparing the s stashed items with all n items of P2 (§7.3, p. 24); super-linear because a negligible failure probability needs \\( s = O(\\log n / \\log \\log n) \\) (§4.2, p. 18); 8,123 MB (\\( \\sigma = 32 \\)) and 12,731 MB (arbitrary σ) for \\( n = 2^{20} \\) (Table 3, p. 25)","computation":"polynomial interpolation over mega-bins, \\( O(n \\log n) \\) asymptotically with Lagrange interpolation for \\( n/\\log n \\) mega-bins (§4.3, p. 18)","reported_measurement":"estimated, not measured: 182,204 ms (LAN) and 752,695 ms (WAN) for \\( n = 2^{20} \\) with arbitrary bitlength and one thread (Table 5, p. 27; §7.4, p. 26)"},"construction_family":"opprf_cuckoo_hashing_circuit_psi","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2019-PSTY-BASIC","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2019-PSTY"],"paper_title":"Efficient Circuit-based PSI with Linear Communication","paper_url":"https://eprint.iacr.org/2019/241","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_quantum_mechanism":null,"preprocessing":null,"primitive":"circuit-PSI","privacy_model":null,"proof_model":null,"properties":{"adversary":["semi_honest"],"adversary_scope":"semi-honest P1 and P2 (§2.2, p. 8)","output":["circuit"],"output_recipients":"both parties obtain \\( f(X \\cap Y) \\) for the agreed function f (§1, p. 1)","parties":"two_party","rounds":"OPPRF phase followed by one circuit evaluation (Protocol 9, p. 17); circuit depth \\( \\max(\\log \\sigma, \\log \\gamma) \\) (§7.3, p. 26)","security_model":["standard_model"],"set_size_regime":"balanced","setup":"batched OPPRF in the F_OPRF-hybrid model (Theorem 8, p. 15); generic two-party computation (Functionality 1, p. 9); cost estimates assume the OPRF of Kolesnikov et al. and GMW (§7.3, p. 24)","technique":["opprf","batched_oprf","cuckoo_hashing","gmw"]},"quantum_security":null,"query_communication":null,"resilience":null,"response_communication":null,"robustness":null,"security_mode":"computational","security_model":"semi-honest two-party; security follows from the OPPRF and 2PC functionalities (§4.1, p. 17); fails if the stash overflows (§4.2, pp. 17-18)","security_notion":"\\( f(X \\cap Y) \\) for a symmetric function f","server_model":null,"server_work":null,"setup_model":null,"signer_model":null,"signing_cost":null,"signing_rounds":null,"sizes":{},"statefulness":null,"summary":"The basic protocol of §4.1 (pp. 16-17), built on PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF. Each bin needs one comparison, but every stashed item is still compared with all of P2's items, which keeps the communication super-linear (§4, p. 16; §5, p. 19).","supported_gates":null,"tag_size":null,"threshold_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-PSTY","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"symmetric","assumption_id":"ASM-PRF","assumption_ids":["ASM-PRF"],"assumption_name":"Pseudorandom functions","authors":["Benny Pinkas","Thomas Schneider","Oleksandr Tkachenko","Avishay Yanai"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["linear-communication","no-stash","payloads"],"ciphertext_security":null,"circuit_class":null,"claim_ids":["PSI-CONTRIB-2019-PSTY-LINEAR-COMMUNICATION","PSI-CONTRIB-2019-PSTY-BATCHED-OPPRF"],"client_storage":null,"communication":null,"complexity":{"communication":"\\( B \\cdot 450 \\) bits for the OPRFs, hints of \\( B \\cdot \\max_b \\cdot \\gamma \\) bits, and \\( B(\\gamma - 1) \\cdot 256 \\) bits for the bin comparisons, with \\( B = 1.27n \\) bins (§7.3, p. 24; §5.2, p. 20); 2,540 MB for \\( n = 2^{20} \\) for both fixed and arbitrary bitlengths, 96% of it the circuit (Table 3, p. 25)","computation":"Lagrange interpolation of hint polynomials of degree at most 1,024 per mega-bin, 45,335 ms estimated for \\( n = 2^{20} \\) with \\( K = 3 \\) (§7.2 and Table 2, pp. 23-24)","reported_measurement":"\\( n = 2^{20} \\), arbitrary bitlength, one thread: 120,731 ms (LAN) and 261,481 ms (WAN); two Intel Core i7-4770K PCs, \\( \\kappa = 128 \\), \\( K = 3 \\), \\( 1.27n \\) bins, no stash, LAN 1 Gbit/s with 1 ms RTT and WAN 100 Mbit/s with 100 ms RTT, averaged over 50 runs (Table 5, p. 27; §7.4, pp. 26-27)"},"construction_family":"opprf_cuckoo_hashing_circuit_psi","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2019-PSTY-NO-STASH","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"paper_ids":["PSI-PAPER-2019-PSTY"],"paper_title":"Efficient Circuit-based PSI with Linear Communication","paper_url":"https://eprint.iacr.org/2019/241","parallelizable":null,"plaintext_space":null,"policy_class":null,"post_
n \\) positions.","resultId":"PSI-CONTRIB-2020-PRTY-GARBLED-CUCKOO","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2020-PRTY-GARBLED-CUCKOO","target":"PSI-CONTRIB-2021-GPRTY-3H-GCT","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-904AD20799DEA4","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2022-RR-CIRCUIT","target":"PSI-CONTRIB-2021-RS-CIRCUIT-PSI","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-91AE0496C986F1","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-2021-NTY-ARBITRARY-COLLUSION","target":"PSI-CONTRIB-2017-KMPRT-AUGMENTED-ZERO-SHARING","type":"SUPPORTED_BY_CLAIM"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-930B154A39E41C","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-CONSTRUCTION-1999-HFH","target":"PSI-PAPER-1999-HFH","type":"DESCRIBED_IN"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-93A7052A551868","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2004-FNP","target":"PSI-CONTRIB-2004-FNP-MULTIPARTY-OPE","type":"HAS_RESULT"},{"evidenceLocator":"","evidenceUrl":"","id":"PSI-REL-9507428DA815F3","note":"","resultId":null,"reviewStatus":"source_declared","source":"PSI-PAPER-2019-GS","target":"PSI-CONTRIB-2019-GS-LOWER-BOUND","type":"HAS_RESULT"},{"evidenceLocator":"CMGD21 §1.2 (p. 3) and §3.1 (pp. 9-10), IACR ePrint 2021/1116, PDF dated 2021-11-14","evidenceUrl":"https://eprint.iacr.org/2021/1116","id":"PSI-REL-95DDF3E8551C05","note":"CMGD21 replaces the windowing introduced by CLR17 with extremal postage-stamp bases, sending fewer encrypted powers for the same depth.","resultId":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","reviewStatus":"fulltext_checked","source":"PSI-CONTRIB-2017-CLR-FHE-SUBLINEAR-COMMUNICATION","target":"PSI-CONTRIB-2021-CONG-POSTAGE-STAMP-BASES","type":"IMPROVES_EFFICIENCY"},{"evidenceLocator":"","evidenc
_policy":null,"transform":null,"update_model":null,"verification_cost":null,"work_id":"PSI-PAPER-2019-PSTY","year":2019},{"adaptive_security":null,"api_style":null,"associated_data":null,"assumption_family":"generic","assumption_id":"PSI-ASSUMPTION-CPA-SECURE-ADDITIVELY-HOMOMORPHIC-ENCRYPTION-EXPONENTIAL-ELGAMAL-AND-RING-LWE-IN-THE-MEASUREMENTS","assumption_name":"CPA-secure additively homomorphic encryption (exponential ElGamal and Ring-LWE in the measurements)","authors":["Mihaela Ion","Ben Kreuter","Ahmet Erhan Nergiz","Sarvar Patel","Shobhit Saxena","Karn Seth","Mariana Raykova","David Shanahan","Moti Yung"],"base_signature":null,"block_size":null,"bootstrapping":null,"capabilities":["encrypted-bloom-filter"],"ciphertext_security":null,"circuit_class":null,"claim_ids":[],"client_storage":null,"communication":null,"complexity":{"communication":"\\( M(61 + 1.44 \\log_2 M) + 1 \\) homomorphic ciphertexts for M items per party (Table 4, p. 12)","computation":"\\( M(104 + 2.44 \\log_2 M) + 1 \\) homomorphic operations and Bloom-filter insertions of M items twice (Table 3, p. 12)","reported_measurement":"100,000 items per party: 1,988.47 s and 925.98 MB with exponential ElGamal over a 256-bit curve for the Bloom filter and slotted Ring-LWE for the values; single thread of an Intel Xeon E5-1650 v3, network time excluded; 7.7865 US cents in the GCP cost model (Tables 5-6, p. 13; §5.1, p. 11)"},"construction_family":"encrypted_bloom_filter_homomorphic_tags","correctness":null,"corruption_model":null,"decapsulation_cost":null,"decrypt_cost":{},"decrypt_pairings":"","decryption_failure":null,"encapsulation_cost":null,"exactness":null,"id":"PSI-CONSTRUCTION-2020-ION-BF","identifiable_abort":null,"key_size":null,"large_universe":null,"misuse_resistance":null,"multi_use_attributes":null,"noise_management":null,"nonce_generation":null,"nonce_requirement":null,"nonce_size":null,"normative_status":null,"object_type":null,"online":null,"output_compatibility":null,"packing":null,"